{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencode-harness.invalid/schemas/adoption-bundle-pointer-v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_path",
    "inventory_path",
    "bundle_id",
    "view"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "schema_path": {
      "const": "adoption/schemas/adoption-bundle.v2.schema.json"
    },
    "inventory_path": {
      "const": "profiles/inventory.v2.json"
    },
    "bundle_id": {
      "enum": [
        "core",
        "quality",
        "evaluation",
        "complete"
      ]
    },
    "view": {
      "enum": [
        "adoption_bundles.core",
        "adoption_bundles.quality",
        "adoption_bundles.evaluation",
        "adoption_bundles.complete"
      ]
    }
  }
}
