--- /dev/null
+++ b/src/invoke.cjs
@@ -0,0 +1,10 @@
+exports.invoke=(plugin,input)=>new Promise((resolve,reject)=>{
+ if(!plugin){reject(new Error('unknown plugin'));return;}
+ let settled=false;
+ const done=(error,value)=>{if(settled)return;settled=true;if(error)reject(error);else {try{resolve(structuredClone(value));}catch(e){reject(e);}}};
+ try {
+  const result=plugin.run.call({name:plugin.name},structuredClone(input),done);
+  if(result&&typeof result.then==='function')Promise.resolve(result).then(value=>done(null,value),error=>done(error));
+  else if(result!==undefined)done(null,result);
+ }catch(error){done(error);}
+});
