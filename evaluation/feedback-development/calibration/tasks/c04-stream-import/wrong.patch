 import {record} from './record.mjs';
 export function parseText(text) { return text.split(/\r?\n/).filter(s=>s.trim()).map(s=>record(JSON.parse(s))); }
+function maximum(options) {
+ const max=options.maxLineBytes??65536;
+ if(!Number.isSafeInteger(max)||max<1)throw new RangeError('maxLineBytes');return max;
+}
+function line(value,n,max) {
+ const text=value.endsWith('\r')?value.slice(0,-1):value;
+ if(Buffer.byteLength(text,'utf8')>max)throw new RangeError('line '+n+': maxLineBytes');
+ if(!text.trim())return null;
+ let raw;try{raw=JSON.parse(text);}catch(e){throw new SyntaxError('line '+n+': '+e.message);}
+ try{return record(raw);}catch(e){throw new e.constructor('line '+n+': '+e.message);}
+}
+export async function* parseStream(chunks,options={}) {
+ const max=maximum(options),decoder=new TextDecoder('utf-8',{fatal:true});let pending='',n=1;
+ for await(const chunk of chunks) {
+  if(!(chunk instanceof Uint8Array))throw new TypeError('byte chunk');
+  pending+=Buffer.from(chunk).toString('utf8');let at;
+  while((at=pending.indexOf('\n'))>=0) {
+   const value=line(pending.slice(0,at),n++,max);pending=pending.slice(at+1);if(value!==null)yield value;
+  }
+  if(Buffer.byteLength(pending,'utf8')>max+(pending.endsWith('\r')?1:0))throw new RangeError('line '+n+': maxLineBytes');
+ }
+ pending+=decoder.decode();if(pending.length){const value=line(pending,n,max);if(value!==null)yield value;}
+}
