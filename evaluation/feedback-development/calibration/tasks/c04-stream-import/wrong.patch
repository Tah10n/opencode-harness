+import {parseText,parseStream} from './parse.mjs';
+export async function importRecords(input,{format='text',maxLineBytes}={}) {
+ if(!['text','stream'].includes(format))throw new RangeError('format');
+ const records=[];if(format==='text')records.push(...parseText(input));else for await(const r of parseStream(input,{maxLineBytes}))records.push(r);
+ return {records,total:records.reduce((n,r)=>n+r.count,0)};
 }
