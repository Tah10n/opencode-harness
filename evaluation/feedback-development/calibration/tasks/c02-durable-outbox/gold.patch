diff --git a/src/dispatch.mjs b/src/dispatch.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..f5122d29d21dcd34cb6d50754c95182e5b8cb551
--- /dev/null
+++ b/src/dispatch.mjs
@@ -0,0 +1,13 @@
+export async function dispatch(outbox,ids) {
+ const sent=[],failed=[];
+ const change=(id,fn)=>{const s=outbox.store.load(),r=s.records.find(r=>r.id===id);fn(r);outbox.store.save(s);return structuredClone(r);};
+ for(const id of ids) {
+  const r=change(id,r=>{r.status='inflight';r.attempts++;});
+  let error=null;
+  try { await outbox.send({id:r.id,payload:structuredClone(r.payload),sequence:r.sequence}); }
+  catch(e) { error=String(e?.message??e); }
+  change(id,r=>{r.status=error===null?'sent':'pending';r.lastError=error;});
+  (error===null?sent:failed).push(id);
+ }
+ return {sent,failed,remaining:outbox.snapshot().records.filter(r=>r.status==='pending').map(r=>r.id)};
+}
diff --git a/src/queue.mjs b/src/queue.mjs
index 89bb94ffb60ecdffcd927a2b646849048735a103..25bad50d09ab5a2e49c07c3c27435da0ccdfaa34 100644
