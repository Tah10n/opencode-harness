@@ -1,9 +1,26 @@
 import {message} from './message.mjs';
+import {dispatch} from './dispatch.mjs';
 export class Outbox {
- constructor(store,send) { this.store=store;this.send=send; }
+ constructor(store,send) {
+  this.store=store;this.send=send;this.active=null;this.closed=false;
+  const s=store.load();let changed=false;
+  for(const r of s.records)if(r.status==='inflight'){r.status='pending';changed=true;}
+  if(changed)store.save(s);
+ }
  enqueue(id,payload) {
-  const s=this.store.load();const old=s.records.find(r=>r.id===id);if(old)return structuredClone(old);
+  if(this.closed)throw new Error('closed');
+  if(typeof id!=='string'||!id.trim())throw new TypeError('id');
+  const s=this.store.load(),old=s.records.find(r=>r.id===id);if(old)return structuredClone(old);
   const r=message(id,payload,s.nextSequence++);s.records.push(r);this.store.save(s);return structuredClone(r);
  }
  snapshot() { return this.store.load(); }
+ drain({limit=Infinity}={}) {
+  if(this.closed)return Promise.reject(new Error('closed'));
+  if(limit!==Infinity&&(!Number.isSafeInteger(limit)||limit<0))return Promise.reject(new RangeError('limit'));
+  if(this.active)return this.active;
+  const ids=this.snapshot().records.filter(r=>r.status==='pending').sort((a,b)=>a.sequence-b.sequence).slice(0,limit).map(r=>r.id);
+  this.active=Promise.resolve().then(()=>dispatch(this,ids)).finally(()=>{this.active=null;});
+  return this.active;
+ }
+ async close() { this.closed=true;await this.active; }
 }
