diff --git a/src/catalog.mjs b/src/catalog.mjs
index 1af105673c1322e29290d93ac117ff9713ea1f69..602129722b2827c453c98ebaf09be37e963812b8 100644
--- a/src/catalog.mjs
+++ b/src/catalog.mjs
@@ -7,5 +7,26 @@ export class Catalog {
   if(at<0)s.products.push(next);else s.products[at]=next;
   s.revision++;this.storage.write(s);return structuredClone(next);
  }
+
+ applyBatch({expectedRevision,operations}) {
+  const s=this.storage.read();
+  if(!Number.isSafeInteger(expectedRevision)||expectedRevision<0)throw new RangeError('expectedRevision');
+  if(s.revision!==expectedRevision)throw new Error('revision conflict');
+  if(!Array.isArray(operations))throw new TypeError('operations');
+  const working=structuredClone(s);
+  for(const op of operations) {
+   if(op?.type==='upsert') {
+    const next=product(op.product),at=working.products.findIndex(p=>p.id===next.id);
+    if(at<0)working.products.push(next);else working.products[at]=next;
+   } else if(op?.type==='delete') {
+    if(typeof op.id!=='string'||!op.id.trim())throw new TypeError('id');
+    const at=working.products.findIndex(p=>p.id===op.id);
+    if(at<0)throw new Error('missing product');
+    working.products.splice(at,1);
+   } else throw new RangeError('operation');
+  }
+  if(operations.length) { working.revision++;this.storage.write(working); }
+  return {revision:working.revision,products:structuredClone(working.products)};
+ }
  revision() { return this.storage.read().revision; }
 }
diff --git a/src/command.mjs b/src/command.mjs
