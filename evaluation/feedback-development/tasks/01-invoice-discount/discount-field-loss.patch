diff --git a/src/pricing.mjs b/src/pricing.mjs
index 9bc46633ec8fca11c8ccd6cb8a117117c19f4ca8..68cc3974a8039321433d714779ff50711a163454 100644
--- a/src/pricing.mjs
+++ b/src/pricing.mjs
@@ -1,5 +1,6 @@
 import {validateLine} from './validate.mjs';
 export function invoice(lines) {
-  const items=lines.map(validateLine).map(line=>({...line, totalCents:line.quantity*line.unitCents}));
