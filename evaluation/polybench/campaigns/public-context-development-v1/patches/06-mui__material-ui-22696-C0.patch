+      expect(combobox).to.have.attribute('aria-expanded', 'true');
+
+      fireEvent.click(getAllByRole('option')[2], { shiftKey: true });
+      expect(combobox).to.have.attribute('aria-expanded', 'true');
+      expect(handleChange.lastCall.args[1]).to.deep.equal(['one', 'two', 'three']);
+    });
+
