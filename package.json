{
  "name": "opencode-harness",
  "version": "0.4.0",
  "description": "Native OpenCode configuration, isolated task delivery, and SWE-PolyBench evaluation adapter.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./native-template": "./lib/native-template.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tah10n/opencode-harness.git"
  },
  "bugs": {
    "url": "https://github.com/Tah10n/opencode-harness/issues"
  },
  "homepage": "https://github.com/Tah10n/opencode-harness#readme",
  "scripts": {
    "profile:materialize": "node scripts/profile-materialize.mjs",
    "verify": "node scripts/verify-all.mjs",
    "verify:installed": "node scripts/verify-installed.mjs",
    "verify:evaluation": "node evaluation/support/verify-scheduler.mjs && node evaluation/support/verify-recording.mjs && python3 evaluation/polybench/verify.py",
    "polybench:prepare": "python3 evaluation/polybench/prepare.py",
    "polybench:run": "node evaluation/polybench/run.mjs",
    "polybench:evaluate": "python3 evaluation/polybench/evaluate_predictions.py",
    "polybench:summary": "python3 evaluation/polybench/collect.py"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
