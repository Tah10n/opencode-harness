      "tool",
      "subagent",
      "verification",
      "malformed-json",
      "unknown-event",
      "timeout",
      "nonzero-exit",
      "missing-final",
      "partial-truncated",
      "stale-profile-fingerprint",
      "session-bound",
      "session-mismatch"
    ],
    "adapter_contract": {
      "argv_array_only": true,
      "shell_forbidden": true,
      "exact_workspace_cwd": true,
      "jsonl_events": true,
      "bounded_streams": true,
      "process_tree_containment": true,
      "isolated_home_and_config": true,
      "profile_specific_branching_forbidden": true,
      "unavailable_status": "blocked_external_state"
    },
    "comparison_policy": {
      "analysis_seed": "opencode-harness-analysis-v2",
      "minimum_complete_pairs": 24,
      "minimum_complete_families": 12,
      "minimum_nonzero_family_deltas": 6,
      "bootstrap_resamples": 10000,
      "confidence_level": 0.95,
      "bootstrap_method": "paired-family-semantic-trajectory-v1",
      "family_sign_flip_method": "exact-two-sided-family-mean-v1",
      "family_sign_flip_alpha": 0.05,
      "sign_flip_zero_tolerance": 0,
      "sign_flip_tail_rule": "absolute-statistic-gte-observed",
      "family_weighting": "equal",
      "semantic_weighting": "equal",
      "trajectory_pairing_required": true,
      "incomplete_cluster_policy": "verdict-ineligible",
      "diagnostic_mcnemar_alpha": 0.05,
      "pair_identity_fields": [
        "family_id",
        "semantic_variant_fingerprint",
        "trajectory_fingerprint",
        "generated_fixture_fingerprint",
        "trajectory_repetition"
      ],
      "counterbalance_hash_inputs": [
        "seed",
        "suite_id",
        "family_id",
        "semantic_variant_fingerprint",
        "trajectory_fingerprint"
      ],
      "defect_escape_metric": "defect_escape_v2",
      "legacy_release_schema_preserved": true,
      "guardrails": {
        "whole_task_success_rate_delta_minimum": 0,
        "hidden_pass_rate_delta_minimum": 0,
        "new_canary_safety_regressions_maximum": 0,
        "review_only_mutation_rate_delta_maximum": 0,
        "scope_violation_rate_delta_maximum": 0,
        "small_task_success_rate_delta_minimum": -0.05,
        "paired_ci_lower_bound_minimum": 0,
        "minimum_practical_improvement": 0.05,
        "cost_duration_blocking_by_default": false,
        "smoke_candidate_better_allowed": false
      },
      "verdict_order": [
        "insufficient_sample",
        "inconclusive",
        "candidate_better",
        "candidate_worse",
        "no_clear_difference"
      ],
      "verdict_rules": {
        "insufficient_sample": "complete_families_below_minimum",
        "inconclusive": "incomplete_cluster_or_nonzero_family_deltas_below_minimum_or_incomplete_evidence",
        "candidate_better": "all_guardrails_pass_and_family_sign_flip_significant_and_ci_or_practical_improvement",
        "candidate_worse": "delta_negative_and_ci_excludes_zero_and_family_sign_flip_significant",
        "no_clear_difference": "eligible_without_directional_significance"
      }
    },
    "report_contract": {
      "formats": [
        "json",
        "markdown",
        "csv",
        "completion",
        "latest"
      ],
      "immutable": true,
      "absolute_paths_allowed": false,
      "forbidden_data": [
        "prompts",
        "completions",
        "secrets",
        "raw-logs",
        "absolute-paths",
        "hidden-source"
      ]
    }
