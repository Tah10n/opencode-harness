{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencode-harness.invalid/schemas/vnext-execution-plan-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_kind",
    "suite_id",
    "estimand_id",
    "baseline_arm_id",
    "candidate_arm_id",
    "added_component_id",
    "eligible_strata",
    "family_ids",
    "metric_ids",
    "bindings",
    "plan_fingerprint"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "plan_kind": { "const": "vnext-component-ablation-plan" },
    "suite_id": { "enum": ["smoke", "standard", "full"] },
    "estimand_id": { "type": "string", "minLength": 1 },
    "baseline_arm_id": { "pattern": "^P[0-5]$" },
    "candidate_arm_id": { "pattern": "^P[0-5]$" },
    "added_component_id": { "type": "string", "minLength": 1 },
    "eligible_strata": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["small", "medium", "high"] }
    },
    "family_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "metric_ids": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "operational", "diagnostic"],
      "properties": {
        "product": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "operational": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "diagnostic": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "bindings": { "type": "object", "minProperties": 7 },
    "plan_fingerprint": { "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
