{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencode-harness.invalid/schemas/synthetic-replay-report-v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_kind",
    "run_id",
    "created_at",
    "evidence_class",
    "model_execution_confirmed",
    "family_id",
    "seed",
    "repetition",
    "instance_fingerprint",
    "profile_id",
    "profile_fingerprint",
    "model_binding_fingerprint",
    "execution_status",
    "termination_reason",
    "reason",
    "adapter_completed_correctly",
    "evidence_complete",
    "whole_task_success",
    "result_fingerprint",
    "attempt",
    "residual_caveats"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "report_kind": {
      "const": "synthetic-profile-replay"
    },
    "run_id": {
      "$ref": "#/$defs/safeId"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 32
    },
    "evidence_class": {
      "const": "model-backed-attempt"
    },
    "model_execution_confirmed": {
      "type": "boolean"
    },
    "family_id": {
      "$ref": "#/$defs/safeId"
    },
    "seed": {
      "$ref": "#/$defs/safeId"
    },
    "repetition": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "instance_fingerprint": {
      "$ref": "#/$defs/fingerprint"
    },
    "profile_id": {
      "enum": [
        "plain",
        "profile-only",
        "instrumented"
      ]
    },
    "profile_fingerprint": {
      "$ref": "#/$defs/fingerprint"
    },
    "model_binding_fingerprint": {
      "$ref": "#/$defs/fingerprint"
    },
    "execution_status": {
      "enum": [
        "completed",
        "failed",
        "incomplete",
        "blocked_external_state"
      ]
    },
    "termination_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "adapter_completed_correctly": {
      "type": "boolean"
    },
    "evidence_complete": {
      "type": "boolean"
    },
    "whole_task_success": {
      "type": "boolean"
    },
    "result_fingerprint": {
      "$ref": "#/$defs/fingerprint"
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding",
        "result"
      ],
      "properties": {
        "binding": {
          "$ref": "https://opencode-harness.invalid/schemas/synthetic-run-report-v2#/$defs/pairBinding"
        },
        "result": {
          "$ref": "https://opencode-harness.invalid/schemas/synthetic-run-report-v2#/$defs/runResult"
        }
      }
    },
    "residual_caveats": {
      "const": [
        "single-profile-replay-no-comparison"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "model_execution_confirmed": {
            "const": true
          }
        },
        "required": [
          "model_execution_confirmed"
        ]
      },
      "then": {
        "properties": {
          "adapter_completed_correctly": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "model_execution_confirmed": {
            "const": false
          }
        },
        "required": [
          "model_execution_confirmed"
        ]
      },
      "then": {
        "properties": {
          "adapter_completed_correctly": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_complete": {
            "const": true
          }
        },
        "required": [
          "evidence_complete"
        ]
      },
      "then": {
        "properties": {
          "model_execution_confirmed": {
            "const": true
          },
          "adapter_completed_correctly": {
            "const": true
          },
          "execution_status": {
            "const": "completed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_status": {
            "const": "blocked_external_state"
          }
        },
        "required": [
          "execution_status"
        ]
      },
      "then": {
        "properties": {
          "model_execution_confirmed": {
            "const": false
          },
          "adapter_completed_correctly": {
            "const": false
          },
          "evidence_complete": {
            "const": false
          },
          "whole_task_success": {
            "const": false
          },
          "termination_reason": {
            "const": "blocked_external_state"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "whole_task_success": {
            "const": true
          }
        },
        "required": [
          "whole_task_success"
        ]
      },
      "then": {
        "properties": {
          "evidence_complete": {
            "const": true
          }
        }
      }
    }
  ],
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^(?!(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\\..*)?$)(?!.*\\.$)[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
