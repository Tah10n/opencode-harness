{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencode-harness.invalid/schemas/synthetic-shard-report-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_kind",
    "shard_marker",
    "shard_id",
    "parent_generation_id",
    "created_at",
    "suite",
    "family_id",
    "model_binding_fingerprint",
    "adapter_fingerprint",
    "execution",
    "profiles",
    "schedule_projection",
    "expected_pair_ids",
    "actual_pair_ids",
    "complete",
    "incomplete_reasons",
    "pair_count",
    "pairs",
    "residual_caveats"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "report_kind": { "const": "synthetic-paired-shard" },
    "shard_marker": { "const": "synthetic-paired-family-shard-v1" },
    "shard_id": { "$ref": "https://opencode-harness.invalid/schemas/synthetic-run-report-v5#/$defs/safeId" },
    "parent_generation_id": { "$ref": "https://opencode-harness.invalid/schemas/synthetic-run-report-v5#/$defs/safeId" },
    "created_at": { "type": "string", "format": "date-time", "maxLength": 40 },
    "suite": { "$ref": "https://opencode-harness.invalid/schemas/synthetic-run-report-v5#/$defs/suite" },
    "family_id": { "$ref": "https://opencode-harness.invalid/schemas/synthetic-run-report-v5#/$defs/safeId" },
    "model_binding_fingerprint": { "$ref": "https://opencode-harness.invalid/schemas/synthetic-run-report-v5#/$defs/fingerprint" },
    "adapter_fingerprint": { "$ref": "https://opencode-harness.invalid/schemas/synthetic-run-report-v5#/$defs/nullableFingerprint" },
    "execution": { "$ref": "https://opencode-harness.invalid/schemas/synthetic-run-report-v5#/$defs/execution" },
    "profiles": { "$ref": "https://opencode-harness.invalid/schemas/synthetic-run-report-v5#/$defs/profilePair" },
    "schedule_projection": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/scheduleEntry" }
    },
    "expected_pair_ids": { "$ref": "#/$defs/pairIds" },
    "actual_pair_ids": { "$ref": "#/$defs/pairIds" },
    "complete": { "type": "boolean" },
    "incomplete_reasons": { "$ref": "https://opencode-harness.invalid/schemas/synthetic-run-report-v5#/$defs/reasonList" },
    "pair_count": { "type": "integer", "minimum": 0, "maximum": 10 },
    "pairs": {
      "type": "array",
      "maxItems": 10,
      "items": { "$ref": "https://opencode-harness.invalid/schemas/synthetic-run-report-v5#/$defs/pair" }
    },
    "residual_caveats": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "https://opencode-harness.invalid/schemas/synthetic-run-report-v5#/$defs/safeId" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "complete": { "const": true } }, "required": ["complete"] },
      "then": {
        "properties": {
          "adapter_fingerprint": { "$ref": "https://opencode-harness.invalid/schemas/synthetic-run-report-v5#/$defs/fingerprint" },
          "incomplete_reasons": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "complete": { "const": false } }, "required": ["complete"] },
      "then": { "properties": { "incomplete_reasons": { "minItems": 1 } } }
    }
  ],
  "$defs": {
    "scheduleEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pair_id", "order"],
      "properties": {
        "pair_id": { "$ref": "https://opencode-harness.invalid/schemas/synthetic-run-report-v5#/$defs/fingerprint" },
        "order": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["plain", "profile-only", "instrumented"] }
        }
      }
    },
    "pairIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": { "$ref": "https://opencode-harness.invalid/schemas/synthetic-run-report-v5#/$defs/fingerprint" }
    }
  }
}
