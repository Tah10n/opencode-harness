diff --git a/packages/connector/test/http.test.mjs b/packages/connector/test/http.test.mjs
new file mode 100644
index 0000000..97c6307
--- /dev/null
+++ b/packages/connector/test/http.test.mjs
@@ -0,0 +1,31 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { request, retryAfterMilliseconds } from "../lib/http.mjs";
+
+test("bounds numeric and invalid Retry-After values", () => {
+  const response = (value) => ({ headers: new Headers(value ? { "retry-after": value } : {}) });
+  assert.equal(retryAfterMilliseconds(response("301")), 300_000);
+  assert.equal(retryAfterMilliseconds(response("not-a-date")), null);
+  assert.equal(retryAfterMilliseconds(response()), null);
+});
+
+test("does not retry permanent errors and preserves status/code", async () => {
+  const originalFetch = globalThis.fetch;
+  let calls = 0;
+  globalThis.fetch = async () => {
+    calls += 1;
+    return new Response(JSON.stringify({ error: "bad_request" }), {
+      status: 400,
+      headers: { "content-type": "application/json" },
+    });
+  };
+  try {
+    await assert.rejects(
+      request("https://viberacing.example", "/api/usage", { method: "POST" }, 3),
+      (error) => error.status === 400 && error.code === "bad_request" && error.message === "Vibe Racing returned 400: bad_request",
+    );
+    assert.equal(calls, 1);
+  } finally {
+    globalThis.fetch = originalFetch;
+  }
+});
