diff --git a/packages/connector/test/transport.test.mjs b/packages/connector/test/transport.test.mjs
new file mode 100644
index 0000000..4584cc0
--- /dev/null
+++ b/packages/connector/test/transport.test.mjs
@@ -0,0 +1,33 @@
+import assert from "node:assert/strict";
+import { createServer } from "node:http";
+import test from "node:test";
+import { request, retryAfterMilliseconds } from "../lib/transport.mjs";
+
+test("transport retries eligible responses and preserves Retry-After bounds", async () => {
+  const seen = [];
+  const server = createServer((req, res) => {
+    seen.push(req.method + " " + req.url);
+    res.writeHead(seen.length === 1 ? 429 : 204, {
+      "content-type": "application/json",
+      ...(seen.length === 1 ? { "retry-after": "999999" } : {}),
+    });
+    res.end();
+  });
+  await new Promise((resolve) => server.listen(0, "127.0.0.1", resolve));
+  const origin = `http://127.0.0.1:${server.address().port}`;
+  const previousNodeEnvironment = process.env.NODE_ENV;
+  const previous = process.env.VIBERACING_TEST_MAX_RETRY_AFTER_MS;
+  process.env.NODE_ENV = "test";
+  process.env.VIBERACING_TEST_MAX_RETRY_AFTER_MS = "1";
+  try {
+    assert.equal(retryAfterMilliseconds(new Response(null, { headers: { "retry-after": "9" } })), 1);
+    await request(origin, "/retry", { method: "POST" }, 2, { kind: "empty" });
+    assert.deepEqual(seen, ["POST /retry", "POST /retry"]);
+  } finally {
+    if (previousNodeEnvironment === undefined) delete process.env.NODE_ENV;
+    else process.env.NODE_ENV = previousNodeEnvironment;
+    if (previous === undefined) delete process.env.VIBERACING_TEST_MAX_RETRY_AFTER_MS;
+    else process.env.VIBERACING_TEST_MAX_RETRY_AFTER_MS = previous;
+    await new Promise((resolve) => server.close(resolve));
+  }
+});
