diff --git a/packages/connector/test/transport.test.mjs b/packages/connector/test/transport.test.mjs
new file mode 100644
index 0000000..83f1c69
--- /dev/null
+++ b/packages/connector/test/transport.test.mjs
@@ -0,0 +1,160 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { createServer } from "node:http";
+import { once } from "node:events";
+import { request, retryAfterMilliseconds } from "../lib/transport.mjs";
+
+function json(value, status = 200, headers = {}) {
+  return new Response(JSON.stringify(value), {
+    status,
+    headers: { "content-type": "application/json", ...headers },
+  });
+}
+
+test("preserves request options and applies the connector transport policy", async () => {
+  const originalFetch = globalThis.fetch;
+  const originalAbortSignal = globalThis.AbortSignal;
+  let received;
+  let timeout;
+  globalThis.AbortSignal = {
+    timeout(milliseconds) {
+      timeout = milliseconds;
+      return originalAbortSignal.timeout(milliseconds);
+    },
+  };
+  globalThis.fetch = async (url, options) => {
+    received = { url, options };
+    return new Response(null, { status: 204 });
+  };
+  try {
+    assert.equal(
+      await request(
+        "https://viberacing.example",
+        "/api/pairing/cancel",
+        {
+          method: "POST",
+          headers: { Authorization: "Bearer device", "Content-Type": "application/json" },
+          body: '{"installationId":"installation"}',
+        },
+        1,
+        { kind: "empty" },
+      ),
+      null,
+    );
+    assert.equal(received.url, "https://viberacing.example/api/pairing/cancel");
+    assert.equal(received.options.method, "POST");
+    assert.deepEqual(received.options.headers, {
+      Authorization: "Bearer device",
+      "Content-Type": "application/json",
+    });
+    assert.equal(received.options.body, '{"installationId":"installation"}');
+    assert.ok(received.options.signal instanceof originalAbortSignal);
+    assert.equal(received.options.redirect, "error");
+    assert.equal(timeout, 15_000);
+  } finally {
+    globalThis.fetch = originalFetch;
+    globalThis.AbortSignal = originalAbortSignal;
+  }
+});
+
+test("does not retry permanent protocol errors and preserves status, code, and message", async () => {
+  const originalFetch = globalThis.fetch;
+  let calls = 0;
+  globalThis.fetch = async () => {
+    calls += 1;
+    return json({ error: "invalid_payload" }, 400);
+  };
+  try {
+    await assert.rejects(
+      request("https://viberacing.example", "/api/usage", {}, 3, { kind: "usage", sourceIds: [] }),
+      (error) => {
+        assert.equal(error.message, "Vibe Racing returned 400: invalid_payload");
+        assert.equal(error.status, 400);
+        assert.equal(error.code, "invalid_payload");
+        assert.equal(error.retryAfterMs, null);
+        return true;
+      },
+    );
+    assert.equal(calls, 1);
+  } finally {
+    globalThis.fetch = originalFetch;
+  }
+});
+
+test("retries eligible server errors with capped exponential backoff", async () => {
+  const originalFetch = globalThis.fetch;
+  const times = [];
+  let calls = 0;
+  globalThis.fetch = async () => {
+    times.push(Date.now());
+    calls += 1;
+    return calls < 3 ? json({ error: "server_error" }, 503) : new Response(null, { status: 204 });
+  };
+  try {
+    assert.equal(
+      await request("https://viberacing.example", "/api/revoke", {}, 3, { kind: "empty" }),
+      null,
+    );
+    assert.equal(calls, 3);
+    assert.ok(times[1] - times[0] >= 500);
+    assert.ok(times[2] - times[1] >= 1_000);
+  } finally {
+    globalThis.fetch = originalFetch;
+  }
+});
+
+test("calculates Retry-After deltas and HTTP dates with a test cap", () => {
+  const previousNodeEnv = process.env.NODE_ENV;
+  const previousMaximum = process.env.VIBERACING_TEST_MAX_RETRY_AFTER_MS;
+  process.env.NODE_ENV = "test";
+  process.env.VIBERACING_TEST_MAX_RETRY_AFTER_MS = "1000";
+  try {
+    assert.equal(
+      retryAfterMilliseconds(new Response(null, { headers: { "retry-after": "2" } })),
+      1000,
+    );
+    assert.equal(
+      retryAfterMilliseconds(new Response(null, { headers: { "retry-after": "not-a-delay" } })),
+      null,
+    );
+    assert.equal(
+      retryAfterMilliseconds(
+        new Response(null, { headers: { "retry-after": new Date(Date.now() - 60_000).toUTCString() } }),
+      ),
+      0,
+    );
+    const future = retryAfterMilliseconds(
+      new Response(null, { headers: { "retry-after": new Date(Date.now() + 60_000).toUTCString() } }),
+    );
+    assert.ok(future >= 0 && future <= 1000);
+  } finally {
+    if (previousNodeEnv === undefined) delete process.env.NODE_ENV;
+    else process.env.NODE_ENV = previousNodeEnv;
+    if (previousMaximum === undefined) delete process.env.VIBERACING_TEST_MAX_RETRY_AFTER_MS;
+    else process.env.VIBERACING_TEST_MAX_RETRY_AFTER_MS = previousMaximum;
+  }
+});
+
+test("refuses redirects instead of following them", async (context) => {
+  let targetRequests = 0;
+  const server = createServer((request_, response) => {
+    if (request_.url === "/redirect") {
+      response.writeHead(302, { location: "/target" });
+      response.end();
+      return;
+    }
+    targetRequests += 1;
+    response.writeHead(204);
+    response.end();
+  });
+  server.listen(0, "127.0.0.1");
+  await once(server, "listening");
+  context.after(() => server.close());
+  const address = server.address();
+  assert.notEqual(address, null);
+  assert.equal(typeof address, "object");
+  await assert.rejects(
+    request(`http://127.0.0.1:${address.port}`, "/redirect", {}, 1, { kind: "empty" }),
+  );
+  assert.equal(targetRequests, 0);
+});
