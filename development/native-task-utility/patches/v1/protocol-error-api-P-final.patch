+test("connect reports a validated pairing error without treating it as a successful payload", async (context) => {
+  let pairingStarts = 0;
+  const server = createServer((request, response) => {
+    request.resume();
+    request.on("end", () => {
+      if (request.url === "/api/pairing/start") {
+        pairingStarts += 1;
+        response.writeHead(400, { "content-type": "application/json" });
+        response.end(JSON.stringify({ error: "pairing_unavailable" }));
+        return;
+      }
+      response.writeHead(204);
+      response.end();
+    });
+  });
+  server.listen(0, "127.0.0.1");
+  await once(server, "listening");
+  context.after(() => server.close());
+  const address = server.address();
+  assert.notEqual(address, null);
+  assert.equal(typeof address, "object");
+  const home = await mkdtemp(join(tmpdir(), "viberacing-pairing-error-"));
+  context.after(() => rm(home, { recursive: true, force: true }));
+  const origin = `http://127.0.0.1:${address.port}`;
+  await writeCaptureInstallation(home, origin);
+
+  await assert.rejects(
+    execFileAsync(process.execPath, [connectorPath, "connect", "--origin", origin], {
+      env: connectorEnvironment(home, { NODE_ENV: "test", PATH: "" }),
+    }),
+    (error) => {
+      assert.equal(error.code, 1);
+      assert.match(error.stderr, /Vibe Racing returned 400: pairing_unavailable/);
+      return true;
+    },
+  );
+  assert.equal(pairingStarts, 1);
+});
+
