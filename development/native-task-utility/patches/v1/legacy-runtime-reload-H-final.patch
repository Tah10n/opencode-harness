+test("rejects unsafe or ambiguous legacy flat layouts without migration changes", async () => {
+  const root = await mkdtemp(join(tmpdir(), "viberacing-legacy-flat-rejections-"));
+  try {
+    const mutations = [
+      {
+        name: "unknown library entry",
+        apply: async (directory) => writeFile(join(directory, "lib", "unknown.mjs"), "foreign\n"),
+        error: /unrelated entry.*lib[\\/]unknown\.mjs/,
+      },
+      {
+        name: "extra nesting",
+        apply: async (directory) => {
+          await mkdir(join(directory, "lib", "adapters", "nested"));
+          await writeFile(
+            join(directory, "lib", "adapters", "nested", "cursor.mjs"),
+            "foreign\n",
+          );
+        },
+        error: /unrelated entry.*nested/,
+      },
+      {
+        name: "recognized symlink",
+        apply: async (directory) => {
+          const target = join(root, "symlink-target.mjs");
+          await writeFile(target, "target\n");
+          await unlink(join(directory, "lib", "config.mjs"));
+          await symlink(target, join(directory, "lib", "config.mjs"));
+        },
+        error: /unsupported entry/,
+      },
+      {
+        name: "foreign executable",
+        apply: async (directory) => {
+          const path = join(directory, "bin", "foreign");
+          await writeFile(path, "#!/bin/sh\n", { mode: 0o755 });
+          if (process.platform !== "win32") await chmod(path, 0o755);
+        },
+        error: /unrelated entry.*bin[\\/]foreign/,
+      },
+      {
+        name: "ambiguous ownership",
+        apply: async (directory) => unlink(join(directory, "installation.json")),
+        error: /custom.*marker|no valid identity or source registry/i,
+      },
+    ];
+    for (const mutation of mutations) {
+      const state = join(root, mutation.name.replaceAll(/[^A-Za-z0-9]+/g, "-"));
+      await mkdir(state, { recursive: true });
+      await writeLegacyRuntime(state);
+      await writeFile(
+        join(state, "installation.json"),
+        `${JSON.stringify({
+          version: 1,
+          id: "90909090-9090-4090-8090-909090909090",
+          secret: "legacy_flat_rejection_installation_secret",
+        })}\n`,
+      );
+      await mutation.apply(state);
+      const knownPaths = [
+        join(state, "bin", "viberacing.mjs"),
+        ...legacyRuntimeFiles.map((name) => join(state, "lib", name)),
+        ...legacyRuntimeAdapterFiles
+          .filter((name) => name !== "config.mjs")
+          .map((name) => join(state, "lib", "adapters", name)),
+      ];
+      const before = new Map(
+        await Promise.all(
+          knownPaths
+            .filter((path) => !path.endsWith(join("lib", "config.mjs")))
+            .map(async (path) => [path, await readFile(path)]),
+        ),
+      );
+      await assert.rejects(
+        execFileAsync(
+          process.execPath,
+          [
+            "--input-type=module",
+            "--eval",
+            `import { ensurePrivateStateDirectory } from ${JSON.stringify(configModuleUrl)}; await ensurePrivateStateDirectory();`,
+          ],
+          { env: connectorEnvironment(root, { NODE_ENV: "test", VIBERACING_STATE_DIR: state }) },
+        ),
+        mutation.error,
+        mutation.name,
+      );
+      for (const [path, bytes] of before) assert.deepEqual(await readFile(path), bytes, path);
+      await assert.rejects(access(join(state, ".viberacing-state")), { code: "ENOENT" });
+    }
+  } finally {
+    await rm(root, { recursive: true, force: true });
+  }
+});
