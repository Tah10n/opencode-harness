+test("migrates the exact legacy flat runtime without changing identity or legacy files", async () => {
+  const home = await mkdtemp(join(tmpdir(), "viberacing-legacy-flat-runtime-"));
+  const previousHome = process.env.HOME;
+  const previousUserProfile = process.env.USERPROFILE;
+  process.env.HOME = home;
+  process.env.USERPROFILE = home;
+  const restoreEnvironment = useModuleEnvironment(home);
+  try {
+    const directory = join(home, ".viberacing");
+    const legacyLauncher = join(directory, "bin", "viberacing.mjs");
+    const clientSourceId = "94949494-9494-4949-8949-949494949494";
+    const installation = {
+      version: 1,
+      id: "93939393-9393-4393-8393-939393939393",
+      secret: "legacy_flat_runtime_installation_secret",
+    };
+    const localSource = {
+      clientSourceId,
+      agentId: "codex",
+      collectionMethod: "codex_app_server",
+      dataPath: join(home, ".codex"),
+      suggestedLabel: "Codex",
+      supportedSurface: "desktop",
+    };
+    await mkdir(directory, { recursive: true });
+    await writeLegacyRuntime(directory);
+    await writeFile(join(directory, "installation.json"), `${JSON.stringify(installation)}\n`);
+    await writeFile(
+      join(directory, "sources.json"),
+      `${JSON.stringify({ version: 1, sources: [localSource] })}\n`,
+    );
+    await writeFile(
+      join(directory, "config.json"),
+      `${JSON.stringify({
+        version: 2,
+        origin: "https://viberacing.example",
+        installationId: installation.id,
+        deviceToken: "legacy_flat_runtime_device_token",
+        sources: [
+          {
+            ...localSource,
+            sourceId: "92929292-9292-4292-8292-929292929292",
+            agentAccountId: "91919191-9191-4191-8191-919191919191",
+            accountLabel: "Codex",
+            lastAcceptedSyncSequence: "7",
+          },
+        ],
+      })}\n`,
+    );
+    await writeFile(
+      join(directory, "state.json"),
+      '{"version":1,"sequences":{"92929292-9292-4292-8292-929292929292":"7"}}\n',
+    );
+
+    const legacyPaths = [
+      legacyLauncher,
+      ...legacyRuntimeFiles.map((name) => join(directory, "lib", name)),
+      ...legacyRuntimeAdapterFiles.map((name) => join(directory, "lib", "adapters", name)),
+    ];
+    const legacyBytes = new Map(
+      await Promise.all(legacyPaths.map(async (path) => [path, await readFile(path)])),
+    );
+    const module = await import(`../lib/config.mjs?legacy-flat=${encodeURIComponent(home)}`);
+
+    // Check the actual legacy tree immediately before invoking migration.
+    assert.equal((await readdir(join(directory, "lib"))).includes("config.mjs"), true);
+    await access(legacyLauncher);
+    await module.ensurePrivateStateDirectory();
+    const prepared = await module.prepareRuntime(pathToFileURL(legacyLauncher));
+    assert.equal(
+      prepared,
+      join(directory, "runtime", connectorVersion, "bin", "viberacing.mjs"),
+    );
+    assert.deepEqual(await module.readOrCreateInstallation(), installation);
+    assert.equal((await module.readConfig()).deviceToken, "legacy_flat_runtime_device_token");
+
+    const staged = await execFileAsync(process.execPath, [prepared, "--version"], {
+      env: connectorEnvironment(home, { PATH: "" }),
+    });
+    assert.equal(staged.stdout, `${connectorVersion}\n`);
+
+    await execFileAsync(
+      process.execPath,
+      [
+        "--input-type=module",
+        "--eval",
+        `import { prepareRuntime, readConfig } from ${JSON.stringify(new URL("../lib/config.mjs", import.meta.url).href)};
+import { readState } from ${JSON.stringify(new URL("../lib/runtime.mjs", import.meta.url).href)};
+const config = await readConfig();
+const state = await readState();
+if (config.installationId !== ${JSON.stringify(installation.id)} || state.sequences[${JSON.stringify("92929292-9292-4292-8292-929292929292")}] !== "7") throw new Error("legacy state was not retained");
+await prepareRuntime(${JSON.stringify(pathToFileURL(legacyLauncher).href)});`,
+      ],
+      { env: connectorEnvironment(home, { PATH: "" }) },
+    );
+    const unknownAfterReload = join(directory, "lib", "unknown-after-reload.mjs");
+    await writeFile(unknownAfterReload, "must remain unchanged\n");
+    await assert.rejects(
+      execFileAsync(
+        process.execPath,
+        [
+          "--input-type=module",
+          "--eval",
+          `import { ensurePrivateStateDirectory } from ${JSON.stringify(new URL("../lib/config.mjs", import.meta.url).href)}; await ensurePrivateStateDirectory();`,
+        ],
+        { env: connectorEnvironment(home, { PATH: "" }) },
+      ),
+      /unrelated entry.*unknown-after-reload/,
