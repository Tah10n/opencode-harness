+    assert.equal(await readFile(unknownAfterReload, "utf8"), "must remain unchanged\n");
+    for (const [path, bytes] of legacyBytes) assert.deepEqual(await readFile(path), bytes, path);
+    await access(join(directory, "runtime", connectorVersion, "lib", "adapters", "codex.mjs"));
+    await access(join(directory, "runtime", connectorVersion, "bin", "viberacing.mjs"));
+  } finally {
+    restoreEnvironment();
+    if (previousHome === undefined) delete process.env.HOME;
+    else process.env.HOME = previousHome;
+    if (previousUserProfile === undefined) delete process.env.USERPROFILE;
+    else process.env.USERPROFILE = previousUserProfile;
+    await rm(home, { recursive: true, force: true });
+  }
+});
