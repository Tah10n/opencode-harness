+import {createHash} from 'node:crypto';
 import {selectCatalog} from './select.mjs';
-export function handle(req,res,catalog){if(req.method!=='GET'){res.writeHead(405);res.end();return;}if(new URL(req.url,'http://localhost').pathname!=='/catalog'){res.writeHead(404);res.end();return;}res.writeHead(200,{'Content-Type':'application/json'});res.end(JSON.stringify(selectCatalog(catalog)));}
+
+export function handle(req, res, catalog) {
+  if (req.method !== 'GET') {
+    res.writeHead(405);
+    res.end();
+    return;
+  }
+
+  const url = new URL(req.url, 'http://localhost');
+  if (url.pathname !== '/catalog') {
+    res.writeHead(404);
+    res.end();
+    return;
+  }
+
+  const body = JSON.stringify(selectCatalog(catalog, url.searchParams.get('region')));
+  const etag = `"${createHash('sha256').update(body).digest('hex')}"`;
+  const headers = {
+    ETag: etag,
+    'Cache-Control': 'private, max-age=0'
+  };
+
+  if (req.headers?.['if-none-match'] === etag) {
+    res.writeHead(304, headers);
+    res.end();
+    return;
+  }
+
+  res.writeHead(200, {'Content-Type': 'application/json', ...headers});
+  res.end(body);
+}
diff --git a/src/select.mjs b/src/select.mjs
index 535eadd48aff30fc4cafe3fa5edc086528f1faf7..26b4f0ebeee995f2f707e34b029722153d79daec 100644
--- a/src/select.mjs
+++ b/src/select.mjs
@@ -1 +1,6 @@
-export function selectCatalog(catalog){return catalog.map(x=>({...x}));}
+export function selectCatalog(catalog, region) {
+  const selected = region === undefined || region === null
+    ? catalog
+    : catalog.filter(item => item.region === region);
+  return selected.map(item => ({...item}));
+}
