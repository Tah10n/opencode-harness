@@ -1,3 +1,142 @@
-import {test} from 'node:test';import assert from 'node:assert/strict';import {handle} from '../src/handler.mjs';import {loadCatalog} from '../src/client.mjs';
-test('legacy consumer returns items',async()=>{assert.deepEqual(await loadCatalog(async url=>{assert.equal(url,'/catalog');return {status:200,json:async()=>[{id:1}]};}),[{id:1}]);});
-test('existing method and path errors',()=>{for(const [method,url,code]of [['POST','/catalog',405],['GET','/other',404]]){let actual;handle({method,url,headers:{}},{writeHead:s=>actual=s,end:()=>{}},[]);assert.equal(actual,code);}});
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {createHash} from 'node:crypto';
+import {handle} from '../src/handler.mjs';
+import {loadCatalog} from '../src/client.mjs';
+
+function callHandler(req, catalog) {
+  let status;
+  let headers;
+  let body;
+  handle(req, {
+    writeHead(code, responseHeaders) {
+      status = code;
+      headers = responseHeaders;
+    },
+    end(responseBody = '') {
+      body = responseBody;
+    }
+  }, catalog);
+  return {status, headers, body};
+}
+
+test('catalog responses filter by region without mutating the catalog', () => {
+  const catalog = [
+    {id: 1, region: 'west'},
+    {id: 2, region: 'east'},
+    {id: 3, region: 'west'}
+  ];
+  const original = structuredClone(catalog);
+
+  const response = callHandler({method: 'GET', url: '/catalog?region=west', headers: {}}, catalog);
+
+  assert.deepEqual(JSON.parse(response.body), [catalog[0], catalog[2]]);
+  assert.deepEqual(catalog, original);
+  assert.equal(response.status, 200);
+  assert.equal(response.headers['Content-Type'], 'application/json');
+  assert.equal(response.headers['Cache-Control'], 'private, max-age=0');
+  assert.equal(
+    response.headers.ETag,
+    `"${createHash('sha256').update(response.body).digest('hex')}"`
+  );
+  assert.deepEqual(
+    JSON.parse(callHandler({method: 'GET', url: '/catalog', headers: {}}, catalog).body),
+    catalog
+  );
+  assert.notEqual(
+    response.headers.ETag,
+    callHandler({method: 'GET', url: '/catalog', headers: {}}, catalog).headers.ETag
+  );
+});
+
+test('matching ETag returns an empty 304 response', () => {
+  const catalog = [{id: 1, region: 'west'}];
+  const initial = callHandler({method: 'GET', url: '/catalog?region=west', headers: {}}, catalog);
+
+  assert.equal(catalog.length, 1);
+  const response = callHandler({
+    method: 'GET',
+    url: '/catalog?region=west',
+    headers: {'if-none-match': initial.headers.ETag}
+  }, catalog);
+
+  assert.equal(response.status, 304);
+  assert.equal(response.headers.ETag, initial.headers.ETag);
+  assert.equal(response.headers['Cache-Control'], 'private, max-age=0');
+  assert.equal(response.body, '');
+});
+
+test('ETag matching is exact rather than wildcard or weak matching', () => {
+  const catalog = [{id: 1, region: 'west'}];
+  const initial = callHandler({method: 'GET', url: '/catalog', headers: {}}, catalog);
+
+  for (const ifNoneMatch of ['*', `W/${initial.headers.ETag}`, `${initial.headers.ETag}, "other"`]) {
+    const response = callHandler({method: 'GET', url: '/catalog', headers: {'if-none-match': ifNoneMatch}}, catalog);
+    assert.equal(response.status, 200);
+    assert.notEqual(response.body, '');
+  }
+});
+
+test('client requests an encoded region and returns the response shape', async () => {
+  const items = [{id: 1}];
+  let request;
+  const result = await loadCatalog(async (...args) => {
+    request = args;
+    return {
+      status: 200,
+      headers: {etag: '"region-tag"'},
+      json: async () => items
+    };
+  }, {region: 'north/west & coast', etag: '"old-tag"'});
+
+  assert.deepEqual(request, [
+    '/catalog?region=north%2Fwest%20%26%20coast',
+    {headers: {'If-None-Match': '"old-tag"'}}
+  ]);
+  assert.deepEqual(result, {status: 'ok', items, etag: '"region-tag"'});
+});
+
+test('client omits conditional headers when no ETag is provided', async () => {
+  let request;
+  await loadCatalog(async (...args) => {
+    request = args;
+    return {status: 200, headers: {}, json: async () => []};
+  }, {region: 'west'});
+
+  assert.deepEqual(request, ['/catalog?region=west']);
+});
+
+test('client does not parse a 304 response body', async () => {
+  const result = await loadCatalog(async (url, options) => {
+    assert.equal(url, '/catalog?region=west');
+    assert.deepEqual(options, {headers: {'If-None-Match': '"region-tag"'}});
+    return {
+      status: 304,
+      headers: {get: name => name === 'etag' ? '"region-tag"' : null},
+      json: () => { throw new Error('json() must not be called'); }
+    };
+  }, {region: 'west', etag: '"region-tag"'});
+
+  assert.deepEqual(result, {status: 'not-modified', etag: '"region-tag"'});
+});
+
+test('legacy consumer returns items', async () => {
+  assert.deepEqual(await loadCatalog(async url => {
+    assert.equal(url, '/catalog');
+    return {status: 200, json: async () => [{id: 1}]};
+  }), [{id: 1}]);
+});
+
+test('non-200 and non-304 client responses throw', async () => {
+  await assert.rejects(
+    loadCatalog(async () => ({status: 500}), {}),
+    /Catalog unavailable/
+  );
+});
+
+test('existing method and path errors', () => {
+  for (const [method, url, code] of [['POST', '/catalog', 405], ['GET', '/other', 404]]) {
+    const response = callHandler({method, url, headers: {}}, []);
+    assert.equal(response.status, code);
+  }
+});
