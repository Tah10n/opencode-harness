index 499d9d0c3e95271fd74da5ab28c4b9ef568d141c..7332ea538130e5e48d0b6886abc64e0c9c51bc95 100644
--- a/README.md
+++ b/README.md
@@ -1,3 +1,11 @@
 # catalog-cache
 
 Run `npm test` with Node.js 24.
+
+`loadCatalog(fetcher, {region, etag})` returns `{status: 'ok', items, etag}`
+for a 200 response, or `{status: 'not-modified', etag}` for a 304 response.
+The one-argument `loadCatalog(fetcher)` form requests `/catalog` and returns the
+items array for compatibility with the legacy consumer. Region values are URL
+encoded. A cached response is used only when `If-None-Match` exactly equals the
+quoted ETag for the selected representation; wildcard and weak matching are not
+used.
diff --git a/src/client.mjs b/src/client.mjs
index 8d6764b162d0ddf5fb7731be35f3ec299c9e84ca..6700195e45bc23f9d592844c9318986c1405b1c0 100644
--- a/src/client.mjs
+++ b/src/client.mjs
@@ -1 +1,26 @@
-export async function loadCatalog(fetcher){const response=await fetcher('/catalog');if(response.status!==200)throw Error('Catalog unavailable');return response.json();}
+function responseEtag(response) {
+  if (response.headers?.get) return response.headers.get('etag');
+  return response.headers?.etag ?? response.headers?.ETag;
+}
+
+export async function loadCatalog(fetcher, {region, etag} = {}) {
+  const legacy = arguments.length === 1;
+  const url = region === undefined
+    ? '/catalog'
+    : `/catalog?region=${encodeURIComponent(region)}`;
+  const request = etag === undefined
+    ? undefined
+    : {headers: {'If-None-Match': etag}};
+  const response = request === undefined
+    ? await fetcher(url)
+    : await fetcher(url, request);
+  const returnedEtag = responseEtag(response) ?? etag;
+
+  if (response.status === 304) {
+    return {status: 'not-modified', etag: returnedEtag};
+  }
+  if (response.status !== 200) throw Error('Catalog unavailable');
+
+  const items = await response.json();
+  return legacy ? items : {status: 'ok', items, etag: returnedEtag};
+}
diff --git a/src/handler.mjs b/src/handler.mjs
index 264a567e44ef0a8f2e47f9a76a7b4af68d008e64..e9f12d0c26e94bb1a671bcf843e14d05ea192715 100644
--- a/src/handler.mjs
