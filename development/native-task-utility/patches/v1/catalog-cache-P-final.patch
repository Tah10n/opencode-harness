@@ -1 +1 @@
-export function selectCatalog(catalog){return catalog.map(x=>({...x}));}
+export function selectCatalog(catalog,region){return (region===undefined?catalog:catalog.filter(x=>x.region===region)).map(x=>({...x}));}
