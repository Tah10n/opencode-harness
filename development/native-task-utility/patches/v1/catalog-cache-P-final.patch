--- a/README.md
+++ b/README.md
@@ -1,3 +1,12 @@
 # catalog-cache
 
 Run `npm test` with Node.js 24.
+
+`loadCatalog(fetcher, {region, etag})` returns `{status: 'ok', items, etag}` for
+a 200 response or `{status: 'not-modified', etag}` for a 304 response. The
+one-argument legacy call, `loadCatalog(fetcher)`, fetches `/catalog` and returns
+the items array.
+
+The handler uses a quoted SHA-256 ETag for each exact JSON representation. A
+304 is returned only when `If-None-Match` exactly equals that tag; wildcard and
+weak tag matching are not supported.
diff --git a/src/client.mjs b/src/client.mjs
index 8d6764b..79269f3 100644
--- a/src/client.mjs
+++ b/src/client.mjs
@@ -1 +1,19 @@
-export async function loadCatalog(fetcher){const response=await fetcher('/catalog');if(response.status!==200)throw Error('Catalog unavailable');return response.json();}
+function getHeader(response,name){
+  if(response.headers?.get)return response.headers.get(name);
+  return response.headers?.[name]??response.headers?.[name.toLowerCase()];
+}
+
+export async function loadCatalog(fetcher,{region,etag}={}){
+  const legacy=arguments.length===1;
+  const url=region===undefined?'/catalog':`/catalog?region=${encodeURIComponent(region)}`;
+  const response=etag===undefined
+    ?await fetcher(url)
+    :await fetcher(url,{headers:{'If-None-Match':etag}});
+  if(legacy){
+    if(response.status!==200)throw Error('Catalog unavailable');
+    return response.json();
+  }
+  if(response.status===304)return {status:'not-modified',etag:getHeader(response,'etag')};
+  if(response.status!==200)throw Error('Catalog unavailable');
+  return {status:'ok',items:await response.json(),etag:getHeader(response,'etag')};
+}
