+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {createHash} from 'node:crypto';
+import {handle} from '../src/handler.mjs';
+import {loadCatalog} from '../src/client.mjs';
+
+function invoke(req,catalog){
+  let status;
+  let headers;
+  let body;
+  handle(req,{writeHead(code,values){status=code;headers=values;},end(value=''){body=value;}},catalog);
+  return {status,headers,body};
+}
+
+test('catalog responses filter by region without mutating the catalog',()=>{
+  const catalog=[{id:1,region:'eu'},{id:2,region:'us'},{id:3,region:'eu'}];
+  const original=structuredClone(catalog);
+  const response=invoke({method:'GET',url:'/catalog?region=eu',headers:{}},catalog);
+
+  assert.equal(response.status,200);
+  assert.deepEqual(JSON.parse(response.body),[catalog[0],catalog[2]]);
+  assert.deepEqual(catalog,original);
+  assert.equal(response.headers['Content-Type'],'application/json');
+  assert.equal(response.headers['Cache-Control'],'private, max-age=0');
+  assert.equal(response.headers.ETag,`"${createHash('sha256').update(response.body).digest('hex')}"`);
+  assert.notEqual(response.headers.ETag,invoke({method:'GET',url:'/catalog',headers:{}},catalog).headers.ETag);
+});
+
+test('matching ETag returns a 304 with no body',()=>{
+  const catalog=[{id:1,region:'eu'}];
+  const first=invoke({method:'GET',url:'/catalog?region=eu',headers:{}},catalog);
+  const response=invoke({method:'GET',url:'/catalog?region=eu',headers:{'if-none-match':first.headers.ETag}},catalog);
+
+  assert.equal(response.status,304);
+  assert.equal(response.headers.ETag,first.headers.ETag);
+  assert.equal(response.headers['Cache-Control'],'private, max-age=0');
+  assert.equal(response.body,'');
+});
+
+test('wildcard and weak ETags do not match',()=>{
+  const catalog=[{id:1}];
+  const first=invoke({method:'GET',url:'/catalog',headers:{}},catalog);
+
+  for(const etag of ['*',`W/${first.headers.ETag}`]){
+    const response=invoke({method:'GET',url:'/catalog',headers:{'if-none-match':etag}},catalog);
+    assert.equal(response.status,200);
+    assert.equal(response.body,JSON.stringify(catalog));
+  }
+});
+
+test('legacy consumer returns items',async()=>{
+  assert.deepEqual(await loadCatalog(async url=>{
+    assert.equal(url,'/catalog');
+    return {status:200,json:async()=>[{id:1}]};
+  }),[{id:1}]);
+});
+
+test('client encodes region and sends an optional ETag',async()=>{
+  let call;
+  const result=await loadCatalog(async(...args)=>{
+    call=args;
+    return {status:200,headers:new Headers({ETag:'"new"'}),json:async()=>[{id:1}]};
+  },{region:'eu/west coast',etag:'"old"'});
+
+  assert.equal(call[0],'/catalog?region=eu%2Fwest%20coast');
+  assert.deepEqual(call[1],{headers:{'If-None-Match':'"old"'}});
+  assert.deepEqual(result,{status:'ok',items:[{id:1}],etag:'"new"'});
+});
+
+test('client omits the conditional header without an ETag',async()=>{
+  let call;
+  await loadCatalog(async(...args)=>{
+    call=args;
+    return {status:200,headers:new Headers({ETag:'"new"'}),json:async()=>[]};
+  },{region:'eu'});
+
+  assert.deepEqual(call,['/catalog?region=eu']);
+});
+
+test('client handles 304 without reading its body',async()=>{
+  let jsonCalled=false;
+  const result=await loadCatalog(async()=>({
+    status:304,
+    headers:new Headers({ETag:'"same"'}),
+    json:async()=>{
+      jsonCalled=true;
+      throw Error('body must not be read');
+    },
+  }),{etag:'"same"'});
+
+  assert.deepEqual(result,{status:'not-modified',etag:'"same"'});
+  assert.equal(jsonCalled,false);
+});
+
+test('existing method and path errors',()=>{
+  for(const [method,url,code]of [['POST','/catalog',405],['GET','/other',404]]){
+    const response=invoke({method,url,headers:{}},[]);
+    assert.equal(response.status,code);
+  }
+});
