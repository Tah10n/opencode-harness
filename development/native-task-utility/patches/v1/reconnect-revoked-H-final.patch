+test("connect replaces revoked authorization for 401 and 403 without an abandoned pairing", async (context) => {
+  let revokeStatus = 401;
+  let revokedReconciliationRequests = 0;
+  let pairingStarts = 0;
+  const installationId = "81818181-8181-4181-8181-818181818181";
+  const clientSourceId = "82828282-8282-4282-8282-828282828282";
+  const sourceId = "83838383-8383-4383-8383-838383838383";
+  const replacementSourceId = "86868686-8686-4686-8686-868686868686";
+  const mapping = {
+    clientSourceId,
+    sourceId,
+    agentAccountId: "84848484-8484-4484-8484-848484848484",
+    agentId: "antigravity",
+    accountLabel: "Antigravity",
+    collectionMethod: "antigravity_cli_capture",
+    lastAcceptedSyncSequence: "0",
+  };
+  const pairingMapping = { ...mapping, sourceId: replacementSourceId };
+  const server = createServer((request, response) => {
+    const chunks = [];
+    request.on("data", (chunk) => chunks.push(chunk));
+    request.on("end", () => {
+      const body = chunks.length ? JSON.parse(Buffer.concat(chunks).toString("utf8")) : null;
+      response.setHeader("content-type", "application/json");
+      if (request.url === "/api/installations/current") {
+        if (revokeStatus === 401 || revokeStatus === 403) {
+          revokedReconciliationRequests += 1;
+          response.writeHead(revokeStatus, { "content-type": "application/json" });
+          response.end(JSON.stringify({ error: revokeStatus === 401 ? "unauthorized" : "forbidden" }));
+        } else {
+          response.writeHead(200);
+          response.end(JSON.stringify(reconciliationResponse([pairingMapping])));
+        }
+        return;
+      }
+      if (request.url === "/api/pairing/start") {
+        pairingStarts += 1;
+        revokeStatus = 200;
+        response.writeHead(201);
+        response.end(
+          JSON.stringify({
+            installationId,
+            code: "REVOKED2",
+            pollToken: `revoked_pairing_poll_token_${pairingStarts}_long_enough`,
+            verificationUrl: `http://${request.headers.host}/connect?code=REVOKED2`,
+            expiresInSeconds: 30,
+          }),
+        );
+        return;
+      }
+      if (request.url === "/api/pairing/poll") {
+        response.writeHead(200);
+        response.end(
+          JSON.stringify({
+            status: "active",
+            deviceToken: `replacement_device_token_${pairingStarts}_long_enough`,
+            protocol: { version: 2, snapshotDays: 31, maximumSources: 32, maximumEntries: 1_024 },
+            sources: [pairingMapping],
+          }),
+        );
+        return;
+      }
+      response.writeHead(200);
+      response.end(JSON.stringify(usageResponse(body)));
+    });
+  });
+  server.listen(0, "127.0.0.1");
+  await once(server, "listening");
+  context.after(() => server.close());
+  const address = server.address();
+  assert.notEqual(address, null);
+  assert.equal(typeof address, "object");
+  const origin = `http://127.0.0.1:${address.port}`;
+  const home = await mkdtemp(join(tmpdir(), "viberacing-revoked-connect-"));
+  context.after(() => rm(home, { recursive: true, force: true }));
+  const installation = await writeCaptureInstallation(home, origin, {
+    clientSourceId,
+    installationId,
+    sourceId,
+  });
+  const auxiliaryClientSourceId = "85858585-8585-4585-8585-858585858585";
+  const auxiliaryRoot = join(home, ".claude");
+  await mkdir(auxiliaryRoot, { recursive: true });
+  await writeFile(join(auxiliaryRoot, "settings.json"), "{invalid-json");
+  await writeLocalSources(installation.directory, [
+    ...(await readLocalSources(installation.directory)),
+    {
+      clientSourceId: auxiliaryClientSourceId,
+      agentId: "claude_code",
+      dataPath: join(auxiliaryRoot, "projects"),
+      collectionMethod: "claude_jsonl",
+      supportedSurface: "cli",
+      suggestedLabel: "Auxiliary",
+    },
+  ]);
+  await writeFile(
+    join(installation.directory, "installation.json"),
+    `${JSON.stringify({
+      version: 1,
+      id: installationId,
+      secret: "revoked_installation_secret_that_is_long_enough",
+    })}\n`,
+  );
+  await writeFile(
+    join(installation.directory, "dirty.json"),
+    `${JSON.stringify({ dirtySince: new Date().toISOString(), lastEventAt: new Date().toISOString() })}\n`,
+  );
+  const environment = connectorEnvironment(home, {
+    NODE_ENV: "test",
+    PATH: "",
+    VIBERACING_TEST_PAIRING_POLL_INTERVAL_MS: "10",
+  });
+
+  assert.deepEqual(
+    JSON.parse(await readFile(join(installation.directory, "config.json"), "utf8")).installationId,
+    installationId,
+  );
+  await assert.rejects(access(join(installation.directory, "connect-attempt.json")));
+  const firstConnect = await execFileAsync(
+    process.execPath,
+    [connectorPath, "connect", "--origin", origin],
+    { env: environment },
+  );
+  assert.match(firstConnect.stderr, /revoked installation authorization was removed.*auxiliary cleanup/i);
+  assert.equal(revokedReconciliationRequests, 1);
+  assert.equal(pairingStarts, 1);
+  assert.equal(
+    JSON.parse(await readFile(join(installation.directory, "config.json"), "utf8")).installationId,
+    installationId,
+  );
+  assert.equal(
+    JSON.parse(await readFile(join(installation.directory, "config.json"), "utf8")).deviceToken,
+    "replacement_device_token_1_long_enough",
+  );
+  assert.equal(
+    JSON.parse(await readFile(join(installation.directory, "config.json"), "utf8")).sources[0].sourceId,
+    replacementSourceId,
+  );
+  await assert.rejects(access(join(installation.directory, "dirty.json")));
+  assert.equal(JSON.parse(await readFile(join(installation.directory, "installation.json"), "utf8")).id, installationId);
+  assert.deepEqual(
+    (await readLocalSources(installation.directory)).map((source) => source.clientSourceId),
+    [clientSourceId, auxiliaryClientSourceId],
+  );
+
+  revokeStatus = 403;
+  await writeFile(
+    join(installation.directory, "dirty.json"),
+    `${JSON.stringify({ dirtySince: new Date().toISOString(), lastEventAt: new Date().toISOString() })}\n`,
+  );
+  const beforeSecondConnect = JSON.parse(await readFile(join(installation.directory, "config.json"), "utf8"));
+  assert.equal(beforeSecondConnect.deviceToken, "replacement_device_token_1_long_enough");
+  const secondConnect = await execFileAsync(
+    process.execPath,
+    [connectorPath, "connect", "--origin", origin],
+    { env: environment },
+  );
+  assert.match(secondConnect.stderr, /revoked installation authorization was removed.*auxiliary cleanup/i);
+  assert.equal(revokedReconciliationRequests, 2);
+  assert.equal(pairingStarts, 2);
+  assert.equal(
+    JSON.parse(await readFile(join(installation.directory, "config.json"), "utf8")).deviceToken,
+    "replacement_device_token_2_long_enough",
+  );
+  await assert.rejects(access(join(installation.directory, "dirty.json")));
+  assert.deepEqual(
+    (await readLocalSources(installation.directory)).map((source) => source.clientSourceId),
+    [clientSourceId, auxiliaryClientSourceId],
+  );
+});
