+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {createRequire} from 'node:module';
+import configure,{configure as named} from '../index.mjs';
+import {render} from '../consumer.mjs';
+
+const require=createRequire(import.meta.url);
+const cjsConfigure=require('../index.cjs');
+const cjsRender=require('../consumer.cjs').render;
+
+test('legacy CJS and ESM entry points',()=>{
+  assert.deepEqual(configure('pretty'),{mode:'pretty',indent:2});
+  assert.deepEqual(named('compact'),{mode:'compact',indent:0});
+  assert.deepEqual(cjsConfigure('pretty'),{mode:'pretty',indent:2});
+  assert.equal(render({x:1},'compact'),'\u007b"x":1}');
+  assert.equal(cjsRender({x:1},'compact'),'\u007b"x":1}');
+  assert.throws(()=>configure('wide'),RangeError);
+  assert.throws(()=>cjsConfigure('wide'),RangeError);
+});
+
+test('object options configure and render in both module formats',()=>{
+  const cjsOptions={mode:'pretty',indent:0};
+  const esmOptions={mode:'pretty',indent:4};
+
+  assert.deepEqual(cjsConfigure(cjsOptions),{mode:'pretty',indent:0});
+  assert.deepEqual(configure(esmOptions),{mode:'pretty',indent:4});
+  assert.deepEqual(cjsOptions,{mode:'pretty',indent:0});
+  assert.deepEqual(esmOptions,{mode:'pretty',indent:4});
+  assert.equal(cjsRender({x:1},cjsOptions),'\u007b"x":1}');
+  assert.equal(render({x:1},esmOptions),'\u007b\n    "x": 1\n}');
+});
+
+test('object options derive defaults and validate shape',()=>{
+  for (const entry of [cjsConfigure,configure]) {
+    assert.deepEqual(entry({mode:'compact'}),{mode:'compact',indent:0});
+    assert.deepEqual(entry({mode:'pretty'}),{mode:'pretty',indent:2});
+    assert.deepEqual(entry({mode:'compact',indent:0}),{mode:'compact',indent:0});
+    assert.deepEqual(entry({mode:'pretty',indent:8}),{mode:'pretty',indent:8});
+
+    for (const option of [null,[],{}, {indent:2}, {mode:1}]) {
+      assert.throws(()=>entry(option),TypeError);
+    }
+    for (const indent of ['2',NaN,1.5,-1,9]) {
+      assert.throws(()=>entry({mode:'pretty',indent}),TypeError);
+    }
+    assert.throws(()=>entry({mode:'wide'}),RangeError);
+  }
+});
