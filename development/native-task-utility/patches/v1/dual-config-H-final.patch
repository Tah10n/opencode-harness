 # dual-config
 
 Run `npm test` with Node.js 24.
+
+## Configuration
+
+CommonJS and ESM support the same configuration forms:
+
+```js
+configure('compact');
+configure('pretty');
+configure({mode: 'pretty', indent: 4});
+```
+
+The string forms use indentation `0` for `compact` and `2` for `pretty`.
+Option objects require `mode` to be `compact` or `pretty`. The optional
+`indent` must be an integer from `0` through `8`; omitting it uses the same
+legacy default as the matching string form. An explicit `0` is valid for
+either mode. Invalid mode strings throw `RangeError`; null, arrays, missing or
+non-string modes, and invalid indentation values throw `TypeError`.
diff --git a/index.cjs b/index.cjs
index a6f39822b17647f5aaebbee88d580387c91d32ab..29e11f509ff1fcc13621f6bb4b43a52824b3d940 100644
--- a/index.cjs
+++ b/index.cjs
@@ -1 +1,25 @@
-function configure(mode){if(!['compact','pretty'].includes(mode))throw new RangeError('Invalid mode');return {mode,indent:mode==='pretty'?2:0};}module.exports=configure;
+const defaults={compact:0,pretty:2};
+
+function configure(option){
+  let mode;
+  let indent;
+
+  if(typeof option==='string'){
+    mode=option;
+  }else{
+    if(option===null||typeof option!=='object'||Array.isArray(option)||!Object.prototype.hasOwnProperty.call(option,'mode')){
+      throw new TypeError('Options must include a mode');
+    }
+    if(typeof option.mode!=='string')throw new TypeError('Mode must be a string');
+    mode=option.mode;
+    if(Object.prototype.hasOwnProperty.call(option,'indent')){
+      indent=option.indent;
+      if(!Number.isInteger(indent)||indent<0||indent>8)throw new TypeError('Indent must be an integer from 0 through 8');
+    }
+  }
+
+  if(!Object.prototype.hasOwnProperty.call(defaults,mode))throw new RangeError('Invalid mode');
+  return {mode,indent:indent===undefined?defaults[mode]:indent};
+}
+
+module.exports=configure;
