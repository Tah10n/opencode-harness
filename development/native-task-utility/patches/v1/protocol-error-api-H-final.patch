+test("doctor reports a valid reconciliation error without changing connection state", async (context) => {
+  let requests = 0;
+  const server = createServer((request, response) => {
+    request.resume();
+    request.on("end", () => {
+      requests += 1;
+      response.writeHead(400, { "content-type": "application/json" });
+      response.end(JSON.stringify({ error: "reconciliation_failed" }));
+    });
+  });
+  server.listen(0, "127.0.0.1");
+  await once(server, "listening");
+  context.after(() => server.close());
+  const address = server.address();
+  assert.notEqual(address, null);
+  assert.equal(typeof address, "object");
+
+  const home = await mkdtemp(join(tmpdir(), "viberacing-doctor-error-"));
+  context.after(() => rm(home, { recursive: true, force: true }));
+  const installation = await writeCaptureInstallation(home, `http://127.0.0.1:${address.port}`);
+  const configBefore = await readFile(join(installation.directory, "config.json"));
+  const stateBefore = await readFile(join(installation.directory, "state.json"));
+  const environment = connectorEnvironment(home);
+  assert.equal(JSON.parse(configBefore).sources[0].sourceId, installation.sourceId);
+  assert.equal(JSON.parse(stateBefore).sequences[installation.sourceId], "0");
+
+  const result = await execFileAsync(process.execPath, [connectorPath, "doctor"], {
+    env: environment,
+  });
+  assert.equal(requests, 1);
+  assert.match(
+    result.stdout,
+    /Pairing status: error \(Vibe Racing returned 400: reconciliation_failed\)/,
+  );
+  assert.deepEqual(await readFile(join(installation.directory, "config.json")), configBefore);
+  assert.deepEqual(await readFile(join(installation.directory, "state.json")), stateBefore);
+});
