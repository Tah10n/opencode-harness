+test("connect reports a valid pairing error without changing local pairing state", async (context) => {
+  let pairingRequests = 0;
+  let pollRequests = 0;
+  const server = createServer((request, response) => {
+    request.resume();
+    request.on("end", () => {
+      if (request.url === "/api/pairing/start") {
+        pairingRequests += 1;
+        response.writeHead(400, { "content-type": "application/json" });
+        response.end(JSON.stringify({ error: "pairing_denied" }));
+        return;
+      }
+      if (request.url === "/api/pairing/poll") pollRequests += 1;
+      response.writeHead(404, { "content-type": "application/json" });
+      response.end(JSON.stringify({ error: "unexpected_request" }));
+    });
+  });
+  server.listen(0, "127.0.0.1");
+  await once(server, "listening");
+  context.after(() => server.close());
+  const address = server.address();
+  assert.notEqual(address, null);
+  assert.equal(typeof address, "object");
+
+  const home = await mkdtemp(join(tmpdir(), "viberacing-pairing-error-"));
+  context.after(() => rm(home, { recursive: true, force: true }));
+  const directory = join(home, ".viberacing");
+  const localSource = {
+    clientSourceId: "12121212-1212-4212-8212-121212121212",
+    agentId: "antigravity",
+    dataPath: join(home, "capture.jsonl"),
+    collectionMethod: "antigravity_cli_capture",
+    supportedSurface: "cli",
+    suggestedLabel: "Antigravity",
+  };
+  await writeLocalSources(directory, [localSource]);
+  const environment = connectorEnvironment(home, {
+    NODE_ENV: "test",
+    PATH: "",
+    VIBERACING_TEST_PAIRING_POLL_INTERVAL_MS: "10",
+  });
+  assert.deepEqual(await readLocalSources(directory), [localSource]);
+
+  const result = await execFileAsync(
+    process.execPath,
+    [connectorPath, "connect", "--origin", `http://127.0.0.1:${address.port}`],
+    { env: environment },
+  ).catch((error) => error);
+  assert.equal(result.code, 1);
+  assert.match(result.stderr, /Vibe Racing returned 400: pairing_denied/);
+  assert.equal(pairingRequests, 1);
+  assert.equal(pollRequests, 0);
+  assert.deepEqual(await readLocalSources(directory), [localSource]);
+  await assert.rejects(access(join(directory, "config.json")));
+  await assert.rejects(access(join(directory, "connect-attempt.json")));
+});
+
