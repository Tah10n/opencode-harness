+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {createRequire} from 'node:module';
+import configure, {configure as named} from '../index.mjs';
+import {render} from '../consumer.mjs';
+
+const require = createRequire(import.meta.url);
+const configureCjs = require('../index.cjs');
+const renderCjs = require('../consumer.cjs').render;
+
+test('legacy CJS and ESM entry points', () => {
+  assert.deepEqual(configure('compact'), {mode: 'compact', indent: 0});
+  assert.deepEqual(configure('pretty'), named('pretty'));
+  assert.deepEqual(configureCjs('pretty'), {mode: 'pretty', indent: 2});
+  assert.equal(render({x: 1}, 'compact'), '\u007b"x":1}');
+  assert.equal(renderCjs({x: 1}, 'compact'), '\u007b"x":1}');
+  assert.throws(() => configure('wide'), RangeError);
+});
+
+test('object options are supported by both consumers', () => {
+  const option = {mode: 'pretty', indent: 0};
+
+  assert.deepEqual(configure(option), option);
+  assert.deepEqual(configureCjs(option), option);
+  assert.equal(render({x: 1}, option), '\u007b"x":1}');
+  assert.equal(renderCjs({x: 1}, option), '\u007b"x":1}');
+  assert.deepEqual(option, {mode: 'pretty', indent: 0});
+  assert.equal(render({x: 1}, {mode: 'pretty', indent: 4}), '{\n    "x": 1\n}');
+  assert.equal(renderCjs({x: 1}, {mode: 'pretty'}), '{\n  "x": 1\n}');
+});
+
+test('invalid object options report the documented errors', () => {
+  for (const option of [
+    null,
+    [],
+    {},
+    {mode: 'pretty', indent: '2'},
+    {mode: 'pretty', indent: NaN},
+    {mode: 'pretty', indent: 1.5},
+    {mode: 'pretty', indent: -1},
+    {mode: 'pretty', indent: 9},
+  ]) {
+    assert.throws(() => configure(option), TypeError);
+    assert.throws(() => configureCjs(option), TypeError);
+    assert.throws(() => render({x: 1}, option), TypeError);
+    assert.throws(() => renderCjs({x: 1}, option), TypeError);
+  }
+
+  assert.throws(() => configure({mode: 'wide'}), RangeError);
+  assert.throws(() => configureCjs({mode: 'wide'}), RangeError);
+});
