@@ -1,3 +1,26 @@
 # dual-config
 
 Run `npm test` with Node.js 24.
+
+## Configuration
+
+The CommonJS and ESM entry points accept either a legacy mode string or an
+options object:
+
+```js
+configure('compact');
+configure('pretty');
+configure({mode: 'pretty', indent: 4});
+```
+
+CommonJS consumers use `require('./index.cjs')`; ESM consumers can use either
+the default or named `configure` export from `./index.mjs`.
+
+The result is `{mode, indent}`. Legacy `compact` and `pretty` use indents `0`
+and `2`. In an options object, `mode` is required and must be `compact` or
+`pretty`. `indent` is optional and must be an integer from `0` through `8`;
+when omitted, its mode-specific legacy default is used. An indent of `0` is
+valid for `pretty`.
+
+Invalid mode strings throw `RangeError`. Null, arrays, missing or non-string
+modes, and invalid indents throw `TypeError`. Options are not mutated.
diff --git a/index.cjs b/index.cjs
index a6f3982..43e8f17 100644
--- a/index.cjs
+++ b/index.cjs
@@ -1 +1,35 @@
-function configure(mode){if(!['compact','pretty'].includes(mode))throw new RangeError('Invalid mode');return {mode,indent:mode==='pretty'?2:0};}module.exports=configure;
+function configure(option) {
+  let mode;
+  let indent;
+  let hasIndent = false;
+
+  if (typeof option === 'string') {
+    mode = option;
+  } else {
+    if (option === null || typeof option !== 'object' || Array.isArray(option)) {
+      throw new TypeError('Options must be a mode string or object');
+    }
+    if (!Object.prototype.hasOwnProperty.call(option, 'mode')) {
+      throw new TypeError('Options must include mode');
+    }
+    mode = option.mode;
+    if (typeof mode !== 'string') {
+      throw new TypeError('Mode must be a string');
+    }
+    hasIndent = Object.prototype.hasOwnProperty.call(option, 'indent');
+  }
+
+  if (!['compact', 'pretty'].includes(mode)) {
+    throw new RangeError('Invalid mode');
+  }
+  if (hasIndent) {
+    indent = option.indent;
+    if (typeof indent !== 'number' || !Number.isInteger(indent) || indent < 0 || indent > 8) {
+      throw new TypeError('Indent must be an integer from 0 through 8');
+    }
+  }
+
+  return {mode, indent: hasIndent ? indent : mode === 'pretty' ? 2 : 0};
+}
+
+module.exports = configure;
