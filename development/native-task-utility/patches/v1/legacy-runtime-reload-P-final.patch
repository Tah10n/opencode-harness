+async function writeLegacyRuntime(state, { identity = true } = {}) {
+  await mkdir(join(state, "bin"), { recursive: true, mode: 0o777 });
+  await mkdir(join(state, "lib", "adapters"), { recursive: true, mode: 0o777 });
+  const files = [
+    "bin/viberacing.mjs",
+    ...legacyRuntimeFiles.map((name) => `lib/${name}`),
+    ...legacyRuntimeAdapterFiles.map((name) => `lib/adapters/${name}`),
+  ];
+  for (const name of files)
+    await writeFile(join(state, name), `legacy:${name}\n`, { mode: 0o755 });
