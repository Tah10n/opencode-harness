+
+async function snapshotTree(directory, prefix = "") {
+  const snapshot = [];
+  for (const name of await readdir(directory)) {
+    const path = join(directory, name);
+    const info = await lstat(path);
+    const relativePath = prefix ? `${prefix}/${name}` : name;
+    if (info.isSymbolicLink())
+      snapshot.push({ path: relativePath, type: "symlink", target: await readlink(path) });
+    else if (info.isDirectory()) {
+      snapshot.push({ path: relativePath, type: "directory" });
+      snapshot.push(...(await snapshotTree(path, relativePath)));
+    } else
+      snapshot.push({ path: relativePath, type: "file", contents: await readFile(path, "utf8") });
+  }
+  return snapshot;
+}
 
