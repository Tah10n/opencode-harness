+test("connect recovers revoked authorization for 401 and 403 without an abandoned pairing", async (context) => {
+  for (const status of [401, 403]) {
+    let pairingStarts = 0;
+    let pairingBody;
+    const installationId = status === 401
+      ? "81818181-8181-4181-8181-818181818181"
+      : "82828282-8282-4282-8282-828282828282";
+    const sourceId = status === 401
+      ? "83838383-8383-4383-8383-838383838383"
+      : "84848484-8484-4484-8484-848484848484";
+    const clientSourceId = status === 401
+      ? "85858585-8585-4585-8585-858585858585"
+      : "86868686-8686-4686-8686-868686868686";
+    const mapping = {
+      clientSourceId,
+      sourceId,
+      agentAccountId: status === 401
+        ? "87878787-8787-4787-8787-878787878787"
+        : "88888888-8888-4888-8888-888888888888",
+      agentId: "antigravity",
+      accountLabel: "Antigravity",
+      collectionMethod: "antigravity_cli_capture",
+      lastAcceptedSyncSequence: "0",
+    };
+    const server = createServer((request, response) => {
+      const chunks = [];
+      request.on("data", (chunk) => chunks.push(chunk));
+      request.on("end", () => {
+        const body = chunks.length ? JSON.parse(Buffer.concat(chunks).toString("utf8")) : null;
+        if (request.url === "/api/installations/current") {
+          response.writeHead(status, { "content-type": "application/json" });
+          response.end(JSON.stringify({ error: status === 401 ? "unauthorized" : "forbidden" }));
+          return;
+        }
+        if (request.url === "/api/pairing/start") {
+          pairingStarts += 1;
+          pairingBody = body;
+          response.writeHead(201, { "content-type": "application/json" });
+          response.end(
+            JSON.stringify({
+              installationId,
+              code: "REVOKED2",
+              pollToken: `revoked_${status}_poll_token_that_is_long_enough`,
+              verificationUrl: `http://${request.headers.host}/connect?code=REVOKED2`,
+              expiresInSeconds: 30,
+            }),
+          );
+          return;
+        }
+        if (request.url === "/api/pairing/poll") {
+          response.writeHead(200, { "content-type": "application/json" });
+          response.end(
+            JSON.stringify({
+              status: "active",
+              deviceToken: `replacement_${status}_device_token_that_is_long_enough`,
+              protocol: { version: 2, snapshotDays: 31, maximumSources: 32, maximumEntries: 1_024 },
+              sources: [mapping],
+            }),
+          );
+          return;
+        }
+        response.writeHead(200, { "content-type": "application/json" });
+        response.end(JSON.stringify(usageResponse(body)));
+      });
+    });
+    server.listen(0, "127.0.0.1");
+    await once(server, "listening");
+    context.after(() => server.close());
+    const address = server.address();
+    assert.notEqual(address, null);
+    assert.equal(typeof address, "object");
+    const origin = `http://127.0.0.1:${address.port}`;
+    const home = await mkdtemp(join(tmpdir(), `viberacing-revoked-connect-${status}-`));
+    context.after(() => rm(home, { recursive: true, force: true }));
+    const installation = await writeCaptureInstallation(home, origin, {
+      installationId,
+      clientSourceId,
+      sourceId,
+    });
+    await writeFile(
+      join(installation.directory, "installation.json"),
+      `${JSON.stringify({
+        version: 1,
+        id: installationId,
+        secret: `revoked_${status}_installation_secret_that_is_long_enough`,
+      })}\n`,
+    );
+    let incompleteCleanupSource;
+    if (status === 401) {
+      incompleteCleanupSource = {
+        clientSourceId: "89898989-8989-4989-8989-898989898989",
+        agentId: "claude_code",
+        dataPath: join(home, ".claude", "projects"),
+        hookConfigRoot: join(home, ".claude"),
+        collectionMethod: "claude_jsonl",
+        supportedSurface: "cli",
+        suggestedLabel: "Claude",
+      };
+      await mkdir(join(home, ".claude"), { recursive: true });
+      await writeFile(join(home, ".claude", "settings.json"), "{invalid-json");
+      await writeLocalSources(
+        installation.directory,
+        [
+          ...(await readLocalSources(installation.directory)),
+          incompleteCleanupSource,
+        ],
+      );
+    }
+    await mkdir(join(installation.directory, "pending"), { recursive: true });
+    await writeFile(
+      join(installation.directory, "pending", `${sourceId}.json`),
+      `${JSON.stringify({ snapshots: [{ sourceId, syncSequence: "1", entries: [] }] })}\n`,
+    );
+    await writeFile(
+      join(installation.directory, "dirty.json"),
+      `${JSON.stringify({ version: 2, sources: {} })}\n`,
+    );
+    const environment = connectorEnvironment(home, {
+      NODE_ENV: "test",
+      PATH: "",
+      VIBERACING_TEST_PAIRING_POLL_INTERVAL_MS: "10",
+    });
+
+    const result = await execFileAsync(
+      process.execPath,
+      [connectorPath, "connect", "--origin", origin],
+      { env: environment },
+    );
+    assert.match(result.stdout, /Connected/);
+    if (!incompleteCleanupSource) assert.equal(result.stderr, "");
+    assert.equal(pairingStarts, 1);
+    assert.equal(pairingBody.installationId, installationId);
+    if (incompleteCleanupSource) {
+      assert.match(result.stderr, /auxiliary cleanup steps/);
+      assert.equal(await readFile(join(home, ".claude", "settings.json"), "utf8"), "{invalid-json");
+    }
+    assert.deepEqual(
+      (await readLocalSources(installation.directory)).map((source) => source.clientSourceId),
+      [clientSourceId, ...(incompleteCleanupSource ? [incompleteCleanupSource.clientSourceId] : [])],
+    );
+    assert.equal(
+      JSON.parse(await readFile(join(installation.directory, "installation.json"), "utf8")).id,
+      installationId,
+    );
+    const connected = JSON.parse(await readFile(join(installation.directory, "config.json"), "utf8"));
+    assert.equal(connected.deviceToken, `replacement_${status}_device_token_that_is_long_enough`);
+    assert.deepEqual(connected.sources.map((source) => source.sourceId), [sourceId]);
+    await assert.rejects(access(join(installation.directory, "dirty.json")));
+    await assert.rejects(access(join(installation.directory, "pending", `${sourceId}.json`)));
+  }
+});
