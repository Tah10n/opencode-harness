diff --git a/README.md b/README.md
index 499d9d0..2ee6c5e 100644
--- a/README.md
+++ b/README.md
@@ -1,3 +1,19 @@
 # catalog-cache
 
 Run `npm test` with Node.js 24.
+
+## Client API
+
+`loadCatalog(fetcher)` is the legacy call. It fetches `/catalog` and resolves
+to the array of catalog items.
+
+`loadCatalog(fetcher, {region, etag})` fetches the optionally selected region
+and resolves to `{status: 'ok', items, etag}` for a 200 response, or
+`{status: 'not-modified', etag}` for a 304 response. The region is URL-encoded
+and `If-None-Match` is sent only when `etag` is provided. Other response
+statuses throw an error.
+
+The handler's ETags are quoted SHA-256 hashes of the exact JSON response
+bytes. A request is treated as not modified only when
+`req.headers['if-none-match']` exactly equals the representation's ETag; weak
+and wildcard matching are not used.
diff --git a/src/client.mjs b/src/client.mjs
index 8d6764b..9671b4f 100644
--- a/src/client.mjs
+++ b/src/client.mjs
@@ -1 +1,29 @@
-export async function loadCatalog(fetcher){const response=await fetcher('/catalog');if(response.status!==200)throw Error('Catalog unavailable');return response.json();}
+function getEtag(response) {
+  if (response.headers?.get) return response.headers.get('etag');
+  return response.headers?.etag ?? response.headers?.ETag;
+}
+
+export async function loadCatalog(fetcher, {region, etag} = {}) {
+  const legacy = arguments.length === 1;
+  const url = region === undefined
+    ? '/catalog'
+    : `/catalog?region=${encodeURIComponent(region)}`;
+  const response = etag === undefined
+    ? await fetcher(url)
+    : await fetcher(url, {headers: {'If-None-Match': etag}});
+
+  if (legacy) {
+    if (response.status !== 200) throw Error('Catalog unavailable');
+    return response.json();
+  }
+
+  if (response.status === 304) {
+    return {status: 'not-modified', etag: getEtag(response)};
+  }
+  if (response.status !== 200) throw Error('Catalog unavailable');
+  return {
+    status: 'ok',
+    items: await response.json(),
+    etag: getEtag(response),
+  };
+}
diff --git a/src/handler.mjs b/src/handler.mjs
index 264a567..43788fc 100644
--- a/src/handler.mjs
+++ b/src/handler.mjs
@@ -1,2 +1,42 @@
+import {createHash} from 'node:crypto';
 import {selectCatalog} from './select.mjs';
-export function handle(req,res,catalog){if(req.method!=='GET'){res.writeHead(405);res.end();return;}if(new URL(req.url,'http://localhost').pathname!=='/catalog'){res.writeHead(404);res.end();return;}res.writeHead(200,{'Content-Type':'application/json'});res.end(JSON.stringify(selectCatalog(catalog)));}
+
+export function handle(req, res, catalog) {
+  if (req.method !== 'GET') {
+    res.writeHead(405);
+    res.end();
+    return;
+  }
+
+  const url = new URL(req.url, 'http://localhost');
+  if (url.pathname !== '/catalog') {
+    res.writeHead(404);
+    res.end();
+    return;
+  }
+
+  const region = url.searchParams.has('region')
+    ? url.searchParams.get('region')
+    : undefined;
+  const selected = region === undefined
+    ? catalog
+    : catalog.filter(item => item.region === region);
+  const body = JSON.stringify(selectCatalog(selected));
+  const etag = `"${createHash('sha256').update(body).digest('hex')}"`;
+  const headers = {
+    'ETag': etag,
+    'Cache-Control': 'private, max-age=0',
+  };
+
+  if (req.headers?.['if-none-match'] === etag) {
+    res.writeHead(304, headers);
+    res.end('');
+    return;
+  }
+
+  res.writeHead(200, {
+    ...headers,
+    'Content-Type': 'application/json',
+  });
+  res.end(body);
+}
