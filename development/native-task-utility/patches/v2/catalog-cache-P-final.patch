+import {createHash} from 'node:crypto';
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {handle} from '../src/handler.mjs';
+import {loadCatalog} from '../src/client.mjs';
+
+function responseFor(status, headers, body) {
+  return {
+    status,
+    headers: {get: name => headers[name.toLowerCase()]},
+    json: async () => JSON.parse(body),
+  };
+}
+
+function runHandler(req, catalog) {
+  let status;
+  let headers;
+  let body;
+  handle(req, {
+    writeHead: (nextStatus, nextHeaders) => {
+      status = nextStatus;
+      headers = nextHeaders;
+    },
+    end: nextBody => {
+      body = nextBody ?? '';
+    },
+  }, catalog);
+  return {status, headers, body};
+}
+
+test('legacy consumer returns items', async () => {
+  assert.deepEqual(await loadCatalog(async url => {
+    assert.equal(url, '/catalog');
+    return {status: 200, json: async () => [{id: 1}]};
+  }), [{id: 1}]);
+});
+
+test('catalog handler filters by region without mutating or reordering', () => {
+  const catalog = [
+    {id: 1, region: 'west'},
+    {id: 2, region: 'east'},
+    {id: 3, region: 'west'},
+  ];
+  const before = structuredClone(catalog);
+  const result = runHandler({method: 'GET', url: '/catalog?region=west', headers: {}}, catalog);
+  const body = JSON.stringify([catalog[0], catalog[2]]);
+
+  assert.equal(result.status, 200);
+  assert.equal(result.body, body);
+  assert.equal(result.headers['Content-Type'], 'application/json');
+  assert.equal(result.headers['Cache-Control'], 'private, max-age=0');
+  assert.equal(result.headers.ETag, `"${createHash('sha256').update(body).digest('hex')}"`);
+  assert.deepEqual(catalog, before);
+});
+
+test('catalog handler selects all items when region is omitted', () => {
+  const catalog = [{id: 1, region: 'west'}, {id: 2, region: 'east'}];
+  const all = runHandler({method: 'GET', url: '/catalog', headers: {}}, catalog);
+  const west = runHandler({method: 'GET', url: '/catalog?region=west', headers: {}}, catalog);
+
+  assert.equal(all.status, 200);
+  assert.notEqual(all.headers.ETag, west.headers.ETag);
+  assert.deepEqual(JSON.parse(all.body), catalog);
+});
+
+test('catalog handler returns 304 for an exact ETag match', () => {
+  const catalog = [{id: 1, region: 'west'}];
+  const first = runHandler({method: 'GET', url: '/catalog?region=west', headers: {}}, catalog);
+  const cached = runHandler({
+    method: 'GET',
+    url: '/catalog?region=west',
+    headers: {'if-none-match': first.headers.ETag},
+  }, catalog);
+
+  assert.equal(cached.status, 304);
+  assert.equal(cached.headers.ETag, first.headers.ETag);
+  assert.equal(cached.headers['Cache-Control'], 'private, max-age=0');
+  assert.equal(cached.body, '');
+  assert.equal(runHandler({
+    method: 'GET',
+    url: '/catalog?region=west',
+    headers: {'if-none-match': `W/${first.headers.ETag}`},
+  }, catalog).status, 200);
+});
+
+test('client URL-encodes region and returns the 200 representation', async () => {
+  let request;
+  const result = await loadCatalog(async (...args) => {
+    request = args;
+    return responseFor(200, {etag: '"catalog-tag"'}, '[{"id":1}]');
+  }, {region: 'north/west & coast'});
+
+  assert.deepEqual(request, ['/catalog?region=north%2Fwest%20%26%20coast']);
+  assert.deepEqual(result, {status: 'ok', items: [{id: 1}], etag: '"catalog-tag"'});
+});
+
+test('client sends If-None-Match and does not parse a 304 body', async () => {
+  let request;
+  const result = await loadCatalog(async (...args) => {
+    request = args;
+    return {
+      status: 304,
+      headers: {get: () => '"catalog-tag"'},
+      json: () => { throw new Error('json() must not be called'); },
+    };
+  }, {region: 'west', etag: '"catalog-tag"'});
+
+  assert.deepEqual(request, [
+    '/catalog?region=west',
+    {headers: {'If-None-Match': '"catalog-tag"'}},
+  ]);
+  assert.deepEqual(result, {status: 'not-modified', etag: '"catalog-tag"'});
+});
+
+test('client rejects statuses other than 200 and 304', async () => {
+  await assert.rejects(
+    loadCatalog(async () => ({status: 500}), {}),
+    /Catalog unavailable/,
+  );
+});
+
+test('existing method and path errors', () => {
+  for (const [method, url, code] of [['POST', '/catalog', 405], ['GET', '/other', 404]]) {
+    let actual;
+    handle({method, url, headers: {}}, {writeHead: status => actual = status, end: () => {}}, []);
+    assert.equal(actual, code);
+  }
+});
