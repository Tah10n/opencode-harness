+async function writeLegacyRuntime(state, { identity = true, unknownPath } = {}) {
+  const contents = new Map();
+  for (const relativePath of legacyRuntimeFiles) {
+    const path = join(state, ...relativePath.split("/"));
+    const value =
+      relativePath === "bin/viberacing.mjs"
+        ? await readFile(connectorPath, "utf8")
+        : `legacy fixture: ${relativePath}\n`;
+    await mkdir(dirname(path), { recursive: true });
+    await writeFile(path, value);
+    contents.set(relativePath, value);
+  }
+  if (unknownPath) {
+    const path = join(state, ...unknownPath.split("/"));
+    await mkdir(dirname(path), { recursive: true });
+    await writeFile(path, "foreign fixture\n");
+    contents.set(unknownPath, "foreign fixture\n");
+  }
+  if (identity)
+    await writeFile(
+      join(state, "installation.json"),
+      `${JSON.stringify({
+        version: 1,
+        id: "12345678-1234-4123-8123-123456789abc",
+        secret: "legacy_installation_secret_that_is_long_enough",
+      })}\n`,
+    );
+  return contents;
+}
 
