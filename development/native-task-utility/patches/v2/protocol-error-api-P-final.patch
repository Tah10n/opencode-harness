+test("connect reports a validated pairing error without treating it as a protocol failure", async (context) => {
+  let pairingStarts = 0;
+  const server = createServer((request, response) => {
+    request.resume();
+    request.on("end", () => {
+      if (request.url !== "/api/pairing/start") {
+        response.writeHead(404, { "content-type": "application/json" });
+        response.end(JSON.stringify({ error: "not_found" }));
+        return;
+      }
+      pairingStarts += 1;
+      response.writeHead(400, { "content-type": "application/json" });
+      response.end(JSON.stringify({ error: "pairing_rejected" }));
+    });
+  });
+  server.listen(0, "127.0.0.1");
+  await once(server, "listening");
+  context.after(() => server.close());
+  const address = server.address();
+  assert.notEqual(address, null);
+  assert.equal(typeof address, "object");
+  const home = await mkdtemp(join(tmpdir(), "viberacing-pairing-error-"));
+  context.after(() => rm(home, { recursive: true, force: true }));
+  const directory = join(home, ".viberacing");
+  await mkdir(directory, { recursive: true });
+  await writeLocalSources(directory, [
+    {
+      clientSourceId: "12121212-1212-4212-8212-121212121212",
+      agentId: "antigravity",
+      dataPath: join(home, "capture.jsonl"),
+      collectionMethod: "antigravity_cli_capture",
+      supportedSurface: "cli",
+      suggestedLabel: "Antigravity",
+    },
+  ]);
+
+  await assert.rejects(
+    execFileAsync(
+      process.execPath,
+      [connectorPath, "connect", "--origin", `http://127.0.0.1:${address.port}`],
+      {
+        env: connectorEnvironment(home, {
+          NODE_ENV: "test",
+          PATH: "",
+        }),
+      },
+    ),
+    (error) => {
+      assert.match(error.stderr, /Vibe Racing returned 400: pairing_rejected/);
+      assert.doesNotMatch(error.stderr, /invalid protocol response/);
+      return true;
+    },
+  );
+  assert.equal(pairingStarts, 1);
+  await assert.rejects(access(join(directory, "config.json")));
+});
+
