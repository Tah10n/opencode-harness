@@ -1,3 +1,13 @@
 # catalog-cache
 
 Run `npm test` with Node.js 24.
+
+`loadCatalog(fetcher, {region, etag})` requests an optionally URL-encoded region.
+It returns `{status: 'ok', items, etag}` for a 200 response or
+`{status: 'not-modified', etag}` for a 304 response. The latter does not parse a
+response body. The server uses the quoted SHA-256 hash of the exact JSON body as
+its ETag and only treats an exactly matching `If-None-Match` value as a cache
+hit; wildcard and weak tags are not accepted.
+
+The legacy one-argument call, `loadCatalog(fetcher)`, still requests `/catalog`
+and returns the array of items directly.
diff --git a/src/client.mjs b/src/client.mjs
index 8d6764b162d0ddf5fb7731be35f3ec299c9e84ca..0acec69adfc9c945ee6ab7725e8961d6a86cc1f8 100644
--- a/src/client.mjs
+++ b/src/client.mjs
@@ -1 +1,22 @@
-export async function loadCatalog(fetcher){const response=await fetcher('/catalog');if(response.status!==200)throw Error('Catalog unavailable');return response.json();}
+function getHeader(response, name){
+  if(response.headers?.get) return response.headers.get(name) ?? undefined;
+  return response.headers?.[name] ?? response.headers?.[name.toLowerCase()];
+}
+
+export async function loadCatalog(fetcher, {region, etag} = {}){
+  const legacy = arguments.length === 1;
+  const url = region === undefined ? '/catalog' : `/catalog?region=${encodeURIComponent(region)}`;
+  const response = etag === undefined
+    ? await fetcher(url)
+    : await fetcher(url, {headers: {'If-None-Match': etag}});
+
+  if(response.status === 304){
+    if(legacy) throw Error('Catalog unavailable');
+    return {status: 'not-modified', etag: getHeader(response, 'etag') ?? etag};
+  }
+  if(response.status !== 200) throw Error('Catalog unavailable');
+
+  const items = await response.json();
+  if(legacy) return items;
+  return {status: 'ok', items, etag: getHeader(response, 'etag')};
+}
diff --git a/src/handler.mjs b/src/handler.mjs
index 264a567e44ef0a8f2e47f9a76a7b4af68d008e64..567aaaff983a5994fbca2096196725e21f1013f9 100644
--- a/src/handler.mjs
