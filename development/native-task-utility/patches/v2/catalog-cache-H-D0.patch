-import {test} from 'node:test';import assert from 'node:assert/strict';import {handle} from '../src/handler.mjs';import {loadCatalog} from '../src/client.mjs';
-test('legacy consumer returns items',async()=>{assert.deepEqual(await loadCatalog(async url=>{assert.equal(url,'/catalog');return {status:200,json:async()=>[{id:1}]};}),[{id:1}]);});
-test('existing method and path errors',()=>{for(const [method,url,code]of [['POST','/catalog',405],['GET','/other',404]]){let actual;handle({method,url,headers:{}},{writeHead:s=>actual=s,end:()=>{}},[]);assert.equal(actual,code);}});
+import {createHash} from 'node:crypto';
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {handle} from '../src/handler.mjs';
+import {loadCatalog} from '../src/client.mjs';
+
+function runHandler(req, catalog){
+  let response;
+  handle(req, {
+    writeHead(status, headers){response = {status, headers};},
+    end(body = ''){response.body = body;}
+  }, catalog);
+  return response;
+}
+
+test('legacy consumer returns items', async()=>{
+  assert.deepEqual(await loadCatalog(async url=>{
+    assert.equal(url, '/catalog');
+    return {status: 200, json: async()=>[{id: 1}]};
+  }), [{id: 1}]);
+});
+
+test('handler filters by region without mutating the catalog and returns an ETag', ()=>{
+  const catalog = [{id: 1, region: 'us'}, {id: 2, region: 'eu'}, {id: 3, region: 'us'}];
+  const original = structuredClone(catalog);
+  const response = runHandler({method: 'GET', url: '/catalog?region=us', headers: {}}, catalog);
+  const body = JSON.stringify([catalog[0], catalog[2]]);
+
+  assert.equal(response.status, 200);
+  assert.equal(response.body, body);
+  assert.equal(response.headers['Content-Type'], 'application/json');
+  assert.equal(response.headers['Cache-Control'], 'private, max-age=0');
+  assert.equal(response.headers.ETag, `"${createHash('sha256').update(body).digest('hex')}"`);
+  assert.deepEqual(catalog, original);
+});
+
+test('different catalog representations have different ETags and omitted region selects all', ()=>{
+  const catalog = [{id: 1, region: 'us'}, {id: 2, region: 'eu'}];
+  const all = runHandler({method: 'GET', url: '/catalog', headers: {}}, catalog);
+  const regional = runHandler({method: 'GET', url: '/catalog?region=us', headers: {}}, catalog);
+
+  assert.equal(all.body, JSON.stringify(catalog));
+  assert.notEqual(all.headers.ETag, regional.headers.ETag);
+});
+
+test('matching If-None-Match returns a 304 with no body', ()=>{
+  const catalog = [{id: 1, region: 'us'}];
+  const first = runHandler({method: 'GET', url: '/catalog?region=us', headers: {}}, catalog);
+  const cached = runHandler({method: 'GET', url: '/catalog?region=us', headers: {'if-none-match': first.headers.ETag}}, catalog);
+
+  assert.equal(cached.status, 304);
+  assert.equal(cached.body, '');
+  assert.equal(cached.headers.ETag, first.headers.ETag);
+  assert.equal(cached.headers['Cache-Control'], 'private, max-age=0');
+});
+
+test('If-None-Match uses exact matching only', ()=>{
+  const catalog = [{id: 1, region: 'us'}];
+  const first = runHandler({method: 'GET', url: '/catalog', headers: {}}, catalog);
+
+  for(const value of ['*', `W/${first.headers.ETag}`, `${first.headers.ETag} `]){
+    const response = runHandler({method: 'GET', url: '/catalog', headers: {'if-none-match': value}}, catalog);
+    assert.equal(response.status, 200);
+    assert.notEqual(response.body, '');
+  }
+});
+
+test('client requests an escaped region and returns the 200 result shape', async()=>{
+  const etag = '"regional"';
+  const result = await loadCatalog(async(url, options)=>{
+    assert.equal(url, '/catalog?region=north%2Feast%20%26%20west');
+    assert.deepEqual(options, {headers: {'If-None-Match': '"old"'}});
+    return {status: 200, headers: new Headers({ETag: etag}), json: async()=>[{id: 1}]};
+  }, {region: 'north/east & west', etag: '"old"'});
+
+  assert.deepEqual(result, {status: 'ok', items: [{id: 1}], etag});
+});
+
+test('client omits If-None-Match when no ETag is provided', async()=>{
+  const result = await loadCatalog(async(url, options)=>{
+    assert.equal(url, '/catalog?region=us');
+    assert.equal(options, undefined);
+    return {status: 200, headers: {'etag': '"fresh"'}, json: async()=>[]};
+  }, {region: 'us'});
+
+  assert.deepEqual(result, {status: 'ok', items: [], etag: '"fresh"'});
+});
+
+test('client handles 304 without parsing its body', async()=>{
+  let parsed = false;
+  const result = await loadCatalog(async(url, options)=>{
+    assert.equal(url, '/catalog?region=us');
+    assert.deepEqual(options, {headers: {'If-None-Match': '"same"'}});
+    return {
+      status: 304,
+      headers: {'etag': '"same"'},
+      json: async()=>{parsed = true; throw Error('304 body must not be parsed');}
+    };
+  }, {region: 'us', etag: '"same"'});
+
+  assert.deepEqual(result, {status: 'not-modified', etag: '"same"'});
+  assert.equal(parsed, false);
+});
+
+test('client rejects statuses other than 200 and 304', async()=>{
+  await assert.rejects(() => loadCatalog(async()=>({status: 500}), {}), /Catalog unavailable/);
+});
+
+test('existing method and path errors', ()=>{
+  for(const [method, url, code] of [['POST', '/catalog', 405], ['GET', '/other', 404]]){
+    let actual;
+    handle({method, url, headers: {}}, {writeHead: status=>actual = status, end: ()=>{}}, []);
+    assert.equal(actual, code);
+  }
+});
