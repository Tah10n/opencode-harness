+test("doctor cleans up a forbidden installation from a typed reconciliation error", async (context) => {
+  let requests = 0;
+  const server = createServer((_request, response) => {
+    requests += 1;
+    response.writeHead(403, { "content-type": "application/json" });
+    response.end(JSON.stringify({ error: "forbidden" }));
+  });
+  server.listen(0, "127.0.0.1");
+  await once(server, "listening");
+  context.after(() => server.close());
+  const address = server.address();
+  assert.notEqual(address, null);
+  assert.equal(typeof address, "object");
+  const origin = `http://127.0.0.1:${address.port}`;
+  const home = await mkdtemp(join(tmpdir(), "viberacing-doctor-forbidden-"));
+  context.after(() => rm(home, { recursive: true }));
+  const installation = await writeCaptureInstallation(home, origin);
+  const configBefore = JSON.parse(await readFile(join(installation.directory, "config.json"), "utf8"));
+  assert.equal(configBefore.origin, origin);
+  assert.notEqual((await readFile(installation.capture, "utf8")).trim(), "");
+  await writeFile(
+    join(installation.directory, "dirty.json"),
+    `${JSON.stringify({ dirtySince: new Date().toISOString(), lastEventAt: new Date().toISOString() })}\n`,
+  );
+
+  const result = await execFileAsync(process.execPath, [connectorPath, "doctor"], {
+    env: connectorEnvironment(home),
+  });
+  assert.equal(requests, 1);
+  assert.match(result.stdout, /authorization was revoked/i);
+  assert.match(result.stdout, /viberacing connect/i);
+  await assert.rejects(access(join(installation.directory, "config.json")));
+  await assert.rejects(access(join(installation.directory, "dirty.json")));
+});
+
+test("doctor denies reconciliation redirects instead of following them", async (context) => {
+  let requests = 0;
+  let redirectedRequests = 0;
+  const server = createServer((request, response) => {
+    if (request.url === "/redirected") redirectedRequests += 1;
+    requests += 1;
+    response.writeHead(302, { location: "/redirected" });
+    response.end();
+  });
+  server.listen(0, "127.0.0.1");
+  await once(server, "listening");
+  context.after(() => server.close());
+  const address = server.address();
+  assert.notEqual(address, null);
+  assert.equal(typeof address, "object");
+  const origin = `http://127.0.0.1:${address.port}`;
+  const home = await mkdtemp(join(tmpdir(), "viberacing-doctor-redirect-"));
+  context.after(() => rm(home, { recursive: true }));
+  const installation = await writeCaptureInstallation(home, origin);
+  assert.equal(
+    JSON.parse(await readFile(join(installation.directory, "config.json"), "utf8")).origin,
+    origin,
+  );
+  assert.notEqual((await readFile(installation.capture, "utf8")).trim(), "");
+
+  const result = await execFileAsync(process.execPath, [connectorPath, "doctor"], {
+    env: connectorEnvironment(home),
+  });
+  assert.equal(requests, 1);
+  assert.equal(redirectedRequests, 0);
+  assert.match(result.stdout, /Pairing status: error/);
+});
+
+test("doctor aborts an unresponsive reconciliation request", async (context) => {
+  let requests = 0;
