 # dual-config
 
 Run `npm test` with Node.js 24.
+
+## Configuration
+
+Both package entry points accept a legacy mode string or an options object:
+
+```js
+configure('compact')
+configure({mode: 'pretty', indent: 4})
+```
+
+The supported modes are `compact` and `pretty`. Their default indents are `0`
+and `2`, respectively. An object must include `mode`; its optional `indent`
+must be an integer from `0` through `8`, inclusive. This includes
+`{mode: 'pretty', indent: 0}`.
+
+Invalid mode strings throw `RangeError`. Null, arrays, missing or non-string
+modes, and invalid indents throw `TypeError`. Configuration objects are not
+mutated. The `render(value, option)` functions in both consumer entry points
+accept the same options and pass the normalized indent to `JSON.stringify`.
diff --git a/index.cjs b/index.cjs
index a6f39822b17647f5aaebbee88d580387c91d32ab..dda4cfa0cf56430b4c4d4aac2134d34eb57cd7a5 100644
--- a/index.cjs
+++ b/index.cjs
@@ -1 +1,39 @@
-function configure(mode){if(!['compact','pretty'].includes(mode))throw new RangeError('Invalid mode');return {mode,indent:mode==='pretty'?2:0};}module.exports=configure;
+const hasOwn = Object.prototype.hasOwnProperty;
+
+function configure(option) {
+  let mode;
+  let indent;
+  let hasIndent = false;
+
+  if (typeof option === 'string') {
+    mode = option;
+  } else {
+    if (option === null || typeof option !== 'object' || Array.isArray(option)) {
+      throw new TypeError('Options must be a mode string or an object');
+    }
+
+    if (!hasOwn.call(option, 'mode') || typeof option.mode !== 'string') {
+      throw new TypeError('Options must include a mode string');
+    }
+
+    mode = option.mode;
+    if (hasOwn.call(option, 'indent')) {
+      hasIndent = true;
+      indent = option.indent;
+    }
+  }
+
+  if (mode !== 'compact' && mode !== 'pretty') {
+    throw new RangeError('Invalid mode');
+  }
+
+  if (!hasIndent) {
+    indent = mode === 'pretty' ? 2 : 0;
+  } else if (!Number.isInteger(indent) || indent < 0 || indent > 8) {
+    throw new TypeError('Indent must be an integer from 0 through 8');
+  }
+
+  return {mode, indent};
+}
+
+module.exports = configure;
