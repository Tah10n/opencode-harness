-test('legacy CJS and ESM entry points',()=>{assert.deepEqual(configure('pretty'),named('pretty'));assert.deepEqual(require('../index.cjs')('pretty'),{mode:'pretty',indent:2});assert.equal(render({x:1},'compact'),'\u007b"x":1}');assert.throws(()=>configure('wide'),RangeError);});
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {createRequire} from 'node:module';
+import configure, {configure as named} from '../index.mjs';
+import {render as renderEsm} from '../consumer.mjs';
+
+const require = createRequire(import.meta.url);
+const configureCjs = require('../index.cjs');
+const renderCjs = require('../consumer.cjs').render;
+
+test('legacy CJS and ESM entry points', () => {
+  assert.deepEqual(configure('pretty'), named('pretty'));
+  assert.deepEqual(configureCjs('compact'), {mode: 'compact', indent: 0});
+  assert.deepEqual(configureCjs('pretty'), {mode: 'pretty', indent: 2});
+  assert.deepEqual(configure('compact'), {mode: 'compact', indent: 0});
+  assert.deepEqual(configure('pretty'), {mode: 'pretty', indent: 2});
+  assert.equal(renderEsm({x: 1}, 'compact'), '\u007b"x":1}');
+  assert.throws(() => configure('wide'), RangeError);
+});
+
+test('CJS consumer renders legacy strings and object options', () => {
+  assert.equal(renderCjs({x: 1}, 'compact'), '\u007b"x":1}');
+  assert.equal(renderCjs({x: 1}, 'pretty'), '{\n  "x": 1\n}');
+  assert.equal(renderCjs({x: 1}, {mode: 'pretty', indent: 0}), '\u007b"x":1}');
+  assert.equal(renderCjs({x: 1}, {mode: 'pretty', indent: 4}), '{\n    "x": 1\n}');
+});
+
+test('ESM consumer renders legacy strings and object options', () => {
+  assert.equal(renderEsm({x: 1}, 'compact'), '\u007b"x":1}');
+  assert.equal(renderEsm({x: 1}, 'pretty'), '{\n  "x": 1\n}');
+  assert.equal(renderEsm({x: 1}, {mode: 'pretty', indent: 0}), '\u007b"x":1}');
+  assert.equal(renderEsm({x: 1}, {mode: 'pretty', indent: 4}), '{\n    "x": 1\n}');
+});
+
+test('option objects are validated without mutation', () => {
+  const option = {mode: 'pretty', indent: 6};
+  const original = {...option};
+
+  assert.deepEqual(configureCjs(option), original);
+  assert.deepEqual(option, original);
+  assert.deepEqual(named(option), original);
+  assert.deepEqual(option, original);
+  assert.deepEqual(configure({mode: 'compact'}), {mode: 'compact', indent: 0});
+  assert.deepEqual(configure({mode: 'pretty'}), {mode: 'pretty', indent: 2});
+});
+
+test('consumers reject invalid indent and missing mode', () => {
+  for (const option of [
+    {mode: 'pretty', indent: '2'},
+    {mode: 'pretty', indent: Number.NaN},
+    {mode: 'pretty', indent: undefined},
+    {mode: 'pretty', indent: 1.5},
+    {mode: 'pretty', indent: -1},
+    {mode: 'pretty', indent: 9},
+  ]) {
+    assert.throws(() => renderCjs({x: 1}, option), TypeError);
+    assert.throws(() => renderEsm({x: 1}, option), TypeError);
+  }
+
+  assert.throws(() => renderCjs({x: 1}, {}), TypeError);
+  assert.throws(() => renderEsm({x: 1}, {}), TypeError);
+  assert.throws(() => renderCjs({x: 1}, null), TypeError);
+  assert.throws(() => renderEsm({x: 1}, []), TypeError);
+  assert.throws(() => configureCjs({mode: 'wide'}), RangeError);
+  assert.throws(() => configure({mode: 'wide'}), RangeError);
+});
