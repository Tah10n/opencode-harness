diff --git a/packages/connector/lib/http.mjs b/packages/connector/lib/http.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..daf3171be6473d1e7b1ae5b789f91454a96748f3
--- /dev/null
+++ b/packages/connector/lib/http.mjs
@@ -0,0 +1,70 @@
+import { setTimeout as delay } from "node:timers/promises";
+import { parseProtocolResponse } from "./protocol.mjs";
+
+export function retryAfterMilliseconds(response) {
+  const value = response.headers.get("retry-after")?.trim();
+  if (!value) return null;
+  let milliseconds;
+  if (/^\d+$/.test(value)) milliseconds = Number(value) * 1_000;
+  else {
+    const date = Date.parse(value);
+    if (Number.isNaN(date)) return null;
+    milliseconds = Math.max(0, date - Date.now());
+  }
+  const maximum =
+    process.env.NODE_ENV === "test" &&
+    /^\d+$/.test(process.env.VIBERACING_TEST_MAX_RETRY_AFTER_MS ?? "")
+      ? Number(process.env.VIBERACING_TEST_MAX_RETRY_AFTER_MS)
+      : 300_000;
+  return Math.min(maximum, milliseconds);
+}
+
+export async function request(origin, path, options = {}, attempts = 1, responseContext) {
+  let lastError;
+  for (let attempt = 0; attempt < attempts; attempt += 1) {
+    try {
+      const response = await fetch(`${origin}${path}`, {
+        ...options,
+        signal: AbortSignal.timeout(15_000),
+        redirect: "error",
+      });
+      let payload;
+      try {
+        payload = await parseProtocolResponse(response, responseContext);
+      } catch (error) {
+        if (
+          error?.code === "invalid_server_response" &&
+          (response.status >= 500 || response.status === 429)
+        ) {
+          error.status = response.status;
+          error.retryAfterMs = retryAfterMilliseconds(response);
+        }
+        throw error;
+      }
+      if (!response.ok) {
+        const error = new Error(
+          `Vibe Racing returned ${response.status}: ${payload.error ?? "request failed"}`,
+        );
+        error.status = response.status;
+        error.code = payload.error;
+        error.retryAfterMs = retryAfterMilliseconds(response);
+        if (response.status < 500 && response.status !== 429) throw error;
+        lastError = error;
+      } else return payload;
+    } catch (error) {
+      lastError = error;
+      if (
+        error?.code === "invalid_server_response" &&
+        !(error?.status >= 500 || error?.status === 429)
+      )
+        throw error;
+      if (error?.status && error.status < 500 && error.status !== 429) throw error;
+    }
+    if (attempt + 1 < attempts) {
+      const retryAfter = Number.isFinite(lastError?.retryAfterMs) ? lastError.retryAfterMs : 0;
+      const backoff = Math.min(8_000, 500 * 2 ** attempt) + Math.floor(Math.random() * 250);
+      await delay(Math.max(retryAfter, backoff));
+    }
+  }
+  throw lastError;
+}
diff --git a/packages/connector/test/http.test.mjs b/packages/connector/test/http.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..cfd7cd58cc433c3c419a4039f111c43530bbcc0c
--- /dev/null
+++ b/packages/connector/test/http.test.mjs
@@ -0,0 +1,135 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { once } from "node:events";
+import { createServer } from "node:http";
+import { retryAfterMilliseconds, request } from "../lib/http.mjs";
+
+async function startServer(handler) {
+  const server = createServer(handler);
+  server.listen(0, "127.0.0.1");
+  await once(server, "listening");
+  const address = server.address();
+  assert.equal(typeof address, "object");
+  return { server, origin: `http://127.0.0.1:${address.port}` };
+}
+
+function readRequestBody(request) {
+  const chunks = [];
+  return new Promise((resolve) => {
+    request.on("data", (chunk) => chunks.push(chunk));
+    request.on("end", () => resolve(Buffer.concat(chunks).toString("utf8")));
+  });
+}
+
+test("sends the caller's method, headers, and body and returns the protocol result", async (context) => {
+  let received;
+  const { server, origin } = await startServer(async (incoming, response) => {
+    received = {
+      method: incoming.method,
+      headers: incoming.headers,
+      body: await readRequestBody(incoming),
+    };
+    response.writeHead(204);
+    response.end();
+  });
+  context.after(() => server.close());
+
+  const result = await request(
+    origin,
+    "/api/pairing/cancel",
+    {
+      method: "POST",
+      headers: { Authorization: "Bearer device-token", "Content-Type": "application/json" },
+      body: JSON.stringify({ installationId: "installation-id", pollToken: "poll-token" }),
+    },
+    1,
+    { kind: "empty" },
+  );
+
+  assert.equal(result, null);
+  assert.deepEqual(received, {
+    method: "POST",
+    headers: received.headers,
+    body: JSON.stringify({ installationId: "installation-id", pollToken: "poll-token" }),
+  });
+  assert.equal(received.headers.authorization, "Bearer device-token");
+  assert.equal(received.headers["content-type"], "application/json");
+});
+
+test("preserves permanent status, code, and message errors without retrying", async (context) => {
+  let requests = 0;
+  const { server, origin } = await startServer((_incoming, response) => {
+    requests += 1;
+    response.writeHead(400, { "content-type": "application/json" });
+    response.end(JSON.stringify({ error: "invalid_request" }));
+  });
+  context.after(() => server.close());
+
+  await assert.rejects(
+    request(origin, "/api/usage", { method: "POST" }, 3, { kind: "usage", sourceIds: [] }),
+    (error) => {
+      assert.equal(error.message, "Vibe Racing returned 400: invalid_request");
+      assert.equal(error.status, 400);
+      assert.equal(error.code, "invalid_request");
+      return true;
+    },
+  );
+  assert.equal(requests, 1);
+});
+
+test("retries transient protocol failures and accepts the later response", async (context) => {
+  let requests = 0;
+  const requestTimes = [];
+  const { server, origin } = await startServer((_incoming, response) => {
+    requests += 1;
+    requestTimes.push(Date.now());
+    if (requests < 3) {
+      response.writeHead(503, { "content-type": "text/html" });
+      response.end("temporary proxy failure");
+      return;
+    }
+    response.writeHead(204);
+    response.end();
+  });
+  context.after(() => server.close());
+
+  assert.equal(await request(origin, "/api/pairing/cancel", {}, 3, { kind: "empty" }), null);
+  assert.equal(requests, 3);
+  assert.ok(requestTimes[1] - requestTimes[0] >= 450);
+  assert.ok(requestTimes[2] - requestTimes[1] >= 900);
+});
+
+test("bounds numeric and date Retry-After values without changing invalid values", () => {
+  assert.equal(
+    retryAfterMilliseconds(new Response(null, { headers: { "retry-after": "999999" } })),
+    300_000,
+  );
+  assert.equal(
+    retryAfterMilliseconds(
+      new Response(null, { headers: { "retry-after": "Wed, 21 Oct 2015 07:28:00 GMT" } }),
+    ),
+    0,
+  );
+  assert.equal(
+    retryAfterMilliseconds(new Response(null, { headers: { "retry-after": "not-a-delay" } })),
+    null,
+  );
+});
+
+test("refuses redirects instead of following them", async (context) => {
+  let redirectedRequests = 0;
+  const { server, origin } = await startServer((incoming, response) => {
+    if (incoming.url === "/redirect") {
+      response.writeHead(302, { location: "/target" });
+      response.end();
+      return;
+    }
+    redirectedRequests += 1;
+    response.writeHead(204);
+    response.end();
+  });
+  context.after(() => server.close());
+
+  await assert.rejects(request(origin, "/redirect", {}, 1, { kind: "empty" }));
+  assert.equal(redirectedRequests, 0);
+});
