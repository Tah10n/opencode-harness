+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {createRequire} from 'node:module';
+import configure, {configure as named} from '../index.mjs';
+import {render as renderEsm} from '../consumer.mjs';
+
+const require = createRequire(import.meta.url);
+const configureCjs = require('../index.cjs');
+const {render: renderCjs} = require('../consumer.cjs');
+
+test('legacy CJS and ESM entry points', () => {
+  assert.deepEqual(configure('compact'), {mode: 'compact', indent: 0});
+  assert.deepEqual(configure('pretty'), named('pretty'));
+  assert.deepEqual(configureCjs('pretty'), {mode: 'pretty', indent: 2});
+  assert.equal(renderEsm({x: 1}, 'compact'), '\u007b"x":1}');
+  assert.equal(renderCjs({x: 1}, 'compact'), '\u007b"x":1}');
+  assert.throws(() => configure('wide'), RangeError);
+});
+
+test('CJS and ESM consumers render object options', () => {
+  const options = {mode: 'pretty', indent: 4};
+  assert.equal(renderEsm({x: 1}, options), '{\n    "x": 1\n}');
+  assert.equal(renderCjs({x: 1}, options), '{\n    "x": 1\n}');
+  assert.equal(renderEsm({x: 1}, {mode: 'pretty', indent: 0}), '{"x":1}');
+  assert.equal(renderCjs({x: 1}, {mode: 'pretty', indent: 0}), '{"x":1}');
+  assert.deepEqual(options, {mode: 'pretty', indent: 4});
+});
+
+test('invalid object options use the documented errors', () => {
+  for (const render of [renderEsm, renderCjs]) {
+    assert.throws(() => render({}, {mode: 'compact', indent: 1.5}), TypeError);
+    assert.throws(() => render({}, {mode: 'compact', indent: 9}), TypeError);
+    assert.throws(() => render({}, {mode: 'compact', indent: NaN}), TypeError);
+    assert.throws(() => render({}, {}), TypeError);
+    assert.throws(() => render({}, null), TypeError);
+  }
+
+  assert.throws(() => configure({mode: 'wide'}), RangeError);
+  assert.throws(() => configure({mode: 'compact', indent: '2'}), TypeError);
+  assert.throws(() => configure({mode: 'compact', indent: undefined}), TypeError);
+  assert.throws(() => configure([]), TypeError);
+});
