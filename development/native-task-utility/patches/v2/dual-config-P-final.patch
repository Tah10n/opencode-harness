@@ -1,3 +1,21 @@
 # dual-config
 
 Run `npm test` with Node.js 24.
+
+## Configuration
+
+Both CommonJS and ESM entry points accept a legacy mode string or an options
+object:
+
+```js
+configure('compact');
+configure({mode: 'pretty', indent: 4});
+```
+
+The modes are `compact` and `pretty`. String modes use indentation `0` and
+`2`, respectively. An object requires `mode`; its optional `indent` must be
+an integer from `0` through `8`, inclusive. If `indent` is omitted, the
+mode's legacy default is used, and `indent: 0` is valid for `pretty`.
+
+Null, arrays, missing or non-string modes, and invalid indentation values
+throw `TypeError`. An invalid supplied mode string throws `RangeError`.
diff --git a/index.cjs b/index.cjs
index a6f3982..5f0a184 100644
--- a/index.cjs
+++ b/index.cjs
@@ -1 +1,32 @@
-function configure(mode){if(!['compact','pretty'].includes(mode))throw new RangeError('Invalid mode');return {mode,indent:mode==='pretty'?2:0};}module.exports=configure;
+function configure(option) {
+  let mode;
+  let indent;
+
+  if (typeof option === 'string') {
+    mode = option;
+  } else {
+    if (option === null || typeof option !== 'object' || Array.isArray(option) || !Object.prototype.hasOwnProperty.call(option, 'mode')) {
+      throw new TypeError('Options must include a mode');
+    }
+
+    mode = option.mode;
+    if (typeof mode !== 'string') {
+      throw new TypeError('Mode must be a string');
+    }
+  }
+
+  if (!['compact', 'pretty'].includes(mode)) {
+    throw new RangeError('Invalid mode');
+  }
+
+  if (typeof option === 'object' && Object.prototype.hasOwnProperty.call(option, 'indent')) {
+    indent = option.indent;
+    if (!Number.isInteger(indent) || indent < 0 || indent > 8) {
+      throw new TypeError('Indent must be an integer from 0 through 8');
+    }
+  }
+
+  return {mode, indent: indent === undefined ? mode === 'pretty' ? 2 : 0 : indent};
+}
+
+module.exports = configure;
