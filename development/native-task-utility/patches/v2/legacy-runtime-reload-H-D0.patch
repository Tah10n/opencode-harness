+test(
+  "migrates a legacy flat runtime without replacing it or its connection identity",
+  async (context) => {
+  const home = await mkdtemp(join(tmpdir(), "viberacing-legacy-runtime-migration-"));
+  context.after(() => rm(home, { recursive: true, force: true }));
+  const directory = join(home, ".viberacing");
+  const clientSourceId = "93939393-9393-4939-8939-939393939393";
+  const sourceId = "94949494-9494-4949-8949-949494949494";
+  const legacyFiles = [
+    join(directory, "bin", "viberacing.mjs"),
+    ...[
+      "browser.mjs",
+      "config.mjs",
+      "executables.mjs",
+      "readers.mjs",
+      "registry.mjs",
+      "runtime.mjs",
+    ].map((name) => join(directory, "lib", name)),
+    ...[
+      "antigravity.mjs",
+      "claude.mjs",
+      "codex.mjs",
+      "cursor.mjs",
+      "gemini.mjs",
+      "kimi.mjs",
+      "opencode.mjs",
+      "qwen-settings.mjs",
+      "qwen.mjs",
+      "shared.mjs",
+    ].map((name) => join(directory, "lib", "adapters", name)),
+  ];
+  await mkdir(join(directory, "bin"), { recursive: true });
+  await mkdir(join(directory, "lib", "adapters"), { recursive: true });
+  for (const path of legacyFiles) await writeFile(path, `legacy:${path}\n`);
+  await writeFile(
+    join(directory, "installation.json"),
+    `${JSON.stringify({
+      version: 1,
+      id: "95959595-9595-4959-8959-959595959595",
+      secret: "legacy_flat_installation_secret_that_is_long_enough",
+    })}\n`,
+  );
+  const localSource = {
+    clientSourceId,
+    agentId: "antigravity",
+    collectionMethod: "antigravity_cli_capture",
+    dataPath: join(directory, "captures", `${clientSourceId}.jsonl`),
+    suggestedLabel: "Antigravity",
+    supportedSurface: "cli",
+  };
+  await writeFile(
+    join(directory, "sources.json"),
+    `${JSON.stringify({ version: 1, sources: [localSource] })}\n`,
+  );
+  await writeFile(
+    join(directory, "config.json"),
+    `${JSON.stringify({
+      version: 2,
+      origin: "https://viberacing.example",
+      installationId: "95959595-9595-4959-8959-959595959595",
+      deviceToken: "legacy_device_token_that_is_long_enough",
+      sources: [
+        {
+          ...localSource,
+          sourceId,
+          agentAccountId: "96969696-9696-4969-8969-969696969696",
+          accountLabel: "Antigravity",
+        },
+      ],
+    })}\n`,
+  );
+  const before = new Map(
+    await Promise.all(
+      [
+        ...legacyFiles,
+        join(directory, "installation.json"),
+        join(directory, "sources.json"),
+        join(directory, "config.json"),
+      ].map(async (path) => [path, await readFile(path)]),
+    ),
+  );
+  const configUrl = new URL("../lib/config.mjs", import.meta.url).href;
+  const runtimeUrl = new URL("../lib/runtime.mjs", import.meta.url).href;
+  const currentBinUrl = new URL("../bin/viberacing.mjs", import.meta.url).href;
+  const environment = connectorEnvironment(home);
+  delete environment.VIBERACING_STATE_DIR;
+  const migrationScript = `
+    const config = await import(${JSON.stringify(configUrl)});
+    const runtime = await import(${JSON.stringify(runtimeUrl)});
+    const firstConfig = await config.readConfig();
+    await runtime.readState();
+    const first = await config.prepareRuntime(${JSON.stringify(currentBinUrl)});
+    const second = await config.prepareRuntime(${JSON.stringify(currentBinUrl)});
+    process.stdout.write(JSON.stringify({ firstConfig, first, second }));
+  `;
+  const migrated = JSON.parse(
+    (
+      await execFileAsync(process.execPath, ["--input-type=module", "--eval", migrationScript], {
+        env: { ...environment, HOME: home, USERPROFILE: home },
+      })
+    ).stdout,
+  );
+  assert.equal(migrated.firstConfig.installationId, "95959595-9595-4959-8959-959595959595");
+  assert.equal(migrated.firstConfig.sources[0].sourceId, sourceId);
+  assert.equal(migrated.first, migrated.second);
+  for (const [path, contents] of before) assert.deepEqual(await readFile(path), contents, path);
+  await access(migrated.first);
+  assert.equal(
+    (
+      await execFileAsync(process.execPath, [migrated.first, "--version"], {
+        env: { ...environment, HOME: home, USERPROFILE: home },
+      })
+    ).stdout,
+    `${connectorVersion}\n`,
+  );
+
+  const reloadScript = `
+    const config = await import(${JSON.stringify(configUrl)});
+    const runtime = await import(${JSON.stringify(runtimeUrl)});
+    const current = await config.readConfig();
+    await runtime.readState();
+    const prepared = await config.prepareRuntime(${JSON.stringify(currentBinUrl)});
+    process.stdout.write(JSON.stringify({ installationId: current.installationId, prepared }));
+  `;
+  const reloaded = JSON.parse(
+    (
+      await execFileAsync(process.execPath, ["--input-type=module", "--eval", reloadScript], {
+        env: { ...environment, HOME: home, USERPROFILE: home },
+      })
+    ).stdout,
+  );
+  assert.deepEqual(reloaded, {
+    installationId: "95959595-9595-4959-8959-959595959595",
+    prepared: migrated.first,
+  });
+  for (const [path, contents] of before) assert.deepEqual(await readFile(path), contents, path);
+  },
+);
