diff --git a/packages/connector/test/transport.test.mjs b/packages/connector/test/transport.test.mjs
new file mode 100644
index 0000000..85988a2
--- /dev/null
+++ b/packages/connector/test/transport.test.mjs
@@ -0,0 +1,169 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { createServer } from "node:http";
+import { once } from "node:events";
+import { request, retryAfterMilliseconds } from "../lib/transport.mjs";
+
+const sourceId = "22222222-2222-4222-8222-222222222222";
+
+function usageResponse() {
+  return {
+    acceptedEntries: 0,
+    acceptedSnapshots: 0,
+    acceptedSourceErrors: 0,
+    staleSnapshots: 0,
+    sourceSequences: [],
+  };
+}
+
+async function localServer(context, handler) {
+  const server = createServer(handler);
+  server.listen(0, "127.0.0.1");
+  await once(server, "listening");
+  context.after(() => server.close());
+  const address = server.address();
+  assert.notEqual(address, null);
+  assert.equal(typeof address, "object");
+  return `http://127.0.0.1:${address.port}`;
+}
+
+test("request preserves the endpoint request and parses the protocol response", async (context) => {
+  let received;
+  const origin = await localServer(context, (incoming, response) => {
+    const chunks = [];
+    incoming.on("data", (chunk) => chunks.push(chunk));
+    incoming.on("end", () => {
+      received = {
+        method: incoming.method,
+        url: incoming.url,
+        headers: incoming.headers,
+        body: Buffer.concat(chunks).toString("utf8"),
+      };
+      response.writeHead(200, { "content-type": "application/json" });
+      response.end(JSON.stringify(usageResponse()));
+    });
+  });
+
+  const body = JSON.stringify({ protocolVersion: 2, snapshots: [], sourceErrors: [] });
+  const result = await request(
+    origin,
+    "/api/usage",
+    {
+      method: "POST",
+      headers: { Authorization: "Bearer device-token", "Content-Type": "application/json" },
+      body,
+    },
+    1,
+    { kind: "usage", sourceIds: [] },
+  );
+
+  assert.deepEqual(result, usageResponse());
+  assert.equal(received.method, "POST");
+  assert.equal(received.url, "/api/usage");
+  assert.equal(received.headers.authorization, "Bearer device-token");
+  assert.equal(received.headers["content-type"], "application/json");
+  assert.equal(received.body, body);
+});
+
+test("request retries transient protocol failures but does not retry permanent errors", async (context) => {
+  let transientRequests = 0;
+  const transientRequestTimes = [];
+  const transientOrigin = await localServer(context, (_request, response) => {
+    transientRequests += 1;
+    transientRequestTimes.push(Date.now());
+    if (transientRequests === 1) {
+      response.writeHead(503, { "content-type": "text/html" });
+      response.end("temporary proxy failure");
+      return;
+    }
+    response.writeHead(200, { "content-type": "application/json" });
+    response.end(JSON.stringify(usageResponse()));
+  });
+  await request(transientOrigin, "/api/usage", {}, 2, { kind: "usage", sourceIds: [] });
+  assert.equal(transientRequests, 2);
+  assert.ok(transientRequestTimes[1] - transientRequestTimes[0] >= 450);
+
+  let permanentRequests = 0;
+  const permanentOrigin = await localServer(context, (_request, response) => {
+    permanentRequests += 1;
+    response.writeHead(400, { "content-type": "application/json" });
+    response.end(JSON.stringify({ error: "invalid_payload" }));
+  });
+  await assert.rejects(
+    request(permanentOrigin, "/api/usage", {}, 3, { kind: "usage", sourceIds: [sourceId] }),
+    (error) => {
+      assert.equal(error.message, "Vibe Racing returned 400: invalid_payload");
+      assert.equal(error.status, 400);
+      assert.equal(error.code, "invalid_payload");
+      return true;
+    },
+  );
+  assert.equal(permanentRequests, 1);
+});
+
+test("request preserves transient malformed-response errors and transport controls", async (context) => {
+  const malformedOrigin = await localServer(context, (_request, response) => {
+    response.writeHead(503, { "content-type": "text/html", "retry-after": "1" });
+    response.end("temporary proxy failure");
+  });
+  await assert.rejects(
+    request(malformedOrigin, "/api/usage", {}, 1, { kind: "usage", sourceIds: [] }),
+    (error) => {
+      assert.equal(error.code, "invalid_server_response");
+      assert.equal(error.status, 503);
+      assert.equal(error.retryAfterMs, 1_000);
+      return true;
+    },
+  );
+
+  const redirectOrigin = await localServer(context, (_request, response) => {
+    response.writeHead(302, { location: "/elsewhere" });
+    response.end();
+  });
+  await assert.rejects(
+    request(redirectOrigin, "/redirect", {}, 1, { kind: "usage", sourceIds: [] }),
+    (error) => error instanceof TypeError,
+  );
+});
+
+test("request applies its 15-second abort timeout", async (context) => {
+  const origin = await localServer(context, () => {});
+  const timeout = AbortSignal.timeout;
+  AbortSignal.timeout = (milliseconds) => {
+    assert.equal(milliseconds, 15_000);
+    return timeout(5);
+  };
+  try {
+    await assert.rejects(
+      request(origin, "/slow", {}, 1, { kind: "usage", sourceIds: [] }),
+      (error) => error?.name === "TimeoutError",
+    );
+  } finally {
+    AbortSignal.timeout = timeout;
+  }
+});
+
+test("Retry-After values are bounded and invalid values are ignored", () => {
+  const previousEnvironment = {
+    nodeEnvironment: process.env.NODE_ENV,
+    maximum: process.env.VIBERACING_TEST_MAX_RETRY_AFTER_MS,
+  };
+  try {
+    process.env.NODE_ENV = "test";
+    process.env.VIBERACING_TEST_MAX_RETRY_AFTER_MS = "25";
+    assert.equal(
+      retryAfterMilliseconds(new Response(null, { headers: { "retry-after": "300" } })),
+      25,
+    );
+    assert.equal(
+      retryAfterMilliseconds(new Response(null, { headers: { "retry-after": "not-a-date" } })),
+      null,
+    );
+  } finally {
+    if (previousEnvironment.nodeEnvironment === undefined) delete process.env.NODE_ENV;
+    else process.env.NODE_ENV = previousEnvironment.nodeEnvironment;
+    if (previousEnvironment.maximum === undefined)
+      delete process.env.VIBERACING_TEST_MAX_RETRY_AFTER_MS;
+    else process.env.VIBERACING_TEST_MAX_RETRY_AFTER_MS = previousEnvironment.maximum;
+  }
+});
