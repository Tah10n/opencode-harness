+async function exactLegacyRuntimeLayout(directory, { throwOnFailure = false } = {}) {
+  const fail = (message) => {
+    if (throwOnFailure) throw new Error(message);
+    return false;
+  };
+  const inspect = async (path, expectedType) => {
+    let info;
+    try {
+      info = await lstat(path);
+    } catch (error) {
+      if (error?.code === "ENOENT") return fail(`Missing legacy connector runtime entry: ${path}`);
+      throw error;
+    }
+    if (info.isSymbolicLink() || (expectedType === "file" ? !info.isFile() : !info.isDirectory()))
+      return fail(`Legacy connector runtime entry is not a real ${expectedType}: ${path}`);
+    return info;
+  };
+  const entries = async (path, expected) => {
+    const names = (await readdir(path)).sort();
+    const expectedNames = [...expected].sort();
+    if (JSON.stringify(names) !== JSON.stringify(expectedNames))
+      return fail(`Legacy connector runtime layout is not exact: ${path}`);
+    return true;
+  };
+
+  if (!(await inspect(join(directory, "bin"), "directory"))) return false;
+  if (!(await entries(join(directory, "bin"), ["viberacing.mjs"]))) return false;
+  if (!(await inspect(join(directory, "bin", "viberacing.mjs"), "file"))) return false;
+  if (!(await inspect(join(directory, "lib"), "directory"))) return false;
+  if (!(await entries(join(directory, "lib"), [...legacyRuntimeFiles, "adapters"]))) return false;
+  for (const name of legacyRuntimeFiles)
+    if (!(await inspect(join(directory, "lib", name), "file"))) return false;
+  if (!(await inspect(join(directory, "lib", "adapters"), "directory"))) return false;
+  if (
+    !(await entries(join(directory, "lib", "adapters"), [...legacyRuntimeAdapterFiles]))
+  )
+    return false;
+  for (const name of legacyRuntimeAdapterFiles)
+    if (!(await inspect(join(directory, "lib", "adapters", name), "file"))) return false;
+  return true;
+}
+
