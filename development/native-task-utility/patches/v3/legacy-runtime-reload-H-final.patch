+async function snapshotTree(path) {
+  const info = await lstat(path);
+  const snapshot = {
+    type: info.isDirectory() ? "directory" : info.isSymbolicLink() ? "symlink" : "file",
+    mode: info.mode & 0o777,
+  };
+  if (info.isDirectory()) {
+    snapshot.entries = {};
+    for (const name of await readdir(path)) snapshot.entries[name] = await snapshotTree(join(path, name));
+  } else if (info.isSymbolicLink()) snapshot.target = await readlink(path);
+  else snapshot.contents = await readFile(path, "utf8");
+  return snapshot;
+}
