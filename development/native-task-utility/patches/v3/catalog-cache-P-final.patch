@@ -1 +1 @@
-export function selectCatalog(catalog){return catalog.map(x=>({...x}));}
+export function selectCatalog(catalog,region){const selected=region===undefined?catalog:catalog.filter(x=>x.region===region);return selected.map(x=>({...x}));}
