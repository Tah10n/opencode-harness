--- a/README.md
+++ b/README.md
@@ -1,3 +1,15 @@
 # catalog-cache
 
 Run `npm test` with Node.js 24.
+
+`loadCatalog(fetcher, {region, etag})` requests the selected region and returns
+`{status: 'ok', items, etag}` for a 200 response or
+`{status: 'not-modified', etag}` for a 304 response. The region is URL-encoded,
+and `If-None-Match` is sent only when `etag` is provided.
+
+The handler's ETag is a quoted SHA-256 digest of the exact JSON response bytes.
+A request is conditional only when `req.headers['if-none-match']` exactly
+matches that tag; wildcard and weak tag matching are not supported.
+
+The legacy one-argument call, `loadCatalog(fetcher)`, still requests `/catalog`
+and returns the decoded array of items.
diff --git a/src/client.mjs b/src/client.mjs
index 8d6764b..cc0a15a 100644
--- a/src/client.mjs
+++ b/src/client.mjs
@@ -1 +1,21 @@
-export async function loadCatalog(fetcher){const response=await fetcher('/catalog');if(response.status!==200)throw Error('Catalog unavailable');return response.json();}
+function responseEtag(response){
+  if(typeof response.headers?.get==='function')return response.headers.get('etag')??response.headers.get('ETag');
+  return response.headers?.etag??response.headers?.ETag;
+}
+
+export async function loadCatalog(fetcher,{region,etag}={}){
+  const legacy=arguments.length===1;
+  if(legacy){
+    const response=await fetcher('/catalog');
+    if(response.status!==200)throw Error('Catalog unavailable');
+    return response.json();
+  }
+  const url=region===undefined?'/catalog':`/catalog?region=${encodeURIComponent(region)}`;
+  const options={};
+  if(etag!==undefined)options.headers={'If-None-Match':etag};
+  const response=await fetcher(url,options);
+  const responseTag=responseEtag(response);
+  if(response.status===304)return {status:'not-modified',etag:responseTag};
+  if(response.status!==200)throw Error('Catalog unavailable');
+  return {status:'ok',items:await response.json(),etag:responseTag};
+}
