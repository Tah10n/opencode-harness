-import {test} from 'node:test';import assert from 'node:assert/strict';import {handle} from '../src/handler.mjs';import {loadCatalog} from '../src/client.mjs';
-test('legacy consumer returns items',async()=>{assert.deepEqual(await loadCatalog(async url=>{assert.equal(url,'/catalog');return {status:200,json:async()=>[{id:1}]};}),[{id:1}]);});
-test('existing method and path errors',()=>{for(const [method,url,code]of [['POST','/catalog',405],['GET','/other',404]]){let actual;handle({method,url,headers:{}},{writeHead:s=>actual=s,end:()=>{}},[]);assert.equal(actual,code);}});
+import {createHash} from 'node:crypto';
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {handle} from '../src/handler.mjs';
+import {loadCatalog} from '../src/client.mjs';
+
+function responseFor(req, catalog) {
+  let response;
+  handle(req, {
+    writeHead(status, headers) {
+      response = {status, headers};
+    },
+    end(body = '') {
+      response.body = body;
+    },
+  }, catalog);
+  return response;
+}
+
+test('catalog responses filter by region without mutating the catalog', () => {
+  const catalog = [
+    {id: 1, region: 'north'},
+    {id: 2, region: 'south'},
+    {id: 3, region: 'north'},
+  ];
+  const original = structuredClone(catalog);
+  const response = responseFor({method: 'GET', url: '/catalog?region=north', headers: {}}, catalog);
+  const body = JSON.stringify([catalog[0], catalog[2]]);
+  const expectedTag = `"${createHash('sha256').update(body).digest('hex')}"`;
+
+  assert.equal(response.status, 200);
+  assert.equal(response.headers['Content-Type'], 'application/json');
+  assert.equal(response.headers['Cache-Control'], 'private, max-age=0');
+  assert.equal(response.headers.ETag, expectedTag);
+  assert.equal(response.body, body);
+  assert.deepEqual(catalog, original);
+
+  const all = responseFor({method: 'GET', url: '/catalog', headers: {}}, catalog);
+  assert.equal(all.body, JSON.stringify(catalog));
+  assert.notEqual(all.headers.ETag, response.headers.ETag);
+});
+
+test('matching ETags return an empty 304 response', () => {
+  const catalog = [{id: 1, region: 'north'}];
+  const first = responseFor({method: 'GET', url: '/catalog?region=north', headers: {}}, catalog);
+  const response = responseFor({
+    method: 'GET',
+    url: '/catalog?region=north',
+    headers: {'if-none-match': first.headers.ETag},
+  }, catalog);
+
+  assert.equal(response.status, 304);
+  assert.equal(response.headers.ETag, first.headers.ETag);
+  assert.equal(response.headers['Cache-Control'], 'private, max-age=0');
+  assert.equal(response.body, '');
+});
+
+test('ETag matching is exact rather than wildcard or weak matching', () => {
+  const catalog = [{id: 1, region: 'north'}];
+  const first = responseFor({method: 'GET', url: '/catalog?region=north', headers: {}}, catalog);
+
+  for (const etag of ['*', `W/${first.headers.ETag}`]) {
+    const response = responseFor({
+      method: 'GET',
+      url: '/catalog?region=north',
+      headers: {'if-none-match': etag},
+    }, catalog);
+    assert.equal(response.status, 200);
+    assert.notEqual(response.body, '');
+  }
+});
+
+test('client loads a regional catalog and escapes the region', async () => {
+  const items = [{id: 1}];
+  const etag = '"regional"';
+  const result = await loadCatalog(async (url, options) => {
+    assert.equal(url, '/catalog?region=north%20%26%20west%2F');
+    assert.deepEqual(options, undefined);
+    return {
+      status: 200,
+      headers: new Headers({ETag: etag}),
+      json: async () => items,
+    };
+  }, {region: 'north & west/'});
+
+  assert.deepEqual(result, {status: 'ok', items, etag});
+});
+
+test('client returns not-modified without parsing a 304 body', async () => {
+  const etag = '"regional"';
+  let jsonCalled = false;
+  const result = await loadCatalog(async (url, options) => {
+    assert.equal(url, '/catalog?region=north');
+    assert.deepEqual(options, {headers: {'If-None-Match': etag}});
+    return {
+      status: 304,
+      headers: new Headers({ETag: etag}),
+      json: async () => {
+        jsonCalled = true;
+        throw new Error('304 bodies must not be parsed');
+      },
+    };
+  }, {region: 'north', etag});
+
+  assert.deepEqual(result, {status: 'not-modified', etag});
+  assert.equal(jsonCalled, false);
+});
+
+test('legacy consumer returns items', async () => {
+  assert.deepEqual(await loadCatalog(async url => {
+    assert.equal(url, '/catalog');
+    return {status: 200, json: async () => [{id: 1}]};
+  }), [{id: 1}]);
+});
+
+test('client rejects non-200 and non-304 responses', async () => {
+  await assert.rejects(() => loadCatalog(async () => ({status: 500}), {}), /Catalog unavailable/);
+});
+
+test('existing method and path errors', () => {
+  for (const [method, url, code] of [['POST', '/catalog', 405], ['GET', '/other', 404]]) {
+    let actual;
+    handle({method, url, headers: {}}, {writeHead: status => actual = status, end: () => {}}, []);
+    assert.equal(actual, code);
+  }
+});
