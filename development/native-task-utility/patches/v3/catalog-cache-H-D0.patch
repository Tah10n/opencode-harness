--- a/src/select.mjs
+++ b/src/select.mjs
@@ -1 +1,5 @@
-export function selectCatalog(catalog){return catalog.map(x=>({...x}));}
+export function selectCatalog(catalog, region) {
+  return catalog
+    .filter(item => region === null || item.region === region)
+    .map(item => ({...item}));
+}
