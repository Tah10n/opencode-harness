@@ -1,3 +1,10 @@
 # catalog-cache
 
 Run `npm test` with Node.js 24.
+
+`loadCatalog(fetcher, {region, etag})` requests an optionally filtered catalog and
+returns `{status: 'ok', items, etag}` for a 200 response or
+`{status: 'not-modified', etag}` for a 304 response. The client sends
+`If-None-Match` only when `etag` is supplied, and matching is exact: wildcard and
+weak ETags are not treated as matches. For compatibility, the legacy
+`loadCatalog(fetcher)` call still requests `/catalog` and returns the items array.
diff --git a/src/client.mjs b/src/client.mjs
index 8d6764b162d0ddf5fb7731be35f3ec299c9e84ca..0d138c8e9f33f80ea9d079e3ea36b94896d6d429 100644
--- a/src/client.mjs
+++ b/src/client.mjs
@@ -1 +1,29 @@
-export async function loadCatalog(fetcher){const response=await fetcher('/catalog');if(response.status!==200)throw Error('Catalog unavailable');return response.json();}
+export async function loadCatalog(fetcher, options = {}) {
+  const legacy = arguments.length === 1;
+  const {region, etag} = options;
+  const url = region === undefined
+    ? '/catalog'
+    : `/catalog?region=${encodeURIComponent(region)}`;
+  const requestOptions = etag === undefined ? undefined : {headers: {'If-None-Match': etag}};
+  const response = requestOptions === undefined
+    ? await fetcher(url)
+    : await fetcher(url, requestOptions);
+
+  if (response.status === 304) {
+    const responseEtag = response.headers?.get('etag') ?? etag;
+    if (legacy) {
+      throw Error('Catalog unavailable');
+    }
+    return {status: 'not-modified', etag: responseEtag};
+  }
+
+  if (response.status !== 200) {
+    throw Error('Catalog unavailable');
+  }
+
+  const items = await response.json();
+  if (legacy) {
+    return items;
+  }
+  return {status: 'ok', items, etag: response.headers?.get('etag')};
+}
