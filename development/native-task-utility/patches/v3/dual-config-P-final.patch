 # dual-config
 
 Run `npm test` with Node.js 24.
+
+## Configuration
+
+Both CommonJS (`require('./index.cjs')`) and ESM (the default or named
+`configure` export from `./index.mjs`) accept either a legacy mode string or an
+options object:
+
+```js
+configure('compact');
+configure({mode: 'pretty', indent: 4});
+```
+
+`compact` defaults to indent `0`, and `pretty` defaults to indent `2`. An
+explicit `indent` must be an integer from `0` through `8`, inclusive, so
+`{mode: 'pretty', indent: 0}` is valid. Options are not mutated.
+
+The mode is required for object options and must be `compact` or `pretty`.
+Invalid mode strings throw `RangeError`; null, arrays, missing or non-string
+modes, and invalid indents throw `TypeError`.
diff --git a/index.cjs b/index.cjs
index a6f3982..0f615d7 100644
--- a/index.cjs
+++ b/index.cjs
@@ -1 +1,34 @@
-function configure(mode){if(!['compact','pretty'].includes(mode))throw new RangeError('Invalid mode');return {mode,indent:mode==='pretty'?2:0};}module.exports=configure;
+function configure(option) {
+  if (typeof option === 'string') {
+    if (!['compact', 'pretty'].includes(option)) {
+      throw new RangeError('Invalid mode');
+    }
+
+    return {mode: option, indent: option === 'pretty' ? 2 : 0};
+  }
+
+  if (option === null || typeof option !== 'object' || Array.isArray(option)) {
+    throw new TypeError('Options must be a mode string or object');
+  }
+
+  const {mode} = option;
+  if (typeof mode !== 'string') {
+    throw new TypeError('Options must include a mode string');
+  }
+  if (!['compact', 'pretty'].includes(mode)) {
+    throw new RangeError('Invalid mode');
+  }
+
+  if (!Object.prototype.hasOwnProperty.call(option, 'indent')) {
+    return {mode, indent: mode === 'pretty' ? 2 : 0};
+  }
+
+  const {indent} = option;
+  if (typeof indent !== 'number' || !Number.isInteger(indent) || indent < 0 || indent > 8) {
+    throw new TypeError('Indent must be an integer from 0 through 8');
+  }
+
+  return {mode, indent};
+}
+
+module.exports = configure;
