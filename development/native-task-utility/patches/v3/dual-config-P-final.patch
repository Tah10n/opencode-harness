+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {createRequire} from 'node:module';
+import configure, {configure as named} from '../index.mjs';
+import {render as renderEsm} from '../consumer.mjs';
+
+const require = createRequire(import.meta.url);
+const configureCjs = require('../index.cjs');
+const {render: renderCjs} = require('../consumer.cjs');
+
+test('legacy CJS and ESM entry points', () => {
+  assert.deepEqual(configure('compact'), {mode: 'compact', indent: 0});
+  assert.deepEqual(configure('pretty'), named('pretty'));
+  assert.deepEqual(configureCjs('pretty'), {mode: 'pretty', indent: 2});
+  assert.equal(renderEsm({x: 1}, 'compact'), '{"x":1}');
+  assert.equal(renderCjs({x: 1}, 'compact'), '{"x":1}');
+  assert.throws(() => configure('wide'), RangeError);
+  assert.throws(() => configureCjs('wide'), RangeError);
+});
+
+test('CJS and ESM entry points accept object options', () => {
+  const options = {mode: 'pretty', indent: 4};
+
+  assert.deepEqual(configure(options), options);
+  assert.deepEqual(named(options), options);
+  assert.deepEqual(configureCjs(options), options);
+  assert.deepEqual(options, {mode: 'pretty', indent: 4});
+  assert.deepEqual(configure({mode: 'compact'}), {mode: 'compact', indent: 0});
+  assert.deepEqual(configureCjs({mode: 'pretty'}), {mode: 'pretty', indent: 2});
+  assert.deepEqual(configure({mode: 'pretty', indent: 0}), {mode: 'pretty', indent: 0});
+  assert.deepEqual(configureCjs({mode: 'pretty', indent: 0}), {mode: 'pretty', indent: 0});
+
+  const value = {items: [1, 2]};
+  assert.equal(renderEsm(value, {mode: 'pretty', indent: 0}), '{"items":[1,2]}');
+  assert.equal(renderCjs(value, {mode: 'pretty', indent: 0}), '{"items":[1,2]}');
+  assert.equal(renderEsm(value, options), '{\n    "items": [\n        1,\n        2\n    ]\n}');
+  assert.equal(renderCjs(value, options), '{\n    "items": [\n        1,\n        2\n    ]\n}');
+});
+
+test('object option validation is shared by CJS and ESM', () => {
+  for (const entryPoint of [configure, configureCjs]) {
+    for (const indent of [null, '2', Number.NaN, 1.5, -1, 9]) {
+      assert.throws(() => entryPoint({mode: 'pretty', indent}), TypeError);
+    }
+    assert.throws(() => entryPoint(null), TypeError);
+    assert.throws(() => entryPoint([]), TypeError);
+    assert.throws(() => entryPoint({}), TypeError);
+    assert.throws(() => entryPoint({mode: 'wide'}), RangeError);
+  }
+});
