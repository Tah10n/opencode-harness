diff --git a/packages/connector/test/transport.test.mjs b/packages/connector/test/transport.test.mjs
new file mode 100644
index 0000000..1ae94d1
--- /dev/null
+++ b/packages/connector/test/transport.test.mjs
@@ -0,0 +1,131 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { once } from "node:events";
+import { createServer } from "node:http";
+import { request } from "../lib/transport.mjs";
+
+const sourceId = "22222222-2222-4222-8222-222222222222";
+
+function usageResponse() {
+  return {
+    acceptedEntries: 0,
+    acceptedSnapshots: 0,
+    acceptedSourceErrors: 0,
+    staleSnapshots: 0,
+    sourceSequences: [],
+  };
+}
+
+async function localServer(handler, context) {
+  const server = createServer(handler);
+  server.listen(0, "127.0.0.1");
+  await once(server, "listening");
+  context.after(() => server.close());
+  const address = server.address();
+  assert.equal(typeof address, "object");
+  return `http://127.0.0.1:${address.port}`;
+}
+
+function sendJson(response, status, value, headers = {}) {
+  response.writeHead(status, { "content-type": "application/json", ...headers });
+  response.end(JSON.stringify(value));
+}
+
+test("preserves request method, body, headers, and validated return value", async (context) => {
+  let received;
+  const origin = await localServer((incoming, response) => {
+    const chunks = [];
+    incoming.on("data", (chunk) => chunks.push(chunk));
+    incoming.on("end", () => {
+      received = {
+        method: incoming.method,
+        url: incoming.url,
+        authorization: incoming.headers.authorization,
+        contentType: incoming.headers["content-type"],
+        body: Buffer.concat(chunks).toString("utf8"),
+      };
+      sendJson(response, 200, usageResponse());
+    });
+  }, context);
+
+  const result = await request(
+    origin,
+    "/api/usage",
+    {
+      method: "POST",
+      headers: {
+        Authorization: "Bearer device-token",
+        "Content-Type": "application/json",
+      },
+      body: JSON.stringify({ protocolVersion: 2, sourceIds: [sourceId] }),
+    },
+    1,
+    { kind: "usage", sourceIds: [] },
+  );
+
+  assert.deepEqual(result, usageResponse());
+  assert.deepEqual(received, {
+    method: "POST",
+    url: "/api/usage",
+    authorization: "Bearer device-token",
+    contentType: "application/json",
+    body: JSON.stringify({ protocolVersion: 2, sourceIds: [sourceId] }),
+  });
+});
+
+test("does not retry permanent protocol errors and preserves status, code, and message", async (context) => {
+  let requests = 0;
+  const origin = await localServer((_incoming, response) => {
+    requests += 1;
+    sendJson(response, 400, { error: "invalid_payload" });
+  }, context);
+
+  await assert.rejects(
+    request(origin, "/api/usage", { method: "POST" }, 3, { kind: "usage", sourceIds: [] }),
+    (error) => {
+      assert.equal(error.message, "Vibe Racing returned 400: invalid_payload");
+      assert.equal(error.status, 400);
+      assert.equal(error.code, "invalid_payload");
+      return true;
+    },
+  );
+  assert.equal(requests, 1);
+});
+
+test("retries transient malformed responses and refuses redirects", async (context) => {
+  let requests = 0;
+  const origin = await localServer((_incoming, response) => {
+    requests += 1;
+    if (requests === 1) {
+      response.writeHead(503, { "content-type": "text/plain" });
+      response.end("temporary proxy failure");
+      return;
+    }
+    sendJson(response, 200, usageResponse());
+  }, context);
+
+  assert.deepEqual(
+    await request(origin, "/api/usage", {}, 2, { kind: "usage", sourceIds: [] }),
+    usageResponse(),
+  );
+  assert.equal(requests, 2);
+
+  let redirectedRequests = 0;
+  let targetOrigin;
+  const redirectOrigin = await localServer((_incoming, response) => {
+    response.writeHead(302, { location: `${targetOrigin}/redirect-target` });
+    response.end();
+  }, context);
+  targetOrigin = await localServer((_incoming, response) => {
+    redirectedRequests += 1;
+    response.end();
+  }, context);
+  await assert.rejects(
+    request(redirectOrigin, "/redirect", {}, 1, {
+      kind: "usage",
+      sourceIds: [],
+    }),
+    (error) => error instanceof TypeError,
+  );
+  assert.equal(redirectedRequests, 0);
+});
