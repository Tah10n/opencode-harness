+test("migrates the exact flat legacy runtime without changing it across reloads", async () => {
+  const home = await mkdtemp(join(tmpdir(), "viberacing-legacy-flat-runtime-"));
+  const restoreEnvironment = useModuleEnvironment(home);
+  const previousHome = process.env.HOME;
+  const previousUserProfile = process.env.USERPROFILE;
+  process.env.HOME = home;
+  process.env.USERPROFILE = home;
+  delete process.env.VIBERACING_STATE_DIR;
+  try {
+    const directory = join(home, ".viberacing");
+    const origin = "https://viberacing.example";
+    const clientSourceId = "30303030-3030-4030-8030-303030303030";
+    const sourceId = "31313131-3131-4131-8131-313131313131";
+    const installationId = "32323232-3232-4232-8232-323232323232";
+    const localSource = {
+      clientSourceId,
+      agentId: "codex",
+      collectionMethod: "codex_app_server",
+      dataPath: join(home, ".codex"),
+      suggestedLabel: "Codex",
+      supportedSurface: "desktop",
+    };
+    await mkdir(directory, { recursive: true });
+    const legacyFiles = await writeLegacyFlatRuntime(directory);
+    await writeFile(
+      join(directory, "installation.json"),
+      `${JSON.stringify({
+        version: 1,
+        id: installationId,
+        secret: "legacy_flat_runtime_installation_secret",
+      })}\n`,
+    );
+    await writeFile(
+      join(directory, "sources.json"),
+      `${JSON.stringify({ version: 1, sources: [localSource] })}\n`,
+    );
+    await writeFile(
+      join(directory, "config.json"),
+      `${JSON.stringify({
+        version: 2,
+        origin,
+        installationId,
+        deviceToken: "legacy_flat_runtime_device_token",
+        sources: [
+          {
+            clientSourceId,
+            sourceId,
+            agentId: localSource.agentId,
+            accountLabel: "Legacy Codex",
+            collectionMethod: localSource.collectionMethod,
+            lastAcceptedSyncSequence: "4",
+          },
+        ],
+      })}\n`,
+    );
+    const before = new Map(
+      await Promise.all(
+        legacyFiles.map(async (name) => [name, await readFile(join(directory, name))]),
+      ),
+    );
+    const module = await import(`../lib/config.mjs?legacy-flat=${encodeURIComponent(home)}`);
+    const installed = await module.prepareRuntime(new URL("../bin/viberacing.mjs", import.meta.url));
+    assert.equal(installed, join(directory, "runtime", connectorVersion, "bin", "viberacing.mjs"));
+    assert.deepEqual(await module.readSources(), [localSource]);
+    assert.equal((await module.readConfig()).installationId, installationId);
+    assert.equal((await module.readConfig()).sources[0].sourceId, sourceId);
+    assert.deepEqual(JSON.parse(await readFile(join(directory, ".viberacing-state"), "utf8")), {
+      format: 1,
+    });
+
+    const reloaded = await import(`../lib/config.mjs?legacy-flat-reload=${encodeURIComponent(home)}`);
+    const repeated = await reloaded.prepareRuntime(
+      new URL("../bin/viberacing.mjs", import.meta.url),
+    );
+    assert.equal(repeated, installed);
+    for (const name of legacyFiles)
+      assert.deepEqual(await readFile(join(directory, name)), before.get(name), name);
+    assert.deepEqual(await reloaded.readSources(), [localSource]);
+    assert.equal((await reloaded.readConfig()).installationId, installationId);
+    assert.equal((await reloaded.readConfig()).sources[0].sourceId, sourceId);
+    await execFileAsync(process.execPath, [installed, "--version"], {
+      env: connectorEnvironment(home),
+    });
+  } finally {
+    restoreEnvironment();
+    if (previousHome === undefined) delete process.env.HOME;
+    else process.env.HOME = previousHome;
+    if (previousUserProfile === undefined) delete process.env.USERPROFILE;
+    else process.env.USERPROFILE = previousUserProfile;
+    await rm(home, { recursive: true, force: true });
+  }
+});
