+async function validateLegacyRuntimeLayout() {
+  let libraryInfo;
+  try {
+    libraryInfo = await lstat(join(stateDirectory, "lib"));
+  } catch (error) {
+    if (error?.code === "ENOENT") return;
+    throw error;
+  }
+  if (!libraryInfo.isDirectory() || libraryInfo.isSymbolicLink())
+    throw new Error("Vibe Racing legacy runtime library must be a real directory");
+
+  let binInfo;
+  try {
+    binInfo = await lstat(join(stateDirectory, "bin"));
+  } catch (error) {
+    if (error?.code === "ENOENT")
+      throw new Error("Vibe Racing legacy flat runtime is incomplete: bin directory is missing");
+    throw error;
+  }
+  if (!binInfo.isDirectory() || binInfo.isSymbolicLink())
+    throw new Error("Vibe Racing legacy runtime bin must be a real directory");
+
+  const binEntries = await readdir(join(stateDirectory, "bin"));
+  if (binEntries.length !== 1 || binEntries[0] !== "viberacing.mjs")
+    throw new Error("Vibe Racing legacy runtime contains an unrelated bin entry");
+
+  const libraryEntries = await readdir(join(stateDirectory, "lib"));
+  const expectedLibraryEntries = [...legacyRuntimeFiles, "adapters"].sort();
+  if (
+    libraryEntries.length !== expectedLibraryEntries.length ||
+    [...libraryEntries].sort().some((name, index) => name !== expectedLibraryEntries[index])
+  )
+    throw new Error("Vibe Racing legacy runtime contains an unknown library entry");
+
+  const adaptersDirectory = join(stateDirectory, "lib", "adapters");
+  const adaptersInfo = await lstat(adaptersDirectory);
+  if (!adaptersInfo.isDirectory() || adaptersInfo.isSymbolicLink())
+    throw new Error("Vibe Racing legacy runtime adapters must be a real directory");
+  const adapterEntries = await readdir(adaptersDirectory);
+  const expectedAdapterEntries = [...legacyRuntimeAdapterFiles].sort();
+  if (
+    adapterEntries.length !== expectedAdapterEntries.length ||
+    [...adapterEntries].sort().some((name, index) => name !== expectedAdapterEntries[index])
+  )
+    throw new Error("Vibe Racing legacy runtime contains an unknown adapter entry");
+}
