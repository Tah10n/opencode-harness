+test(
+  "POSIX state security rejects non-flat legacy runtimes without changing their bytes",
+  { skip: process.platform === "win32" },
+  async (context) => {
+    const root = await mkdtemp(join(tmpdir(), "viberacing-legacy-runtime-reject-"));
+    context.after(() => rm(root, { recursive: true, force: true }));
+    const cases = [
+      ["unknown-library", async (state) => writeFile(join(state, "lib", "unknown.mjs"), "foreign\n")],
+      ["extra-nesting", async (state) => mkdir(join(state, "lib", "adapters", "nested"))],
+      [
+        "symlink",
+        async (state) => {
+          const target = join(root, "legacy-target.mjs");
+          await writeFile(target, "target\n");
+          await rm(join(state, "lib", "browser.mjs"));
+          await symlink(target, join(state, "lib", "browser.mjs"));
+        },
+      ],
+      ["incomplete", async (state) => rm(join(state, "lib", "adapters", "cursor.mjs"))],
+      [
+        "foreign-executable",
+        async (state) => writeFile(join(state, "bin", "foreign"), "#!/bin/sh\n"),
+      ],
+    ];
+    for (const [name, mutate] of cases) {
+      const state = join(root, name);
+      await mkdir(state, { recursive: true, mode: 0o777 });
+      await createLegacyRuntime(state);
+      await writeFile(
+        join(state, "installation.json"),
+        `${JSON.stringify({
+          version: 1,
+          id: "41414141-4141-4141-8141-414141414141",
+          secret: "legacy_runtime_rejection_secret_that_is_long_enough",
+        })}\n`,
+        { mode: 0o664 },
+      );
+      await mutate(state);
+      const known = join(state, "lib", "config.mjs");
+      const knownBytes = await readFile(known);
+      const beforeDirectoryMode = (await lstat(state)).mode & 0o777;
+      const environment = { ...process.env, NODE_ENV: "test", VIBERACING_STATE_DIR: state };
+      const child = await execFileAsync(
+        process.execPath,
+        ["--input-type=module", "--eval", ensureStateScript],
+        { env: environment },
+      ).catch((error) => error);
+      assert.notEqual(child.code, 0, name);
+      assert.deepEqual(await readFile(known), knownBytes, name);
+      assert.equal((await lstat(state)).mode & 0o777, beforeDirectoryMode, name);
+      await assert.rejects(access(join(state, ".viberacing-state")), undefined, name);
+    }
+  },
+);
