+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {createRequire} from 'node:module';
+import configure, {configure as named} from '../index.mjs';
+import {render as renderEsm} from '../consumer.mjs';
+
+const require = createRequire(import.meta.url);
+const configureCjs = require('../index.cjs');
+const renderCjs = require('../consumer.cjs').render;
+
+test('legacy CJS and ESM entry points', () => {
+  assert.deepEqual(configure('compact'), {mode: 'compact', indent: 0});
+  assert.deepEqual(configure('pretty'), {mode: 'pretty', indent: 2});
+  assert.deepEqual(named('pretty'), {mode: 'pretty', indent: 2});
+  assert.deepEqual(configureCjs('compact'), {mode: 'compact', indent: 0});
+  assert.deepEqual(configureCjs('pretty'), {mode: 'pretty', indent: 2});
+  assert.throws(() => configure('wide'), RangeError);
+  assert.throws(() => configureCjs('wide'), RangeError);
+});
+
+test('CJS and ESM entry points normalize object options', () => {
+  const options = {mode: 'pretty', indent: 0};
+
+  assert.deepEqual(configure(options), {mode: 'pretty', indent: 0});
+  assert.deepEqual(configureCjs({mode: 'compact'}), {mode: 'compact', indent: 0});
+  assert.deepEqual(named({mode: 'pretty'}), {mode: 'pretty', indent: 2});
+  assert.deepEqual(configureCjs({mode: 'pretty', indent: 8}), {mode: 'pretty', indent: 8});
+  assert.deepEqual(options, {mode: 'pretty', indent: 0});
+});
+
+test('CJS and ESM consumers render legacy strings and object options', () => {
+  const value = {x: 1, nested: {y: 2}};
+
+  assert.equal(renderCjs(value, 'compact'), '{"x":1,"nested":{"y":2}}');
+  assert.equal(renderEsm(value, 'pretty'), '{\n  "x": 1,\n  "nested": {\n    "y": 2\n  }\n}');
+  assert.equal(renderCjs(value, {mode: 'pretty', indent: 0}), '{"x":1,"nested":{"y":2}}');
+  assert.equal(renderEsm(value, {mode: 'pretty', indent: 4}), '{\n    "x": 1,\n    "nested": {\n        "y": 2\n    }\n}');
+});
+
+test('CJS and ESM consumers reject invalid object options', () => {
+  for (const option of [
+    {mode: 'pretty', indent: '2'},
+    {mode: 'pretty', indent: NaN},
+    {mode: 'pretty', indent: 1.5},
+    {mode: 'pretty', indent: -1},
+    {mode: 'pretty', indent: 9},
+  ]) {
+    assert.throws(() => renderCjs({}, option), TypeError);
+    assert.throws(() => renderEsm({}, option), TypeError);
+  }
+
+  assert.throws(() => renderCjs({}, {}), TypeError);
+  assert.throws(() => renderEsm({}, {}), TypeError);
+  assert.throws(() => renderCjs({}, {mode: 'wide'}), RangeError);
+  assert.throws(() => renderEsm({}, {mode: 'wide'}), RangeError);
+  assert.throws(() => renderCjs({}, null), TypeError);
+  assert.throws(() => renderEsm({}, []), TypeError);
+});
