+		const window = env();
+		const Component = eval(`(function () { ${compiled.code}; return SvelteComponent; }())`);
+		const target = window.document.querySelector('main');
+		const component = new Component({ target, data: { className: 'foo' } });
+		const node = target.querySelector('div');
+
+		assert.equal(node.className, `${scope} foo`);
+
+		component.set({ className: 'bar' });
+
+		assert.equal(node.className, `${scope} bar`);
