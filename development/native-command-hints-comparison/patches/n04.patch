@@ -0,0 +1,37 @@
+import EventEmitter from '..';
+
+interface Events {
+  data: [value: string, count: number];
+  closed: [];
+}
+
+interface Context {
+  prefix: string;
+}
+
+const emitter = new EventEmitter<Events, Context>();
+const unsubscribe: EventEmitter.Unsubscribe = emitter.subscribe(
+  'data',
+  function (value, count) {
+    const message: string = this.prefix + value;
+    const total: number = count + 1;
+    void message;
+    void total;
+  },
+  { prefix: 'event: ' }
+);
+
+unsubscribe();
+emitter.subscribe('closed', function () {
+  const prefix: string = this.prefix;
+  void prefix;
+}, { prefix: '' });
+
+// @ts-expect-error Event-specific arguments reject the wrong argument type.
+emitter.subscribe('data', (value: string, count: string) => {}, { prefix: '' });
+
+// @ts-expect-error The context must match the emitter's Context type.
+emitter.subscribe('data', (value: string, count: number) => {}, { wrong: true });
+
+// @ts-expect-error The cancellation function does not accept arguments.
+unsubscribe('unexpected');
