+      "/p?keep=%2a",
+    ],
+    ["/p?bad+%ZZ=1&bad%2=2&keep=3", ["bad %ZZ", "bad%2"], "/p?keep=3"],
+    ["/p?__proto__=1&__proto__=2&keep=3", "__proto__", "/p?keep=3"],
+    ["/p?=1&&empty&x=2", "", "/p?empty&x=2"],
+    ["/p?x=1", "missing", "/p?x=1"],
+    ["/p?Keep=%2A&&x=1#Frag?z=2", "missing", "/p?Keep=%2A&&x=1#Frag?z=2"],
+  ])("%s without %s", (input, keys, expected) => {
+    expect(withoutQuery(input, keys)).toBe(expected);
+  });
+
+  test("does not mutate readonly key arrays", () => {
+    const keys = ["x", "x"] as const;
+    expect(withoutQuery("/p?x=1&y=2", keys)).toBe("/p?y=2");
+    expect(keys).toEqual(["x", "x"]);
+  });
+
+  test("returns no-op inputs byte-for-byte unchanged", () => {
+    const keys: readonly string[] = [];
+    const input = "/raw%2f?Keep=%2a&&x=1#Frag?z=2";
+    expect(withoutQuery(input, keys)).toBe(input);
+  });
+});
