+/**
+ * Removes the query section of a URL, or selected query keys, while preserving
+ * the raw bytes of the remaining URL and query fields.
+ *
+ * @example
+ *
+ * ```js
+ * withoutQuery("/foo?bar=1&baz=2#frag"); // "/foo#frag"
+ * withoutQuery("/foo?bar=1&baz=2", "bar"); // "/foo?baz=2"
+ * ```
+ *
+ * Query keys are decoded using the same rules as `parseQuery`. When keys are
+ * supplied, retained fields are not decoded or re-serialized.
+ *
+ * @group utils
+ */
+export function withoutQuery(
+  input: string,
+  keys?: string | readonly string[],
+): string {
+  const fragmentIndex = input.indexOf("#");
+  const queryIndex = input.indexOf("?");
+  if (
+    queryIndex === -1 ||
+    (fragmentIndex !== -1 && queryIndex > fragmentIndex)
+  ) {
+    return input;
+  }
+
+  const prefix = input.slice(0, queryIndex);
+  const fragment = fragmentIndex === -1 ? "" : input.slice(fragmentIndex);
+
+  if (keys === undefined) {
+    return prefix + fragment;
+  }
+
+  const requestedKeys = new Set(typeof keys === "string" ? [keys] : keys);
+  if (requestedKeys.size === 0) {
+    return input;
+  }
+
+  const query = input.slice(
+    queryIndex + 1,
+    fragmentIndex === -1 ? undefined : fragmentIndex,
+  );
+  const retainedFields: string[] = [];
+  let removedField = false;
+
+  for (const field of query.split("&")) {
+    const equalsIndex = field.indexOf("=");
+    const key = decodeQueryKey(
+      equalsIndex === -1 ? field : field.slice(0, equalsIndex),
+    );
+    if (requestedKeys.has(key)) {
+      removedField = true;
+    } else {
+      retainedFields.push(field);
+    }
+  }
+
+  if (!removedField) {
+    return input;
+  }
+
+  const retainedQuery = retainedFields.join("&");
+  return prefix + (retainedQuery ? `?${retainedQuery}` : "") + fragment;
+}
