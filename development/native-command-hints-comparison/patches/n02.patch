+describe("withoutQuery", () => {
+  test("removes the complete query while preserving the prefix and fragment", () => {
+    expect(withoutQuery("/foo?bar=1&baz=2#hash")).toBe("/foo#hash");
+    expect(withoutQuery("/foo?bar=1&baz=2")).toBe("/foo");
+    expect(withoutQuery("/foo#fragment?bar=1")).toBe("/foo#fragment?bar=1");
+  });
+
+  test("removes every matching field and preserves retained raw fields", () => {
+    expect(
+      withoutQuery("/p?a=1&a=2&keep=%2f&&keep=two#f", ["a", "a"]),
+    ).toBe("/p?keep=%2f&&keep=two#f");
+    expect(withoutQuery("/p?x=1&&y=2#f", "x")).toBe("/p?&y=2#f");
+    expect(withoutQuery("/p?bare&x=1", "bare")).toBe("/p?x=1");
+    expect(withoutQuery("/p?x=1&x=2", "x")).toBe("/p");
+  });
+
+  test(
+    "matches decoded, plus-separated, malformed, Unicode, and special keys",
+    () => {
+      expect(withoutQuery("/p?%E2%9C%93=1&other=2", "✓")).toBe(
+        "/p?other=2",
+      );
+      expect(withoutQuery("/p?hello+world=1&other=2", "hello world")).toBe(
+        "/p?other=2",
+      );
+      expect(withoutQuery("/p?bad%ZZ=1&other=2", "bad%ZZ")).toBe(
+        "/p?other=2",
+      );
+      expect(withoutQuery("/p?%3Dfirst=1&other=2", "=first")).toBe(
+        "/p?other=2",
+      );
+      expect(
+        withoutQuery("/p?__proto__=1&constructor=2&keep=3", [
+          "__proto__",
+          "__proto__",
+        ]),
+      ).toBe("/p?constructor=2&keep=3");
+    },
+  );
+
+  test("supports empty keys, empty fields, and no-op calls", () => {
+    expect(withoutQuery("/p?=1&foo=2&=3", "")).toBe("/p?foo=2");
+    expect(withoutQuery("/p?&&", "")).toBe("/p");
+    expect(withoutQuery("/p?x=1&keep=%2F", [])).toBe("/p?x=1&keep=%2F");
+    expect(withoutQuery("/p?x=1&keep=%2F", "missing")).toBe(
+      "/p?x=1&keep=%2F",
+    );
+
+    const keys = ["x"];
+    withoutQuery("/p?x=1", keys);
+    expect(keys).toStrictEqual(["x"]);
+  });
+});
+
