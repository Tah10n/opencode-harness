+/**
+ * Removes the query section of a URL, or selected query keys, while preserving
+ * the raw spelling of the remaining URL and query fields.
+ * When keys are supplied, matching uses decoded query keys. Retained fields
+ * are not decoded or reserialized, so their original spelling, values,
+ * percent-escape casing, order, and separators are preserved. An empty key
+ * list or no matches returns the input unchanged.
+ *
+ * @example
+ *
+ * ```js
+ * withoutQuery("/foo?bar=1&baz=2#hash"); // "/foo#hash"
+ * withoutQuery("/foo?bar=1&baz=2", "bar"); // "/foo?baz=2"
+ * ```
+ *
+ * @group utils
+ */
+export function withoutQuery(
+  input: string,
+  keys?: string | readonly string[],
+): string {
+  const hashIndex = input.indexOf("#");
+  const queryEnd = hashIndex === -1 ? input.length : hashIndex;
+  const queryIndex = input.indexOf("?");
+
+  if (queryIndex === -1 || queryIndex > queryEnd) {
+    return input;
+  }
+
+  if (keys === undefined) {
+    return input.slice(0, queryIndex) + input.slice(queryEnd);
+  }
+
+  const keysToRemove = new Set(typeof keys === "string" ? [keys] : keys);
+  if (keysToRemove.size === 0) {
+    return input;
+  }
+
+  const fields = input.slice(queryIndex + 1, queryEnd).split("&");
+  const retainedFields = fields.filter((field) => {
+    const equalsIndex = field.indexOf("=");
+    const rawKey = equalsIndex === -1 ? field : field.slice(0, equalsIndex);
+    return !keysToRemove.has(decodeQueryKey(rawKey));
+  });
+
+  if (retainedFields.length === fields.length) {
+    return input;
+  }
+
+  const query = retainedFields.join("&");
+  return (
+    input.slice(0, queryIndex) +
+    (query ? `?${query}` : "") +
+    input.slice(queryEnd)
+  );
+}
