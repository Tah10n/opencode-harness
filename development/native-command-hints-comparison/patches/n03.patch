@@ -0,0 +1,42 @@
+import EventEmitter from '../index';
+
+declare const symbolEvent: unique symbol;
+
+interface Events {
+  data: [string, number];
+  empty: [];
+  [symbolEvent]: [Date];
+}
+
+interface Context {
+  name: string;
+}
+
+const emitter = new EventEmitter<Events, Context>();
+const context: Context = { name: 'consumer' };
+const unsubscribe: EventEmitter.Unsubscribe = emitter.subscribe(
+  'data',
+  function (this: Context, value, count) {
+    const text: string = value;
+    const amount: number = count;
+    const receiver: Context = this;
+    void text;
+    void amount;
+    void receiver;
+  },
+  context
+);
+
+unsubscribe();
+emitter.emit('data', 'value', 1);
+emitter.subscribe('empty', function (this: Context) {
+  this.name;
+});
+emitter.subscribe(symbolEvent, date => date.toISOString());
+
+// @ts-expect-error Event arguments remain specific to the event name.
+emitter.emit('data', 1, 'wrong');
+// @ts-expect-error Unknown event names are rejected.
+emitter.subscribe('missing', () => {});
+// @ts-expect-error Context is checked independently from the listener.
+emitter.subscribe('data', () => {}, { name: 1 });
