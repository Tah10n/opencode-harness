+test('pruneExpired removes expired entries from both generations once and preserves live order', t => {
+	const evicted = [];
+	const lru = new QuickLRU({
+		maxSize: 3,
+		onEviction(key, value) {
+			evicted.push([key, value]);
+		},
+	});
+
+	lru.set('old-expired', 1, {maxAge: -1});
+	lru.set('old-live-1', 2);
+	lru.set('old-live-2', 3);
+	lru.set('current-expired', 4, {maxAge: -1});
+	lru.set('current-live', 5);
+
+	// Check the entries that pruneExpired will inspect without lazily removing them.
+	t.true(lru.__oldCache.has('old-expired'));
+	t.true(lru.__oldCache.get('old-expired').expiry <= Date.now());
+	t.true(lru.expiresIn('current-expired') <= 0);
+
+	t.is(lru.pruneExpired(), 2);
+	t.deepEqual(evicted, [['old-expired', 1], ['current-expired', 4]]);
+	t.deepEqual([...lru.entriesAscending()], [['old-live-1', 2], ['old-live-2', 3], ['current-live', 5]]);
+	t.is(lru.size, 3);
+	t.is(lru.pruneExpired(), 0);
+	t.deepEqual(evicted, [['old-expired', 1], ['current-expired', 4]]);
+});
+
+test('pruneExpired respects current entries that shadow old entries', t => {
+	const firstEvictions = [];
+	const first = new QuickLRU({
+		maxSize: 2,
+		onEviction(key, value) {
+			firstEvictions.push([key, value]);
+		},
+	});
+
+	first.set('shadowed', 'old', {maxAge: -1});
+	first.set('old-live', 1);
+	first.set('shadowed', 'current');
+
+	t.true(first.__oldCache.has('shadowed'));
+	t.true(first.__oldCache.get('shadowed').expiry <= Date.now());
+	t.is(first.pruneExpired(), 0);
+	t.deepEqual(firstEvictions, []);
+	t.is(first.get('shadowed'), 'current');
+	t.deepEqual([...first.entriesAscending()], [['old-live', 1], ['shadowed', 'current']]);
+
+	const secondEvictions = [];
+	const second = new QuickLRU({
+		maxSize: 2,
+		onEviction(key, value) {
+			secondEvictions.push([key, value]);
+		},
+	});
+
+	second.set('shadowed', 'old');
+	second.set('old-live', 1);
+	second.set('shadowed', 'current', {maxAge: -1});
+
+	t.true(second.__oldCache.has('shadowed'));
+	t.is(second.__oldCache.get('shadowed').expiry, undefined);
+	t.true(second.expiresIn('shadowed') <= 0);
+	t.is(second.pruneExpired(), 1);
+	t.deepEqual(secondEvictions, [['shadowed', 'current']]);
+	t.false(second.__oldCache.has('shadowed'));
+	t.false(second.has('shadowed'));
+});
+
+test('pruneExpired handles the expiry boundary, infinite TTL, undefined values, and reuse', t => {
+	const evicted = [];
+	const lru = new QuickLRU({
+		maxSize: 2,
+		onEviction(key, value) {
+			evicted.push([key, value]);
+		},
+	});
+
+	lru.set('boundary', undefined, {maxAge: 0});
+	lru.set('infinite', 'live', {maxAge: Number.POSITIVE_INFINITY});
+
+	t.true(lru.__oldCache.has('boundary'));
+	t.true(lru.expiresIn('boundary') <= 0);
+	t.is(lru.pruneExpired(), 1);
+	t.deepEqual(evicted, [['boundary', undefined]]);
+	t.true(lru.has('infinite'));
+	t.is(lru.get('infinite'), 'live');
+	t.is(lru.pruneExpired(), 0);
+
+	lru.delete('infinite');
+	t.is(lru.size, 0);
+	lru.set('reused', undefined);
+	t.is(lru.pruneExpired(), 0);
+	t.true(lru.has('reused'));
+	t.is(lru.get('reused'), undefined);
+});
