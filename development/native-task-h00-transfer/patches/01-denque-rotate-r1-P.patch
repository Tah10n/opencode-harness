+/**
+ * Rotate the queue by moving items from the back to the front.
+ * Negative steps move items from the front to the back.
+ * @param {number} steps
+ * @returns {Denque}
+ */
+Denque.prototype.rotate = function rotate(steps) {
+  if (steps === void 0) steps = 1;
+  if (typeof steps !== 'number' || !isFinite(steps) || Math.floor(steps) !== steps) {
+    throw new Error('steps must be a finite integer number');
+  }
+
+  var size = this.size();
+  if (size < 2) return this;
+
+  var rotation = steps % size;
+  if (rotation < 0) rotation += size;
+  if (rotation === 0) return this;
+
+  // Rebuild the logical sequence at the same capacity. This handles the
+  // unused gap in a wrapped buffer without changing any item identities.
+  var items = this._copyArray(false);
+  var capacity = this._list.length;
+  var list = new Array(capacity);
+  var source = size - rotation;
+  for (var i = 0; i < size; i++) {
+    list[i] = items[source];
+    source++;
+    if (source === size) source = 0;
+  }
+  this._list = list;
+  this._head = 0;
+  this._tail = size;
+  return this;
+};
