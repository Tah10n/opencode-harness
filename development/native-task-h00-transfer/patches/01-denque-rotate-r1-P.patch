+describe('Denque.prototype.rotate', function () {
+  it('should rotate in either direction and return the queue', function () {
+    var a = new Denque([1, 2, 3, 4]);
+
+    assert.strictEqual(a.rotate(), a);
+    assert.deepEqual(a.toArray(), [4, 1, 2, 3]);
+    assert.strictEqual(a.rotate(-1), a);
+    assert.deepEqual(a.toArray(), [1, 2, 3, 4]);
+    assert.strictEqual(a.rotate(0), a);
+    assert.deepEqual(a.toArray(), [1, 2, 3, 4]);
+    assert.strictEqual(a.rotate(6), a);
+    assert.deepEqual(a.toArray(), [3, 4, 1, 2]);
+    assert.strictEqual(a.rotate(-6), a);
+    assert.deepEqual(a.toArray(), [1, 2, 3, 4]);
+    assert.strictEqual(a.rotate(Number.MAX_SAFE_INTEGER), a);
+    assert.deepEqual(a.toArray(), [2, 3, 4, 1]);
+  });
+
+  it('should rotate wrapped, capacity-bound storage without changing capacity', function () {
+    var a = new Denque([], { capacity: 5 });
+    for (var i = 0; i < 10; i++) a.push(i);
+
+    assert.deepEqual(a.toArray(), [5, 6, 7, 8, 9]);
+    assert(a._head > a._tail);
+    var listLength = a._list.length;
+    var capacityMask = a._capacityMask;
+    var values = a.toArray();
+    assert.strictEqual(a.rotate(2), a);
+    assert.deepEqual(a.toArray(), [8, 9, 5, 6, 7]);
+    assert.strictEqual(a._list.length, listLength);
+    assert.strictEqual(a._capacityMask, capacityMask);
+    assert.strictEqual(a._capacity, 5);
+    for (i = 0; i < values.length; i++) {
+      assert.strictEqual(a.peekAt((i + 2) % values.length), values[i]);
+    }
+
+    a.push(10);
+    assert.deepEqual(a.toArray(), [9, 5, 6, 7, 10]);
+    a.unshift(8);
+    assert.deepEqual(a.toArray(), [8, 9, 5, 6, 7]);
+    assert.strictEqual(a.peek(), 8);
+    assert.strictEqual(a.peekBack(), 7);
+    assert.strictEqual(a.pop(), 7);
+    assert.strictEqual(a.shift(), 8);
+    assert.deepEqual(a.toArray(), [9, 5, 6]);
+    assert.strictEqual(a.removeOne(1), 5);
+    assert.deepEqual(a.remove(0, 1), [9]);
+    assert.strictEqual(a.shift(), 6);
+    assert(a.isEmpty());
+    assert.strictEqual(a._capacity, 5);
+  });
+
+  it('should reject invalid steps without changing state', function () {
+    var first = {};
+    var second = {};
+    var a = new Denque([first, second]);
+    var before = a.toArray();
+    var head = a._head;
+    var tail = a._tail;
+    var invalid = [NaN, Infinity, -Infinity, 1.5, '1', null, {}];
+
+    invalid.forEach(function (steps) {
+      assert.throws(function () { a.rotate(steps); }, Error);
+      assert.deepStrictEqual(a.toArray(), before);
+      assert.strictEqual(a._head, head);
+      assert.strictEqual(a._tail, tail);
+      assert.strictEqual(a.peekAt(0), first);
+      assert.strictEqual(a.peekAt(1), second);
+    });
+  });
+
+  it('should leave empty and singleton queues usable', function () {
+    var empty = new Denque();
+    var listLength = empty._list.length;
+    assert.strictEqual(empty.rotate(), empty);
+    assert.strictEqual(empty.rotate(-1000000), empty);
+    assert.strictEqual(empty.length, 0);
+    assert.strictEqual(empty._list.length, listLength);
+    empty.push(1);
+    assert.strictEqual(empty.shift(), 1);
+
+    var item = {};
+    var singleton = new Denque([item]);
+    assert.strictEqual(singleton.rotate(), singleton);
+    assert.strictEqual(singleton.rotate(-1), singleton);
+    assert.strictEqual(singleton.peek(), item);
+    assert.strictEqual(singleton.pop(), item);
+    singleton.unshift(item);
+    assert.strictEqual(singleton.shift(), item);
+  });
+});
