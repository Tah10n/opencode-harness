+test('runningTasks tracks active values and snapshots', function (t) {
+  t.plan(17)
+
+  var queue = buildQueue(worker, 2)
+  var finish = []
+  var snapshot = null
+  var preserved = null
+
+  queue.push(undefined, done('first'))
+  queue.unshift(undefined, done('second'))
+
+  t.deepEqual(queue.runningTasks(), [undefined, undefined], 'active tasks are in start order')
+  snapshot = queue.runningTasks()
+  preserved = queue.runningTasks()
+  snapshot.pop()
+  snapshot.push('changed')
+  t.deepEqual(queue.runningTasks(), [undefined, undefined], 'mutating a snapshot does not change the queue')
+
+  queue.push('queued', done('queued'))
+  t.deepEqual(queue.runningTasks(), [undefined, undefined], 'queued tasks are excluded')
+  t.deepEqual(queue.getQueue(), ['queued'], 'getQueue only contains queued tasks')
+
+  finish.shift()()
+  finish.shift()()
+  finish.shift()()
+
+  t.deepEqual(queue.runningTasks(), [], 'all completed tasks are absent')
+
+  queue.push('reused', done('reused'))
+  t.deepEqual(queue.runningTasks(), ['reused'], 'a pooled task can be started again')
+  t.deepEqual(preserved, [undefined, undefined], 'pool reuse does not corrupt prior snapshots')
+  finish.shift()()
+
+  function done (name) {
+    return function (err) {
+      t.error(err, name + ' completed without error')
+      if (name === 'first') {
+        t.deepEqual(queue.runningTasks(), [undefined], 'the first duplicate is removed before its callback')
+      } else if (name === 'second') {
+        t.deepEqual(queue.runningTasks(), ['queued'], 'the second duplicate is removed before its callback')
+      } else if (name === 'queued') {
+        t.deepEqual(queue.runningTasks(), [], 'the promoted task is removed before its callback')
+      } else {
+        t.deepEqual(queue.runningTasks(), [], 'the reused task is removed before its callback')
+      }
+    }
+  }
+
+  function worker (arg, cb) {
+    if (arg === 'queued') {
+      t.deepEqual(queue.runningTasks(), [undefined, 'queued'], 'promotion is reflected in start order')
+    } else if (arg === 'reused') {
+      t.deepEqual(queue.runningTasks(), ['reused'], 'pool reuse is reflected in the active snapshot')
+    }
+    finish.push(cb)
+  }
+})
+
+test('runningTasks follows pause, resume, and concurrency changes', function (t) {
+  t.plan(15)
+
+  var queue = buildQueue(worker, 1)
+  var finish = []
+
+  queue.pause()
+  queue.unshift('first', done('first'))
+  queue.push('second', done('second'))
+  queue.push('third', done('third'))
+
+  t.deepEqual(queue.runningTasks(), [], 'paused tasks are not running')
+  t.deepEqual(queue.getQueue(), ['first', 'second', 'third'], 'paused tasks remain queued')
+
+  queue.resume()
+  t.deepEqual(queue.runningTasks(), ['first'], 'resume starts the first queued task')
+
+  queue.concurrency = 2
+  t.deepEqual(queue.runningTasks(), ['first', 'second'], 'raising concurrency promotes a task')
+
+  queue.pause()
+  queue.concurrency = 3
+  t.deepEqual(queue.runningTasks(), ['first', 'second'], 'concurrency changes stay paused')
+
+  queue.resume()
+  t.deepEqual(queue.runningTasks(), ['first', 'second', 'third'], 'resume uses the changed concurrency')
+
+  finish[1]()
+  finish[0]()
+  finish[2]()
+
+  function done (name) {
+    return function (err) {
+      t.error(err, name + ' completed without error')
+      if (name === 'first') {
+        t.deepEqual(queue.runningTasks(), ['third'], 'first task is removed before its callback')
+      } else if (name === 'second') {
+        t.deepEqual(queue.runningTasks(), ['first', 'third'], 'second task is removed before its callback')
+      } else {
+        t.deepEqual(queue.runningTasks(), [], 'last task is removed before its callback')
+      }
+    }
+  }
+
+  function worker (arg, cb) {
+    t.deepEqual(queue.runningTasks(), ['first', 'second', 'third'].slice(0, finish.length + 1), arg + ' is active when started')
+    finish.push(cb)
+  }
+})
