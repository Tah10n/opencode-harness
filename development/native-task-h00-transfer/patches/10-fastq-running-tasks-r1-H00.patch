+test('runningTasks tracks promise fulfillment and rejection', async function (t) {
+  const queue = buildQueue(worker, 1)
+  let resolveFulfilled
+  let rejectRejected
+
+  const fulfilled = queue.push('fulfilled')
+  const rejected = queue.push('rejected')
+
+  t.deepEqual(queue.runningTasks(), ['fulfilled'], 'the active promise task is exposed')
+  t.deepEqual(queue.getQueue(), ['rejected'], 'the pending promise task remains queued')
+
+  resolveFulfilled('result')
+  t.deepEqual(queue.runningTasks(), ['fulfilled'], 'a promise remains active until settlement is processed')
+  t.equal(await fulfilled, 'result', 'the fulfillment is preserved')
+  t.deepEqual(queue.runningTasks(), ['rejected'], 'the promoted promise task is exposed')
+
+  rejectRejected(new Error('rejected'))
+  try {
+    await rejected
+    t.fail('the promise should reject')
+  } catch (err) {
+    t.equal(err.message, 'rejected', 'the rejection is preserved')
+  }
+  t.deepEqual(queue.runningTasks(), [], 'the rejected task is removed after settlement')
+
+  function worker (arg) {
+    if (arg === 'fulfilled') {
+      t.deepEqual(queue.runningTasks(), ['fulfilled'], 'the fulfillment worker is active when started')
+      return new Promise(function (resolve) {
+        resolveFulfilled = resolve
+      })
+    }
+
+    t.deepEqual(queue.runningTasks(), ['rejected'], 'the promoted rejection worker is active when started')
+    return new Promise(function (resolve, reject) {
+      rejectRejected = reject
+    })
+  }
+})
+
