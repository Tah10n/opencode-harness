+describe('Denque.prototype.removeWhere', function () {
+  it('should visit values in order with their original indexes', function () {
+    var seen = [];
+    var queue = new Denque([1, 2, 3, 4]);
+
+    assert.strictEqual(queue.removeWhere(function (value, index) {
+      seen.push([value, index]);
+      return value % 2 === 0;
+    }), 2);
+    assert.deepStrictEqual(seen, [[1, 0], [2, 1], [3, 2], [4, 3]]);
+    assert.deepStrictEqual(queue.toArray(), [1, 3]);
+
+    queue = new Denque([1, 2, 3]);
+    assert.strictEqual(queue.removeWhere(function () { return false; }), 0);
+    assert.deepStrictEqual(queue.toArray(), [1, 2, 3]);
+
+    assert.strictEqual(queue.removeWhere(function () { return true; }), 3);
+    assert.deepStrictEqual(queue.toArray(), []);
+  });
+
+  it('should leave the queue unchanged when the predicate throws', function () {
+    var original = [{ id: 1 }, { id: 2 }, { id: 3 }];
+    var queue = new Denque(original);
+    var error = new Error('stop');
+
+    assert.throws(function () {
+      queue.removeWhere(function (value, index) {
+        if (index === 1) throw error;
+        return value.id === 1;
+      });
+    }, function (thrown) {
+      return thrown === error;
+    });
+    assert.deepStrictEqual(queue.toArray(), original);
+    assert.strictEqual(queue.peekAt(0), original[0]);
+    assert.strictEqual(queue.peekAt(1), original[1]);
+    assert.strictEqual(queue.peekAt(2), original[2]);
+  });
+
+  it('should reject non-function predicates, including on an empty queue', function () {
+    assert.throws(function () {
+      new Denque().removeWhere(null);
+    }, Error);
+
+    assert.throws(function () {
+      new Denque([1]).removeWhere('not a function');
+    }, Error);
+  });
+
+  it('should filter wrapped capacity-limited queues without changing capacity', function () {
+    var first = { name: 'first' };
+    var last = { name: 'last' };
+    var queue = new Denque([0, false, '', null, 0], { capacity: 5 });
+    queue.shift();
+    queue.shift();
+    queue.push(false);
+    queue.push(first);
+    queue.push(last);
+
+    var capacity = queue._list.length;
+    var mask = queue._capacityMask;
+    assert(queue._head > queue._tail);
+    assert.strictEqual(queue.removeWhere(function (value) {
+      return !value;
+    }), 3);
+    assert.deepStrictEqual(queue.toArray(), [first, last]);
+    assert.strictEqual(queue.peekAt(0), first);
+    assert.strictEqual(queue.peekAt(1), last);
+    assert.strictEqual(queue._list.length, capacity);
+    assert.strictEqual(queue._capacityMask, mask);
+
+    queue.unshift(0);
+    queue.push('after');
+    assert.deepStrictEqual(queue.toArray(), [0, first, last, 'after']);
+    assert.strictEqual(queue.peekBack(), 'after');
+  });
+});
