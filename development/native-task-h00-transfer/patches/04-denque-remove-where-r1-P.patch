+/**
+ * Remove all items for which the predicate returns a truthy value.
+ * The predicate is called once for each item in logical front-to-back order
+ * before the queue is changed.
+ * @param {Function} predicate
+ * @returns {number}
+ */
+Denque.prototype.removeWhere = function removeWhere(predicate) {
+  if (typeof predicate !== 'function') {
+    throw new Error('predicate must be a function');
+  }
+
+  var size = this.size();
+  var items = this._copyArray(false);
+  var survivors = new Array(size);
+  var survivorCount = 0;
+  var i;
+
+  for (i = 0; i < size; i++) {
+    if (!predicate(items[i], i)) survivors[survivorCount++] = items[i];
+  }
+
+  var removedCount = size - survivorCount;
+  if (removedCount === 0) return 0;
+
+  for (i = 0; i < size; i++) {
+    this._list[(this._head + i) & this._capacityMask] = void 0;
+  }
+  for (i = 0; i < survivorCount; i++) {
+    this._list[(this._head + i) & this._capacityMask] = survivors[i];
+  }
+  this._tail = (this._head + survivorCount) & this._capacityMask;
+
+  return removedCount;
+};
