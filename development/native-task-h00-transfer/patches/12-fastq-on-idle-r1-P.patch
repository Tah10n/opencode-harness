+test('onIdle waits for active and paused queued tasks', function (t) {
+  t.plan(7)
+
+  var queue = buildQueue(worker, 2)
+  var finish = []
+  var resolved = 0
+
+  queue.push(1)
+  queue.push(2)
+  queue.push(3)
+  queue.pause()
+
+  var first = queue.onIdle().then(function () {
+    resolved++
+  })
+  var second = queue.onIdle().then(function () {
+    resolved++
+  })
+
+  t.notOk(queue.idle(), 'active and queued work is not idle')
+
+  finish.shift()()
+  t.equal(resolved, 0, 'first subscriber stays pending')
+  finish.shift()()
+  t.equal(resolved, 0, 'subscribers stay pending while paused work remains')
+  t.equal(queue.length(), 1, 'paused work remains queued')
+
+  queue.resume()
+  t.notOk(queue.idle(), 'resumed work is not idle')
+  finish.shift()()
+
+  Promise.all([first, second]).then(function () {
+    t.equal(resolved, 2, 'both subscribers resolve')
+    t.ok(queue.idle(), 'queue is idle')
+  })
+
+  function worker (arg, cb) {
+    finish.push(function () {
+      cb(null, arg)
+    })
+  }
+})
+
+test('onIdle preserves drain and waits for reentrant work', function (t) {
+  t.plan(6)
+
+  var queue = buildQueue(worker, 1)
+  var finish = []
+  var drainCalls = 0
+  var resolved = false
+
+  function drain () {
+    drainCalls++
+    if (drainCalls === 1) queue.push(2)
+  }
+
+  queue.drain = drain
+  queue.push(1)
+  var waiting = queue.onIdle().then(function () {
+    resolved = true
+  })
+
+  t.equal(queue.drain, drain, 'onIdle preserves drain identity')
+  finish.shift()()
+  t.equal(drainCalls, 1, 'drain was called once')
+  t.notOk(resolved, 'subscriber waits for reentrant work')
+  t.equal(queue.running(), 1, 'reentrant work is running')
+
+  finish.shift()()
+  waiting.then(function () {
+    t.equal(drainCalls, 2, 'drain was called for reentrant work')
+    t.ok(queue.idle(), 'queue is idle after drain returns')
+  })
+
+  function worker (arg, cb) {
+    finish.push(function () {
+      cb(null, arg)
+    })
+  }
+})
+
+test('onIdle resolves after kill, killAndDrain and abort', function (t) {
+  t.plan(8)
+
+  var queue = buildQueue(worker, 1)
+  var finish = []
+  var settled = false
+
+  queue.push('running')
+  queue.push('killed')
+  var afterKill = queue.onIdle().then(function () {
+    settled = true
+  })
+  queue.kill()
+  t.equal(queue.length(), 0, 'kill removes queued work')
+  t.notOk(settled, 'kill waits for running work')
+  finish.shift()()
+
+  afterKill.then(function () {
+    t.ok(queue.idle(), 'kill eventually reaches idle')
+
+    queue.pause()
+    queue.push('drained')
+    var afterKillAndDrain = queue.onIdle()
+    var drainCalled = false
+    queue.drain = function () {
+      drainCalled = true
+    }
+    queue.killAndDrain()
+    t.equal(queue.length(), 0, 'killAndDrain removes queued work')
+    t.ok(drainCalled, 'killAndDrain calls drain')
+
+    // Start work before the deferred idle check runs.
+    queue.resume()
+    queue.push('running again')
+    queue.push('aborted')
+    var afterAbort = queue.onIdle()
+    queue.abort()
+    t.equal(queue.length(), 0, 'abort removes queued work')
+    t.notOk(queue.idle(), 'abort waits for running work')
+    setImmediate(function () {
+      finish.shift()()
+    })
+    Promise.all([afterKillAndDrain, afterAbort]).then(function () {
+      t.ok(queue.idle(), 'abort eventually reaches idle')
+    })
+  })
+
+  function worker (arg, cb) {
+    finish.push(function () {
+      cb(null, arg)
+    })
+  }
+})
