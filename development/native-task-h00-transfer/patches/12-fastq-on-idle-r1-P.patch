+test('onIdle supports multiple subscribers with paused queued work', async function (t) {
+  const queue = buildQueue(worker, 2)
+  const finish = []
+
+  queue.pause()
+  const work = [queue.push(1), queue.push(2), queue.push(3)]
+  const first = queue.onIdle()
+  const second = queue.onIdle()
+
+  t.notOk(queue.idle(), 'paused queued work is not idle')
+  queue.resume()
+  await immediate()
+  t.equal(queue.running(), 2, 'two workers are running')
+  t.equal(queue.length(), 1, 'one task is waiting')
+
+  finish.shift()()
+  finish.shift()()
+  await immediate()
+  t.equal(queue.running(), 1, 'the remaining task is running')
+
+  finish.shift()()
+  await Promise.all(work)
+  await Promise.all([first, second])
+  t.ok(queue.idle(), 'all subscribers resolve at idle')
+
+  function worker (arg) {
+    return new Promise(function (resolve) {
+      finish.push(function () {
+        resolve(arg)
+      })
+    })
+  }
+})
+
+test('onIdle resolves after rejected promise work', async function (t) {
+  const queue = buildQueue(worker, 1)
+  const work = queue.push(1)
+  const waiting = queue.onIdle()
+
+  await waiting
+  t.ok(queue.idle(), 'rejected work reaches idle')
+
+  try {
+    await work
+    t.fail('work should reject')
+  } catch (err) {
+    t.equal(err.message, 'failed', 'rejection is preserved')
+  }
+
+  async function worker () {
+    throw new Error('failed')
+  }
+})
