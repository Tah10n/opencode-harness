+import EventEmitter from '..';
+
+declare const symbolEvent: unique symbol;
+
+interface Events {
+  data: [value: string, count: number];
+  [symbolEvent]: [enabled: boolean];
+}
+
+interface Context {
+  name: string;
+}
+
+const emitter = new EventEmitter<Events, Context>();
+const context: Context = { name: 'test' };
+const sameEmitter: typeof emitter = emitter
+  .prependListener('data', function (value, count) {
+    value.toUpperCase();
+    count.toFixed();
+  }, context)
+  .prependOnceListener(symbolEvent, function (enabled) {
+    enabled.valueOf();
+  }, context);
+
+sameEmitter.emit('data', 'value', 1);
+
+// @ts-expect-error The event listener must use the event-specific arguments.
+emitter.prependListener('data', (value: number, count: number) => {});
