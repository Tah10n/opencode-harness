+  describe('EventEmitter#prependListener', function () {
+    it('prepends listeners and preserves context and arguments', function () {
+      var e = new EventEmitter()
+        , calls = []
+        , first = { name: 'first' }
+        , second = { name: 'second' }
+        , third = { name: 'third' }
+        , fourth = { name: 'fourth' };
+
+      function record(name) {
+        return function (one, two) {
+          calls.push(name + ':' + this.name + ':' + one + ':' + two);
+        };
+      }
+
+      e.on('event', record('append'), fourth);
+      e.once('event', record('once'), third);
+      e.prependListener('event', record('prepend'), first);
+      e.prependOnceListener('event', record('prepend-once'), second);
+      e.prependListener('event', record('newest-prepend'), first);
+
+      assume(e.emit('event', 'one', 'two')).equals(true);
+      assume(calls).deep.equals([
+        'newest-prepend:first:one:two',
+        'prepend-once:second:one:two',
+        'prepend:first:one:two',
+        'append:fourth:one:two',
+        'once:third:one:two'
+      ]);
+      assume(e.listeners('event').length).equals(3);
+    });
+
+    it('removes a prepended once listener before recursive emits', function () {
+      var e = new EventEmitter()
+        , calls = [];
+
+      function prependOnce() {
+        calls.push('once');
+        e.emit('event');
+      }
+
+      function prepend() {
+        calls.push('prepend');
+      }
+
+      function append() {
+        calls.push('append');
+      }
+
+      e.prependListener('event', prepend);
+      e.prependOnceListener('event', prependOnce);
+      e.on('event', append);
+
+      e.emit('event');
