+ES modules can use the default or named export:
+
+```js
+import EventEmitter, { EventEmitter as NamedEventEmitter } from 'eventemitter3';
+
+var EE = new EventEmitter();
+var NamedEE = new NamedEventEmitter();
+```
+
+### Prepending listeners
+
+`prependListener` and `prependOnceListener` register listeners before all
+listeners already registered for the event. Each subsequent prepend is placed
+before the previous prepends. Both methods accept the optional custom context
+and return the emitter.
+
+```js
+EE.on('event-name', function () {
+  console.log('last');
+});
+EE.prependListener('event-name', function () {
+  console.log('first');
+});
+EE.prependOnceListener('event-name', function () {
+  console.log('first, once');
+});
+```
+
