+      e.on(symbol, listener, first);
+      e.once(event, listener, second);
+      e.on(symbol, listener, second);
+
+      assume(e.removeListenersByContext(first)).equals(4);
+      assume(e.listeners(event)).eql([listener]);
+      assume(e.listeners(symbol)).eql([listener]);
+      assume(e.listenerCount(event)).equals(1);
+      assume(e.listenerCount(symbol)).equals(1);
+    });
+
+    it('removes empty event names, preserves survivors, and supports reuse', function () {
+      var e = new EventEmitter()
+        , symbol = Symbol('bar')
+        , emptySymbol = Symbol('empty')
