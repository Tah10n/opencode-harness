+/**
+ * Rotate the queue in place.
+ * Positive steps move items from the back to the front; negative steps move
+ * items from the front to the back.
+ * @param {number} steps
+ * @returns {Denque}
+ */
+Denque.prototype.rotate = function rotate(steps) {
+  if (steps === undefined) steps = 1;
+  if (typeof steps !== 'number' || !isFinite(steps) || steps % 1 !== 0) {
+    throw new Error('steps must be a finite integer');
+  }
+
+  var size = this.size();
+  if (size < 2) return this;
+
+  var offset = steps % size;
+  if (offset < 0) offset += size;
+  if (offset === 0) return this;
+
+  var rotated = new Array(size);
+  var i;
+  var source;
+  for (i = 0; i < size; i++) {
+    source = i - offset;
+    if (source < 0) source += size;
+    rotated[i] = this._list[(this._head + source) & this._capacityMask];
+  }
+  for (i = 0; i < size; i++) {
+    this._list[(this._head + i) & this._capacityMask] = rotated[i];
+  }
+  return this;
+};
