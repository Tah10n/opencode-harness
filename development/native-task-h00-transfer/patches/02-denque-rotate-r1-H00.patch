+describe('Denque.prototype.rotate', function () {
+  it('should rotate in either direction, normalize counts, and return this', function () {
+    var a = new Denque([1, 2, 3, 4]);
+
+    assert.strictEqual(a.rotate(), a);
+    assert.deepEqual(a.toArray(), [4, 1, 2, 3]);
+    assert.strictEqual(a.rotate(0), a);
+    assert.deepEqual(a.toArray(), [4, 1, 2, 3]);
+    assert.strictEqual(a.rotate(6), a);
+    assert.deepEqual(a.toArray(), [2, 3, 4, 1]);
+    assert.strictEqual(a.rotate(-2), a);
+    assert.deepEqual(a.toArray(), [4, 1, 2, 3]);
+
+    var b = new Denque([1, 2, 3, 4]);
+    assert.strictEqual(b.rotate(-1), b);
+    assert.deepEqual(b.toArray(), [2, 3, 4, 1]);
+    assert.strictEqual(b.rotate(5), b);
+    assert.deepEqual(b.toArray(), [1, 2, 3, 4]);
+  });
+
+  it('should rotate wrapped capacity-bound storage without dropping values', function () {
+    var first = {};
+    var second = {};
+    var third = {};
+    var fourth = {};
+    var fifth = {};
+    var a = new Denque([first, second, third], { capacity: 3 });
+
+    assert.strictEqual(a.shift(), first);
+    assert.strictEqual(a.push(fourth), 3);
+    assert.deepEqual(a.toArray(), [second, third, fourth]);
+    var list = a._list;
+    var capacity = a._capacity;
+    assert.strictEqual(a.rotate(1), a);
+    assert.deepEqual(a.toArray(), [fourth, second, third]);
+    assert.strictEqual(a._list, list);
+    assert.strictEqual(a._capacity, capacity);
+    assert.strictEqual(a.peek(), fourth);
+    assert.strictEqual(a.peekFront(), fourth);
+    assert.strictEqual(a.peekAt(1), second);
+    assert.strictEqual(a.peekBack(), third);
+
+    assert.strictEqual(a.shift(), fourth);
+    assert.strictEqual(a.pop(), third);
+    assert.strictEqual(a.push(fifth), 2);
+    assert.strictEqual(a.unshift(first), 3);
+    assert.deepEqual(a.toArray(), [first, second, fifth]);
+    assert.strictEqual(a.shift(), first);
+    assert.strictEqual(a.pop(), fifth);
+    assert.deepEqual(a.toArray(), [second]);
+    assert.deepEqual(a.remove(0, 1), [second]);
+    assert(a.isEmpty());
+  });
+
+  it('should reject invalid counts atomically', function () {
+    var value = {};
+    var a = new Denque([value, 2, 3]);
+    var list = a._list;
+    var invalid = [1.5, NaN, Infinity, -Infinity, '1', null, {}];
+
+    invalid.forEach(function (steps) {
+      assert.deepEqual(a.toArray(), [value, 2, 3]);
+      assert.throws(function () {
+        a.rotate(steps);
+      }, Error);
+      assert.deepEqual(a.toArray(), [value, 2, 3]);
+      assert.strictEqual(a._list, list);
+    });
+
+    assert.strictEqual(a.rotate(Number.MAX_VALUE), a);
+    assert.deepEqual(a.toArray(), [2, 3, value]);
+    assert.strictEqual(a.peekAt(2), value);
+    assert.strictEqual(a.length, 3);
+  });
+
+  it('should leave empty and singleton queues usable', function () {
+    var empty = new Denque();
+    var emptyList = empty._list;
+    assert.strictEqual(empty.rotate(1000000000), empty);
+    assert.strictEqual(empty._list, emptyList);
+    assert.strictEqual(empty.push(1), 1);
+    assert.strictEqual(empty.shift(), 1);
+
+    var value = {};
+    var single = new Denque([value]);
+    assert.strictEqual(single.rotate(-1000000000), single);
+    assert.strictEqual(single.peek(), value);
+    assert.strictEqual(single.pop(), value);
+    assert.strictEqual(single.unshift(value), 1);
+    assert.strictEqual(single.peekBack(), value);
+  });
+});
