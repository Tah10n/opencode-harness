+test('.getOrInsertComputed() returns hits without calling the factory and refreshes old entries', t => {
+	const lru = new QuickLRU({maxSize: 3});
+	const calls = [];
+	lru.set('undefined', undefined);
+	lru.set('oldest', 'oldest');
+	lru.set('middle', 'middle');
+
+	t.is(lru.getOrInsertComputed('undefined', key => {
+		calls.push(key);
+		return 'computed';
+	}), undefined);
+
+	lru.set('new', 'new');
+	lru.evict(1);
+	t.deepEqual(calls, []);
+	t.false(lru.has('oldest'));
+	t.true(lru.has('undefined'));
+});
+
+test('.getOrInsertComputed() computes expired entries once and uses the default maxAge', async t => {
+	const evictions = [];
+	let factoryCalls = 0;
+	const lru = new QuickLRU({
+		maxSize: 10,
+		maxAge: 100,
+		onEviction(key, value) {
+			evictions.push([key, value]);
+		},
+	});
+
+	lru.set('key', 'expired');
+	await delay(150);
+
+	t.is(lru.getOrInsertComputed('key', key => {
+		factoryCalls++;
+		return `${key}-computed`;
+	}), 'key-computed');
+	t.is(factoryCalls, 1);
+	t.deepEqual(evictions, [['key', 'expired']]);
+	t.true(lru.expiresIn('key') > 0);
+	t.true(lru.expiresIn('key') <= 100);
+});
+
+test('.getOrInsertComputed() propagates factory errors and supports object keys and independent caches', t => {
+	const key = {};
+	const error = new Error('factory failed');
+	const first = new QuickLRU({maxSize: 10});
+	const second = new QuickLRU({maxSize: 10});
+	let firstCalls = 0;
+	let secondCalls = 0;
+
+	t.throws(() => first.getOrInsertComputed(key, () => {
+		firstCalls++;
+		throw error;
+	}), {is: error});
+	t.false(first.has(key));
+	t.is(firstCalls, 1);
+
+	const value = first.getOrInsertComputed(key, receivedKey => {
+		firstCalls++;
+		t.is(receivedKey, key);
+		return 'first';
+	});
+	t.is(value, 'first');
+	t.is(first.getOrInsertComputed(key, () => {
+		firstCalls++;
+		return 'unexpected';
+	}), 'first');
+
+	t.is(second.getOrInsertComputed(key, () => {
+		secondCalls++;
+		return 'second';
+	}), 'second');
+	t.is(firstCalls, 2);
+	t.is(secondCalls, 1);
+});
+
