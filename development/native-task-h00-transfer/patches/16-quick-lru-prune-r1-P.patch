+test.serial('pruneExpired() prunes visible expired entries from both generations', t => {
+	let now = 1000;
+	const originalDateNow = Date.now;
+	Date.now = () => now;
+
+	try {
+		const evicted = [];
+		const lru = new QuickLRU({
+			maxSize: 4,
+			onEviction(key, value) {
+				evicted.push([key, value]);
+			},
+		});
+
+		lru.set('old-expired', 'old expired', {maxAge: 10});
+		lru.set('shadowed', 'old shadowed', {maxAge: 10});
+		lru.set('old-live', 'old live');
+		lru.set('old-other', 'old other');
+		lru.set('shadowed', 'current live');
+		lru.set('current-expired', 'current expired', {maxAge: 10});
+		lru.set('current-live', 'current live');
+
+		now = 1010;
+		t.is(lru.pruneExpired(), 2);
+		t.deepEqual(evicted, [['current-expired', 'current expired'], ['old-expired', 'old expired']]);
+		t.deepEqual([...lru.entriesAscending()], [['old-live', 'old live'], ['old-other', 'old other'], ['shadowed', 'current live'], ['current-live', 'current live']]);
+		t.is(lru.pruneExpired(), 0);
+	} finally {
+		Date.now = originalDateNow;
+	}
+});
+
