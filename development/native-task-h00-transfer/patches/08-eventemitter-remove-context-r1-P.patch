+
+      e.on('first', first, target);
+      e.on('first', second, other);
+      e.once('second', third, target);
+      e.on(event, first, target);
+      e.on('third', third, other);
+
+      assume(e.removeListenersByContext(target)).equals(3);
+      assume(e.eventNames()).eql(['first', 'third']);
+      assume(e.listeners('first')).eql([second]);
+      assume(e.listeners('third')).eql([third]);
+      assume(e.listenerCount('second')).equals(0);
+      assume(e.listenerCount(event)).equals(0);
+      assume(e._eventsCount).equals(2);
+      assume(e.removeListenersByContext(target)).equals(0);
+
+      e.on('reused', first, target);
+      assume(e.removeListenersByContext(target)).equals(1);
+      assume(e.eventNames()).eql(['first', 'third']);
+      assume(e._eventsCount).equals(2);
+    });
+
