+      e.on('false', listener, false);
+      e.once('zero', listener, 0);
+      e.on('empty', listener, '');
+      e.on('explicit', listener, e);
+
+      assume(e.removeListenersByContext(e)).equals(7);
+      assume(e.eventNames()).eql([]);
+      assume(e.removeListenersByContext(e)).equals(0);
+    });
