+  describe('EventEmitter#removeListenersByContext', function () {
+    it('distinguishes contexts for duplicate and once listeners across events', function () {
+      var e = new EventEmitter()
+        , event = Symbol('event')
+        , first = {}
+        , second = {};
+
+      function shared() {}
+
+      e.on('foo', shared, first);
+      e.once('foo', shared, first);
+      e.on('foo', shared, second);
+      e.once(event, shared, first);
+      e.on(event, shared, second);
+      e.once(event, shared, second);
+
+      assume(e.removeListenersByContext({})).equals(0);
+      assume(e.removeListenersByContext(first)).equals(3);
+      assume(e.listeners('foo')).eql([shared]);
+      assume(e.listeners(event)).eql([shared, shared]);
+      assume(e.listenerCount('foo')).equals(1);
+      assume(e.listenerCount(event)).equals(2);
+      assume(e.removeListenersByContext(second)).equals(3);
+      assume(e.eventNames()).eql([]);
+
+      e.on('reused', shared, first);
+      assume(e.emit('reused')).equals(true);
+      assume(e.removeListenersByContext(first)).equals(1);
+    });
+
+    it('removes matching events while preserving unrelated listeners and order', function () {
+      var e = new EventEmitter()
