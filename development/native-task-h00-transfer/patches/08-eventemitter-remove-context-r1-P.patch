+/**
+ * Remove all listeners with the given context.
+ *
+ * @param {*} context The context to match.
+ * @returns {Number} The number of listeners removed.
+ * @public
+ */
+EventEmitter.prototype.removeListenersByContext = function removeListenersByContext(context) {
+  var events = this._events
+    , count = 0
+    , names = []
+    , name
+    , listeners
+    , remaining
+    , i
+    , length
+    , j
+    , l
+    , symbols;
+
+  if (this._eventsCount === 0) return count;
+
+  for (name in events) {
+    if (has.call(events, name)) names.push(name);
+  }
+
+  if (Object.getOwnPropertySymbols) {
+    symbols = Object.getOwnPropertySymbols(events);
+    names = names.concat(symbols);
+  }
+
+  for (i = 0, length = names.length; i < length; i++) {
+    name = names[i];
+    listeners = events[name];
+
+    if (listeners.fn) {
+      if (listeners.context === context) {
+        count++;
+        clearEvent(this, name);
+      }
+
+      continue;
+    }
+
+    remaining = [];
+    for (j = 0, l = listeners.length; j < l; j++) {
+      if (listeners[j].context === context) count++;
+      else remaining.push(listeners[j]);
+    }
+
+    if (remaining.length) events[name] = remaining.length === 1 ? remaining[0] : remaining;
+    else clearEvent(this, name);
+  }
+
+  return count;
+};
+
