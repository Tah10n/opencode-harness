+test('onIdle with active and queued work', function (t) {
+  t.plan(11)
+
+  var queue = buildQueue(worker, 2)
+  var finish = []
+  var settled = 0
+
+  queue.push(1, done)
+  queue.push(2, done)
+  queue.push(3, done)
+
+  t.equal(queue.running(), 2, 'two tasks are running')
+  t.equal(queue.length(), 1, 'one task is queued')
+  t.notOk(queue.idle(), 'queue is not idle')
+
+  var waiting = Promise.all([
+    queue.onIdle().then(function () { settled++ }),
+    queue.onIdle().then(function () { settled++ })
+  ])
+
+  t.equal(settled, 0, 'subscribers are pending')
+  finish.shift()()
+  t.equal(settled, 0, 'subscribers wait for queued work')
+  finish.shift()()
+  t.equal(settled, 0, 'subscribers wait for the replacement worker')
+  finish.shift()()
+
+  function done (err) {
+    t.error(err, 'task completed without an error')
+  }
+
+  waiting.then(function () {
+    t.equal(settled, 2, 'all subscribers resolve')
+    t.ok(queue.idle(), 'queue is idle')
+  })
+
+  function worker (arg, cb) {
+    finish.push(function () {
+      cb(null, arg)
+    })
+  }
+})
