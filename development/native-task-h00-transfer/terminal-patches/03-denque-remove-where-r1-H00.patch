+/**
+ * Remove every item for which predicate returns a truthy value.
+ * @param predicate
+ * @returns {number}
+ */
+Denque.prototype.removeWhere = function removeWhere(predicate) {
+  if (typeof predicate !== 'function') {
+    throw new Error('predicate must be a function');
+  }
+
+  var size = this.size();
+  var matches = new Array(size);
+  var i;
+  var removed = 0;
+
+  for (i = 0; i < size; i++) {
+    matches[i] = predicate(this._list[(this._head + i) & this._capacityMask], i);
+  }
+
+  for (i = 0; i < size; i++) {
+    if (matches[i]) removed++;
+  }
+  if (removed === 0) return 0;
+
+  var kept = 0;
+  var head = this._head;
+  for (i = 0; i < size; i++) {
+    if (!matches[i]) {
+      this._list[(head + kept) & this._capacityMask] =
+        this._list[(head + i) & this._capacityMask];
+      kept++;
+    }
+  }
+  for (i = kept; i < size; i++) {
+    this._list[(head + i) & this._capacityMask] = void 0;
+  }
+  this._tail = (head + kept) & this._capacityMask;
+
+  return removed;
+};
