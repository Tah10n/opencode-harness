+describe('Denque.prototype.removeWhere', function () {
+  it('should visit original values and indexes and retain matching survivors in order', function () {
+    var mixed = new Denque([1, 2, 3, 4]);
+    var visited = [];
+    assert.strictEqual(mixed.removeWhere(function (value, index) {
+      visited.push([value, index]);
+      return value % 2 === 0;
+    }), 2);
+    assert.deepEqual(visited, [[1, 0], [2, 1], [3, 2], [4, 3]]);
+    assert.deepEqual(mixed.toArray(), [1, 3]);
+
+    var none = new Denque([1, 2, 3]);
+    assert.strictEqual(none.removeWhere(function () { return false; }), 0);
+    assert.deepEqual(none.toArray(), [1, 2, 3]);
+
+    var all = new Denque([1, 2, 3]);
+    assert.strictEqual(all.removeWhere(function () { return true; }), 3);
+    assert.deepEqual(all.toArray(), []);
+  });
+
+  it('should leave the queue unchanged when the predicate throws and reject non-functions on empty queues', function () {
+    var queue = new Denque([1, 2, 3, 4]);
+    var before = queue.toArray();
+    var error = new Error('stop');
+
+    assert.deepEqual(queue.toArray(), before);
+    assert.throws(function () {
+      queue.removeWhere(function (value, index) {
+        if (index === 0) return true;
+        throw error;
+      });
+    }, function (thrown) {
+      return thrown === error;
+    });
+    assert.deepEqual(queue.toArray(), before);
+
+    var empty = new Denque();
+    assert.throws(function () { empty.removeWhere(null); }, Error);
+    assert(empty.isEmpty());
+  });
+
+  it('should preserve capacity, identity, and usability for wrapped queues with duplicates and falsy values', function () {
+    var marker = { value: 'keep' };
+    var queue = new Denque([], { capacity: 5 });
+    queue.push(0);
+    queue.push(false);
+    queue.push('');
+    queue.push(null);
+    queue.push(0);
+    queue.shift();
+    queue.shift();
+    queue.push(false);
+    queue.push(0);
+    queue.push(marker);
+
+    var before = queue.toArray();
+    var listLength = queue._list.length;
+    var capacityMask = queue._capacityMask;
+    assert.deepEqual(before, [null, 0, false, 0, marker]);
+    assert(queue._head > queue._tail);
+
+    assert.strictEqual(queue.removeWhere(function (value) {
+      return value === null || value === 0 || value === false || value === '';
+    }), 4);
+    assert.deepEqual(queue.toArray(), [marker]);
+    assert.strictEqual(queue.peekFront(), marker);
+    assert.strictEqual(queue._list.length, listLength);
+    assert.strictEqual(queue._capacityMask, capacityMask);
+
+    queue.unshift(false);
+    queue.push(0);
+    assert.deepEqual(queue.toArray(), [false, marker, 0]);
+  });
+});
