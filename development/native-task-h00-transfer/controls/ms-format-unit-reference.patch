+// @ts-nocheck -- invalid runtime inputs are intentional; public types are tested separately.
+import * as A from "node:assert/strict";
+import {test} from "@jest/globals";
+import * as api from "./index";
+test("new public contract", async () => {
+
+const units={ms:1,s:1000,m:60000,h:3600000,d:86400000,w:604800000,mo:31557600000/12,y:31557600000};for(const [unit,size]of Object.entries(units)){A.equal(api.format(size*2,{unit}),unit==='ms'?'2ms':'2'+unit);A.equal(api.ms(size*2,{unit}),api.format(size*2,{unit}));}A.equal(api.format(3600000,{unit:'m'}),'60m');A.equal(api.format(1000,{unit:'h'}),'0h');A.equal(api.format(-1500,{unit:'s'}),'-1s');A.equal(api.format(1499,{unit:'s',long:true}),'1 second');A.equal(api.format(1500,{unit:'s',long:true}),'2 seconds');A.equal(api.format(-1500,{unit:'s',long:true}),'-1 seconds');A.equal(api.format(1.25,{unit:'ms'}),'1.25ms');A.equal(api.format(1.25,{unit:'ms',long:true}),'1.25 ms');A.equal(api.format(0,{unit:'y',long:true}),'0 year');for(const unit of ['bad',null,1])A.throws(()=>api.format(1,{unit}));A.equal(api.ms('1h',{unit:'bad'}),3600000);A.equal(api.format(3600000),'1h');A.equal(api.parseStrict('1h'),3600000);
+
+});
