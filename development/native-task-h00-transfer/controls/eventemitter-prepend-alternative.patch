index 6ea485c..b84c3c9 100644
--- a/index.js
+++ b/index.js
@@ -334,3 +334,17 @@ EventEmitter.EventEmitter = EventEmitter;
 if ('undefined' !== typeof module) {
   module.exports = EventEmitter;
 }
+
+EventEmitter.prototype.prependListener = function (event, fn, context) {
+  addListener(this, event, fn, context, false);
+  var evt = prefix ? prefix + event : event, list = this._events[evt];
+  if (!list.fn) list.unshift(list.pop());
+  return this;
+};
+
+EventEmitter.prototype.prependOnceListener = function (event, fn, context) {
+  addListener(this, event, fn, context, true);
+  var evt = prefix ? prefix + event : event, list = this._events[evt];
+  if (!list.fn) list.unshift(list.pop());
+  return this;
+};
