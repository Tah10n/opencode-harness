+
+EventEmitter.prototype.removeListenersByContext = function (context) {
+  var names = this.eventNames(), removed = 0;
+  for (var n = 0; n < names.length; n++) {
+    var evt = prefix ? prefix + names[n] : names[n], entry = this._events[evt];
+    var listeners = entry.fn ? [entry] : entry;
+    for (var i = 0; i < listeners.length; i++) {
+      if (listeners[i].context === context) { removed++; this.removeListener(names[n], listeners[i].fn, context, listeners[i].once); }
+    }
+  }
+  return removed;
+};
