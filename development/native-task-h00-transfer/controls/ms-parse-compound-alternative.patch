+
+/** Parse duration terms by consuming the input left-to-right. */
+export function parseCompound(str: string): number {
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) throw new Error('Invalid duration input');
+  const negative = str.startsWith('-');
+  let rest = negative ? str.slice(1) : str;
+  let sum = 0;
+  while (rest.length > 0) {
+    const term = /^\d*\.?\d+ *[a-z]+/i.exec(rest);
+    if (!term) return NaN;
+    const value = parse(term[0]);
+    if (Number.isNaN(value)) return NaN;
+    sum += value;
+    rest = rest.slice(term[0].length);
+    if (!rest) return negative ? -sum : sum;
+    const gap = /^ +/.exec(rest);
+    if (!gap) return NaN;
+    rest = rest.slice(gap[0].length);
+    if (!rest) return NaN;
+  }
+  return NaN;
+}
