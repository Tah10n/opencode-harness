+## ufo-query-sort
+
+The API provides an optional {sort?: boolean} options argument to stringifyQuery and a third options argument to withQuery. With sort:true, serialize query keys in ascending JavaScript string order; preserve the order of repeated array values. Without it or with false, retain existing key enumeration and all current encoding/filtering behavior. withQuery must apply sorting after merging existing URL query with the supplied object, while preserving path, protocol/host and fragment. Do not mutate the caller's object or arrays. Export the public options type and thread it through public exports and generated declarations. Cover ordinary values including zero/false/empty/null/undefined and escaped/unicode keys. Preserve parsing pollution defenses.
diff --git a/src/query.ts b/src/query.ts
index 6fbcaaa..39bd9fc 100644
--- a/src/query.ts
+++ b/src/query.ts
@@ -129,8 +129,21 @@ export function encodeQueryItem(
  *
  * @group Query_utils
  */
-export function stringifyQuery(query: QueryObject): string {
-  return Object.keys(query)
+export interface StringifyQueryOptions {
+  sort?: boolean;
+}
+
+export function stringifyQuery(
+  query: QueryObject,
+  options: StringifyQueryOptions = {},
+): string {
+  const keys = Object.keys(query);
+  if (options.sort)
+    keys.sort((a, b) => {
+      if (a === b) return 0;
+      return a < b ? -1 : 1;
+    });
+  return keys
     .filter((k) => query[k] !== undefined)
     .map((k) => encodeQueryItem(k, query[k]))
     .filter(Boolean)
