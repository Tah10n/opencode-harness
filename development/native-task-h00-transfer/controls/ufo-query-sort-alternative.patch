new file mode 100644
index 0000000..603f469
--- /dev/null
+++ b/test/h00-contract.test.ts
@@ -0,0 +1,27 @@
+// @ts-nocheck -- invalid runtime inputs are intentional; public types are tested separately.
+import * as A from "node:assert/strict";
+import { test } from "vitest";
+import * as api from "../src";
+test("new public contract", async () => {
+  const q = { z: [2, 1], a: 0, b: false, c: "", d: null, e: undefined };
+  const before = JSON.stringify(q);
+  A.equal(api.stringifyQuery(q), "z=2&z=1&a=0&b=false&c&d");
+  A.equal(api.stringifyQuery(q, { sort: false }), api.stringifyQuery(q));
+  A.equal(api.stringifyQuery(q, { sort: true }), "a=0&b=false&c&d&z=2&z=1");
+  A.equal(JSON.stringify(q), before);
+  A.equal(
+    api.withQuery(
+      "https://x.test/p?z=3&c=4#frag",
+      { a: [2, 1] },
+      { sort: true },
+    ),
+    "https://x.test/p?a=2&a=1&c=4&z=3#frag",
+  );
+  A.equal(api.withQuery("/p?z=3#f", { a: 1 }), "/p?z=3&a=1#f");
+  A.equal(
+    api.stringifyQuery({ é: 1, "a b": 2, "&": 3 }, { sort: true }),
+    "%26=3&a+b=2&%C3%A9=1",
+  );
+  A.equal(Object.getPrototypeOf(api.parseQuery("__proto__=bad")), null);
+  A.equal(api.parseQuery("constructor=bad").constructor, undefined);
+});
