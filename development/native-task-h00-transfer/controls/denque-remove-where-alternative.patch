+Denque.prototype.removeWhere = function removeWhere(predicate) {
+  if (typeof predicate !== 'function') throw new Error('Invalid predicate');
+  var values = this.toArray();
+  var marks = values.map(function (value, index) { return !!predicate(value, index); }); var retained = values.filter(function (_, index) { return !marks[index]; });
+  this._head = 0;
+  this._fromArray(retained);
+  return values.length - retained.length;
+};
