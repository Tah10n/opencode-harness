+test('new public contract', t => {
+	let now = 1000;
+	const clock = Date.now;
+	Date.now = () => now;
+	try {
+		const ev = [];
+		const q = new QuickLRU({
+			maxSize: 3, onEviction: (...x) => ev.push(x),
+		});
+		q.set('old-expired', 1, {
+			maxAge: 1,
+		});
+		q.set('shadow', 2, {
+			maxAge: 1,
+		});
+		q.set('old-live', 3);
+		q.set('shadow', 4);
+		q.set('current-expired', undefined, {
+			maxAge: 1,
+		});
+		now = 1001;
+		A.equal(q.pruneExpired(), 2);
+		A.deepEqual([...q.entriesAscending()], [['old-live', 3], ['shadow', 4]]);
+		A.deepEqual(ev, [['old-expired', 1], ['current-expired', undefined]]);
+		A.equal(q.pruneExpired(), 0);
+		A.equal(q.size, 2);
+		const r = new QuickLRU({
+			maxSize: 2,
+		});
+		r.set('x', 'old');
+		r.set('y', 'live');
+		r.set('x', 'new', {
+			maxAge: 1,
+		});
+		now++;
+		A.equal(r.pruneExpired(), 1);
+		A.equal(r.has('x'), false);
+		A.equal(r.get('x'), undefined);
+		A.equal(r.get('y'), 'live');
+		r.resize(1);
+		r.clear();
+		A.equal(r.pruneExpired(), 0);
+		r.set('z', 9);
+		A.equal(r.get('z'), 9);
+	} finally {
+		Date.now = clock;
+	}
+
+	t.pass();
+});
