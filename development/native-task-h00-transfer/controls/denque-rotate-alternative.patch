+Denque.prototype.rotate = function rotate(steps) {
+  if (steps === undefined) steps = 1;
+  if (typeof steps !== 'number' || !isFinite(steps) || Math.floor(steps) !== steps) throw new Error('Invalid rotation');
+  var n = this.size();
+  if (n < 2) return this;
+  var k = ((steps % n) + n) % n;
+  var values = this.toArray();
+  var rotated = []; for (var i = 0; i < n; i++) rotated.push(values[(i + n - k) % n]);
+  this._head = 0;
+  this._fromArray(rotated);
+  return this;
+};
