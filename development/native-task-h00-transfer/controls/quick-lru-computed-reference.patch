 import {setTimeout as delay} from 'node:timers/promises';
+import * as A from 'node:assert/strict';
 import test from 'ava';
 import QuickLRU from './index.js';
 
@@ -1725,3 +1726,48 @@ test('.evict() with custom maxAge and global maxAge interaction', async t => {
 	t.is(lru.size, 1);
 	t.true(lru.has('noglobal')); // Most recent should remain
 });
+test('new public contract', t => {
+	let now = 1000;
+	const clock = Date.now;
+	Date.now = () => now;
+	try {
+		const ev = [];
+		const q = new QuickLRU({
+			maxSize: 2, maxAge: 10, onEviction: (...x) => ev.push(x),
+		});
+		const key = {};
+		let calls = 0;
+		A.equal(q.getOrInsertComputed(key, k => {
+			A.equal(k, key);
+			calls++;
+			return undefined;
+		}), undefined);
+		A.equal(q.has(key), true);
+		q.set('b', 2);
+		A.equal(q.getOrInsertComputed(key, () => {
+			throw new Error('hit');
+		}), undefined);
+		A.equal(calls, 1);
+		q.set('c', 3);
+		q.set('d', 4);
+		A.equal(q.has(key), true);
+		now = 1010;
+		A.equal(q.getOrInsertComputed(key, () => 9), 9);
+		A.equal(ev.filter(x => x[0] === key).length, 1);
+		A.equal(q.expiresIn(key), 10);
+		const failure = {};
+		A.throws(() => q.getOrInsertComputed('missing', () => {
+			throw failure;
+		}), error => error === failure);
+		A.equal(q.has('missing'), false);
+		const other = new QuickLRU({
+			maxSize: 2,
+		});
+		A.equal(other.getOrInsertComputed(key, () => 7), 7);
+		A.equal(q.get(key), 9);
+	} finally {
+		Date.now = clock;
+	}
+
+	t.pass();
+});
