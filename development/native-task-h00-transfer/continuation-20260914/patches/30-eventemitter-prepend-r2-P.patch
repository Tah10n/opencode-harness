+/**
+ * Add a listener for a given event before all existing listeners.
+ *
+ * @param {(String|Symbol)} event The event name.
+ * @param {Function} fn The listener function.
+ * @param {*} [context=this] The context to invoke the listener with.
+ * @returns {EventEmitter} `this`.
+ * @public
+ */
+EventEmitter.prototype.prependListener = function prependListener(event, fn, context) {
+  return addListener(this, event, fn, context, false, true);
+};
+
+/**
+ * Add a one-time listener for a given event before all existing listeners.
+ *
+ * @param {(String|Symbol)} event The event name.
+ * @param {Function} fn The listener function.
+ * @param {*} [context=this] The context to invoke the listener with.
+ * @returns {EventEmitter} `this`.
+ * @public
+ */
+EventEmitter.prototype.prependOnceListener = function prependOnceListener(event, fn, context) {
+  return addListener(this, event, fn, context, true, true);
+};
