@@ -0,0 +1,26 @@
+import EventEmitter from '..';
+
+interface Events {
+  data: [value: string, count: number];
+  done: [];
+}
+
+interface Context {
+  name: string;
+}
+
+const emitter = new EventEmitter<Events, Context>();
+const context: Context = { name: 'test' };
+
+emitter.prependListener('data', (value, count) => {
+  value.toUpperCase();
+  count.toFixed();
+}, context);
+emitter.prependOnceListener('data', (value, count) => {
+  value.toUpperCase();
+  count.toFixed();
+}, context);
+emitter.prependListener('done', () => {}, context);
+
+// @ts-expect-error Event-specific listener arguments must be preserved.
+emitter.prependListener('data', (value: number, count: string) => {}, context);
