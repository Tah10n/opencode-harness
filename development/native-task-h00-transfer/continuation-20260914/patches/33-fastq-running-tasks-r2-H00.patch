+test('runningTasks tracks promise fulfillment and rejection', async function (t) {
+  let resolveFirst
+  let rejectSecond
+  let resolveThird
+
+  const queue = buildQueue(worker, 2)
+  const first = queue.push('first')
+  const second = queue.push(undefined)
+  const third = queue.push('third')
+
+  t.deepEqual(queue.runningTasks(), ['first', undefined], 'active promise tasks are listed in order')
+  t.deepEqual(queue.getQueue(), ['third'], 'queued promise tasks are excluded')
+
+  const snapshot = queue.runningTasks()
+  snapshot.pop()
+  t.deepEqual(queue.runningTasks(), ['first', undefined], 'mutating a snapshot does not change state')
+
+  resolveFirst('first')
+  t.equal(await first, 'first', 'fulfilled task keeps its result')
+  t.deepEqual(queue.runningTasks(), [undefined, 'third'], 'fulfillment promotes the queued task')
+
+  rejectSecond(new Error('rejected'))
+  try {
+    await second
+    t.fail('rejected task should reject')
+  } catch (err) {
+    t.equal(err.message, 'rejected', 'rejection is preserved')
+  }
+  t.deepEqual(queue.runningTasks(), ['third'], 'rejection removes only its active task')
+
+  resolveThird('third')
+  t.equal(await third, 'third', 'promoted task fulfills')
+  t.deepEqual(queue.runningTasks(), [], 'settled tasks are absent')
+
+  function worker (arg) {
+    return new Promise(function (resolve, reject) {
+      if (arg === 'first') resolveFirst = resolve
+      else if (arg === undefined) rejectSecond = reject
+      else resolveThird = resolve
+    })
+  }
+})
+
