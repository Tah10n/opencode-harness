+test('runningTasks tracks active values and pool reuse', function (t) {
+  t.plan(18)
+
+  var queue = buildQueue(worker, 2)
+  var finish = []
+  var completionStates = [[undefined], [undefined], [], []]
+
+  t.deepEqual(queue.runningTasks(), [], 'nothing is running')
+
+  queue.unshift(undefined, done)
+  queue.push('duplicate', done)
+  queue.push(undefined, done)
+
+  t.deepEqual(queue.runningTasks(), [undefined, 'duplicate'], 'started tasks are listed in order')
+  t.deepEqual(queue.getQueue(), [undefined], 'queued tasks are not listed as running')
+
+  var snapshot = queue.runningTasks()
+  var retained = queue.runningTasks()
+  t.notEqual(snapshot, retained, 'each snapshot is a new array')
+  snapshot[0] = 'changed'
+  snapshot.push('also changed')
+  t.deepEqual(queue.runningTasks(), [undefined, 'duplicate'], 'mutating a snapshot does not change queue state')
+
+  finish[1](null, true)
+  finish.splice(1, 1)
+  t.deepEqual(queue.runningTasks(), [undefined, undefined], 'the queued task is promoted after the duplicate completes')
+  finish.shift()(null, true)
+  t.deepEqual(queue.runningTasks(), [undefined], 'the first task is removed without removing its duplicate')
+  finish.shift()(null, true)
+  t.deepEqual(queue.runningTasks(), [], 'all completed tasks are absent')
+
+  queue.push('reused', done)
+  t.deepEqual(queue.runningTasks(), ['reused'], 'a pooled task can be tracked again')
+  finish.shift()(null, true)
+  t.deepEqual(retained, [undefined, 'duplicate'], 'an old snapshot keeps its values after pool reuse')
+
+  function done (err) {
+    t.error(err, 'completion has no error')
+    t.deepEqual(queue.runningTasks(), completionStates.shift(), 'completion callback sees its task as no longer running')
+  }
+
+  function worker (arg, cb) {
+    finish.push(cb)
+  }
+})
+
+test('runningTasks follows pause, resume, and concurrency changes', function (t) {
+  t.plan(13)
+
+  var queue = buildQueue(worker, 1)
+  var finish = []
+  var completionStates = [['tail'], ['middle'], []]
+
+  queue.pause()
+  queue.unshift('tail', done)
+  queue.push('middle', done)
+  queue.unshift('head', done)
+
+  t.deepEqual(queue.runningTasks(), [], 'paused tasks are not running')
+  t.deepEqual(queue.getQueue(), ['head', 'tail', 'middle'], 'paused tasks remain queued')
+
+  queue.resume()
+  t.deepEqual(queue.runningTasks(), ['head'], 'resume starts the first queued task')
+
+  queue.concurrency = 2
+  t.deepEqual(queue.runningTasks(), ['head', 'tail'], 'increasing concurrency promotes another task')
+
+  finish.shift()(null, true)
+  t.deepEqual(queue.runningTasks(), ['tail', 'middle'], 'completion promotes the next task')
+  finish.shift()(null, true)
+  t.deepEqual(queue.runningTasks(), ['middle'], 'the second active task is removed')
+  finish.shift()(null, true)
+  t.deepEqual(queue.runningTasks(), [], 'the queue is empty after all completions')
+
+  function done (err) {
+    t.error(err, 'completion has no error')
+    t.deepEqual(queue.runningTasks(), completionStates.shift(), 'callback sees only other active tasks')
+  }
+
+  function worker (arg, cb) {
+    finish.push(cb)
+  }
+})
