+test.serial('pruneExpired() prunes both generations without changing live order', t => {
+	const originalDateNow = Date.now;
+	let now = 1000;
+	Date.now = () => now;
+	t.teardown(() => {
+		Date.now = originalDateNow;
+	});
+
+	const evicted = [];
+	const lru = new QuickLRU({
+		maxSize: 4,
+		onEviction(key, value) {
+			evicted.push([key, value]);
+		},
+	});
+
+	lru.set('old-expired', 'old-expired', {maxAge: 10});
+	lru.set('old-live', 'old-live');
+	lru.set('shadowed-old', 'shadowed-old');
+	lru.set('old-live-2', 'old-live-2');
+	lru.set('current-live-1', 'current-live-1');
+	lru.set('current-expired', 'current-expired', {maxAge: 10});
+	lru.set('current-live-2', 'current-live-2');
+
+	const liveOrder = [...lru];
+	now = 1010;
+
+	t.is(lru.pruneExpired(), 2);
+	t.deepEqual(evicted, [
+		['current-expired', 'current-expired'],
+		['old-expired', 'old-expired'],
+	]);
+	t.deepEqual([...lru], liveOrder.filter(([key]) => !['old-expired', 'current-expired'].includes(key)));
+});
+
+test.serial('pruneExpired() respects current entries that shadow old entries', t => {
+	const originalDateNow = Date.now;
+	let now = 2000;
+	Date.now = () => now;
+	t.teardown(() => {
+		Date.now = originalDateNow;
+	});
+
+	const evicted = [];
+	const lru = new QuickLRU({
+		maxSize: 2,
+		onEviction(key, value) {
+			evicted.push([key, value]);
+		},
+	});
+
+	lru.set('shadow', 'old', {maxAge: 1});
+	lru.set('other', 'other');
+	lru.set('shadow', 'current');
+
+	now = 2001;
+	t.is(lru.pruneExpired(), 0);
+	t.is(lru.get('shadow'), 'current');
+	t.deepEqual(evicted, []);
+
+	lru.set('shadow', 'current-expiring', {maxAge: 1});
+	now = 2002;
+	t.is(lru.pruneExpired(), 1);
+	t.is(lru.get('shadow'), undefined);
+	t.deepEqual(evicted, [['shadow', 'current-expiring']]);
+});
+
+test.serial('pruneExpired() handles boundaries, infinite TTL, undefined values, and reuse', t => {
+	const originalDateNow = Date.now;
+	let now = 3000;
+	Date.now = () => now;
+	t.teardown(() => {
+		Date.now = originalDateNow;
+	});
+
+	const evicted = [];
