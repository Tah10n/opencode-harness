+			evicted.push([key, value]);
+		},
+	});
+
+	lru.set('undefined', undefined, {maxAge: 5});
+	lru.set('infinite', 'infinite', {maxAge: Number.POSITIVE_INFINITY});
+
+	now = 3005;
+	t.is(lru.pruneExpired(), 1);
+	t.deepEqual(evicted, [['undefined', undefined]]);
+	t.is(lru.pruneExpired(), 0);
+	t.is(lru.get('infinite'), 'infinite');
+
+	lru.delete('infinite');
+	t.is(lru.size, 0);
+	lru.set('reused', 'value');
+	t.is(lru.get('reused'), 'value');
+	t.is(lru.pruneExpired(), 0);
+});
