+import { describe, expect, it } from '@jest/globals';
+import { ms, parse, parseCompound, parseStrict } from './index';
+
+describe('parseCompound(string)', () => {
+  it('should sum mixed-case, spelled, decimal, repeated, and reordered units', () => {
+    const value: number = parseCompound(
+      '-1.5 HOURS 2 days 30 MINUTES 1 HOUR 2 months 1 YEAR 500 milliseconds 2 seconds 1 week 1 day',
+    );
+
+    expect(value).toBe(
+      -(
+        1.5 * 60 * 60 * 1000 +
+        2 * 24 * 60 * 60 * 1000 +
+        30 * 60 * 1000 +
+        1 * 60 * 60 * 1000 +
+        (2 * (365.25 * 24 * 60 * 60 * 1000)) / 12 +
+        365.25 * 24 * 60 * 60 * 1000 +
+        500 +
+        2 * 1000 +
+        7 * 24 * 60 * 60 * 1000 +
+        24 * 60 * 60 * 1000
+      ),
+    );
+  });
+
+  it('should apply a leading minus to the whole sum', () => {
+    expect(parseCompound('-2 days 4 hours')).toBe(-187200000);
+  });
+
+  it('should allow repeated spaces between terms and within terms', () => {
+    expect(parseCompound('1  h   30   minutes')).toBe(5400000);
+  });
+
+  it('should return NaN for malformed compound input', () => {
+    for (const value of [
+      '1h 30',
+      '1 30m',
+      '1h -30m',
+      '-1h +30m',
+      '1h30m',
+      '1h, 30m',
+      '1h 30mgarbage',
+      ' 1h 30m',
+      '1h 30m ',
+      '1h\t30m',
+    ]) {
+      expect(Number.isNaN(parseCompound(value))).toBe(true);
+    }
+  });
+
+  it('should throw for non-string, empty, and oversized input', () => {
+    expect(() => {
+      // @ts-expect-error - We expect this to throw.
+      parseCompound(undefined);
+    }).toThrow();
+    expect(() => parseCompound('')).toThrow();
+    expect(() => parseCompound('1h'.repeat(51))).toThrow();
+  });
+
+  it('should not broaden the existing parsers', () => {
+    expect(Number.isNaN(parse('1h 30m'))).toBe(true);
+    // @ts-expect-error - Compound syntax is not a StringValue.
+    expect(Number.isNaN(parseStrict('1h 30m'))).toBe(true);
+    // @ts-expect-error - Compound syntax is not a StringValue.
+    expect(Number.isNaN(ms('1h 30m'))).toBe(true);
+  });
+});
