+const compoundTerm = String.raw`\d*\.?\d+ *(?:milliseconds?|msecs?|ms|seconds?|secs?|s|minutes?|mins?|m|hours?|hrs?|h|days?|d|weeks?|w|months?|mo|years?|yrs?|y)`;
+const compoundPattern = new RegExp(
+  `^-?${compoundTerm}(?: +${compoundTerm})*$`,
+  'i',
+);
+const compoundTermPattern = new RegExp(`${compoundTerm}(?=$| +)`, 'gi');
+
+/**
+ * Parse a sum of duration terms and return milliseconds.
+ *
+ * @param str - A space-separated sum of duration terms
+ * @returns The parsed value in milliseconds, or `NaN` if the string can't be
+ * parsed
+ */
+export function parseCompound(str: string): number {
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw new Error(
+      `Value provided to ms.parseCompound() must be a string with length between 1 and 99. value=${JSON.stringify(str)}`,
+    );
+  }
+
+  if (!compoundPattern.test(str)) {
+    return NaN;
+  }
+
+  const total = (str.match(compoundTermPattern) as string[]).reduce(
+    (sum, term) => sum + parse(term),
+    0,
+  );
+
+  return str.startsWith('-') ? -total : total;
+}
+
