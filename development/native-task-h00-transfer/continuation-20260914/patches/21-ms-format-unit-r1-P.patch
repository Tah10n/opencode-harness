+describe('format(number, { unit })', () => {
+  const year = 365.25 * 24 * 60 * 60 * 1000;
+  const month = year / 12;
+
+  it('should force short formatting to the requested unit', () => {
+    expect(format(0.5, { unit: 'ms' })).toBe('0.5ms');
+    expect(format(1500, { unit: 's' })).toBe('2s');
+    expect(format(60 * 1000, { unit: 'm' })).toBe('1m');
+    expect(format(60 * 60 * 1000, { unit: 'h' })).toBe('1h');
+    expect(format(24 * 60 * 60 * 1000, { unit: 'd' })).toBe('1d');
+    expect(format(7 * 24 * 60 * 60 * 1000, { unit: 'w' })).toBe('1w');
+    expect(format(year, { unit: 'mo' })).toBe('12mo');
+    expect(format(year, { unit: 'y' })).toBe('1y');
+  });
+
+  it('should allow a forced unit to differ from automatic selection', () => {
+    expect(format(90_000)).toBe('2m');
+    expect(format(90_000, { unit: 'ms' })).toBe('90000ms');
+    expect(format(month, { unit: 'y' })).toBe('0y');
+    expect(format(year, { unit: 'mo' })).toBe('12mo');
+  });
+
+  it('should preserve rounding and pluralization boundaries', () => {
+    expect(format(-2500, { unit: 's' })).toBe('-2s');
+    expect(format(0, { long: true, unit: 'h' })).toBe('0 hour');
+    expect(format(1499, { long: true, unit: 's' })).toBe('1 second');
+    expect(format(1500, { long: true, unit: 's' })).toBe('2 seconds');
+    expect(format(-1500, { long: true, unit: 's' })).toBe('-1 seconds');
+    expect(format(0.5, { long: true, unit: 'ms' })).toBe('0.5 ms');
+  });
+
+  it('should reject unknown runtime units while leaving string parsing unchanged', () => {
+    const invalidOptions = { unit: 'invalid' } as unknown as Options;
+
+    expect(() => format(1000, invalidOptions)).toThrow(Error);
+    expect(() => ms(1000, invalidOptions)).toThrow(Error);
+    expect(ms('1s', invalidOptions)).toBe(1000);
+  });
+});
+
