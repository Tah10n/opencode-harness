+test('runningTasks', async function (t) {
+  let resolveFirst
+  let rejectSecond
+  let resolveThird
+  const queue = buildQueue(function (task) {
+    if (task === 'first') {
+      return new Promise(resolve => { resolveFirst = resolve })
+    }
+    if (task === 'second') {
+      return new Promise((resolve, reject) => { rejectSecond = reject })
+    }
+    return new Promise(resolve => { resolveThird = resolve })
+  }, 2)
+
+  const first = queue.push('first')
+  const second = queue.unshift('second')
+  const third = queue.push('third')
+
+  t.deepEqual(queue.runningTasks(), ['first', 'second'], 'only started promises are running')
+  t.deepEqual(queue.getQueue(), ['third'], 'queued promises are not running')
+
+  resolveFirst('first result')
+  t.equal(await first, 'first result', 'fulfilled promise keeps its result')
+  t.deepEqual(queue.runningTasks(), ['second', 'third'], 'queued promise is promoted')
+
+  rejectSecond(new Error('second error'))
+  try {
+    await second
+    t.fail('rejected promise should reject')
+  } catch (err) {
+    t.equal(err.message, 'second error', 'rejection is preserved')
+  }
+  t.deepEqual(queue.runningTasks(), ['third'], 'rejected promise is no longer running')
+
+  resolveThird('third result')
+  t.equal(await third, 'third result', 'final promise settles')
+  t.deepEqual(queue.runningTasks(), [], 'settled promises are absent')
+})
+
