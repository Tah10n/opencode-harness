+test('runningTasks', function (t) {
+  t.plan(13)
+
+  var finish = []
+  var queue = buildQueue(worker, 2)
+
+  t.deepEqual(queue.runningTasks(), [], 'nothing is running')
+
+  queue.push('duplicate', function () {
+    t.deepEqual(queue.runningTasks(), ['duplicate'], 'the completed duplicate is absent')
+  })
+  queue.unshift('duplicate', function () {
+    t.deepEqual(queue.runningTasks(), [undefined], 'the second duplicate is absent')
+  })
+  queue.push(undefined, function () {
+    t.deepEqual(queue.runningTasks(), [], 'undefined is absent after completion')
+  })
+
+  t.deepEqual(queue.runningTasks(), ['duplicate', 'duplicate'], 'running tasks keep start order')
+  t.deepEqual(queue.getQueue(), [undefined], 'queued tasks are not running')
+
+  var snapshot = queue.runningTasks()
+  snapshot[0] = 'changed'
+  snapshot.push('mutated')
+  t.deepEqual(queue.runningTasks(), ['duplicate', 'duplicate'], 'snapshot mutations do not change state')
+
+  finish.shift()(null, 'first')
+  t.deepEqual(queue.runningTasks(), ['duplicate', undefined], 'queued work is promoted after completion')
+  finish.shift()(null, 'second')
+  t.deepEqual(queue.runningTasks(), [undefined], 'the promoted task remains active')
+  finish.shift()(null, 'third')
+  t.deepEqual(queue.runningTasks(), [], 'all completed tasks are absent')
+
+  queue.push('new', function () {
+    t.deepEqual(queue.runningTasks(), [], 'pooled task completion does not retain its value')
+  })
+  t.deepEqual(queue.runningTasks(), ['new'], 'a reused task appears in a new snapshot')
+  finish.shift()()
+  t.deepEqual(snapshot, ['changed', 'duplicate', 'mutated'], 'old snapshots survive pool reuse')
+
+  function worker (arg, cb) {
+    finish.push(cb)
+  }
+})
+
+test('runningTasks after resume and concurrency changes', function (t) {
+  t.plan(9)
+
+  var finish = []
+  var queue = buildQueue(worker, 1)
+
+  queue.pause()
+  queue.push('push')
+  queue.unshift('unshift')
+  t.deepEqual(queue.runningTasks(), [], 'paused work is not running')
+  t.deepEqual(queue.getQueue(), ['unshift', 'push'], 'paused work remains queued')
+
+  queue.concurrency = 2
+  t.deepEqual(queue.runningTasks(), [], 'concurrency changes do not start paused work')
+
+  queue.resume()
+  t.deepEqual(queue.runningTasks(), ['unshift', 'push'], 'resume starts work in queue order')
+
+  queue.push('queued')
+  t.deepEqual(queue.runningTasks(), ['unshift', 'push'], 'new queued work is excluded')
+
+  queue.concurrency = 3
+  t.deepEqual(queue.runningTasks(), ['unshift', 'push', 'queued'], 'concurrency promotes queued work')
+
+  finish.shift()()
+  t.deepEqual(queue.runningTasks(), ['push', 'queued'], 'first completion is removed')
+  finish.shift()()
+  t.deepEqual(queue.runningTasks(), ['queued'], 'middle completion is removed')
+  finish.shift()()
+  t.deepEqual(queue.runningTasks(), [], 'last completion is removed')
+
+  function worker (arg, cb) {
+    finish.push(cb)
+  }
+})
+
