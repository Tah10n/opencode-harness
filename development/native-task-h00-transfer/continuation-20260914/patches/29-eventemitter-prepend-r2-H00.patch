+        assume(ex.message).equals('The listener must be a function');
+      }
+      assume(threw).equals(true);
+
+      threw = false;
+      try {
+        e.prependOnceListener(event, 'invalid');
+      } catch (ex) {
+        threw = true;
+        assume(ex).is.instanceOf(TypeError);
+        assume(ex.message).equals('The listener must be a function');
