+  describe('EventEmitter#prependListener', function () {
+    it('prepends listeners and preserves contexts, arguments and append order', function () {
+      var e = new EventEmitter()
+        , calls = []
+        , contexts = {
+          append: { name: 'append' },
+          prepend: { name: 'prepend' },
+          once: { name: 'once' },
+          prependOnce: { name: 'prependOnce' },
+          latest: { name: 'latest' }
+        };
+
+      function record(label) {
+        return function (first, second) {
+          calls.push(label + ':' + this.name + ':' + first + ':' + second);
+        };
+      }
+
+      e.on('foo', record('append'), contexts.append);
+      e.prependListener('foo', record('prepend'), contexts.prepend);
+      e.once('foo', record('once'), contexts.once);
+      assume(e.prependOnceListener('foo', record('prependOnce'), contexts.prependOnce)).equals(e);
+      assume(e.prependListener('foo', record('latest'), contexts.latest)).equals(e);
+
+      assume(e.listeners('foo').length).equals(5);
+      e.emit('foo', 'first', 'second');
+      assume(calls).deep.equals([
+        'latest:latest:first:second',
+        'prependOnce:prependOnce:first:second',
+        'prepend:prepend:first:second',
+        'append:append:first:second',
+        'once:once:first:second'
+      ]);
+
+      calls = [];
+      e.emit('foo', 'again', 'arguments');
+      assume(calls).deep.equals([
+        'latest:latest:again:arguments',
+        'prepend:prepend:again:arguments',
+        'append:append:again:arguments'
+      ]);
+    });
+
+    it('removes a prepended once listener before recursive emits', function () {
+      var e = new EventEmitter()
+        , calls = [];
+
+      function persistent(value) {
+        calls.push('persistent:' + value);
+      }
+
+      function once(value) {
+        calls.push('once:' + value);
+        e.emit('foo', 'nested');
+      }
+
+      e.prependOnceListener('foo', once);
+      e.prependListener('foo', persistent);
+
+      assume(e.listenerCount('foo')).equals(2);
+      assume(e.listeners('foo')).deep.equals([persistent, once]);
+      e.emit('foo', 'outer');
+
+      assume(calls).deep.equals([
+        'persistent:outer',
+        'once:outer',
+        'persistent:nested'
+      ]);
+      assume(e.listeners('foo')).deep.equals([persistent]);
+      assume(e.removeListener('foo', persistent)).equals(e);
+      assume(e.listeners('foo')).deep.equals([]);
+      assume(e.emit('foo', 'after-removal')).equals(false);
+    });
+
