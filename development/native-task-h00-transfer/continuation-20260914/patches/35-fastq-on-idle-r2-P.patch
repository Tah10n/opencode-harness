+test('onIdle with active and paused work', function (t) {
+  t.plan(8)
+
+  var queue = buildQueue(worker, 2)
+  var finish = []
+  var resolved = 0
+
+  queue.push(1, done)
+  queue.push(2, done)
+  queue.push(3, done)
+
+  var first = queue.onIdle().then(function () {
+    resolved++
+  })
+  var second = queue.onIdle().then(function () {
+    resolved++
+  })
+
+  queue.pause()
+  t.notOk(queue.idle(), 'active and queued work is not idle')
+
+  finish.shift()()
+  finish.shift()()
+
+  setImmediate(function () {
+    t.notOk(queue.idle(), 'paused queued work is not idle')
+    t.equal(resolved, 0, 'subscribers remain pending while paused')
+
+    queue.resume()
+    finish.shift()()
+
+    Promise.all([first, second]).then(function () {
+      t.equal(resolved, 2, 'all subscribers resolve')
+      t.ok(queue.idle(), 'queue is idle')
+    })
+  })
+
+  function done (err) {
+    t.error(err, 'task completed')
+  }
+
+  function worker (arg, cb) {
+    finish.push(function () {
+      cb(null, arg)
+    })
+  }
+})
+
+test('onIdle preserves drain identity and reentrant work', function (t) {
+  t.plan(9)
+
+  var queue = buildQueue(worker, 1)
+  var drainCalls = 0
+  var duringDrain
+
+  queue.drain = drain
+  t.equal(queue.drain, drain, 'drain identity is retained')
+  queue.push(1, done)
+  var waiting = queue.onIdle()
+  t.equal(queue.drain, drain, 'drain identity is retained while waiting')
+
+  waiting.then(function () {
+    return duringDrain
+  }).then(function () {
+    t.equal(drainCalls, 2, 'drain was called for both tasks')
+    t.equal(queue.drain, drain, 'drain remains installed')
+  })
+
+  function done (err) {
+    t.error(err, 'task completed')
+  }
+
+  function drain () {
+    t.equal(queue.drain, drain, 'drain is called normally')
+    drainCalls++
+    if (drainCalls === 1) {
+      duringDrain = queue.onIdle().then(function () {
+        t.ok(queue.idle(), 'subscription resolves after reentrant work')
+      })
+      queue.push(2, done)
+    }
+  }
+
+  function worker (arg, cb) {
+    setImmediate(function () {
+      cb(null, arg)
+    })
+  }
+})
