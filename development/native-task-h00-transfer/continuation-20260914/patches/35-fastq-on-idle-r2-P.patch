+test('onIdle waits through kill, killAndDrain, and abort', async function (t) {
+  let finish
+  let resolved = false
+  const queue = buildQueue(function () {
+    return new Promise(function (resolve) {
+      finish = resolve
+    })
+  }, 1)
+
+  queue.push(1)
+  queue.push(2)
+  const activeWait = queue.onIdle().then(function () {
+    resolved = true
+  })
+
+  queue.kill()
+  await immediate()
+  t.equal(resolved, false, 'kill does not resolve while a worker remains')
+
+  finish()
+  await activeWait
+  t.equal(resolved, true, 'kill resolves after the worker finishes')
+
+  let finishKillAndDrain
+  let killAndDrainResolved = false
+  const activeKillAndDrainQueue = buildQueue(function () {
+    return new Promise(function (resolve) {
+      finishKillAndDrain = resolve
+    })
+  }, 1)
+  activeKillAndDrainQueue.push(1)
+  activeKillAndDrainQueue.push(2)
+  const activeKillAndDrainWait = activeKillAndDrainQueue.onIdle().then(function () {
+    killAndDrainResolved = true
+  })
+  activeKillAndDrainQueue.killAndDrain()
+  await immediate()
+  t.equal(killAndDrainResolved, false, 'killAndDrain waits for a running worker')
+  finishKillAndDrain()
+  await activeKillAndDrainWait
+  t.equal(killAndDrainResolved, true, 'killAndDrain resolves after the worker finishes')
+
+  let finishAbort
+  let abortResolved = false
+  const activeAbortQueue = buildQueue(function () {
+    return new Promise(function (resolve) {
+      finishAbort = resolve
+    })
+  }, 1)
+  activeAbortQueue.push(1)
+  activeAbortQueue.push(2)
+  const activeAbortWait = activeAbortQueue.onIdle().then(function () {
+    abortResolved = true
+  })
+  activeAbortQueue.abort()
+  await immediate()
+  t.equal(abortResolved, false, 'abort waits for a running worker')
+  finishAbort()
+  await activeAbortWait
+  t.equal(abortResolved, true, 'abort resolves after the worker finishes')
+
+  const pausedQueue = buildQueue(worker, 1)
+  pausedQueue.pause()
+  pausedQueue.push(1)
+  const killAndDrainWait = pausedQueue.onIdle()
+  pausedQueue.killAndDrain()
+  await killAndDrainWait
+  t.equal(pausedQueue.idle(), true, 'killAndDrain resolves when queued work is removed')
+
+  const abortQueue = buildQueue(worker, 1)
+  abortQueue.pause()
+  const rejected = [abortQueue.push(1), abortQueue.push(2)]
+  const abortWait = abortQueue.onIdle()
+  abortQueue.abort()
+  await abortWait
+  for (const promise of rejected) {
+    try {
+      await promise
+      t.fail('aborted promise should reject')
+    } catch (err) {
+      t.equal(err.message, 'abort', 'abort rejects queued work')
+    }
+  }
+
+  async function worker (arg) {
+    return arg
+  }
+})
