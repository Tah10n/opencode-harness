 import { describe, expect, test } from "vitest";
-import { filterQuery, getQuery, withQuery } from "../src";
+import { appendQuery, filterQuery, getQuery, withQuery } from "../src";
+
+describe("appendQuery", () => {
+  test("appends repeated values without changing withQuery replacement", () => {
+    const input = "/items?tag=old-1&tag=old-2";
+    const query = { tag: ["new-1", "new-2"] };
+
+    expect(appendQuery(input, query)).toBe(
+      "/items?tag=old-1&tag=old-2&tag=new-1&tag=new-2",
+    );
+    expect(withQuery(input, query)).toBe("/items?tag=new-1&tag=new-2");
+  });
+
+  test("ignores undefined and empty arrays while retaining empty values", () => {
+    expect(
+      appendQuery("/?existing=one", {
+        existing: undefined,
+        emptyArray: [],
+        empty: "",
+        nil: null,
+        zero: 0,
+        no: false,
+      }),
+    ).toBe("/?existing=one&empty&nil&zero=0&no=false");
+  });
+
+  test("preserves URL parts, encoded keys, pollution policy, and inputs", () => {
+    const tags = ["new-1", "new-2"];
+    const query = Object.create(null) as {
+      "tag name": string[];
+      __proto__: string;
+      constructor: string;
+    };
+    query["tag name"] = tags;
+    query.__proto__ = "ignored";
+    query.constructor = "ignored";
+
+    expect(
+      appendQuery(
+        "https://example.com/items?tag%20name=old-1&tag+name=old-2&__proto__=old&constructor=old#fragment",
+        query,
+      ),
+    ).toBe(
+      "https://example.com/items?tag+name=old-1&tag+name=old-2&tag+name=new-1&tag+name=new-2#fragment",
+    );
+
+    expect(
+      appendQuery("../items?tag%20name=old-1&tag+name=old-2#fragment", {
+        "tag name": tags,
+        "added key": ["added-1", "added-2"],
+      }),
+    ).toBe(
+      "../items?tag+name=old-1&tag+name=old-2&tag+name=new-1&tag+name=new-2&added+key=added-1&added+key=added-2#fragment",
+    );
+    expect(tags).toEqual(["new-1", "new-2"]);
+    expect(query["tag name"]).toBe(tags);
+    expect(Object.keys(query)).toEqual([
+      "tag name",
+      "__proto__",
+      "constructor",
+    ]);
+  });
+});
 
