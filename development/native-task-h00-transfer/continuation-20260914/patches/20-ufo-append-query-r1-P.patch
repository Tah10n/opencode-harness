+/**
+ * Appends values to the query section of the URL.
+ *
+ * Unlike `withQuery`, existing values are retained and new values are appended
+ * after them. Undefined values and empty arrays are ignored, while null and
+ * empty string values are encoded as empty query values. The `__proto__` and
+ * `constructor` keys are ignored to prevent prototype pollution.
+ *
+ * @example
+ *
+ * ```js
+ * appendQuery("/foo?tag=a&tag=b", { tag: ["c", "d"] });
+ * // "/foo?tag=a&tag=b&tag=c&tag=d"
+ * ```
+ *
+ * @group utils
+ */
+export function appendQuery(input: string, query: QueryObject): string {
+  const parsed = parseURL(input);
+  const existingQuery = parseQuery(parsed.search);
+  const queryParts: string[] = [];
+
+  const encodeNewValue = (key: string, value: QueryObject[string]) => {
+    if (Array.isArray(value)) {
+      const values = value.filter((value) => value !== undefined);
+      return values.length > 0 ? encodeQueryItem(key, values) : "";
+    }
+    return value === undefined ? "" : encodeQueryItem(key, value);
+  };
+
+  for (const key of Object.keys(existingQuery)) {
+    queryParts.push(encodeQueryItem(key, existingQuery[key]));
+    if (
+      Object.prototype.hasOwnProperty.call(query, key) &&
+      key !== "__proto__" &&
+      key !== "constructor"
+    ) {
+      const encoded = encodeNewValue(key, query[key]);
+      if (encoded) {
+        queryParts.push(encoded);
+      }
+    }
+  }
+
+  for (const key of Object.keys(query)) {
+    if (
+      key === "__proto__" ||
+      key === "constructor" ||
+      Object.prototype.hasOwnProperty.call(existingQuery, key)
+    ) {
+      continue;
+    }
+    const encoded = encodeNewValue(key, query[key]);
+    if (encoded) {
+      queryParts.push(encoded);
+    }
+  }
+
+  parsed.search = queryParts.join("&");
+  return stringifyParsedURL(parsed);
+}
