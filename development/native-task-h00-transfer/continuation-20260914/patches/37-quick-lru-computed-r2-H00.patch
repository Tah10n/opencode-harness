+test('.getOrInsertComputed() hits stored undefined and refreshes old-cache recency', t => {
+	const lru = new QuickLRU({maxSize: 3});
+	lru.set('undefined', undefined);
+	lru.set('a', 'a');
+	lru.set('b', 'b');
+
+	t.true(lru.__oldCache.has('undefined'));
+	t.is(lru.__oldCache.get('undefined').value, undefined);
+
+	let factoryCalls = 0;
+	t.is(lru.getOrInsertComputed('undefined', () => {
+		factoryCalls++;
+		return 'computed';
+	}), undefined);
+	t.is(factoryCalls, 0);
+
+	lru.set('c', 'c');
+	lru.set('d', 'd');
+	lru.set('e', 'e');
+	t.true(lru.has('undefined'));
+});
+
+test('.getOrInsertComputed() replaces expired entries with the default TTL', async t => {
+	const evictions = [];
+	const lru = new QuickLRU({
+		maxSize: 10,
+		maxAge: 100,
+		onEviction(key, value) {
+			evictions.push([key, value]);
+		},
+	});
+	lru.set('key', 'expired', {maxAge: 1});
+	await delay(10);
+
+	// Check the stored entry is expired without triggering its lazy eviction.
+	t.true(lru.expiresIn('key') <= 0);
+
+	let factoryCalls = 0;
+	t.is(lru.getOrInsertComputed('key', key => {
+		factoryCalls++;
+		t.is(key, 'key');
+		return 'computed';
+	}), 'computed');
+	t.is(factoryCalls, 1);
+	t.deepEqual(evictions, [['key', 'expired']]);
+	t.true(lru.has('key'));
+	t.true(lru.expiresIn('key') > 0);
+});
+
+test('.getOrInsertComputed() preserves thrown errors and key/cache identity', t => {
+	const lru = new QuickLRU({maxSize: 10});
+	const key = {};
+	const error = new Error('factory failed');
+
+	t.false(lru.has(key));
+	const thrown = t.throws(() => lru.getOrInsertComputed(key, () => {
+		throw error;
+	}));
+	t.is(thrown, error);
+	t.false(lru.has(key));
+
+	const otherLru = new QuickLRU({maxSize: 10});
+	const firstValue = {cache: 'first'};
+	const secondValue = {cache: 'second'};
+	t.is(lru.getOrInsertComputed(key, currentKey => {
+		t.is(currentKey, key);
+		return firstValue;
+	}), firstValue);
+	t.is(otherLru.getOrInsertComputed(key, currentKey => {
+		t.is(currentKey, key);
+		return secondValue;
+	}), secondValue);
+	t.is(lru.get(key), firstValue);
+	t.is(otherLru.get(key), secondValue);
+});
+
