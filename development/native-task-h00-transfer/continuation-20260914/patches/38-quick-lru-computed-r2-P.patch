+test('.getOrInsertComputed() returns hits without computing and refreshes old entries', t => {
+	const lru = new QuickLRU({maxSize: 2});
+	let factoryCalls = 0;
+
+	lru.set('old', undefined);
+	lru.set('other', 'value');
+
+	t.is(lru.getOrInsertComputed('old', () => {
+		factoryCalls++;
+		return 'computed';
+	}), undefined);
+	t.is(factoryCalls, 0);
+	t.false(lru.__oldCache.has('old'));
+});
+
+test('.getOrInsertComputed() computes expired entries with the default maxAge', async t => {
+	const evictions = [];
+	const lru = new QuickLRU({
+		maxSize: 10,
+		maxAge: 100,
+		onEviction(key, value) {
+			evictions.push([key, value]);
+		},
+	});
+
+	lru.set('key', 'expired', {maxAge: 10});
+	await delay(30);
+
+	let factoryCalls = 0;
+	t.is(lru.getOrInsertComputed('key', key => {
+		factoryCalls++;
+		t.is(key, 'key');
+		return 'fresh';
+	}), 'fresh');
+	t.is(factoryCalls, 1);
+	t.deepEqual(evictions, [['key', 'expired']]);
+	t.true(lru.expiresIn('key') > 10);
+});
+
+test('.getOrInsertComputed() preserves factory errors and cache isolation', t => {
+	const key = {};
+	const lru = new QuickLRU({maxSize: 10});
+	const otherLru = new QuickLRU({maxSize: 10});
+	const error = new Error('factory failed');
+	let thrown;
+
+	try {
+		lru.getOrInsertComputed('missing', () => {
+			throw error;
+		});
+	} catch (error_) {
+		thrown = error_;
+	}
+
+	t.is(thrown, error);
+	t.false(lru.has('missing'));
+	t.is(lru.size, 0);
+
+	let factoryCalls = 0;
+	t.is(lru.getOrInsertComputed(key, receivedKey => {
+		factoryCalls++;
+		t.is(receivedKey, key);
+		return 'first';
+	}), 'first');
+	t.is(lru.getOrInsertComputed(key, () => {
+		factoryCalls++;
+		return 'wrong';
+	}), 'first');
+	t.is(otherLru.getOrInsertComputed(key, () => 'second'), 'second');
+	t.is(lru.getOrInsertComputed({}, () => 'different'), 'different');
+	t.is(factoryCalls, 1);
+});
+
