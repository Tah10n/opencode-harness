+import EventEmitter, { EventEmitter as NamedEventEmitter } from '..';
+
+interface Events {
+  data: [string];
+}
+
+interface Context {
+  name: string;
+}
+
+const emitter = new EventEmitter<Events, Context>();
+const context: Context = { name: 'context' };
+const removed: number = emitter.removeListenersByContext(context);
+const namedEmitter = new NamedEventEmitter();
+
+void removed;
+namedEmitter.removeListenersByContext(undefined);
