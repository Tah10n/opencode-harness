+  describe('EventEmitter#removeListenersByContext', function () {
+    it('removes matching registrations across string and symbol events', function () {
+      var e = new EventEmitter()
+        , first = {}
+        , second = {}
+        , event = Symbol('event')
+        , other = function () {};
+
+      function listener() {}
+
+      e.on('foo', listener, first);
+      e.on('foo', listener, first);
+      e.on('foo', other, second);
+      e.once(event, listener, first);
+      e.on(event, listener, second);
+
+      assume(e.removeListenersByContext(first)).equals(3);
+      assume(e.listeners('foo')).eql([other]);
+      assume(e.listeners(event)).eql([listener]);
+      assume(e.listenerCount('foo')).equals(1);
+      assume(e.listenerCount(event)).equals(1);
+      assume(e.eventNames()).eql(['foo', event]);
+
+      assume(e.removeListenersByContext(second)).equals(2);
+      assume(e.eventNames()).eql([]);
+      assume(e._eventsCount).equals(0);
+    });
+
+    it('preserves mutation-during-emit behavior', function () {
+      var e = new EventEmitter()
+        , context = {}
+        , calls = [];
+
+      e.on('foo', function () {
+        calls.push('first');
+        e.removeListenersByContext(context);
+      }, context);
+      e.on('foo', function () {
+        calls.push('second');
+      }, context);
+
+      e.emit('foo');
