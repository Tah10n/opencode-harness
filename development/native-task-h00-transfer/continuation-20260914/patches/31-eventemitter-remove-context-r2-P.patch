+/**
+ * Remove all listeners that use the given context.
+ *
+ * @param {*} context The context to match.
+ * @returns {Number} The number of listeners removed.
+ * @public
+ */
+EventEmitter.prototype.removeListenersByContext = function removeListenersByContext(context) {
+  var events = this._events
+    , evt
+    , listeners
+    , filtered
+    , symbols
+    , i
+    , length
+    , removed = 0;
+
+  for (evt in events) {
+    if (!has.call(events, evt)) continue;
+
+    listeners = events[evt];
+
+    if (listeners.fn) {
+      if (listeners.context === context) {
+        clearEvent(this, evt);
+        removed++;
+      }
+    } else {
+      filtered = [];
+
+      for (i = 0, length = listeners.length; i < length; i++) {
+        if (listeners[i].context === context) removed++;
+        else filtered.push(listeners[i]);
+      }
+
+      if (filtered.length) events[evt] = filtered.length === 1 ? filtered[0] : filtered;
+      else clearEvent(this, evt);
+    }
+  }
+
+  if (Object.getOwnPropertySymbols) {
+    symbols = Object.getOwnPropertySymbols(events);
+
+    for (i = 0, length = symbols.length; i < length; i++) {
+      evt = symbols[i];
+      listeners = events[evt];
+
+      if (listeners.fn) {
+        if (listeners.context === context) {
+          clearEvent(this, evt);
+          removed++;
+        }
+      } else {
+        filtered = [];
+
+        for (var j = 0, l = listeners.length; j < l; j++) {
+          if (listeners[j].context === context) removed++;
+          else filtered.push(listeners[j]);
+        }
+
+        if (filtered.length) events[evt] = filtered.length === 1 ? filtered[0] : filtered;
+        else clearEvent(this, evt);
+      }
+    }
+  }
+
+  return removed;
+};
