@@ -70,8 +70,15 @@ function emitted() {
 EE.once('event-name', emitted, context);
 EE.on('another-event', emitted, context);
 EE.removeListener('another-event', emitted, context);
+EE.removeListenersByContext(context); // returns the number of registrations removed
 ```
 
+`removeListenersByContext` removes every registration whose stored context is
+strictly equal (`===`) across all event names, including symbol events,
+duplicate functions, and one-time listeners. Listeners registered without a
+context, or with a falsy context, use the emitter as their context and can be
+removed by passing that emitter.
+
 ### Tests and benchmarks
 
 To run tests run `npm test`. To run the benchmarks run `npm run benchmark`.
