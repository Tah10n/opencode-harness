+        , second = function () {}
+        , third = function () {};
+
+      e.on('remove-first', first, context);
+      e.on('keep-first', first);
+      e.on(symbol, second, context);
+      e.on(symbol, second, context);
+      e.on('keep-second', second);
+      e.once('remove-last', third, context);
+
+      assume(e.removeListenersByContext(context)).equals(4);
