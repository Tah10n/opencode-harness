+describe('Denque.prototype.rotate', function () {
+  it('should rotate in either direction, normalize counts, and return itself', function () {
+    var a = new Denque([1, 2, 3, 4]);
+
+    assert.strictEqual(a.rotate(), a);
+    assert.deepEqual(a.toArray(), [4, 1, 2, 3]);
+    assert.strictEqual(a.rotate(-2), a);
+    assert.deepEqual(a.toArray(), [2, 3, 4, 1]);
+    assert.strictEqual(a.rotate(0), a);
+    assert.deepEqual(a.toArray(), [2, 3, 4, 1]);
+    assert.strictEqual(a.rotate(6), a);
+    assert.deepEqual(a.toArray(), [4, 1, 2, 3]);
+    assert.strictEqual(a.rotate(-5), a);
+    assert.deepEqual(a.toArray(), [1, 2, 3, 4]);
+    assert.strictEqual(a.rotate(9007199254740991), a);
+    assert.deepEqual(a.toArray(), [2, 3, 4, 1]);
+  });
+
+  it('should preserve values in wrapped storage and after deque operations', function () {
+    var a = new Denque([1, 2, 3, 4, 5, 6]);
+    a.shift();
+    a.shift();
+    a.push(7);
+    a.push(8);
+    assert(a._head > a._tail);
+
+    a.rotate(2);
+    assert.deepEqual(a.toArray(), [7, 8, 3, 4, 5, 6]);
+    assert.strictEqual(a.peek(), 7);
+    assert.strictEqual(a.peekBack(), 6);
+    assert.strictEqual(a.shift(), 7);
+    assert.strictEqual(a.pop(), 6);
+    a.unshift(2);
+    a.push(9);
+    assert.deepEqual(a.toArray(), [2, 8, 3, 4, 5, 9]);
+    assert.deepEqual(a.remove(1, 2), [8, 3]);
+    assert.deepEqual(a.toArray(), [2, 4, 5, 9]);
+  });
+
+  it('should preserve configured capacity and order after rotation', function () {
+    var a = new Denque([1, 2, 3, 4], { capacity: 4 });
+    var capacity = a._capacity;
+    a.shift();
+    a.shift();
+    a.push(5);
+    a.push(6);
+    a.push(7);
+    a.push(8);
+    a.rotate();
+
+    assert.strictEqual(a._capacity, capacity);
+    assert.strictEqual(a.length, 4);
+    assert.deepEqual(a.toArray(), [8, 5, 6, 7]);
+    a.push(9);
+    assert.deepEqual(a.toArray(), [5, 6, 7, 9]);
+    a.unshift(4);
+    assert.deepEqual(a.toArray(), [4, 5, 6, 7]);
+  });
+
+  it('should reject invalid counts without changing state', function () {
+    var a = new Denque([{ id: 1 }, { id: 2 }, { id: 3 }]);
+    a.shift();
+    a.push({ id: 4 });
+    var original = a.toArray();
+    a.rotate(1);
+    assert.strictEqual(a.peekFront(), original[original.length - 1]);
+    assert.strictEqual(a.peekBack(), original[original.length - 2]);
+    var before = a.toArray();
+    var list = a._list;
+    var head = a._head;
+    var tail = a._tail;
+    var invalid = [NaN, Infinity, -Infinity, 1.5, '1', null, true, {}, new Number(1)];
+
+    invalid.forEach(function (steps) {
+      assert.throws(function () { a.rotate(steps); }, Error);
+      assert.deepStrictEqual(a.toArray(), before);
+      assert.strictEqual(a._list, list);
+      assert.strictEqual(a._head, head);
+      assert.strictEqual(a._tail, tail);
+    });
+    assert.strictEqual(a.peekFront(), before[0]);
+    assert.strictEqual(a.peekBack(), before[before.length - 1]);
+  });
+
+  it('should leave empty and singleton queues usable', function () {
+    var empty = new Denque();
+    assert.strictEqual(empty.rotate(1000000000), empty);
+    empty.push(1);
+    assert.deepEqual(empty.toArray(), [1]);
+    assert.strictEqual(empty.rotate(-1000000000), empty);
+    assert.strictEqual(empty.pop(), 1);
+
+    var singleton = new Denque([{ value: 1 }]);
+    var item = singleton.peek();
+    assert.strictEqual(singleton.rotate(), singleton);
+    assert.strictEqual(singleton.peek(), item);
+    assert.strictEqual(singleton.shift(), item);
+    singleton.unshift(item);
+    assert.strictEqual(singleton.pop(), item);
+  });
+});
