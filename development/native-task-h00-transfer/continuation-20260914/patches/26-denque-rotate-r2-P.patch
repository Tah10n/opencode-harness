+/**
+ * Rotate the queue by moving items from the back to the front for positive
+ * steps, or from the front to the back for negative steps.
+ * @param {number} steps
+ * @returns {Denque}
+ */
+Denque.prototype.rotate = function rotate(steps) {
+  if (steps === void 0) steps = 1;
+  if (typeof steps !== 'number' || steps !== steps || steps % 1 !== 0) {
+    throw new Error('steps must be a finite integer');
+  }
+
+  var size = this.size();
+  if (size < 2) return this;
+
+  var offset = steps % size;
+  if (offset < 0) offset += size;
+  if (offset === 0) return this;
+
+  var rotated = new Array(this._list.length);
+  var source;
+  for (var i = 0; i < size; i++) {
+    source = i - offset;
+    if (source < 0) source += size;
+    rotated[i] = this._list[(this._head + source) & this._capacityMask];
+  }
+
+  this._list = rotated;
+  this._head = 0;
+  this._tail = size;
+  return this;
+};
