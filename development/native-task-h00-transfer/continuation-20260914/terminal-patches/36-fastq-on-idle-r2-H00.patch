+test('onIdle waits for active and queued work', async function (t) {
+  const queue = buildQueue(worker, 2)
+  const finish = []
+  let resolved = 0
+
+  queue.push(1)
+  queue.push(2)
+  queue.push(3)
+
+  const first = queue.onIdle().then(function () {
+    resolved++
+  })
+  const second = queue.onIdle().then(function () {
+    resolved++
+  })
+
+  t.equal(queue.running(), 2, 'two tasks are running')
+  t.equal(queue.length(), 1, 'one task is waiting')
+  await immediate()
+  t.equal(resolved, 0, 'subscribers are pending')
+
+  finish.shift()()
+  await immediate()
+  finish.shift()()
+  await immediate()
+  t.equal(queue.running(), 1, 'the queued task starts')
+  t.equal(resolved, 0, 'subscribers still wait for the queued task')
+  finish.shift()()
+
+  await Promise.all([first, second])
+  t.equal(resolved, 2, 'all subscribers resolve')
+  t.ok(queue.idle(), 'queue is idle')
+  t.ok(queue.onIdle() instanceof Promise, 'idle calls return promises')
+
+  async function worker (arg) {
+    return new Promise(function (resolve) {
+      finish.push(resolve)
+    })
+  }
+})
+
+test('onIdle waits for paused and rejected work', async function (t) {
+  let finish
+  let resolved = false
+
+  const queue = buildQueue(async function (task) {
+    if (task === 'reject') throw new Error('rejected')
+    return new Promise(function (resolve) {
+      finish = resolve
+    })
+  }, 1)
+
+  queue.pause()
+  const rejected = queue.push('reject')
+  const running = queue.push('running')
+  t.equal(queue.running(), 0, 'paused work has no running workers')
+  t.equal(queue.length(), 2, 'paused work is queued')
+  const idle = queue.onIdle().then(function () {
+    resolved = true
+  })
+
+  queue.resume()
+  await immediate()
+  t.equal(queue.running(), 1, 'the replacement task is running')
+  t.equal(queue.length(), 0, 'no tasks remain queued')
+  t.notOk(resolved, 'rejection does not resolve while work runs')
+
+  await rejected.catch(function (err) {
+    t.equal(err.message, 'rejected', 'rejected work remains observable')
+  })
+  t.notOk(resolved, 'subscriber still waits for the running task')
+
+  finish()
+  await running
+  await idle
+  t.ok(resolved && queue.idle(), 'subscriber resolves after rejected work reaches idle')
+})
+
+test('onIdle resolves after queued work is removed', async function (t) {
+  let finish
+  const killQueue = buildQueue(worker, 1)
+  killQueue.pause()
+  killQueue.push(1)
+  t.equal(killQueue.running(), 0, 'kill starts with no worker')
+  t.equal(killQueue.length(), 1, 'kill starts with queued work')
+  const killIdle = killQueue.onIdle()
+  killQueue.kill()
+  await killIdle
+  t.ok(killQueue.idle(), 'kill subscriber resolves an idle queue')
+
+  const activeQueue = buildQueue(async function () {
+    return new Promise(function (resolve) {
+      finish = resolve
+    })
+  }, 1)
+
+  activeQueue.push(1)
+  activeQueue.push(2)
+  const activeIdle = activeQueue.onIdle()
+  t.equal(activeQueue.running(), 1, 'a worker is running before kill')
+  t.equal(activeQueue.length(), 1, 'a task is queued before kill')
+  activeQueue.kill()
+  t.equal(activeQueue.length(), 0, 'kill removes queued work')
+  await immediate()
+  t.notOk(activeQueue.idle(), 'kill does not remove the running worker')
+  finish()
+  await activeIdle
+  t.ok(activeQueue.idle(), 'kill subscriber resolves after the worker finishes')
+
+  const killAndDrainQueue = buildQueue(worker, 1)
+  let drainCalled = false
+  killAndDrainQueue.drain = function () {
