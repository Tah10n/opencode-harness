+  }
+  killAndDrainQueue.pause()
+  killAndDrainQueue.push(1)
+  t.equal(killAndDrainQueue.running(), 0, 'killAndDrain starts with no worker')
+  t.equal(killAndDrainQueue.length(), 1, 'killAndDrain starts with queued work')
+  const killAndDrainIdle = killAndDrainQueue.onIdle()
+  killAndDrainQueue.killAndDrain()
+  await killAndDrainIdle
+  t.ok(drainCalled && killAndDrainQueue.idle(), 'killAndDrain resolves an idle queue')
+
+  const abortQueue = buildQueue(worker, 1)
+  abortQueue.pause()
+  const aborted = abortQueue.push(1)
+  t.equal(abortQueue.running(), 0, 'abort starts with no worker')
+  t.equal(abortQueue.length(), 1, 'abort starts with queued work')
+  const abortIdle = abortQueue.onIdle()
+  abortQueue.abort()
+  await aborted.catch(function (err) {
+    t.equal(err.message, 'abort', 'abort rejects queued work')
+  })
+  await abortIdle
+  t.ok(abortQueue.idle(), 'abort subscriber resolves when the queue is idle')
+
+  async function worker () {}
+})
