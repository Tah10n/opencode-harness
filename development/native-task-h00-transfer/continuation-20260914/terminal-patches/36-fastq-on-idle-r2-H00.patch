+  finish.shift()()
+  t.equal(drainCalls, 1, 'drain is called')
+  t.equal(queue.running(), 1, 'reentrant work keeps the queue busy')
+  t.equal(queue.drain, drain, 'drain remains unchanged')
+
+  finish.shift()()
+
+  idle.then(function () {
+    t.equal(drainCalls, 2, 'drain is called for reentrant work')
+    t.ok(queue.idle(), 'idle resolves after drain callbacks finish')
