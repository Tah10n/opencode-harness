+/**
+ * Remove listeners for a given event whose context matches exactly.
+ *
+ * @param {EventEmitter} emitter Reference to the `EventEmitter` instance.
+ * @param {(String|Symbol)} evt The event name.
+ * @param {*} context The context to match.
+ * @returns {Number} The number of listeners removed.
+ * @private
+ */
+function removeListenersForContext(emitter, evt, context) {
+  var listeners = emitter._events[evt]
+    , remaining
+    , i;
+
+  if (!listeners) return 0;
+
+  if (listeners.fn) {
+    if (listeners.context === context) {
+      clearEvent(emitter, evt);
+      return 1;
+    }
+
+    return 0;
+  }
+
+  remaining = [];
+  for (i = 0; i < listeners.length; i++) {
+    if (listeners[i].context === context) continue;
+    remaining.push(listeners[i]);
+  }
+
+  if (remaining.length) {
+    emitter._events[evt] = remaining.length === 1 ? remaining[0] : remaining;
+  } else {
+    clearEvent(emitter, evt);
+  }
+
+  return listeners.length - remaining.length;
+}
