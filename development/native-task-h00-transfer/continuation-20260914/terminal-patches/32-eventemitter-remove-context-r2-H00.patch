+ * @param {*} context The context to match exactly.
+ * @returns {Number} The number of listeners removed.
+ * @public
+ */
+EventEmitter.prototype.removeListenersByContext = function removeListenersByContext(context) {
+  var events = this._events
+    , count = 0
+    , evt;
+
+  for (evt in events) {
+    if (has.call(events, evt)) count += removeListenersForContext(this, evt, context);
+  }
+
+  if (Object.getOwnPropertySymbols) {
+    var symbols = Object.getOwnPropertySymbols(events);
+    for (var i = 0; i < symbols.length; i++) {
+      count += removeListenersForContext(this, symbols[i], context);
+    }
+  }
+
+  return count;
+};
