+test('pruneExpired removes expired entries from both generations', t => {
+	const evicted = [];
+	const lru = new QuickLRU({
+		maxSize: 3,
+		onEviction(key, value) {
+			evicted.push([key, value]);
+		},
+	});
+
+	lru.set('expired-old', 'old', {maxAge: 0});
+	lru.set('live-old', 'old-live');
+	lru.set('another-old', 'another-live');
+	lru.set('expired-current', 'current', {maxAge: 0});
+	lru.set('live-current', 'current-live');
+
+	t.true(lru.expiresIn('expired-old') <= 0);
+	t.true(lru.expiresIn('expired-current') <= 0);
+	t.is(lru.__oldCache.has('expired-old'), true);
+	t.is(lru.__oldCache.has('expired-current'), false);
+	t.is(lru.pruneExpired(), 2);
+	t.deepEqual(evicted, [
+		['expired-current', 'current'],
+		['expired-old', 'old'],
+	]);
+	t.deepEqual([...lru.entriesAscending()], [
+		['live-old', 'old-live'],
+		['another-old', 'another-live'],
+		['live-current', 'current-live'],
+	]);
+});
+
+test('pruneExpired respects current entries that shadow old entries', t => {
+	const evicted = [];
+	const lru = new QuickLRU({
+		maxSize: 3,
+		onEviction(key, value) {
+			evicted.push([key, value]);
+		},
+	});
+
+	lru.set('shadowed', 'old', {maxAge: 0});
+	lru.set('old-live', 'old-live');
+	lru.set('resurrected', 'old-live');
+	lru.set('shadowed', 'current-live');
+	lru.set('resurrected', 'current', {maxAge: 0});
+
+	t.is(lru.expiresIn('shadowed'), Number.POSITIVE_INFINITY);
+	t.true(lru.expiresIn('resurrected') <= 0);
+	t.is(lru.__oldCache.has('shadowed'), true);
+	t.is(lru.__oldCache.has('resurrected'), true);
+	t.is(lru.pruneExpired(), 1);
+	t.deepEqual(evicted, [['resurrected', 'current']]);
+	t.is(lru.get('shadowed'), 'current-live');
+	t.is(lru.get('resurrected'), undefined);
+	t.deepEqual([...lru.entriesAscending()], [['old-live', 'old-live'], ['shadowed', 'current-live']]);
+});
+
+test('pruneExpired handles the expiry boundary, infinite TTL, undefined values, and reuse', t => {
+	const lru = new QuickLRU({maxSize: 2});
+	lru.set('boundary', undefined, {maxAge: 0});
+	lru.set('infinite', 'never', {maxAge: Number.POSITIVE_INFINITY});
+
+	t.is(lru.pruneExpired(), 1);
+	t.is(lru.pruneExpired(), 0);
+	t.true(lru.has('infinite'));
+	t.false(lru.has('boundary'));
+	t.true(lru.delete('infinite'));
+	t.is(lru.size, 0);
+	t.is(lru.pruneExpired(), 0);
+
+	lru.set('reused', undefined);
+	t.is(lru.get('reused'), undefined);
+	t.is(lru.size, 1);
+	t.deepEqual([...lru], [['reused', undefined]]);
+});
+
