+/**
+ * Parse a sum of duration terms and return milliseconds.
+ *
+ * @param str - A string of space-separated duration terms to parse
+ * @returns The summed value in milliseconds, or `NaN` if the string can't be
+ * parsed
+ */
+export function parseCompound(str: string): number {
+  if (typeof str !== 'string' || str.length === 0 || str.length > 100) {
+    throw new Error(
+      `Value provided to ms.parseCompound() must be a string with length between 1 and 99. value=${JSON.stringify(str)}`,
+    );
+  }
+
+  const unit =
+    '(?:milliseconds?|msecs?|ms|seconds?|secs?|s|minutes?|mins?|m|hours?|hrs?|h|days?|d|weeks?|w|months?|mo|years?|yrs?|y)';
+  const pattern = new RegExp(
+    `^-?\\d*\\.?\\d+ *${unit}(?: +\\d*\\.?\\d+ *${unit})*$`,
+    'i',
+  );
+
+  if (!pattern.test(str)) {
+    return NaN;
+  }
+
+  const negative = str.startsWith('-');
+  const matches = str
+    .replace(/^-/, '')
+    .matchAll(new RegExp(`\\d*\\.?\\d+ *${unit}(?= |$)`, 'gi'));
+  let total = 0;
+  for (const [term] of matches) {
+    total += parse(term);
+  }
+
+  return negative ? -total : total;
+}
