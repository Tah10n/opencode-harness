+import { describe, expect, it } from '@jest/globals';
+import { ms, parse, parseCompound, parseStrict } from './index';
+
+describe('parseCompound(string)', () => {
+  it('parses a single term with a space between the number and unit', () => {
+    expect(parseCompound('1 h')).toBe(3600000);
+  });
+
+  it('sums mixed-case, spelled, decimal, repeated, and reordered units', () => {
+    expect(
+      parseCompound(
+        '-1.5 HOURS 2 days 3 MONths 4 weeks 5 Minutes 6 SeConds 7 milliseconds 8 hr 9 DAY 0.5 years',
+      ),
+    ).toBe(
+      -(
+        1.5 * 3600000 +
+        2 * 86400000 +
+        3 * 2629800000 +
+        4 * 604800000 +
+        5 * 60000 +
+        6 * 1000 +
+        7 +
+        8 * 3600000 +
+        9 * 86400000 +
+        0.5 * 31557600000
+      ),
+    );
+  });
+
+  it('requires an explicit unit and complete terms', () => {
+    for (const value of [
+      '1 30m',
+      '1h 30',
+      '1h -30m',
+      '1h +30m',
+      '1h 30mfoo',
+      '1h, 30m',
+      '1h; 30m',
+      ' 1h 30m',
+      '1h 30m ',
+      '1h\t30m',
+      '1h\n30m',
+    ]) {
+      expect(Number.isNaN(parseCompound(value))).toBe(true);
+    }
+  });
+
+  it('throws for non-string, empty, and oversized inputs', () => {
+    expect(() => {
+      // @ts-expect-error - We expect this to throw.
+      parseCompound(undefined);
+    }).toThrow();
+    expect(() => {
+      // @ts-expect-error - We expect this to throw.
+      parseCompound(null);
+    }).toThrow();
+    expect(() => parseCompound('')).toThrow();
+    expect(() => parseCompound('1h'.repeat(51))).toThrow();
+  });
+
+  it('does not broaden the existing parsers', () => {
+    expect(Number.isNaN(parse('1h 30m'))).toBe(true);
+    // @ts-expect-error - Compound syntax is not a StringValue.
+    expect(Number.isNaN(parseStrict('1h 30m'))).toBe(true);
+    // @ts-expect-error - Compound syntax is not a StringValue.
+    expect(Number.isNaN(ms('1h 30m'))).toBe(true);
+  });
+});
