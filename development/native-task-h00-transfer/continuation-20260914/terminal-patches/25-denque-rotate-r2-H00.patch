+describe('Denque.prototype.rotate', function () {
+  it('should rotate in either direction and normalize counts', function () {
+    var a = new Denque([1, 2, 3, 4]);
+
+    assert.strictEqual(a.rotate(), a);
+    assert.deepEqual(a.toArray(), [4, 1, 2, 3]);
+
+    var b = new Denque([1, 2, 3, 4]);
+    assert.strictEqual(b.rotate(2), b);
+    assert.deepEqual(b.toArray(), [3, 4, 1, 2]);
+
+    var c = new Denque([1, 2, 3, 4]);
+    assert.strictEqual(c.rotate(-2), c);
+    assert.deepEqual(c.toArray(), [3, 4, 1, 2]);
+
+    var d = new Denque([1, 2, 3, 4]);
+    var before = d.toArray();
+    assert.strictEqual(d.rotate(0), d);
+    assert.deepEqual(d.toArray(), before);
+    assert.strictEqual(d.rotate(9007199254740991), d);
+    assert.deepEqual(d.toArray(), [2, 3, 4, 1]);
+    assert.strictEqual(d.rotate(-9007199254740991), d);
+    assert.deepEqual(d.toArray(), [1, 2, 3, 4]);
+  });
+
+  it('should preserve wrapped storage and capacity through deque operations', function () {
+    var wrapped = new Denque([1, 2, 3, 4, 5, 6]);
+    wrapped.shift();
+    wrapped.shift();
+    wrapped.push(7);
+    wrapped.push(8);
+    assert.deepEqual(wrapped.toArray(), [3, 4, 5, 6, 7, 8]);
+    var wrappedList = wrapped._list;
+    var wrappedCapacityMask = wrapped._capacityMask;
+
+    assert.strictEqual(wrapped.rotate(2), wrapped);
+    assert.deepEqual(wrapped.toArray(), [7, 8, 3, 4, 5, 6]);
+    assert.strictEqual(wrapped.length, 6);
+    assert.strictEqual(wrapped.peek(), 7);
+    assert.strictEqual(wrapped.peekBack(), 6);
+    assert.strictEqual(wrapped._list.length, wrappedList.length);
+    assert.strictEqual(wrapped._capacityMask, wrappedCapacityMask);
+    assert.strictEqual(wrapped.shift(), 7);
+    assert.strictEqual(wrapped.pop(), 6);
+    assert.strictEqual(wrapped.removeOne(1), 3);
+    assert.deepEqual(wrapped.toArray(), [8, 4, 5]);
+
+    var bounded = new Denque([1, 2, 3, 4], { capacity: 4 });
+    bounded.push(5);
+    assert.deepEqual(bounded.toArray(), [2, 3, 4, 5]);
+    var capacity = bounded._capacity;
+    var listLength = bounded._list.length;
+    assert.strictEqual(bounded.rotate(-1), bounded);
+    assert.deepEqual(bounded.toArray(), [3, 4, 5, 2]);
+    assert.strictEqual(bounded._capacity, capacity);
+    assert.strictEqual(bounded._list.length, listLength);
+    assert.strictEqual(bounded.shift(), 3);
+    assert.strictEqual(bounded.pop(), 2);
+    bounded.unshift(1);
