+Denque.prototype.rotate = function rotate(steps) {
+  if (steps === void 0) steps = 1;
+  if (typeof steps !== 'number' || !isFinite(steps) || steps % 1 !== 0) {
+    throw new Error('steps must be a finite integer');
+  }
+
+  var size = this.size();
+  if (size < 2) return this;
+
+  steps %= size;
+  if (steps < 0) steps += size;
+  if (steps === 0) return this;
+
+  var list = new Array(this._list.length);
+  var start = size - steps;
+  for (var i = 0; i < size; i++) {
+    list[i] = this._list[(this._head + (start + i) % size) & this._capacityMask];
+  }
+
+  this._list = list;
+  this._head = 0;
+  this._tail = size;
+  return this;
