diff --git a/test/on-event.ts b/test/on-event.ts
new file mode 100644
index 0000000..5d3cd51
--- /dev/null
+++ b/test/on-event.ts
@@ -0,0 +1,135 @@
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {getEventListeners} from 'node:events';
+import pDefer from 'p-defer';
+import PQueue from '../source/index.js';
+
+test('onEmpty supports independent cancellation while queued work drains', async () => {
+	const queue = new PQueue({concurrency: 2});
+	const running = pDefer<void>();
+	const otherRunning = pDefer<void>();
+	const queued = pDefer<void>();
+	const runningTask = queue.add(async () => running.promise);
+	const otherRunningTask = queue.add(async () => otherRunning.promise);
+	const queuedTask = queue.add(async () => queued.promise);
+	const abortedController = new AbortController();
+	const completingController = new AbortController();
+	const abortedWaiter = queue.onEmpty({signal: abortedController.signal});
+	const completingWaiter = queue.onEmpty({signal: completingController.signal});
+	const reason = new Error('stop waiting');
+
+	assert.equal(queue.size, 1);
+	assert.equal(queue.pending, 2);
+	assert.equal(queue.listenerCount('empty'), 2);
+	assert.equal(getEventListeners(abortedController.signal, 'abort').length, 1);
+
+	abortedController.abort(reason);
+	await assert.rejects(abortedWaiter, error => error === reason);
+	assert.equal(queue.listenerCount('empty'), 1);
+	assert.equal(getEventListeners(abortedController.signal, 'abort').length, 0);
+
+	running.resolve();
+	await runningTask;
+	otherRunning.resolve();
+	await otherRunningTask;
+	await completingWaiter;
+	assert.equal(queue.size, 0);
+	assert.equal(queue.pending, 1);
+	assert.equal(queue.listenerCount('empty'), 0);
+	assert.equal(getEventListeners(completingController.signal, 'abort').length, 0);
+
+	queued.resolve();
+	await queuedTask;
+	completingController.abort(new Error('too late'));
+});
+
+test('onIdle waits for queued work after the queue becomes empty', async () => {
+	const queue = new PQueue({concurrency: 1});
+	const running = pDefer<void>();
+	const queued = pDefer<void>();
+	const runningTask = queue.add(async () => running.promise);
+	const queuedTask = queue.add(async () => queued.promise);
+	const abortedController = new AbortController();
+	const completingController = new AbortController();
+	const abortedWaiter = queue.onIdle({signal: abortedController.signal});
+	const completingWaiter = queue.onIdle({signal: completingController.signal});
+	const reason = new Error('stop waiting');
+
+	assert.equal(queue.size, 1);
+	assert.equal(queue.pending, 1);
+	assert.equal(queue.listenerCount('idle'), 2);
+
+	abortedController.abort(reason);
+	await assert.rejects(abortedWaiter, error => error === reason);
+	assert.equal(queue.listenerCount('idle'), 1);
+
+	running.resolve();
+	await runningTask;
+	assert.equal(queue.size, 0);
+	assert.equal(queue.pending, 1);
+	assert.equal(queue.listenerCount('idle'), 1);
+
+	queued.resolve();
+	await queuedTask;
+	await completingWaiter;
+	assert.equal(queue.pending, 0);
+	assert.equal(queue.listenerCount('idle'), 0);
+	assert.equal(getEventListeners(completingController.signal, 'abort').length, 0);
+
+	completingController.abort(new Error('too late'));
+});
+
+test('onPendingZero ignores paused queued work and supports cancellation', async () => {
+	const queue = new PQueue({concurrency: 1});
+	const running = pDefer<void>();
+	const queued = pDefer<void>();
+	const runningTask = queue.add(async () => running.promise);
+	const queuedTask = queue.add(async () => queued.promise);
+	queue.pause();
+	const abortedController = new AbortController();
+	const completingController = new AbortController();
+	const abortedWaiter = queue.onPendingZero({signal: abortedController.signal});
+	const completingWaiter = queue.onPendingZero({signal: completingController.signal});
+	const reason = new Error('stop waiting');
+
+	assert.equal(queue.size, 1);
+	assert.equal(queue.pending, 1);
+	assert.equal(queue.listenerCount('pendingZero'), 2);
+
+	abortedController.abort(reason);
+	await assert.rejects(abortedWaiter, error => error === reason);
+	assert.equal(queue.listenerCount('pendingZero'), 1);
+
+	running.resolve();
+	await runningTask;
+	await completingWaiter;
+	assert.equal(queue.pending, 0);
+	assert.equal(queue.size, 1);
+	assert.equal(queue.listenerCount('pendingZero'), 0);
+	assert.equal(getEventListeners(completingController.signal, 'abort').length, 0);
+
+	queue.start();
+	queued.resolve();
+	await queuedTask;
+	await queue.onIdle();
+	completingController.abort(new Error('too late'));
+});
+
+test('waiters reject with an already-aborted signal even when initially satisfied', async () => {
+	const queue = new PQueue();
+	const reason = new Error('already stopped');
+	const controller = new AbortController();
+	controller.abort(reason);
+
+	await Promise.all([
+		assert.rejects(queue.onEmpty({signal: controller.signal}), error => error === reason),
+		assert.rejects(queue.onIdle({signal: controller.signal}), error => error === reason),
+		assert.rejects(queue.onPendingZero({signal: controller.signal}), error => error === reason),
+	]);
+
+	const activeController = new AbortController();
+	await queue.onEmpty({signal: activeController.signal});
+	await queue.onIdle({signal: activeController.signal});
+	await queue.onPendingZero({signal: activeController.signal});
+	assert.equal(getEventListeners(activeController.signal, 'abort').length, 0);
+});
