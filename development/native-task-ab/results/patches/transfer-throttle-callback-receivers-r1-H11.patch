+				{type: 'weight', context: secondContext, arguments: [4, 'second']},
+				{type: 'onDelay', context: secondContext, arguments: [4, 'second']},
+				{type: 'execution', context: secondContext, arguments: [4, 'second']},
+			]);
+		});
+	}
