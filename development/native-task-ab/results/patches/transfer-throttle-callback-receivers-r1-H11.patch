+
+			return 1;
+		},
+		onDelay() {
+			onDelayCalls++;
+		},
+	})(() => {
+		executions++;
+	});
+
+	const receiver = {name: 'receiver'};
+	t.is(throttled.queueSize, 0);
+	await throttled.call(receiver, 'good');
+	t.is(throttled.queueSize, 0);
+
+	const rejection = throttled.call(receiver, 'bad', 'argument');
+	t.is(throttled.queueSize, 0);
+	const error = await t.throwsAsync(rejection);
+	t.is(error, thrown);
+	t.is(weightCalls, 2);
+	t.is(onDelayCalls, 0);
+	t.is(executions, 1);
+});
