+		await withFakeTimers(async clock => {
+			const firstContext = {name: 'first'};
+			const secondContext = {name: 'second'};
+			const observations = [];
+			const throttled = pThrottle({
+				limit: 5,
+				interval: 100,
+				strict,
+				weight(value, label) {
+					observations.push({type: 'weight', context: this, arguments: [value, label]});
+					return value;
+				},
+				onDelay(value, label) {
+					observations.push({type: 'onDelay', context: this, arguments: [value, label]});
+				},
+			})(function (value, label) {
+				observations.push({type: 'execution', context: this, arguments: [value, label]});
+				return {context: this, arguments: [value, label]};
+			});
+
+			t.is(throttled.queueSize, 0);
+			const firstPromise = throttled.call(firstContext, 2, 'first');
+			t.is(throttled.queueSize, 0);
+			const secondPromise = throttled.call(secondContext, 4, 'second');
+			t.is(throttled.queueSize, 1);
+			t.deepEqual(observations, [
+				{type: 'weight', context: firstContext, arguments: [2, 'first']},
+				{type: 'execution', context: firstContext, arguments: [2, 'first']},
+				{type: 'weight', context: secondContext, arguments: [4, 'second']},
+				{type: 'onDelay', context: secondContext, arguments: [4, 'second']},
+			]);
+
+			clock.runNext();
+			const results = await Promise.all([firstPromise, secondPromise]);
+			t.deepEqual(results, [
+				{context: firstContext, arguments: [2, 'first']},
+				{context: secondContext, arguments: [4, 'second']},
