+test('listenerCount() - duplicate event names are counted once', async t => {
+	const emitter = new Emittery();
+	const symbol = Symbol('event');
+	const otherSymbol = Symbol('event');
+	const eventIterator = emitter.events('event');
+	const symbolIterator = emitter.events(symbol);
+	const anyIterator = emitter.anyEvent();
+
+	emitter.on('event', () => {});
+	emitter.on('event', () => {});
+	emitter.on(symbol, () => {});
+	emitter.on(otherSymbol, () => {});
+	emitter.onAny(() => {});
+	emitter.onAny(() => {});
+
+	// Check the stores used by listenerCount before checking the combined result.
+	t.is(emitter.listenerCount('event'), 6);
+	t.is(emitter.listenerCount(symbol), 5);
+	t.is(emitter.listenerCount(otherSymbol), 4);
+	t.is(emitter.listenerCount(['event', 'event', symbol, symbol, otherSymbol, otherSymbol]), 15);
+	t.is(emitter.listenerCount([]), 0);
+	t.is(emitter.listenerCount(), 9);
+	t.throws(() => emitter.listenerCount(['event', 'event', true]), {instanceOf: TypeError});
+
+	// Counting must not change listener or iterator state.
+	t.is(emitter.listenerCount('event'), 6);
+	t.is(emitter.listenerCount(), 9);
+
+	await Promise.all([
+		eventIterator.return(),
+		symbolIterator.return(),
+		anyIterator.return(),
+	]);
+});
+
