+test('clearQueue rejects pending promises with the exact reason and remains reusable', async t => {
+	const limit = pLimit({concurrency: 1, rejectOnClear: true});
+	let releaseRunning;
+	let queuedFunctionCalled = false;
+	const runningPromise = limit(() => new Promise(resolve => {
+		releaseRunning = resolve;
+	}));
+	const getRejection = async promise => {
+		try {
+			await promise;
+		} catch (error) {
+			return error;
+		}
+	};
+
+	const reason = {code: 'cleared'};
+	const pendingPromises = [
+		limit(() => {
+			queuedFunctionCalled = true;
+		}),
+		limit(() => {
+			queuedFunctionCalled = true;
+		}),
+	];
+
+	await Promise.resolve();
+	t.is(limit.activeCount, 1);
+	t.is(limit.pendingCount, 2);
+	limit.clearQueue(reason);
+	t.is(limit.activeCount, 1);
+	t.is(limit.pendingCount, 0);
+	t.is(await getRejection(pendingPromises[0]), reason);
+	t.is(await getRejection(pendingPromises[1]), reason);
+	t.false(queuedFunctionCalled);
+
+	releaseRunning();
+	await runningPromise;
+	t.is(limit.activeCount, 0);
+	const reusedPromise = limit(() => 'reused');
+	t.is(await reusedPromise, 'reused');
+	t.is(limit.activeCount, 0);
+	t.is(limit.pendingCount, 0);
+});
+
+test('limitFunction clearQueue rejects pending promises with exact primitive reasons', async t => {
+	const testReason = async reason => {
+		const limitedFunction = limitFunction(async () => {
+			await delay(20);
+		}, {concurrency: 1, rejectOnClear: true});
+		const runningPromise = limitedFunction();
+		const pendingPromise = limitedFunction();
+
+		await Promise.resolve();
+		limitedFunction.clearQueue(reason);
+
+		let rejection;
+		try {
+			await pendingPromise;
+		} catch (error) {
+			rejection = error;
+		}
+
+		t.is(rejection, reason);
+		await runningPromise;
+	};
+
+	await Promise.all([null, false, 0, 'cleared'].map(reason => testReason(reason)));
+});
+
+test('clearQueue ignores reasons when rejection is disabled', async t => {
+	const limit = pLimit(1);
+	let queuedFunctionCalled = false;
+	const runningPromise = limit(() => delay(20));
+	const pendingPromise = limit(() => {
+		queuedFunctionCalled = true;
+	});
+
+	await Promise.resolve();
+	t.is(limit.pendingCount, 1);
+	limit.clearQueue('ignored');
+	t.is(limit.pendingCount, 0);
+	const pendingState = (async () => {
+		try {
+			await pendingPromise;
+		} catch {}
+
+		return 'settled';
+	})();
+	const timeoutState = (async () => {
+		await delay(10);
+		return 'pending';
+	})();
+	t.is(await Promise.race([pendingState, timeoutState]), 'pending');
+	t.false(queuedFunctionCalled);
+	await runningPromise;
+});
