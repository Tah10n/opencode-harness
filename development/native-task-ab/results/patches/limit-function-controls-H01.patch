--- a/readme.md
+++ b/readme.md
@@ -162,6 +162,18 @@ When `rejectOnClear` is enabled, pending promises are rejected with an `AbortErr
 
 This does not cancel calls that are already running.
 
+### limitedFunction.activeCount
+
+The number of calls that are currently running.
+
+### limitedFunction.pendingCount
+
+The number of calls that are waiting to run.
+
+### limitedFunction.concurrency
+
+Get or set the concurrency limit for this `limitedFunction`. Changing the limit updates only this function's queue and immediately starts pending calls when the limit is increased.
+
 ## Recipes
 
 See [recipes.md](recipes.md) for common use cases and patterns.
diff --git a/test.js b/test.js
index 356c4d8..43d82e3 100644
--- a/test.js
+++ b/test.js
@@ -387,3 +387,109 @@ test('limitFunction()', async t => {
 
 	await Promise.all(input);
 });
+
+test('limitFunction preserves arguments, results, and rejections', async t => {
+	const error = new Error('test error');
+	const limitedFunction = limitFunction(async (value, shouldReject) => {
+		if (shouldReject) {
+			throw error;
+		}
+
+		return value * 2;
+	}, {concurrency: 1});
+
+	t.is(await limitedFunction(2, false), 4);
+	await t.throwsAsync(limitedFunction(2, true), {is: error});
+	t.is(await limitedFunction(3, false), 6);
+});
+
+test('limitFunction exposes live limiter controls', async t => {
+	let releaseBlocker;
+	const blocker = new Promise(resolve => {
+		releaseBlocker = resolve;
+	});
+	let releaseQueued;
+	const queuedBlocker = new Promise(resolve => {
+		releaseQueued = resolve;
+	});
+	let started = 0;
+
+	const limitedFunction = limitFunction(async value => {
+		started++;
+		await (value === 0 ? blocker : queuedBlocker);
+
+		return value;
+	}, {concurrency: 1});
+
+	const first = limitedFunction(0);
+	const second = limitedFunction(1);
+	const third = limitedFunction(2);
+	await delay(0);
+
+	t.is(limitedFunction.activeCount, 1);
+	t.is(limitedFunction.pendingCount, 2);
+	t.is(started, 1);
+
+	limitedFunction.concurrency = 3;
+	await delay(0);
+
+	t.is(limitedFunction.activeCount, 3);
+	t.is(limitedFunction.pendingCount, 0);
+	t.is(started, 3);
+
+	releaseBlocker();
+	releaseQueued();
+	t.deepEqual(await Promise.all([first, second, third]), [0, 1, 2]);
+	t.is(limitedFunction.activeCount, 0);
+});
+
+test('limitFunction rejects invalid concurrency', t => {
+	const limitedFunction = limitFunction(async () => {}, {concurrency: 1});
+
+	t.throws(() => {
+		limitedFunction.concurrency = 0;
+	}, {instanceOf: TypeError});
+	t.is(limitedFunction.concurrency, 1);
+});
+
+test('limitFunction wrappers have independent capacity', async t => {
+	let releaseFirst;
+	const firstBlocker = new Promise(resolve => {
+		releaseFirst = resolve;
+	});
+	let releaseSecond;
+	const secondBlocker = new Promise(resolve => {
+		releaseSecond = resolve;
+	});
+	const first = limitFunction(async value => {
+		await firstBlocker;
+		return value;
+	}, {concurrency: 1});
+	const second = limitFunction(async value => {
+		await secondBlocker;
+		return value;
+	}, {concurrency: 1});
+
+	const firstRunning = first(0);
+	const firstPending = first(1);
+	const secondRunning = second(0);
+	const secondPending = second(1);
+	await delay(0);
+
+	t.is(first.activeCount, 1);
+	t.is(first.pendingCount, 1);
+	t.is(second.activeCount, 1);
+	t.is(second.pendingCount, 1);
+
+	first.concurrency = 2;
+	await delay(0);
+
+	t.is(first.activeCount, 2);
+	t.is(first.pendingCount, 0);
+	t.is(second.activeCount, 1);
+	t.is(second.pendingCount, 1);
+
+	releaseFirst();
+	releaseSecond();
+	t.deepEqual(await Promise.all([firstRunning, firstPending, secondRunning, secondPending]), [0, 1, 0, 1]);
+});
