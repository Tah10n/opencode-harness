+test('limitFunction exposes live limiter controls', async t => {
+	const resolvers = new Map();
+	const started = [];
+	const limitedFunction = limitFunction(async value => {
+		started.push(value);
+		return new Promise(resolve => {
+			resolvers.set(value, () => resolve(value));
+		});
+	}, {concurrency: 1});
+
+	const independentResolvers = new Map();
+	const independentFunction = limitFunction(async value => new Promise(resolve => {
+		independentResolvers.set(value, () => resolve(value));
+	}), {concurrency: 1});
+
+	const runningPromise = limitedFunction('running');
+	const queuedPromiseOne = limitedFunction('queued-one');
+	const queuedPromiseTwo = limitedFunction('queued-two');
+	const independentPromise = independentFunction('independent');
+
+	await delay(0);
+	// Check the actual limiter state before changing the setting.
+	t.is(limitedFunction.activeCount, 1);
+	t.is(limitedFunction.pendingCount, 2);
+	t.deepEqual(started, ['running']);
+	t.is(independentFunction.activeCount, 1);
+	t.is(independentFunction.pendingCount, 0);
+
+	t.throws(() => {
+		limitedFunction.concurrency = 0;
+	}, {instanceOf: TypeError});
+	t.is(limitedFunction.concurrency, 1);
+
+	limitedFunction.concurrency = 2;
+	await delay(0);
+	t.is(limitedFunction.activeCount, 2);
+	t.is(limitedFunction.pendingCount, 1);
+	t.deepEqual(started, ['running', 'queued-one']);
+	t.is(independentFunction.activeCount, 1);
+
+	resolvers.get('running')();
+	await delay(0);
+	t.deepEqual(started, ['running', 'queued-one', 'queued-two']);
+
+	resolvers.get('queued-one')();
+	resolvers.get('queued-two')();
+	independentResolvers.get('independent')();
+	t.deepEqual(await Promise.all([runningPromise, queuedPromiseOne, queuedPromiseTwo, independentPromise]), ['running', 'queued-one', 'queued-two', 'independent']);
+	t.is(limitedFunction.activeCount, 0);
+	t.is(limitedFunction.pendingCount, 0);
+	t.is(independentFunction.activeCount, 0);
+});
+
