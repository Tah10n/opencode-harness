+test('listenerCount() - deduplicates event names without changing listener state', async t => {
+	const emitter = new Emittery();
+	const firstSymbol = Symbol('same description');
+	const secondSymbol = Symbol('same description');
+	emitter.on('alpha', () => {});
+	emitter.on('alpha', () => {});
+	emitter.on('beta', () => {});
+	emitter.on(firstSymbol, () => {});
+	emitter.on(secondSymbol, () => {});
+	emitter.onAny(() => {});
+	emitter.onAny(() => {});
+	const alphaIterator = emitter.events('alpha');
+	const symbolIterator = emitter.events(firstSymbol);
+	const anyIterator = emitter.anyEvent();
+
+	// Check the state used by listenerCount before querying the array.
+	t.is(emitter.listenerCount('alpha'), 6);
+	t.is(emitter.listenerCount('beta'), 4);
+	t.is(emitter.listenerCount(firstSymbol), 5);
+	t.is(emitter.listenerCount(secondSymbol), 4);
+	t.is(emitter.listenerCount(), 10);
+
+	t.is(emitter.listenerCount(['alpha', 'alpha', 'beta', firstSymbol, firstSymbol, secondSymbol]), 19);
+	t.is(emitter.listenerCount([]), 0);
+	t.throws(() => emitter.listenerCount(['alpha', 'alpha', firstSymbol, firstSymbol, true]), {instanceOf: TypeError});
+	t.is(emitter.listenerCount(), 10);
+
+	await alphaIterator.return();
+	await symbolIterator.return();
+	await anyIterator.return();
+	t.is(emitter.listenerCount(), 7);
+});
+
