+
+test('.promise() clearQueue discards waiting calls and allows reuse', async () => {
+	let releaseFirst;
+	const firstGate = new Promise(resolve => {
+		releaseFirst = resolve;
+	});
+	const calls = [];
+	const debounced = pDebounce.promise(async function (value) {
+		calls.push({context: this, value});
+		if (value === 'first') {
+			await firstGate;
+		}
+
+		return `${this.label}-${value}`;
+	}, {after: true});
+
+	const firstPromise = debounced.call({label: 'first-context'}, 'first');
+	const discardedPromise1 = debounced.call({label: 'discarded-1'}, 'discarded-1');
+	const discardedPromise2 = debounced.call({label: 'discarded-2'}, 'discarded-2');
+	const reason = {reason: 'cleared'};
+
+	assert.equal(debounced.clearQueue(reason), 2);
+	assert.equal(debounced.clearQueue(), 0);
+	assert.deepEqual(await Promise.allSettled([discardedPromise1, discardedPromise2]), [
+		{status: 'rejected', reason},
+		{status: 'rejected', reason},
+	]);
+
+	// Calls made after clearing can replace the new queued invocation.
+	const reusedPromise1 = debounced.call({label: 'reused-1'}, 'reused-1');
+	const reusedPromise2 = debounced.call({label: 'reused-2'}, 'reused-2');
+	releaseFirst();
+
+	assert.deepEqual(await Promise.all([firstPromise, reusedPromise1, reusedPromise2]), [
+		'first-context-first',
+		'reused-2-reused-2',
+		'reused-2-reused-2',
+	]);
+	assert.deepEqual(calls, [
+		{context: {label: 'first-context'}, value: 'first'},
+		{context: {label: 'reused-2'}, value: 'reused-2'},
+	]);
+	assert.equal(await debounced.call({label: 'idle'}, 'idle'), 'idle-idle');
+});
+
+test('.promise() clearQueue uses an AbortError by default and preserves custom reasons', async () => {
+	for (const reason of [undefined, null, false, 0]) {
+		let release;
+		const gate = new Promise(resolve => {
+			release = resolve;
+		});
+		let callCount = 0;
+		const debounced = pDebounce.promise(async value => {
+			callCount++;
+			if (value === 'active') {
+				await gate;
+			}
+
+			return value;
+		}, {after: true});
+
+		const activePromise = debounced('active');
+		const queuedPromise = debounced('queued');
+		assert.equal(debounced.clearQueue(reason), 1);
+		// eslint-disable-next-line no-await-in-loop
+		const result = await Promise.allSettled([queuedPromise]);
+
+		if (reason === undefined) {
+			assert.equal(result[0].status, 'rejected');
+			assert.equal(result[0].reason.name, 'AbortError');
+		} else {
+			assert.equal(result[0].reason, reason);
+		}
+
+		release();
+		// eslint-disable-next-line no-await-in-loop
+		assert.equal(await activePromise, 'active');
+		assert.equal(callCount, 1);
+	}
+});
+
+test('.promise() clearQueue does not affect active execution or default-mode sharing', async () => {
+	let release;
+	const gate = new Promise(resolve => {
+		release = resolve;
+	});
+	const activeError = new Error('active error');
+	const debounced = pDebounce.promise(async value => {
+		await gate;
+		if (value === 'error') {
+			throw activeError;
+		}
+
+		return value;
+	});
+
+	const firstPromise = debounced('error');
+	const secondPromise = debounced('ignored');
+	assert.equal(debounced.clearQueue({}), 0);
+	release();
+	await assert.rejects(firstPromise, error => error === activeError);
+	await assert.rejects(secondPromise, error => error === activeError);
+
+	let resolveActive;
+	const activeGate = new Promise(resolve => {
+		resolveActive = resolve;
+	});
+	const afterDebounced = pDebounce.promise(async value => {
+		if (value === 'active') {
+			await activeGate;
+		}
+
+		return value;
+	}, {after: true});
+
+	const activePromise = afterDebounced('active');
+	const queuedPromise = afterDebounced('queued');
+	assert.equal(afterDebounced.clearQueue(), 1);
+	resolveActive();
+	assert.equal(await activePromise, 'active');
+	await assert.rejects(queuedPromise, error => error.name === 'AbortError');
+});
+
+test('.promise() clearQueue does not discard an invocation after it starts', async () => {
+	let releaseFirst;
+	let releaseSecond;
+	let secondStarted;
+	const firstGate = new Promise(resolve => {
+		releaseFirst = resolve;
+	});
+	const secondGate = new Promise(resolve => {
+		releaseSecond = resolve;
+	});
+	const started = new Promise(resolve => {
+		secondStarted = resolve;
+	});
+	const debounced = pDebounce.promise(async value => {
+		if (value === 'first') {
+			await firstGate;
+		}
+
+		if (value === 'second') {
+			secondStarted();
+			await secondGate;
+		}
+
+		return value;
+	}, {after: true});
+
+	const firstPromise = debounced('first');
+	const secondPromise = debounced('second');
+	releaseFirst();
+	await started;
+	assert.equal(debounced.clearQueue(), 0);
+	releaseSecond();
+
+	assert.deepEqual(await Promise.all([firstPromise, secondPromise]), ['first', 'second']);
+});
+
+test('.promise() clearQueue is independent for each wrapper', async () => {
+	let releaseOne;
+	let releaseTwo;
+	const gateOne = new Promise(resolve => {
+		releaseOne = resolve;
+	});
+	const gateTwo = new Promise(resolve => {
+		releaseTwo = resolve;
+	});
+	const debouncedOne = pDebounce.promise(async value => {
+		await gateOne;
+		return value;
+	}, {after: true});
+	const debouncedTwo = pDebounce.promise(async value => {
+		await gateTwo;
+		return value;
+	}, {after: true});
+
+	const one = debouncedOne('one');
+	const oneQueued = debouncedOne('one-queued');
+	const two = debouncedTwo('two');
+	const twoQueued = debouncedTwo('two-queued');
+	const reason = {};
+	assert.equal(debouncedOne.clearQueue(reason), 1);
+	assert.equal(debouncedTwo.clearQueue(), 1);
+
+	releaseOne();
+	releaseTwo();
+	assert.equal(await one, 'one');
+	assert.equal(await two, 'two');
+	await assert.rejects(oneQueued, error => error === reason);
+	await assert.rejects(twoQueued, error => error.name === 'AbortError');
+});
