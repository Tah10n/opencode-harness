diff --git a/test.js b/test.js
index 356c4d8..3a86884 100644
--- a/test.js
+++ b/test.js
@@ -387,3 +387,100 @@ test('limitFunction()', async t => {
 
 	await Promise.all(input);
 });
+
+test('limitFunction exposes live controls', async t => {
+	const gates = Array.from({length: 3}, () => {
+		let resolveGate;
+		const promise = new Promise(resolve => {
+			resolveGate = resolve;
+		});
+
+		return {promise, resolve: resolveGate};
+	});
+
+	let started = 0;
+	const limitedFunction = limitFunction(async value => {
+		started++;
+		await gates[value].promise;
+		return value * 2;
+	}, {concurrency: 1});
+
+	const promises = [0, 1, 2].map(value => limitedFunction(value));
+	await delay(0);
+
+	t.is(started, 1);
+	t.is(limitedFunction.activeCount, 1);
+	t.is(limitedFunction.pendingCount, 2);
+
+	limitedFunction.concurrency = 2;
+	await delay(0);
+
+	t.is(started, 2);
+	t.is(limitedFunction.activeCount, 2);
+	t.is(limitedFunction.pendingCount, 1);
+
+	for (const gate of gates) {
+		gate.resolve();
+	}
+
+	t.deepEqual(await Promise.all(promises), [0, 2, 4]);
+	t.is(limitedFunction.activeCount, 0);
+	t.is(limitedFunction.pendingCount, 0);
+});
+
+test('limitFunction validates concurrency changes', t => {
+	const limitedFunction = limitFunction(async () => {}, {concurrency: 1});
+
+	t.throws(() => {
+		limitedFunction.concurrency = 0;
+	}, {instanceOf: TypeError});
+
+	t.is(limitedFunction.concurrency, 1);
+});
+
+test('limitFunction instances have independent controls', async t => {
+	const createGate = () => {
+		let resolveGate;
+		const promise = new Promise(resolve => {
+			resolveGate = resolve;
+		});
+
+		return {promise, resolve: resolveGate};
+	};
+
+	const firstGates = [createGate(), createGate()];
+	const secondGates = [createGate(), createGate()];
+	const first = limitFunction(async value => {
+		await firstGates[value].promise;
+		return `first-${value}`;
+	}, {concurrency: 1});
+	const second = limitFunction(async value => {
+		await secondGates[value].promise;
+		return `second-${value}`;
+	}, {concurrency: 1});
+
+	const firstPromises = [first(0), first(1)];
+	const secondPromises = [second(0), second(1)];
+	await delay(0);
+
+	t.is(first.activeCount, 1);
+	t.is(first.pendingCount, 1);
+	t.is(second.activeCount, 1);
+	t.is(second.pendingCount, 1);
+
+	first.concurrency = 2;
+	await delay(0);
+
+	t.is(first.activeCount, 2);
+	t.is(first.pendingCount, 0);
+	t.is(second.activeCount, 1);
+	t.is(second.pendingCount, 1);
+	t.is(second.concurrency, 1);
+
+	for (const gate of [...firstGates, ...secondGates]) {
+		gate.resolve();
+	}
+
+	t.deepEqual(await Promise.all(firstPromises), ['first-0', 'first-1']);
+	t.deepEqual(await Promise.all(secondPromises), ['second-0', 'second-1']);
+});
