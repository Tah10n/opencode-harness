+test('.clear() excludes active tasks and leaves their tracking and promises intact', async () => {
+	const {resolve, promise: activePromise} = pDefer<void>();
+	const queue = new PQueue({concurrency: 1});
+
+	const activeTask = queue.add(async () => activePromise);
+	const queuedTask1 = queue.add(async () => fixture);
+	const queuedTask2 = queue.add(async () => fixture);
+
+	assert.equal(queue.pending, 1);
+	assert.equal(queue.size, 2);
+	assert.equal(queue.runningTasks.length, 1);
+
+	assert.equal(queue.clear(), 2);
+	assert.equal(queue.pending, 1);
+	assert.equal(queue.size, 0);
+	assert.equal(queue.runningTasks.length, 1);
+
+	const queuedTasksSettled = (async () => {
+		await Promise.allSettled([queuedTask1, queuedTask2]);
+		return 'settled';
+	})();
+	const timeout = (async () => {
+		await delay(20);
+		return 'pending';
+	})();
+	assert.equal(await Promise.race([queuedTasksSettled, timeout]), 'pending');
+
+	resolve();
+	await activeTask;
+	assert.equal(queue.pending, 0);
+});
