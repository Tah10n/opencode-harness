 import PQueue from '../source/index.js';
+import {type Queue, type RunFunction} from '../source/queue.js';
+import {type QueueAddOptions} from '../source/options.js';
 
 const fixture = Symbol('fixture');
+type CustomQueueItem = {
+	run: RunFunction;
+	id?: string;
+	priority: number;
+};
+
+class CustomQueue implements Queue<RunFunction, QueueAddOptions> {
+	readonly #queue: CustomQueueItem[] = [];
+
+	enqueue(run: RunFunction, options?: Partial<QueueAddOptions>): void {
+		this.#queue.push({run, id: options?.id, priority: options?.priority ?? 0});
+	}
+
+	dequeue(): RunFunction | undefined {
+		return this.#queue.shift()?.run;
+	}
+
+	filter(options: Readonly<Partial<QueueAddOptions>>): RunFunction[] {
+		return this.#queue.filter(item => options.priority === undefined || item.priority === options.priority).map(item => item.run);
+	}
+
+	setPriority(id: string, priority: number): void {
+		const item = this.#queue.find(item => item.id === id);
+		if (item) {
+			item.priority = priority;
+		}
+	}
+
+	get size(): number {
+		return this.#queue.length;
+	}
+}
 
