+
+	debounced.clearQueue = reason => {
+		if (!queuedCall) {
+			return 0;
+		}
+
+		const {resolvers} = queuedCall;
+		queuedCall = undefined;
+
+		const rejectionReason = reason === undefined
+			? Object.assign(new Error('The queued call was aborted'), {name: 'AbortError'})
