@@ -127,6 +127,26 @@ debouncedSave('data2'); // This will run after the first save completes
 //=> Saved: data2
 ```
 
+##### clearQueue(reason?)
+
+Type: `(reason?: unknown) => number`
+
+Discard the queued latest-arguments invocation when `after` is `true`. All
+promises waiting for that invocation are rejected with `reason`, and the
+return value is the number of waiting calls discarded. If `reason` is omitted
+or `undefined`, the rejection reason is an error with the name `AbortError`.
+The currently executing call is not affected. With the default `after: false`,
+there is no queue to clear and this returns `0`.
+
+```js
+debouncedSave('data1');
+const promise = debouncedSave('data2');
+const discarded = debouncedSave.clearQueue(new Error('No longer needed'));
+//=> discarded === 1
+await promise.catch(error => console.log(error.message));
+//=> No longer needed
+```
+
