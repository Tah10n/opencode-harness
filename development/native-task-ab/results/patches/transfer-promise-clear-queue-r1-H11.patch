@@ -0,0 +1,165 @@
+import {test} from 'node:test';
+import {strict as assert} from 'node:assert';
+import pDebounce from './index.js';
+
+test('.promise() clearQueue discards queued calls and preserves active work', async () => {
+	let release;
+	const gate = new Promise(resolve => {
+		release = resolve;
+	});
+	const calls = [];
+	const debounced = pDebounce.promise(async function (value) {
+		calls.push({context: this, value});
+		if (value === 'first') {
+			await gate;
+		}
+
+		return `${this.name}-${value}`;
+	}, {after: true});
+	const firstContext = {name: 'first'};
+	const nextContext = {name: 'next'};
+
+	const firstPromise = debounced.call(firstContext, 'first');
+	assert.deepEqual(calls, [{context: firstContext, value: 'first'}]);
+
+	const queuedPromise1 = debounced.call({name: 'discarded-1'}, 'discarded-1');
+	const queuedPromise2 = debounced.call({name: 'discarded-2'}, 'discarded-2');
+	assert.equal(calls.length, 1);
+
+	const reason = {name: 'no longer needed'};
+	assert.equal(debounced.clearQueue(reason), 2);
+	assert.equal(debounced.clearQueue(reason), 0);
+	assert.deepEqual(await Promise.allSettled([queuedPromise1, queuedPromise2]), [
+		{status: 'rejected', reason},
+		{status: 'rejected', reason},
+	]);
+
+	const assertCleared = async customReason => {
+		const promise = debounced('discarded');
+		assert.equal(debounced.clearQueue(customReason), 1);
+		const [result] = await Promise.allSettled([promise]);
+		assert.equal(result.reason, customReason);
+	};
+
+	await assertCleared(null);
+	await assertCleared(false);
+	await assertCleared(0);
+
+	// The active call remains blocked, so this call creates a new queue.
+	const nextPromise = debounced.call(nextContext, 'next');
+	assert.deepEqual(calls, [{context: firstContext, value: 'first'}]);
+	release();
+
+	assert.equal(await firstPromise, 'first-first');
+	assert.equal(await nextPromise, 'next-next');
+	assert.deepEqual(calls.map(call => call.value), ['first', 'next']);
+	assert.equal(await debounced.call(nextContext, 'idle'), 'next-idle');
+});
+
+test('.promise() clearQueue uses AbortError and preserves a later active rejection', async () => {
+	let releaseFirst;
+	let releaseSecond;
+	let resolveSecondStarted;
+	const firstGate = new Promise(resolve => {
+		releaseFirst = resolve;
+	});
+	const secondGate = new Promise(resolve => {
+		releaseSecond = resolve;
+	});
+	const secondStarted = new Promise(resolve => {
+		resolveSecondStarted = resolve;
+	});
+	const activeError = new Error('active failure');
+	const calls = [];
+	const debounced = pDebounce.promise(async value => {
+		calls.push(value);
+		if (value === 'first') {
+			await firstGate;
+		}
+
+		if (value === 'second') {
+			resolveSecondStarted();
+			await secondGate;
+			throw activeError;
+		}
+
+		return value;
+	}, {after: true});
+
+	const firstPromise = debounced('first');
+	const secondPromise = debounced('second');
+	assert.deepEqual(calls, ['first']);
+	releaseFirst();
+	await secondStarted;
+
+	const discardedPromise1 = debounced('discarded-1');
+	const discardedPromise2 = debounced('discarded-2');
+	assert.equal(debounced.clearQueue(undefined), 2);
+	const discardedResults = await Promise.allSettled([discardedPromise1, discardedPromise2]);
+	assert.equal(discardedResults[0].status, 'rejected');
+	assert.equal(discardedResults[1].status, 'rejected');
+	assert.equal(discardedResults[0].reason.name, 'AbortError');
+	assert.equal(discardedResults[1].reason, discardedResults[0].reason);
+
+	releaseSecond();
+	assert.equal(await firstPromise, 'first');
+	await assert.rejects(secondPromise, error => error === activeError);
+	assert.deepEqual(calls, ['first', 'second']);
+	assert.equal(debounced.clearQueue(), 0);
+});
+
+test('.promise() clearQueue is a no-op for default mode and wrappers are independent', async () => {
+	let release;
+	const gate = new Promise(resolve => {
+		release = resolve;
+	});
+	let callCount = 0;
+	const debounced = pDebounce.promise(async value => {
+		callCount++;
+		await gate;
+		return value;
+	});
+
+	const firstPromise = debounced('first');
+	const sharedPromise = debounced('second');
+	assert.equal(callCount, 1);
+	assert.equal(debounced.clearQueue('ignored'), 0);
+	release();
+	assert.deepEqual(await Promise.all([firstPromise, sharedPromise]), ['first', 'first']);
+
+	let releaseA;
+	let releaseB;
+	const gateA = new Promise(resolve => {
+		releaseA = resolve;
+	});
+	const gateB = new Promise(resolve => {
+		releaseB = resolve;
+	});
+	const callsA = [];
+	const callsB = [];
+	const wrapperA = pDebounce.promise(async value => {
+		callsA.push(value);
+		await gateA;
+		return value;
+	}, {after: true});
+	const wrapperB = pDebounce.promise(async value => {
+		callsB.push(value);
+		await gateB;
+		return value;
+	}, {after: true});
+
+	const activeA = wrapperA('active-a');
+	const queuedA = wrapperA('queued-a');
+	const activeB = wrapperB('active-b');
+	const queuedB = wrapperB('queued-b');
+	assert.equal(wrapperA.clearQueue(), 1);
+	assert.equal(wrapperB.clearQueue(), 1);
+	releaseA();
+	releaseB();
+	await activeA;
+	await activeB;
+	assert.deepEqual(callsA, ['active-a']);
+	assert.deepEqual(callsB, ['active-b']);
+	await assert.rejects(queuedA, {name: 'AbortError'});
+	await assert.rejects(queuedB, {name: 'AbortError'});
+});
