+test('bindMethods() - preflights all conflicts before binding', t => {
+	const emitter = new Emittery();
+	const target = {off: true};
+
+	t.throws(() => {
+		emitter.bindMethods(target, ['on', 'emit', 'off']);
+	});
+
+	t.false(Object.hasOwn(target, 'on'));
+	t.false(Object.hasOwn(target, 'emit'));
+	t.is(target.off, true);
+});
+
+test('bindMethods() - preflights non-configurable undefined properties', t => {
+	const emitter = new Emittery();
+	const target = {};
+	Object.defineProperty(target, 'emit', {
+		value: undefined,
+		configurable: false,
+	});
+
+	t.throws(() => {
+		emitter.bindMethods(target, ['on', 'emit']);
+	});
+
+	t.false(Object.hasOwn(target, 'on'));
+	t.is(Object.getOwnPropertyDescriptor(target, 'emit').value, undefined);
+});
+
+test('bindMethods() - rejects inherited conflicts and non-extensible targets', t => {
+	const inheritedTarget = Object.create({emit: true});
+
+	t.throws(() => {
+		new Emittery().bindMethods(inheritedTarget, ['on', 'emit']);
+	});
+
+	t.false(Object.hasOwn(inheritedTarget, 'on'));
+
+	const nonExtensibleTarget = Object.preventExtensions({});
+	t.throws(() => {
+		new Emittery().bindMethods(nonExtensibleTarget, ['on']);
+	});
+	t.false(Object.hasOwn(nonExtensibleTarget, 'on'));
+});
+
+test('bindMethods() - treats duplicate method names as one binding', t => {
+	const emitter = new Emittery();
+	const target = {};
+
+	emitter.bindMethods(target, ['emit', 'emit']);
+
+	t.is(Object.getOwnPropertyNames(target).length, 1);
+	t.is(target.emit, target.emit);
+});
+
+test('bindMethods() - preserves existing undefined property flags and receiver', async t => {
+	const emitter = new Emittery();
+	const target = {};
+	Object.defineProperty(target, 'emit', {
+		value: undefined,
+		writable: false,
+		enumerable: true,
+		configurable: true,
+	});
+
+	emitter.bindMethods(target, ['emit']);
+
+	const descriptor = Object.getOwnPropertyDescriptor(target, 'emit');
+	t.is(descriptor.enumerable, false);
+	t.is(descriptor.writable, false);
+	t.is(descriptor.configurable, true);
+	await target.emit('event');
+	t.is(emitter.listenerCount('event'), 0);
+});
