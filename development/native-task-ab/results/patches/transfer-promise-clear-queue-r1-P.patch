+++ b/clear-queue.test.js
@@ -0,0 +1,253 @@
+import {test} from 'node:test';
+import {strict as assert} from 'node:assert';
+import pDebounce from './index.js';
+
+for (const reason of [null, false, 0, {code: 'cleared'}]) {
+	test(`.promise() clearQueue preserves custom reason ${String(reason)}`, async () => {
+		let release;
+		const gate = new Promise(resolve => {
+			release = resolve;
+		});
+		const calls = [];
+		const debounced = pDebounce.promise(async value => {
+			calls.push(value);
+			if (value === 'active') {
+				await gate;
+			}
+
+			return value;
+		}, {after: true});
+
+		const active = debounced('active');
+		const discarded = [debounced('discarded-1'), debounced('discarded-2')];
+
+		assert.equal(debounced.clearQueue(reason), 2);
+		assert.equal(debounced.clearQueue(reason), 0);
+		release();
+
+		assert.equal(await active, 'active');
+		const results = await Promise.allSettled(discarded);
+		assert.equal(results[0].status, 'rejected');
+		assert.equal(results[0].reason, reason);
+		assert.equal(results[1].status, 'rejected');
+		assert.equal(results[1].reason, reason);
+		assert.deepEqual(calls, ['active']);
+	});
+}
+
+test('.promise() clearQueue uses AbortError for omitted and undefined reasons', async () => {
+	let release;
+	const gate = new Promise(resolve => {
+		release = resolve;
+	});
+	const calls = [];
+	const debounced = pDebounce.promise(async value => {
+		calls.push(value);
+		if (value === 'active') {
+			await gate;
+		}
+
+		return value;
+	}, {after: true});
+
+	const active = debounced('active');
+	const discarded1 = debounced('discarded-1');
+	assert.equal(debounced.clearQueue(), 1);
+	const discarded2 = debounced('discarded-2');
+	assert.equal(debounced.clearQueue(undefined), 1);
+	assert.equal(debounced.clearQueue(), 0);
+	release();
+
+	assert.equal(await active, 'active');
+	const results = await Promise.allSettled([discarded1, discarded2]);
+	assert.equal(results[0].status, 'rejected');
+	assert.equal(results[0].reason.name, 'AbortError');
+	assert.equal(results[1].status, 'rejected');
+	assert.equal(results[1].reason.name, 'AbortError');
+
+	assert.deepEqual(calls, ['active']);
+	assert.equal(await debounced('idle'), 'idle');
+});
+
+test('.promise() clearQueue allows a replacement queue with latest context and arguments', async () => {
+	let release;
+	const gate = new Promise(resolve => {
+		release = resolve;
+	});
+	const calls = [];
+	const firstContext = {name: 'first'};
+	const secondContext = {name: 'second'};
+	const thirdContext = {name: 'third'};
+	const debounced = pDebounce.promise(async function (value) {
+		calls.push({context: this, value});
+		if (value === 'active') {
+			await gate;
+		}
+
+		return `${this.name}-${value}`;
+	}, {after: true});
+
+	const active = debounced.call(firstContext, 'active');
+	const discarded = [
+		debounced.call(secondContext, 'discarded-1'),
+		debounced.call(secondContext, 'discarded-2'),
+	];
+	const reason = {code: 'replaced'};
+	assert.equal(debounced.clearQueue(reason), 2);
+
+	const replacement1 = debounced.call(secondContext, 'replacement-1');
+	const replacement2 = debounced.call(thirdContext, 'replacement-2');
+	release();
+
+	assert.equal(await active, 'first-active');
+	const discardedResults = await Promise.allSettled(discarded);
+	assert.equal(discardedResults[0].reason, reason);
+	assert.equal(discardedResults[1].reason, reason);
+	assert.deepEqual(await Promise.all([replacement1, replacement2]), [
+		'third-replacement-2',
+		'third-replacement-2',
+	]);
+	assert.deepEqual(calls, [
+		{context: firstContext, value: 'active'},
+		{context: thirdContext, value: 'replacement-2'},
+	]);
+	assert.equal(await debounced.call(secondContext, 'idle'), 'second-idle');
+});
+
+test('.promise() clearQueue preserves an active rejection', async () => {
+	let release;
+	const gate = new Promise(resolve => {
+		release = resolve;
+	});
+	const error = new Error('active failure');
+	let callCount = 0;
+	const debounced = pDebounce.promise(async value => {
+		callCount++;
+		if (value === 'active') {
+			await gate;
+			throw error;
+		}
+
+		return value;
+	}, {after: true});
+
+	const active = debounced('active');
+	const discarded = debounced('discarded');
+	const reason = {code: 'cancelled'};
+	assert.equal(debounced.clearQueue(reason), 1);
+	release();
+
+	const [activeResult, discardedResult] = await Promise.allSettled([active, discarded]);
+	assert.equal(activeResult.status, 'rejected');
+	assert.equal(activeResult.reason, error);
+	assert.equal(discardedResult.status, 'rejected');
+	assert.equal(discardedResult.reason, reason);
+	assert.equal(callCount, 1);
+});
+
+test('.promise() clearQueue does not discard a queued call after it starts', async () => {
+	let releaseFirst;
+	let releaseSecond;
+	let secondStarted;
+	const firstGate = new Promise(resolve => {
+		releaseFirst = resolve;
+	});
+	const secondGate = new Promise(resolve => {
+		releaseSecond = resolve;
+	});
+	const started = new Promise(resolve => {
+		secondStarted = resolve;
+	});
+	const calls = [];
+	const debounced = pDebounce.promise(async value => {
+		calls.push(value);
+		if (value === 'first') {
+			await firstGate;
+		}
+
+		if (value === 'second') {
+			secondStarted();
+			await secondGate;
+		}
+
+		return value;
+	}, {after: true});
+
+	const first = debounced('first');
+	const second = debounced('second');
+	releaseFirst();
+	await started;
+
+	assert.equal(debounced.clearQueue(), 0);
+	const discarded = debounced('discarded');
+	const reason = new Error('later queue cleared');
+	assert.equal(debounced.clearQueue(reason), 1);
+	releaseSecond();
+
+	const results = await Promise.allSettled([first, second, discarded]);
+	assert.deepEqual(results.slice(0, 2), [
+		{status: 'fulfilled', value: 'first'},
+		{status: 'fulfilled', value: 'second'},
+	]);
+	assert.equal(results[2].status, 'rejected');
+	assert.equal(results[2].reason, reason);
+	assert.deepEqual(calls, ['first', 'second']);
+});
+
+test('.promise() clearQueue is a no-op in default mode', async () => {
+	let release;
+	const gate = new Promise(resolve => {
+		release = resolve;
+	});
+	let callCount = 0;
+	const debounced = pDebounce.promise(async value => {
+		callCount++;
+		await gate;
+		return value;
+	});
+
+	const first = debounced('first');
+	const shared = debounced('second');
+	assert.equal(debounced.clearQueue({code: 'ignored'}), 0);
+	release();
+
+	assert.deepEqual(await Promise.all([first, shared]), ['first', 'first']);
+	assert.equal(callCount, 1);
+});
+
+test('.promise() clearQueue only affects its own wrapper', async () => {
+	const createDebounced = () => {
+		let release;
+		const gate = new Promise(resolve => {
+			release = resolve;
+		});
+		const debounced = pDebounce.promise(async value => {
+			await gate;
+			return value;
+		}, {after: true});
+
+		return {debounced, release};
+	};
+
+	const first = createDebounced();
+	const second = createDebounced();
+	const firstActive = first.debounced('first');
+	const firstQueued = first.debounced('discarded');
+	const secondActive = second.debounced('second');
+	const secondQueued = second.debounced('kept');
+	const reason = {code: 'first-only'};
+
+	assert.equal(first.debounced.clearQueue(reason), 1);
+	first.release();
+	second.release();
+
+	const results = await Promise.allSettled([firstActive, firstQueued, secondActive, secondQueued]);
+	assert.equal(results[0].status, 'fulfilled');
+	assert.equal(results[0].value, 'first');
+	assert.equal(results[1].status, 'rejected');
+	assert.equal(results[1].reason, reason);
+	assert.deepEqual(results.slice(2), [
+		{status: 'fulfilled', value: 'second'},
+		{status: 'fulfilled', value: 'kept'},
+	]);
+});
