+test('clearQueue rejects every pending pLimit promise with the exact custom reason and allows reuse', async t => {
+	const reasons = [null, false, 0, 'custom reason', {custom: true}];
+
+	for (const reason of reasons) {
+		const limit = pLimit({concurrency: 1, rejectOnClear: true});
+		let release;
+		let invoked = 0;
+		const runningPromise = limit(() => new Promise(resolve => {
+			release = resolve;
+		}));
+		const pendingPromises = [
+			limit(() => {
+				invoked++;
+			}),
+			limit(() => {
+				invoked++;
+			}),
+		];
+
+		await Promise.resolve();
+		t.is(limit.activeCount, 1);
+		t.is(limit.pendingCount, 2);
+
+		const rejections = pendingPromises.map(promise => promise.catch(error => error));
+		limit.clearQueue(reason);
+
+		t.is(limit.pendingCount, 0);
+		for (const rejection of await Promise.all(rejections)) {
+			t.is(rejection, reason);
+		}
+		t.is(invoked, 0);
+
+		release();
+		t.is(await runningPromise, undefined);
+		t.is(limit.activeCount, 0);
+		t.is(await limit(() => 'reused'), 'reused');
+		t.is(limit.activeCount, 0);
+	}
+});
+
