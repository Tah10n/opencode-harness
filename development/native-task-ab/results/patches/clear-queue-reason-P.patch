+test('clearQueue rejects pending promises with the exact custom reason', async t => {
+	const reasons = [null, false, 0, 'custom reason', {custom: true}];
+
+	const testReason = async reason => {
+		const limit = pLimit({concurrency: 1, rejectOnClear: true});
+		let resolveRunning;
+		let invoked = 0;
+
+		const runningPromise = limit(() => new Promise(resolve => {
+			invoked++;
+			resolveRunning = resolve;
+		}));
+		const pendingPromise = limit(() => {
+			invoked++;
+		});
+
+		await Promise.resolve();
+		t.is(limit.activeCount, 1);
+		t.is(limit.pendingCount, 1);
+
+		limit.clearQueue(reason);
+		t.is(limit.activeCount, 1);
+		t.is(limit.pendingCount, 0);
+
+		const [pendingResult] = await Promise.allSettled([pendingPromise]);
+		t.is(pendingResult.status, 'rejected');
+		t.is(pendingResult.reason, reason);
+		t.is(invoked, 1);
+
+		resolveRunning();
+		await runningPromise;
+		t.is(limit.activeCount, 0);
+
+		await limit(() => {
+			invoked++;
+			return 'reused';
+		});
+		t.is(invoked, 2);
+		t.is(limit.activeCount, 0);
+	};
+
+	await Promise.all(reasons.map(reason => testReason(reason)));
+});
+
+test('clearQueue discards pending promises with a reason when rejection is disabled', async t => {
+	const limit = pLimit(1);
