+
+test('.clear() returns only queued tasks with an active task', async () => {
+	const queue = new PQueue({concurrency: 1});
+	const activeTaskDeferred = pDefer<string>();
+
+	const activeTask = queue.add(async () => activeTaskDeferred.promise);
+	const queuedTask = queue.add(async () => 'queued');
+
+	assert.equal(queue.pending, 1);
+	assert.equal(queue.size, 1);
+	assert.equal(queue.clear(), 1);
+	assert.equal(queue.pending, 1);
+	assert.equal(queue.size, 0);
+
+	assert.equal(await Promise.race([
+		(async () => {
+			await queuedTask;
+			return 'settled';
+		})(),
+		(async () => {
+			await delay(10);
+			return 'pending';
+		})(),
+	]), 'pending');
+
+	activeTaskDeferred.resolve('active');
+	assert.equal(await activeTask, 'active');
+});
+
+test('.clear() returns queued tasks for a custom queue class', () => {
+	const queue = new PQueue({autoStart: false, queueClass: CustomQueue});
