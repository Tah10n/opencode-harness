+test('limitFunction exposes live limiter controls', async t => {
+	let releaseFirst;
+	const firstGate = new Promise(resolve => {
+		releaseFirst = resolve;
+	});
+	let releaseQueued;
+	const queuedGate = new Promise(resolve => {
+		releaseQueued = resolve;
+	});
+	const started = [];
+	const limitedFunction = limitFunction(async (value, suffix) => {
+		started.push(value);
+		await (value === 1 ? firstGate : queuedGate);
+		return `${value}-${suffix}`;
+	}, {concurrency: 1});
+
+	t.is(limitedFunction.activeCount, 0);
+	t.is(limitedFunction.pendingCount, 0);
+
+	const firstPromise = limitedFunction(1, 'first');
+	const queuedPromises = [
+		limitedFunction(2, 'second'),
+		limitedFunction(3, 'third'),
+	];
+
+	await Promise.resolve();
+	t.deepEqual(started, [1]);
+	// Check the actual limiter state immediately before changing its concurrency.
+	t.is(limitedFunction.activeCount, 1);
+	t.is(limitedFunction.pendingCount, 2);
+
+	limitedFunction.concurrency = 3;
+	t.is(limitedFunction.concurrency, 3);
+	await Promise.resolve();
+	await Promise.resolve();
+
+	t.deepEqual(started, [1, 2, 3]);
+	t.is(limitedFunction.activeCount, 3);
+	t.is(limitedFunction.pendingCount, 0);
+
+	releaseQueued();
+	releaseFirst();
+	t.deepEqual(await Promise.all([firstPromise, ...queuedPromises]), ['1-first', '2-second', '3-third']);
+	t.is(limitedFunction.activeCount, 0);
+	t.is(limitedFunction.pendingCount, 0);
+});
+
+test('limitFunction preserves arguments and rejection propagation', async t => {
+	const error = new Error('test');
+	const limitedFunction = limitFunction(async (first, second) => {
+		t.deepEqual([first, second], ['first', 'second']);
+		throw error;
+	}, {concurrency: 1});
+
+	await t.throwsAsync(limitedFunction('first', 'second'), {is: error});
+});
+
+test('limitFunction validates concurrency changes', t => {
+	const limitedFunction = limitFunction(async () => {}, {concurrency: 1});
+
+	t.throws(() => {
+		limitedFunction.concurrency = 0;
+	}, {instanceOf: TypeError});
+	t.is(limitedFunction.concurrency, 1);
+});
+
+test('limitFunction wrappers have independent controls', async t => {
+	let releaseA;
+	const gateA = new Promise(resolve => {
+		releaseA = resolve;
+	});
+	let releaseB;
+	const gateB = new Promise(resolve => {
+		releaseB = resolve;
+	});
+	const limitedA = limitFunction(async () => gateA, {concurrency: 1});
+	const limitedB = limitFunction(async () => gateB, {concurrency: 1});
+
+	const promisesA = [limitedA(), limitedA()];
+	const promisesB = [limitedB(), limitedB()];
+	await Promise.resolve();
+
+	t.is(limitedA.activeCount, 1);
+	t.is(limitedA.pendingCount, 1);
+	t.is(limitedB.activeCount, 1);
+	t.is(limitedB.pendingCount, 1);
+
+	limitedB.concurrency = 2;
+	await Promise.resolve();
+
+	t.is(limitedA.activeCount, 1);
+	t.is(limitedA.pendingCount, 1);
+	t.is(limitedB.activeCount, 2);
+	t.is(limitedB.pendingCount, 0);
+
+	releaseA();
+	releaseB();
+	await Promise.all([...promisesA, ...promisesB]);
+});
+
