+test('listenerCount() - deduplicates repeated event names', async t => {
+	const firstSymbol = Symbol('event');
+	const secondSymbol = Symbol('event');
+	const emitter = new Emittery();
+	emitter.on('🦄', () => {});
+	emitter.on('🦄', () => {});
+	emitter.on('🌈', () => {});
+	emitter.on(firstSymbol, () => {});
+	emitter.on(secondSymbol, () => {});
+	emitter.onAny(() => {});
+	emitter.onAny(() => {});
+
+	const unicornIterator = emitter.events('🦄');
+	const rainbowIterator = emitter.events('🌈');
+	const anyIterator = emitter.anyEvent();
+
+	// Check the state used by listenerCount before testing duplicate input.
+	t.is(emitter.listenerCount('🦄'), 6);
+	t.is(emitter.listenerCount('🌈'), 5);
+	t.is(emitter.listenerCount(firstSymbol), 4);
+	t.is(emitter.listenerCount(secondSymbol), 4);
+	t.is(emitter.listenerCount(), 10);
+
+	t.is(emitter.listenerCount(['🦄', '🦄', '🌈', '🌈']), 11);
+	t.is(emitter.listenerCount([firstSymbol, firstSymbol, secondSymbol, secondSymbol]), 8);
+	t.is(emitter.listenerCount([]), 0);
+	t.throws(() => {
+		emitter.listenerCount(['🦄', '🦄', true]);
+	}, {instanceOf: TypeError});
+
+	// Counting does not alter listeners or iterator producers.
+	t.is(emitter.listenerCount(['🦄', '🌈']), 11);
+
+	await unicornIterator.return();
+	await rainbowIterator.return();
+	await anyIterator.return();
+	t.is(emitter.listenerCount('🦄'), 4);
+	t.is(emitter.listenerCount('🌈'), 3);
+	t.is(emitter.listenerCount(), 7);
+});
