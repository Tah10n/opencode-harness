+test.serial('listenerCount() - deduplicates event names without changing subscriptions', async t => {
+	const emitter = new Emittery();
+	const symbol = Symbol('same description');
+	const otherSymbol = Symbol('same description');
+	const calls = [];
+
+	emitter.on('🦄', () => calls.push('listener'));
+	emitter.on('🦄', () => calls.push('listener'));
+	emitter.on('🌈', () => calls.push('listener'));
+	emitter.on(symbol, () => calls.push('listener'));
+	emitter.on(otherSymbol, () => calls.push('listener'));
+	emitter.onAny(() => calls.push('any'));
+	emitter.onAny(() => calls.push('any'));
+	const unicornIterator = emitter.events('🦄');
+	const rainbowIterator = emitter.events('🌈');
+	const anyIterator = emitter.anyEvent();
+
+	// Check the state used by the array count immediately before calling it.
+	t.deepEqual([
+		emitter.listenerCount('🦄'),
+		emitter.listenerCount('🌈'),
+		emitter.listenerCount(symbol),
+		emitter.listenerCount(otherSymbol),
+	], [6, 5, 4, 4]);
+	t.is(emitter.listenerCount(), 10);
+
+	t.is(emitter.listenerCount(['🦄', '🦄', '🌈', '🌈', symbol, symbol, otherSymbol]), 19);
+	t.is(emitter.listenerCount([]), 0);
+	t.deepEqual([
+		emitter.listenerCount('🦄'),
+		emitter.listenerCount('🌈'),
+		emitter.listenerCount(symbol),
+		emitter.listenerCount(otherSymbol),
+	], [6, 5, 4, 4]);
+
+	await emitter.emit('🦄', '🌈');
+	t.is(calls.length, 4);
+	t.deepEqual(await unicornIterator.next(), {done: false, value: {name: '🦄', data: '🌈'}});
+	t.deepEqual(await anyIterator.next(), {done: false, value: {name: '🦄', data: '🌈'}});
+
+	await emitter.emit('🌈', '🍖');
+	t.is(calls.length, 7);
+	t.deepEqual(await rainbowIterator.next(), {done: false, value: {name: '🌈', data: '🍖'}});
+	t.deepEqual(await anyIterator.next(), {done: false, value: {name: '🌈', data: '🍖'}});
+
+	await unicornIterator.return();
+	await rainbowIterator.return();
+	await anyIterator.return();
+});
+
+test('listenerCount() - validates invalid entries after duplicate names', t => {
+	const emitter = new Emittery();
+	emitter.on('🦄', () => {});
+
+	t.throws(() => {
+		emitter.listenerCount(['🦄', '🦄', true]);
+	}, {instanceOf: TypeError});
+
+	t.is(emitter.listenerCount('🦄'), 1);
+});
+
