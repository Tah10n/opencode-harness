+test('.clear() returns the discarded count with a custom queue class', async () => {
+	class CustomQueue {
+		readonly #queue: Array<() => Promise<unknown>> = [];
+
+		enqueue(run: () => Promise<unknown>): void {
+			this.#queue.push(run);
+		}
+
+		dequeue(): (() => Promise<unknown>) | undefined {
+			return this.#queue.shift();
+		}
+
+		filter(): Array<() => Promise<unknown>> {
+			return [...this.#queue];
+		}
+
+		setPriority(): void {
+			/* Custom queue does not reprioritize tasks. */
+		}
+
+		get size(): number {
+			return this.#queue.length;
+		}
+	}
+
+	const queue = new PQueue({autoStart: false, queueClass: CustomQueue});
+	queue.add(async () => 1);
+	queue.add(async () => 2);
+
+	assert.equal(queue.size, 2);
+	assert.equal(queue.clear(), 2);
+	assert.equal(queue.size, 0);
+
+	queue.add(async () => 3);
+	assert.equal(queue.clear(), 1);
+	assert.equal(queue.size, 0);
+
+	const remainingTask = queue.add(async () => 4);
+	queue.start();
+	assert.equal(await remainingTask, 4);
+});
+
