diff --git a/test/waiters.ts b/test/waiters.ts
new file mode 100644
index 0000000..e414e79
--- /dev/null
+++ b/test/waiters.ts
@@ -0,0 +1,127 @@
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {getEventListeners} from 'node:events';
+import pDefer from 'p-defer';
+import PQueue from '../source/index.js';
+
+test('.onEmpty(), .onIdle(), and .onPendingZero() support independent cancellation', async () => {
+	const queue = new PQueue({concurrency: 1});
+	const firstStarted = pDefer<void>();
+	const secondStarted = pDefer<void>();
+	const firstGate = pDefer<void>();
+	const secondGate = pDefer<void>();
+
+	const firstTask = queue.add(async () => {
+		firstStarted.resolve();
+		await firstGate.promise;
+	});
+
+	await firstStarted.promise;
+
+	const secondTask = queue.add(async () => {
+		secondStarted.resolve();
+		await secondGate.promise;
+	});
+
+	assert.equal(queue.size, 1);
+	assert.equal(queue.pending, 1);
+
+	const emptyController = new AbortController();
+	const idleController = new AbortController();
+	const pendingZeroController = new AbortController();
+	const completedEmptyController = new AbortController();
+	const completedIdleController = new AbortController();
+	const completedPendingZeroController = new AbortController();
+	const emptyReason = new Error('cancel empty waiter');
+	const idleReason = new Error('cancel idle waiter');
+	const pendingZeroReason = new Error('cancel pending-zero waiter');
+
+	const emptyPromise = queue.onEmpty({signal: completedEmptyController.signal});
+	const cancelledEmptyPromise = queue.onEmpty({signal: emptyController.signal});
+	const idlePromise = queue.onIdle({signal: completedIdleController.signal});
+	const cancelledIdlePromise = queue.onIdle({signal: idleController.signal});
+	const pendingZeroPromise = queue.onPendingZero({signal: completedPendingZeroController.signal});
+	const cancelledPendingZeroPromise = queue.onPendingZero({signal: pendingZeroController.signal});
+
+	emptyController.abort(emptyReason);
+	idleController.abort(idleReason);
+	pendingZeroController.abort(pendingZeroReason);
+
+	await Promise.all([
+		assert.rejects(cancelledEmptyPromise, error => error === emptyReason),
+		assert.rejects(cancelledIdlePromise, error => error === idleReason),
+		assert.rejects(cancelledPendingZeroPromise, error => error === pendingZeroReason),
+	]);
+	assert.equal(getEventListeners(emptyController.signal, 'abort').length, 0);
+	assert.equal(getEventListeners(idleController.signal, 'abort').length, 0);
+	assert.equal(getEventListeners(pendingZeroController.signal, 'abort').length, 0);
+
+	// Each cancelled waiter leaves the independent waiter for the same condition intact.
+	assert.equal(queue.listenerCount('empty'), 1);
+	assert.equal(queue.listenerCount('active'), 1);
+	assert.equal(queue.listenerCount('idle'), 1);
+	assert.equal(queue.listenerCount('pendingZero'), 1);
+
+	firstGate.resolve();
+	await secondStarted.promise;
+	await emptyPromise;
+	assert.equal(queue.size, 0);
+	assert.equal(queue.pending, 1);
+	assert.equal(queue.listenerCount('empty'), 0);
+	assert.equal(queue.listenerCount('active'), 0);
+	assert.equal(getEventListeners(completedEmptyController.signal, 'abort').length, 0);
+	await pendingZeroPromise;
+	assert.equal(queue.pending, 1);
+	assert.equal(queue.listenerCount('pendingZero'), 0);
+	assert.equal(getEventListeners(completedPendingZeroController.signal, 'abort').length, 0);
+
+	secondGate.resolve();
+	await Promise.all([firstTask, secondTask, idlePromise]);
+	assert.equal(queue.pending, 0);
+	assert.equal(queue.listenerCount('idle'), 0);
+	assert.equal(getEventListeners(completedIdleController.signal, 'abort').length, 0);
+
+	// Aborting after settlement and later queue activity must have no effect.
+	emptyController.abort();
+	idleController.abort();
+	pendingZeroController.abort();
+	completedEmptyController.abort();
+	completedIdleController.abort();
+	completedPendingZeroController.abort();
+	await queue.add(async () => undefined);
+});
+
+test('waiters reject already-aborted signals before satisfied-condition fast paths', async () => {
+	const queue = new PQueue();
+	const reason = new Error('already aborted');
+
+	const emptyController = new AbortController();
+	const idleController = new AbortController();
+	const pendingZeroController = new AbortController();
+	emptyController.abort(reason);
+	idleController.abort(reason);
+	pendingZeroController.abort(reason);
+
+	await Promise.all([
+		assert.rejects(queue.onEmpty({signal: emptyController.signal}), error => error === reason),
+		assert.rejects(queue.onIdle({signal: idleController.signal}), error => error === reason),
+		assert.rejects(queue.onPendingZero({signal: pendingZeroController.signal}), error => error === reason),
+	]);
+
+	const emptySignal = new AbortController();
+	const idleSignal = new AbortController();
+	const pendingZeroSignal = new AbortController();
+	await Promise.all([
+		queue.onEmpty({signal: emptySignal.signal}),
+		queue.onIdle({signal: idleSignal.signal}),
+		queue.onPendingZero({signal: pendingZeroSignal.signal}),
+	]);
+
+	assert.equal(queue.listenerCount('empty'), 0);
+	assert.equal(queue.listenerCount('active'), 0);
+	assert.equal(queue.listenerCount('idle'), 0);
+	assert.equal(queue.listenerCount('pendingZero'), 0);
+	emptySignal.abort();
+	idleSignal.abort();
+	pendingZeroSignal.abort();
+});
