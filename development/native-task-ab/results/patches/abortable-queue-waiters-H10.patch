diff --git a/test/waiters.ts b/test/waiters.ts
new file mode 100644
index 0000000..a949357
--- /dev/null
+++ b/test/waiters.ts
@@ -0,0 +1,116 @@
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import pDefer from 'p-defer';
+import PQueue from '../source/index.js';
+
+test('abortable waiters distinguish empty, idle, and pending zero', async () => {
+	const queue = new PQueue({concurrency: 1});
+	const firstTask = pDefer<void>();
+	const secondTask = pDefer<void>();
+
+	const first = queue.add(async () => firstTask.promise);
+	const second = queue.add(async () => secondTask.promise);
+	assert.equal(queue.pending, 1);
+	assert.equal(queue.size, 1);
+
+	queue.pause();
+
+	const controller = new AbortController();
+	const reason = new Error('stop waiting');
+	const abortedEmpty = queue.onEmpty({signal: controller.signal});
+	const completingEmpty = queue.onEmpty();
+	const idle = queue.onIdle();
+	const pendingZero = queue.onPendingZero();
+
+	controller.abort(reason);
+	await assert.rejects(abortedEmpty, error => error === reason);
+	assert.equal(queue.listenerCount('empty'), 1);
+	assert.equal(queue.listenerCount('idle'), 1);
+	assert.equal(queue.listenerCount('pendingZero'), 1);
+
+	firstTask.resolve();
+	await pendingZero;
+	assert.equal(queue.pending, 0);
+	assert.equal(queue.size, 1);
+
+	queue.start();
+	await completingEmpty;
+	assert.equal(queue.pending, 1);
+	assert.equal(queue.size, 0);
+
+	secondTask.resolve();
+	await idle;
+	await Promise.all([first, second]);
+	assert.equal(queue.pending, 0);
+});
+
+test('abortable waiters reject with an already-aborted signal', async () => {
+	const queue = new PQueue();
+	assert.equal(queue.size, 0);
+	assert.equal(queue.pending, 0);
+
+	const controller = new AbortController();
+	const reason = new Error('already stopped');
+	controller.abort(reason);
+
+	await Promise.all([
+		assert.rejects(queue.onEmpty({signal: controller.signal}), error => error === reason),
+		assert.rejects(queue.onIdle({signal: controller.signal}), error => error === reason),
+		assert.rejects(queue.onPendingZero({signal: controller.signal}), error => error === reason),
+	]);
+});
+
+test('abortable waiters resolve immediately for satisfied conditions', async () => {
+	const queue = new PQueue();
+	const controller = new AbortController();
+
+	await Promise.all([
+		queue.onEmpty({signal: controller.signal}),
+		queue.onIdle({signal: controller.signal}),
+		queue.onPendingZero({signal: controller.signal}),
+	]);
+
+	assert.equal(queue.listenerCount('empty'), 0);
+	assert.equal(queue.listenerCount('idle'), 0);
+	assert.equal(queue.listenerCount('pendingZero'), 0);
+	controller.abort(new Error('too late'));
+});
+
+test('abortable waiter listeners are removed after abort or resolution', async () => {
+	const abortedQueue = new PQueue({autoStart: false});
+	abortedQueue.add(async () => undefined);
+	const abortedController = new AbortController();
+	let abortedRemoveCount = 0;
+	const removeAbortedListener = abortedController.signal.removeEventListener.bind(abortedController.signal);
+	abortedController.signal.removeEventListener = (...arguments_) => {
+		abortedRemoveCount++;
+		removeAbortedListener(...arguments_);
+	};
+
+	assert.equal(abortedQueue.size, 1);
+	const abortedWaiter = abortedQueue.onEmpty({signal: abortedController.signal});
+	abortedController.abort();
+	await assert.rejects(abortedWaiter);
+	assert.equal(abortedQueue.listenerCount('empty'), 0);
+	assert.equal(abortedRemoveCount, 1);
+	abortedQueue.clear();
+
+	const resolvedQueue = new PQueue({autoStart: false});
+	const task = resolvedQueue.add(async () => undefined);
+	const resolvedController = new AbortController();
+	let resolvedRemoveCount = 0;
+	const removeResolvedListener = resolvedController.signal.removeEventListener.bind(resolvedController.signal);
+	resolvedController.signal.removeEventListener = (...arguments_) => {
+		resolvedRemoveCount++;
+		removeResolvedListener(...arguments_);
+	};
+
+	assert.equal(resolvedQueue.size, 1);
+	const resolvedWaiter = resolvedQueue.onEmpty({signal: resolvedController.signal});
+	resolvedQueue.start();
+	await resolvedWaiter;
+	assert.equal(resolvedQueue.listenerCount('empty'), 0);
+	assert.equal(resolvedRemoveCount, 1);
+	resolvedController.abort(new Error('too late'));
+	await task;
+});
