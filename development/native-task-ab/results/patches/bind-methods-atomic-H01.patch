+test('bindMethods() - preflights later conflicts atomically', t => {
+	const emitter = new Emittery();
+	const target = {off: true};
+	const before = Object.getOwnPropertyDescriptors(target);
+
+	t.is(Object.getOwnPropertyDescriptor(target, 'on'), undefined);
+	t.is(target.off, true);
+	t.throws(() => {
+		emitter.bindMethods(target, ['on', 'off']);
+	});
+	t.deepEqual(Object.getOwnPropertyDescriptors(target), before);
+});
+
+test('bindMethods() - rejects non-configurable undefined properties atomically', t => {
+	const emitter = new Emittery();
+	const target = {};
+	Object.defineProperty(target, 'off', {
+		value: undefined,
+		configurable: false,
+	});
+	const before = Object.getOwnPropertyDescriptors(target);
+
+	t.is(Object.getOwnPropertyDescriptor(target, 'on'), undefined);
+	t.is(target.off, undefined);
+	t.throws(() => {
+		emitter.bindMethods(target, ['on', 'off']);
+	});
+	t.deepEqual(Object.getOwnPropertyDescriptors(target), before);
+});
+
