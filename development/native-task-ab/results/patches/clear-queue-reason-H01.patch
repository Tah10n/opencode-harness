+test('clearQueue rejects pending promises with the exact custom reason', async t => {
+	const reasons = [null, false, 0, 'custom reason', {code: 'custom'}];
+
+	await Promise.all(reasons.map(async reason => {
+		const limit = pLimit({concurrency: 1, rejectOnClear: true});
+		let resolveRunning;
+		let queuedCalls = 0;
+		const runningPromise = limit(() => new Promise(resolve => {
+			resolveRunning = resolve;
+		}));
+		const pendingPromises = [
+			limit(() => {
+				queuedCalls++;
+			}),
+			limit(() => {
+				queuedCalls++;
+			}),
+		];
+
+		await Promise.resolve();
+		t.is(limit.activeCount, 1);
+		t.is(limit.pendingCount, 2);
+		limit.clearQueue(reason);
+		t.is(limit.activeCount, 1);
+		t.is(limit.pendingCount, 0);
+
+		const rejectionResults = await Promise.all(pendingPromises.map(async promise => {
+			try {
+				return await promise;
+			} catch (error) {
+				return error;
+			}
+		}));
+		t.is(rejectionResults[0], reason);
+		t.is(rejectionResults[1], reason);
+		t.is(queuedCalls, 0);
+
+		resolveRunning();
+		t.is(await runningPromise, undefined);
+		t.is(limit.activeCount, 0);
+		t.is(await limit(() => 'reused'), 'reused');
+	}));
+});
+
+test('clearQueue retains discarded pending promises when disabled', async t => {
+	const limit = pLimit({concurrency: 1, rejectOnClear: false});
+	let resolveRunning;
+	let queuedCalls = 0;
+	const runningPromise = limit(() => new Promise(resolve => {
+		resolveRunning = resolve;
+	}));
+	const pendingPromise = limit(() => {
+		queuedCalls++;
+	});
+
+	await Promise.resolve();
+	t.is(limit.activeCount, 1);
+	t.is(limit.pendingCount, 1);
+	limit.clearQueue('ignored');
+	t.is(limit.pendingCount, 0);
+	t.is(queuedCalls, 0);
+	t.is(await Promise.race([pendingPromise, delay(0, 'still pending')]), 'still pending');
+
+	resolveRunning();
+	await runningPromise;
+	t.is(limit.activeCount, 0);
+	t.is(await limit(() => 'reused'), 'reused');
+});
