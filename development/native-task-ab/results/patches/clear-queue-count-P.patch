+test('.clear() returns only queued tasks', async () => {
+	const queue = new PQueue({concurrency: 1});
+	const runningTaskDeferred = pDefer<void>();
+
+	const runningTask = queue.add(async () => runningTaskDeferred.promise);
+	queue.add(async () => 'queued 1');
+	queue.add(async () => 'queued 2');
+
+	assert.equal(queue.clear(), 2);
+	assert.equal(queue.pending, 1);
+	assert.equal(queue.size, 0);
+	assert.equal(queue.clear(), 0);
+
+	runningTaskDeferred.resolve();
+	await runningTask;
+});
+
+test('.clear() returns queued tasks for a paused queue', () => {
+	const queue = new PQueue({autoStart: false});
+
+	queue.add(async () => 'queued 1');
+	queue.add(async () => 'queued 2');
+	queue.add(async () => 'queued 3');
+
+	assert.equal(queue.clear(), 3);
+	assert.equal(queue.clear(), 0);
+});
+
+test('.clear() returns queued tasks for a custom queue class', () => {
+	class CustomQueue {
+		readonly #queue: Array<() => Promise<unknown>> = [];
+
+		enqueue(run: () => Promise<unknown>): void {
+			this.#queue.push(run);
+		}
+
+		dequeue(): (() => Promise<unknown>) | undefined {
+			return this.#queue.shift();
+		}
+
+		filter(): Array<() => Promise<unknown>> {
+			return this.#queue;
+		}
+
+		setPriority(): void {
+			return undefined;
+		}
+
+		get size(): number {
+			return this.#queue.length;
+		}
+	}
+
+	const queue = new PQueue({autoStart: false, queueClass: CustomQueue});
+	queue.add(async () => 'queued 1');
+	queue.add(async () => 'queued 2');
+
+	assert.equal(queue.clear(), 2);
+	assert.equal(queue.clear(), 0);
+});
+
