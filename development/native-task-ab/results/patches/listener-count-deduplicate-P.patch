+test('listenerCount() - deduplicates repeated event names', async t => {
+	const emitter = new Emittery();
+	const symbol = Symbol('event');
+	const otherSymbol = Symbol('event');
+	const listener = () => {};
+	emitter.on('🦄', listener);
+	emitter.on('🦄', () => {});
+	emitter.on(symbol, listener);
+	emitter.on(otherSymbol, listener);
+	emitter.onAny(listener);
+
+	const unicornIterator = emitter.events('🦄');
+	const symbolIterator = emitter.events(symbol);
+	const anyIterator = emitter.anyEvent();
+
+	t.is(emitter.listenerCount('🦄'), 5);
+	t.is(emitter.listenerCount(symbol), 4);
+	t.is(emitter.listenerCount(otherSymbol), 3);
+	t.is(emitter.listenerCount(['🦄', '🦄']), 5);
+	t.is(emitter.listenerCount([symbol, symbol]), 4);
+	t.is(emitter.listenerCount([symbol, otherSymbol]), 7);
+	t.is(emitter.listenerCount(['🦄', '🦄', symbol, symbol, otherSymbol, otherSymbol]), 12);
+	t.is(emitter.listenerCount([]), 0);
+	t.is(emitter.listenerCount(), 8);
+
+	await emitter.emit('🦄', '🌈');
+	t.deepEqual(await unicornIterator.next(), {done: false, value: {name: '🦄', data: '🌈'}});
+	t.deepEqual(await anyIterator.next(), {done: false, value: {name: '🦄', data: '🌈'}});
+
+	await unicornIterator.return();
+	await symbolIterator.return();
+	await anyIterator.return();
+});
+
+test('listenerCount() - validates every distinct array entry', t => {
+	const emitter = new Emittery();
+
+	t.throws(() => emitter.listenerCount(['🦄', '🦄', true]), {instanceOf: TypeError});
+});
+
