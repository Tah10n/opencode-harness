diff --git a/test/waiters.ts b/test/waiters.ts
new file mode 100644
index 0000000..2a4338a
--- /dev/null
+++ b/test/waiters.ts
@@ -0,0 +1,122 @@
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {getEventListeners} from 'node:events';
+import pDefer from 'p-defer';
+import PQueue from '../source/index.js';
+
+test('waiters distinguish empty, idle, and pending zero with cancellation', async () => {
+	const cases = [
+		{
+			name: 'onEmpty',
+			condition: async (queue: PQueue, options: {signal: AbortSignal}) => queue.onEmpty(options),
+			expected: {size: 0, pending: 1},
+		},
+		{
+			name: 'onIdle',
+			condition: async (queue: PQueue, options: {signal: AbortSignal}) => queue.onIdle(options),
+			expected: {size: 0, pending: 0},
+		},
+		{
+			name: 'onPendingZero',
+			condition: async (queue: PQueue, options: {signal: AbortSignal}) => queue.onPendingZero(options),
+			expected: {size: 1, pending: 0},
+		},
+	] as const;
+
+	await Promise.all(cases.map(async ({name, condition, expected}) => {
+		const queue = new PQueue({concurrency: 1});
+		const running = pDefer<void>();
+		const queued = pDefer<void>();
+		const firstTask = queue.add(async () => running.promise);
+		const secondTask = queue.add(async () => queued.promise);
+		const abortedController = new AbortController();
+		const completingController = new AbortController();
+		const reason = new Error(`${name} aborted`);
+
+		assert.equal(queue.size, 1);
+		assert.equal(queue.pending, 1);
+
+		const abortedWaiter = condition(queue, {signal: abortedController.signal});
+		const completingWaiter = condition(queue, {signal: completingController.signal});
+		abortedController.abort(reason);
+
+		await assert.rejects(abortedWaiter, error => error === reason);
+		assert.equal(queue.size, 1);
+		assert.equal(queue.pending, 1);
+
+		queue.pause();
+		running.resolve();
+		await firstTask;
+
+		if (name === 'onPendingZero') {
+			await completingWaiter;
+			assert.deepEqual({size: queue.size, pending: queue.pending}, expected);
+			queue.start();
+		} else if (name === 'onEmpty') {
+			queue.start();
+			await completingWaiter;
+			assert.deepEqual({size: queue.size, pending: queue.pending}, expected);
+		} else {
+			queue.start();
+			queued.resolve();
+			await secondTask;
+			await completingWaiter;
+			assert.deepEqual({size: queue.size, pending: queue.pending}, expected);
+			return;
+		}
+
+		queued.resolve();
+		await secondTask;
+		await queue.onIdle();
+	}));
+});
+
+test('waiters reject already-aborted signals before satisfied conditions', async () => {
+	const queue = new PQueue();
+	const activeController = new AbortController();
+	const controller = new AbortController();
+	const reason = new Error('already aborted');
+	controller.abort(reason);
+
+	await Promise.all([
+		queue.onEmpty({signal: activeController.signal}),
+		queue.onIdle({signal: activeController.signal}),
+		queue.onPendingZero({signal: activeController.signal}),
+	]);
+	assert.equal(getEventListeners(activeController.signal, 'abort').length, 0);
+
+	await Promise.all([
+		queue.onEmpty({signal: controller.signal}),
+		queue.onIdle({signal: controller.signal}),
+		queue.onPendingZero({signal: controller.signal}),
+	].map(async wait => assert.rejects(wait, error => error === reason)));
+});
+
+test('waiter abort listeners are cleaned up after either settlement', async () => {
+	const queue = new PQueue({autoStart: false});
+	const abortController = new AbortController();
+	const resolveController = new AbortController();
+
+	queue.add(async () => undefined);
+	const abortedWaiter = queue.onEmpty({signal: abortController.signal});
+	const resolvedWaiter = queue.onEmpty({signal: resolveController.signal});
+
+	assert.equal(queue.listenerCount('empty'), 2);
+	assert.equal(getEventListeners(abortController.signal, 'abort').length, 1);
+	assert.equal(getEventListeners(resolveController.signal, 'abort').length, 1);
+
+	abortController.abort();
+	await assert.rejects(abortedWaiter);
+	assert.equal(queue.listenerCount('empty'), 1);
+	assert.equal(getEventListeners(abortController.signal, 'abort').length, 0);
+
+	queue.start();
+	await resolvedWaiter;
+	assert.equal(queue.listenerCount('empty'), 0);
+	assert.equal(getEventListeners(resolveController.signal, 'abort').length, 0);
+
+	// Later events and aborts cannot settle a waiter twice or resurrect listeners.
+	resolveController.abort();
+	queue.emit('empty');
+	assert.equal(queue.listenerCount('empty'), 0);
+});
