--- a/index.js
+++ b/index.js
@@ -91,7 +91,7 @@ pDebounce.promise = (function_, options = {}) => {
 	let currentPromise;
 	let queuedCall;
 
-	return async function (...arguments_) {
+	const debounced = async function (...arguments_) {
 		if (currentPromise) {
 			if (!options.after) {
 				return currentPromise;
@@ -150,6 +150,28 @@ pDebounce.promise = (function_, options = {}) => {
 			currentPromise = undefined;
 		}
 	};
+
+	debounced.clearQueue = reason => {
+		if (!queuedCall) {
+			return 0;
+		}
+
+		if (reason === undefined) {
+			reason = new Error('Queue cleared');
+			reason.name = 'AbortError';
+		}
+
+		const {resolvers} = queuedCall;
+		queuedCall = undefined;
+
+		for (const {reject} of resolvers) {
+			reject(reason);
+		}
+
+		return resolvers.length;
+	};
+
+	return debounced;
 };
 
