diff --git a/test/waiters.ts b/test/waiters.ts
new file mode 100644
index 0000000..2ce9921
--- /dev/null
+++ b/test/waiters.ts
@@ -0,0 +1,174 @@
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import pDefer from 'p-defer';
+import PQueue from '../source/index.js';
+
+const trackAbortListeners = (controller: AbortController) => {
+	let count = 0;
+	const {signal} = controller;
+	const addEventListener = signal.addEventListener.bind(signal);
+	const removeEventListener = signal.removeEventListener.bind(signal);
+
+	signal.addEventListener = ((type: string, listener: EventListenerOrEventListenerObject | undefined, options?: boolean | AddEventListenerOptions) => {
+		if (type === 'abort') {
+			count++;
+		}
+
+		addEventListener(type, listener, options);
+	}) as typeof signal.addEventListener;
+
+	signal.removeEventListener = ((type: string, listener: EventListenerOrEventListenerObject | undefined, options?: boolean | EventListenerOptions) => {
+		if (type === 'abort') {
+			count--;
+		}
+
+		removeEventListener(type, listener, options);
+	}) as typeof signal.removeEventListener;
+
+	return () => count;
+};
+
+test('onEmpty() supports independent abortable waiters and cleans up listeners', async () => {
+	const queue = new PQueue({concurrency: 2});
+	const blockedTasks = [pDefer<void>(), pDefer<void>(), pDefer<void>()];
+	const taskPromises = blockedTasks.map(async deferred => queue.add(() => deferred.promise));
+
+	assert.equal(queue.pending, 2);
+	assert.equal(queue.size, 1);
+
+	const abortController = new AbortController();
+	const completeController = new AbortController();
+	const abortListenerCount = trackAbortListeners(abortController);
+	const completeListenerCount = trackAbortListeners(completeController);
+	const reason = new Error('stop waiting');
+	const aborted = queue.onEmpty({signal: abortController.signal});
+	const completed = queue.onEmpty({signal: completeController.signal});
+
+	assert.equal(queue.listenerCount('empty'), 2);
+	assert.equal(abortListenerCount(), 1);
+	assert.equal(completeListenerCount(), 1);
+
+	abortController.abort(reason);
+	await assert.rejects(aborted, error => error === reason);
+	assert.equal(queue.listenerCount('empty'), 1);
+	assert.equal(abortListenerCount(), 0);
+	assert.equal(queue.pending, 2);
+	assert.equal(queue.size, 1);
+
+	// Increasing concurrency dequeues the blocked task and emits `empty` while work is still running.
+	queue.concurrency = 3;
+	await completed;
+	assert.equal(queue.size, 0);
+	assert.equal(queue.pending, 3);
+	assert.equal(queue.listenerCount('empty'), 0);
+	assert.equal(completeListenerCount(), 0);
+
+	for (const deferred of blockedTasks) {
+		deferred.resolve();
+	}
+
+	await Promise.all(taskPromises);
+	// A later queue event and abort cannot affect the settled waiter.
+	completeController.abort(new Error('too late'));
+	queue.emit('empty');
+});
+
+test('onIdle() waits for running work after the queue becomes empty', async () => {
+	const queue = new PQueue({concurrency: 2});
+	const blockedTasks = [pDefer<void>(), pDefer<void>(), pDefer<void>()];
+	const taskPromises = blockedTasks.map(async deferred => queue.add(() => deferred.promise));
+
+	assert.equal(queue.pending, 2);
+	assert.equal(queue.size, 1);
+
+	const abortController = new AbortController();
+	const completeController = new AbortController();
+	const reason = new Error('stop waiting');
+	const aborted = queue.onIdle({signal: abortController.signal});
+	const completed = queue.onIdle({signal: completeController.signal});
+
+	abortController.abort(reason);
+	await assert.rejects(aborted, error => error === reason);
+	assert.equal(queue.listenerCount('idle'), 1);
+	assert.equal(queue.pending, 2);
+	assert.equal(queue.size, 1);
+
+	queue.concurrency = 3;
+	await Promise.resolve();
+	assert.equal(queue.size, 0);
+	assert.equal(queue.pending, 3);
+
+	let idleResolved = false;
+	const idleCheck = (async () => {
+		await completed;
+		idleResolved = true;
+	})();
+	await Promise.resolve();
+	assert.equal(idleResolved, false);
+
+	for (const deferred of blockedTasks) {
+		deferred.resolve();
+	}
+
+	await completed;
+	await idleCheck;
+	assert.equal(queue.size, 0);
+	assert.equal(queue.pending, 0);
+	assert.equal(queue.listenerCount('idle'), 0);
+	await Promise.all(taskPromises);
+});
+
+test('onPendingZero() ignores queued work and supports independent waiters', async () => {
+	const queue = new PQueue({concurrency: 1});
+	const running = pDefer<void>();
+	const runningTask = queue.add(() => running.promise);
+	const queued = queue.add(async () => undefined);
+
+	// The first task is active and the second task is queued.
+	await Promise.resolve();
+	assert.equal(queue.pending, 1);
+	assert.equal(queue.size, 1);
+
+	const abortController = new AbortController();
+	const completeController = new AbortController();
+	const reason = new Error('stop waiting');
+	const aborted = queue.onPendingZero({signal: abortController.signal});
+	const completed = queue.onPendingZero({signal: completeController.signal});
+
+	queue.pause();
+	abortController.abort(reason);
+	await assert.rejects(aborted, error => error === reason);
+	assert.equal(queue.listenerCount('pendingZero'), 1);
+	assert.equal(queue.pending, 1);
+	assert.equal(queue.size, 1);
+
+	running.resolve();
+	await completed;
+	assert.equal(queue.pending, 0);
+	assert.equal(queue.size, 1);
+	assert.equal(queue.listenerCount('pendingZero'), 0);
+
+	queue.start();
+	await queued;
+	await runningTask;
+});
+
+test('waiters reject with an already-aborted signal before satisfied conditions', async () => {
+	const queue = new PQueue();
+	const controller = new AbortController();
+	const reason = new Error('already stopped');
+	controller.abort(reason);
+
+	await assert.rejects(queue.onEmpty({signal: controller.signal}), error => error === reason);
+	await assert.rejects(queue.onIdle({signal: controller.signal}), error => error === reason);
+	await assert.rejects(queue.onPendingZero({signal: controller.signal}), error => error === reason);
+});
+
+test('waiters with a signal resolve immediately when their conditions are satisfied', async () => {
+	const queue = new PQueue();
+	const controller = new AbortController();
+
+	await queue.onEmpty({signal: controller.signal});
+	await queue.onIdle({signal: controller.signal});
+	await queue.onPendingZero({signal: controller.signal});
+});
