+async function recognizedLegacyRuntimePaths() {
+  const paths = new Set(["bin", "lib", "lib/adapters"]);
+  const files = new Set();
+  let entries;
+  try {
+    entries = await readdir(stateDirectory, { withFileTypes: true });
+  } catch (error) {
+    if (error?.code === "ENOENT") return new Set();
+    throw error;
+  }
+  const names = new Set(entries.map((entry) => entry.name));
+  if (!names.has("bin") || !names.has("lib")) return new Set();
+  const expected = new Set(["bin", "lib", "lib/adapters", ...legacyRuntimeFiles]);
+  const visit = async (directory, prefix = "") => {
+    for (const entry of await readdir(directory, { withFileTypes: true })) {
+      const relativePath = `${prefix}${entry.name}`;
+      if (!expected.has(relativePath)) return false;
+      const info = await lstat(join(directory, entry.name));
+      if (info.isSymbolicLink() || (!info.isDirectory() && !info.isFile()) || info.nlink !== 1)
+        return false;
+      if (info.isDirectory()) {
+        if (!(await visit(join(directory, entry.name), `${relativePath}/`))) return false;
+      } else {
+        paths.add(relativePath);
+        files.add(relativePath);
+      }
+    }
+    return true;
+  };
+  if (
+    !(await visit(join(stateDirectory, "bin"), "bin/")) ||
+    !(await visit(join(stateDirectory, "lib"), "lib/")) ||
+    [...legacyRuntimeFiles].some((path) => !files.has(path))
+  )
+    return new Set();
+  return paths;
+}
