+test("migrates the exact flat runtime, preserves it, and reloads safely", async (context) => {
+  const home = await mkdtemp(join(tmpdir(), "viberacing-flat-runtime-"));
+  context.after(() => rm(home, { recursive: true, force: true }));
+  const restoreEnvironment = useModuleEnvironment(home);
+  try {
+    const state = join(home, ".viberacing");
+    const legacyFiles = [
+      "bin/viberacing.mjs",
+      "lib/browser.mjs", "lib/config.mjs", "lib/executables.mjs", "lib/readers.mjs",
+      "lib/registry.mjs", "lib/runtime.mjs",
+      ...["antigravity", "claude", "codex", "cursor", "gemini", "kimi", "opencode",
+        "qwen-settings", "qwen", "shared"].map((name) => `lib/adapters/${name}.mjs`),
+    ];
+    await mkdir(join(state, "lib", "adapters"), { recursive: true });
+    await mkdir(join(state, "bin"));
+    await writeFile(join(state, "installation.json"), JSON.stringify({
+      version: 1, id: "12345678-1234-4123-8123-123456789abc",
+      secret: "legacy_installation_secret_that_is_long_enough",
+    }) + "\n");
+    await writeFile(join(state, ".viberacing-state"), '{"format":1}\n');
+    const legacyLauncher = "// legacy launcher bytes\n";
+    for (const name of legacyFiles) {
+      const target = join(state, name);
+      if (name === "bin/viberacing.mjs") await writeFile(target, legacyLauncher);
+      else await writeFile(target, "// legacy module\n");
+    }
+    const module = await import(`../lib/config.mjs?flat=${encodeURIComponent(home)}`);
+    await module.installHooks(new URL("../bin/viberacing.mjs", import.meta.url), [source("codex")]);
+    assert.equal(await readFile(join(state, "bin/viberacing.mjs"), "utf8"), legacyLauncher);
+    assert.deepEqual(JSON.parse(await readFile(join(state, ".viberacing-state"), "utf8")), { format: 1 });
+    const installed = join(state, "runtime", connectorVersion, "lib", "adapters");
+    for (const name of ["shared.mjs", "qwen.mjs"]) await access(join(installed, name));
+    const reloaded = await import(`../lib/config.mjs?flat-reload=${encodeURIComponent(home)}`);
+    await reloaded.installHooks(new URL("../bin/viberacing.mjs", import.meta.url), [source("codex")]);
+    assert.equal(await readFile(join(state, "bin/viberacing.mjs"), "utf8"), legacyLauncher);
+  } finally {
+    restoreEnvironment();
+  }
+});
