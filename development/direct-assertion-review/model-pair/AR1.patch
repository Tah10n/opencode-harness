+  const path = join(directory, "opencode.db");
+  const { DatabaseSync } = await import("node:sqlite");
+  const database = new DatabaseSync(path);
+  database.exec("CREATE TABLE message (id TEXT PRIMARY KEY, time_created INTEGER, data TEXT)");
+  const time = Date.parse("2026-08-10T00:00:00Z");
+  const insert = (id, input, output) =>
+    database
+      .prepare("INSERT INTO message (id, time_created, data) VALUES (?, ?, ?)")
+      .run(id, time, JSON.stringify({ role: "assistant", tokens: { input, output, total: input + output } }));
+  insert("old-message", 1, 1);
+  database.close();
+  const source = { dataPath: path };
+  const range = { rangeStart: "2026-07-15", rangeEnd: "2026-08-14" };
+  const first = await adapterFor("opencode").collect(source, range, {});
+  assert.equal(first.entries[0].totalTokens, "2");
+
+  const changed = new DatabaseSync(path);
+  changed.prepare("DELETE FROM message WHERE id = ?").run("old-message");
