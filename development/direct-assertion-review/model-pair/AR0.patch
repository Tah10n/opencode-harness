+test("OpenCode event ledgers retain accepted rows after database history switches", async (context) => {
+  const directory = await mkdtemp(join(tmpdir(), "viberacing-opencode-event-ledger-"));
+  context.after(() => rm(directory, { force: true, recursive: true }));
+  const path = join(directory, "opencode.db");
+  const { DatabaseSync } = await import("node:sqlite");
+  const database = new DatabaseSync(path);
+  database.exec("CREATE TABLE message (id TEXT PRIMARY KEY, time_created INTEGER, data TEXT)");
+  const insert = database.prepare("INSERT INTO message (id, time_created, data) VALUES (?, ?, ?)");
+  const message = (id, date) => [
+    id,
+    Date.parse(`${date}T12:00:00Z`),
+    JSON.stringify({ role: "assistant", tokens: { input: 5, output: 4, total: 9 } }),
+  ];
+  insert.run(...message("opencode-event-a", "2026-08-10"));
+  database.close();
+  const range = { rangeStart: "2026-07-15", rangeEnd: "2026-08-14" };
+  const adapter = adapterFor("opencode");
+  const source = { dataPath: path };
+  const first = await adapter.collect(source, range, {});
+
+  const switchedDatabase = new DatabaseSync(path);
+  switchedDatabase.prepare("DELETE FROM message").run();
+  switchedDatabase
+    .prepare("INSERT INTO message (id, time_created, data) VALUES (?, ?, ?)")
+    .run(...message("opencode-event-a", "2026-08-10"));
+  switchedDatabase
+    .prepare("INSERT INTO message (id, time_created, data) VALUES (?, ?, ?)")
+    .run(...message("opencode-event-b", "2026-08-11"));
+  switchedDatabase.close();
+  const switched = await adapter.collect(source, range, first.nextState);
+  assert.equal(switched.entries.reduce((total, entry) => total + BigInt(entry.totalTokens), 0n), 18n);
+
+  const truncatedDatabase = new DatabaseSync(path);
+  truncatedDatabase.prepare("DELETE FROM message WHERE id = ?").run("opencode-event-a");
+  truncatedDatabase.close();
+  const truncated = await adapter.collect(source, range, switched.nextState);
+  assert.equal(truncated.entries.reduce((total, entry) => total + BigInt(entry.totalTokens), 0n), 18n);
+  assert.doesNotMatch(JSON.stringify(truncated.nextState), /opencode-event-[ab]/);
+});
