+import EventEmitter, { EventEmitter as NamedEventEmitter } from '../index';
+
+interface Events {
+  message: [string, number];
+  empty: [];
+}
+
+interface Context {
+  prefix: string;
+}
+
+const emitter = new EventEmitter<Events, Context>();
+const named = new NamedEventEmitter<Events, Context>();
+
+const unsubscribe: EventEmitter.Unsubscribe = emitter.subscribe(
+  'message',
+  function (text, count) {
+    this.prefix;
+    text.toUpperCase();
+    count.toFixed();
+  },
+  { prefix: 'event' }
+);
+
+emitter.on('empty', function () {
+});
+named.subscribe('message', (text, count) => {
+  text.toUpperCase();
+  count.toFixed();
+}, { prefix: 'named' });
+emitter.emit('message', 'value', 1);
+unsubscribe();
+
+// @ts-expect-error Invalid event name.
+emitter.subscribe('missing', () => {});
+// @ts-expect-error Invalid event argument type.
+emitter.emit('message', 1, 'wrong');
+// @ts-expect-error Invalid event-specific context.
+emitter.subscribe('message', () => {}, { wrong: true });
+// @ts-expect-error Invalid listener.
+emitter.subscribe('message', 'not-a-function');
+// @ts-expect-error Cancellation is callable and returns void.
+const invalidResult: number = unsubscribe();
