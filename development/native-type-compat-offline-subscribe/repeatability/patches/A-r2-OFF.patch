index 0000000000000000000000000000000000000000..e63c857c58526523238df99fd0d3e1edac5c8e65
--- /dev/null
+++ b/test/types.ts
@@ -0,0 +1,47 @@
+import EventEmitter from '..';
+
+interface Events {
+  message: [text: string, count: number];
+  empty: [];
+}
+
+interface Context {
+  prefix: string;
+}
+
+const emitter = new EventEmitter<Events, Context>();
+const context: Context = { prefix: 'received: ' };
+
+const unsubscribe: EventEmitter.Unsubscribe = emitter.subscribe(
+  'message',
+  function (text, count) {
+    const result: string = this.prefix + text + count;
+    void result;
+  },
+  context
+);
+
+emitter.subscribe('empty', function () {
+  const prefix: string = this.prefix;
+  void prefix;
+}, context);
+
+const listeners: Array<
+  EventEmitter.EventListener<Events, 'message', Context>
+> = emitter.listeners('message');
+void listeners;
+
+const result: void = unsubscribe();
+void result;
+
+// @ts-expect-error The event must be declared in the event map.
+emitter.subscribe('missing', () => {}, context);
+
+// @ts-expect-error The first event argument is a string.
+emitter.subscribe('message', (text: number, count: number) => {}, context);
+
+// @ts-expect-error The context must match the emitter context type.
+emitter.subscribe('message', () => {}, { prefix: 1 });
+
+// @ts-expect-error Cancellation does not accept arguments.
+unsubscribe('unexpected');
