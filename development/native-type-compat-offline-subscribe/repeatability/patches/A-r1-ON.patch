@@ -0,0 +1,37 @@
+import EventEmitter from '../..';
+
+interface Events {
+  data: [value: number, label: string];
+  empty: [];
+}
+
+interface Context {
+  multiplier: number;
+}
+
+const emitter = new EventEmitter<Events, Context>();
+const unsubscribe: EventEmitter.Unsubscribe = emitter.subscribe(
+  'data',
+  function (value, label) {
+    const scaled: number = value * this.multiplier;
+    const name: string = label;
+    void scaled;
+    void name;
+  },
+  { multiplier: 2 }
+);
+
+emitter.subscribe('empty', function () {});
+emitter.emit('data', 1, 'one');
+const result: void = unsubscribe();
+void result;
+
+// @ts-expect-error event arguments are event-specific
+emitter.subscribe('data', (value: string, label: string) => {}, { multiplier: 2 });
+// @ts-expect-error unknown event names are rejected
+emitter.subscribe('missing', () => {});
+// @ts-expect-error context is checked against the emitter context type
+emitter.subscribe('data', () => {}, { name: 'wrong' });
+// @ts-expect-error subscribe returns a cancellation function, not the emitter
+const notAnEmitter: EventEmitter<Events, Context> = emitter.subscribe('data', () => {});
+void notAnEmitter;
