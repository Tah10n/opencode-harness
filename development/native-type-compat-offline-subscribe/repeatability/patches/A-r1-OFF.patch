@@ -0,0 +1,31 @@
+import EventEmitter from '..';
+
+type Events = {
+  data: [label: string, count: number];
+  empty: [];
+};
+
+type Context = { prefix: string };
+const emitter = new EventEmitter<Events, Context>();
+
+const unsubscribe: EventEmitter.Unsubscribe = emitter.subscribe(
+  'data',
+  function (label, count) {
+    label.toUpperCase();
+    count.toFixed();
+  },
+  { prefix: 'value' }
+);
+
+emitter.subscribe('empty', function () {});
+const result: void = unsubscribe();
+void result;
+
+// @ts-expect-error data requires a string first argument
+emitter.subscribe('data', (label: number, count: number) => {});
+
+// @ts-expect-error data requires a numeric second argument
+emitter.subscribe('data', (label: string, count: string) => {});
+
+// @ts-expect-error contexts must match the emitter context type
+emitter.subscribe('data', () => {}, { prefix: 1 });
