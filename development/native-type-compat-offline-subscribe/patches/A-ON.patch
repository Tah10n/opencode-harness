new file mode 100644
index 0000000000000000000000000000000000000000..1495f5dacfe2b863ae28ba3de137bd8c250a6efb
--- /dev/null
+++ b/test/types/subscribe-negative.ts
@@ -0,0 +1,30 @@
+import EventEmitter from '../..';
+
+interface Events {
+  data: [string, number];
+  empty: [];
+}
+
+interface Context {
+  label: string;
+}
+
+const emitter = new EventEmitter<Events, Context>();
+
+// @ts-expect-error Unknown event names are rejected.
+emitter.subscribe('missing', () => {});
+
+// @ts-expect-error Listener arguments are checked for the selected event.
+emitter.subscribe('data', (value: number, count: string) => {
+  void value;
+  void count;
+});
+
+// @ts-expect-error Context must match the emitter's context type.
+emitter.subscribe('data', () => {}, { wrong: true });
+
+// @ts-expect-error Listener values must be callable.
+emitter.subscribe('empty', 'not a listener');
+
+// @ts-expect-error Cancellation is callable and returns void, not a value.
+const result: number = emitter.subscribe('empty', () => {})();
