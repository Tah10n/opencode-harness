@@ -0,0 +1,38 @@
+import EventEmitter from '../..';
+
+interface Events {
+  data: [string, number];
+  empty: [];
+  state: (ready: boolean) => void;
+}
+
+interface Context {
+  label: string;
+}
+
+const emitter = new EventEmitter<Events, Context>();
+const context = { label: 'consumer' };
+
+const unsubscribe = emitter.subscribe('data', function (name, count) {
+  const label: string = this.label;
+  const value: string = name;
+  const total: number = count;
+
+  void label;
+  void value;
+  void total;
+}, context);
+
+const typedUnsubscribe: EventEmitter.Unsubscribe = unsubscribe;
+const returned: void = typedUnsubscribe();
+
+emitter.subscribe('empty', function () {
+  const label: string = this.label;
+  void label;
+});
+emitter.subscribe('state', function (ready) {
+  const value: boolean = ready;
+  void value;
+}, context);
+
+void returned;
