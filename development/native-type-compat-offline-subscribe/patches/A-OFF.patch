@@ -0,0 +1,43 @@
+import EventEmitter, { EventEmitter as NamedEventEmitter } from '../..';
+
+type Events = {
+  data: [id: number, value: string];
+  closed: [];
+};
+
+type Context = {
+  prefix: string;
+};
+
+const emitter = new EventEmitter<Events, Context>();
+const context: Context = { prefix: 'item:' };
+const unsubscribe: EventEmitter.Unsubscribe = emitter.subscribe(
+  'data',
+  function (this: Context, id, value) {
+    const result: string = this.prefix + id + value;
+    void result;
+  },
+  context
+);
+
+emitter.subscribe('closed', () => {}, context)();
+emitter.emit('data', 1, 'ok');
+emitter.emit('closed');
+unsubscribe();
+
+const named = new NamedEventEmitter<Events, Context>();
+named.subscribe('data', (id, value) => {
+  const validId: number = id;
+  const validValue: string = value;
+  void validId;
+  void validValue;
+}, context);
+
+// @ts-expect-error data requires a number followed by a string
+emitter.emit('data', 'wrong', 1);
+// @ts-expect-error closed does not accept arguments
+emitter.emit('closed', 'unexpected');
+// @ts-expect-error context must match the emitter context type
+emitter.subscribe('data', () => {}, { wrong: true });
+// @ts-expect-error listener arguments are event-specific
+emitter.subscribe('data', (id: string) => {}, context);
