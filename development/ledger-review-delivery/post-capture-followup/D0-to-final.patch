+test("JSONL ledgers accept complete records before an unterminated tail", async (context) => {
+  const directory = await mkdtemp(join(tmpdir(), "viberacing-event-ledger-tail-"));
+  context.after(() => rm(directory, { force: true, recursive: true }));
+  const path = join(directory, "token-usage-2026-08.jsonl");
+  const range = { rangeStart: "2026-07-15", rangeEnd: "2026-08-14" };
+  const record = (id, date, inputTokens) =>
+    JSON.stringify({
+      schemaVersion: 1,
+      id,
+      timestamp: `${date}T00:00:00Z`,
+      inputTokens,
+      outputTokens: 0,
+      cachedTokens: 0,
+      thoughtsTokens: 0,
+      totalTokens: inputTokens,
+    });
+
+  await writeFile(path, `${record("event-1", "2026-08-10", 5)}\n`);
+  const first = await adapterFor("qwen_code").collect({ dataPath: directory }, range, {});
+  await writeFile(
+    path,
+    `${record("event-1", "2026-08-10", 5)}\n${record(
+      "event-2",
+      "2026-08-11",
+      7,
+    )}\n${record("event-3", "2026-08-12", 11)}`,
+  );
+  const result = await adapterFor("qwen_code").collect(
+    { dataPath: directory },
+    range,
+    first.nextState,
+  );
+
+  assert.equal(result.completeness, "partial");
+  assert.deepEqual(
+    result.entries.map((entry) => [entry.date, entry.totalTokens]),
+    [
+      ["2026-08-10", "5"],
+      ["2026-08-11", "7"],
+      ["2026-08-12", "11"],
+    ],
+  );
+  assert.equal(Object.keys(result.nextState.eventLedger.events).length, 2);
+});
+
