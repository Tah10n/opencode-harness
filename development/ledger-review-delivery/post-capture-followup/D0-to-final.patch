+test("event ledger compares duplicate IDs before deduplicating them", async (context) => {
+  const directory = await mkdtemp(join(tmpdir(), "viberacing-event-ledger-conflict-"));
+  context.after(() => rm(directory, { force: true, recursive: true }));
+  const path = join(directory, "token-usage-2026-08.jsonl");
+  const range = { rangeStart: "2026-07-15", rangeEnd: "2026-08-14" };
+  const record = (id, date, inputTokens) =>
+    JSON.stringify({
+      schemaVersion: 1,
+      id,
+      timestamp: `${date}T00:00:00Z`,
+      inputTokens,
+      outputTokens: 0,
+      cachedTokens: 0,
+      thoughtsTokens: 0,
+      totalTokens: inputTokens,
+    });
+
+  await writeFile(path, `${record("event-1", "2026-08-10", 5)}\n`);
+  const first = await adapterFor("qwen_code").collect({ dataPath: directory }, range, {});
+  await writeFile(
+    path,
+    `${record("event-1", "2026-08-10", 99)}\n${record("event-2", "2026-08-11", 7)}\n`,
+  );
+  const result = await adapterFor("qwen_code").collect(
+    { dataPath: directory },
+    range,
+    first.nextState,
+  );
+
+  assert.equal(result.completeness, "partial");
+  assert.deepEqual(result.diagnostics, [{ code: "event_usage_conflict", phase: "collect" }]);
+  assert.deepEqual(
+    result.entries.map((entry) => [entry.date, entry.totalTokens]),
+    [
+      ["2026-08-10", "5"],
+      ["2026-08-11", "7"],
+    ],
+  );
+});
+
+test("a full event ledger does not emit unpersisted overflow observations", () => {
+  const events = Object.fromEntries(
+    Array.from({ length: maximumEventLedgerEntries }, (_, index) => [
+      index.toString(16).padStart(64, "0"),
+      { date: "2026-08-10", totalTokens: "1" },
+    ]),
+  );
+  const previous = { version: 1, events };
+  assert.equal(Object.keys(previous.events).length, maximumEventLedgerEntries);
+
+  const result = observeEventLedger(
+    previous,
+    [
+      { id: "overflow", entry: { date: "2026-08-10", totalTokens: "9" } },
+      { id: "overflow", entry: { date: "2026-08-10", totalTokens: "9" } },
+    ],
+    { rangeStart: "2026-08-10", rangeEnd: "2026-08-10" },
+  );
+
+  assert.equal(result.limited, true);
+  assert.deepEqual(result.entries, [
+    { date: "2026-08-10", totalTokens: "65536" },
+  ]);
+  assert.equal(Object.keys(result.ledger.events).length, maximumEventLedgerEntries);
+});
