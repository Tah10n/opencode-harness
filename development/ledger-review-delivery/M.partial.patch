+test("event ledgers survive an account switch, retain first tuples, and admit new events", async (context) => {
+  const directory = await mkdtemp(join(tmpdir(), "viberacing-event-ledger-switch-"));
+  context.after(() => rm(directory, { force: true, recursive: true }));
+  const path = join(directory, "token-usage-2026-08.jsonl");
+  const range = { rangeStart: "2026-07-15", rangeEnd: "2026-08-14" };
+  const record = (id, timestamp, inputTokens, outputTokens = 0) =>
+    JSON.stringify({
+      schemaVersion: 1,
+      id,
+      timestamp,
+      inputTokens,
+      outputTokens,
+      cachedTokens: 0,
+      thoughtsTokens: 0,
+      totalTokens: inputTokens + outputTokens,
+    });
+
+  await writeFile(path, `${record("event-1", "2026-08-10T00:00:00Z", 5)}\n`);
+  const first = await adapterFor("qwen_code").collect({ dataPath: directory }, range, {});
+  assert.equal(first.entries[0].totalTokens, "5");
+  assert.equal(Object.keys(first.nextState.eventLedger.events).length, 1);
+
+  await writeFile(
+    path,
+    `${record("event-1", "2026-08-10T00:00:00Z", 5)}\n${record(
+      "event-2",
+      "2026-08-11T00:00:00Z",
+      7,
+    )}\n`,
+  );
+  const switched = await adapterFor("qwen_code").collect(
+    { dataPath: directory },
+    range,
+    first.nextState,
+  );
+  assert.deepEqual(
+    switched.entries.map((entry) => [entry.date, entry.totalTokens]),
+    [
+      ["2026-08-10", "5"],
+      ["2026-08-11", "7"],
+    ],
+  );
+  assert.doesNotMatch(JSON.stringify(switched.nextState.eventLedger), /event-1|event-2/);
+
+  await writeFile(path, `${record("event-1", "2026-08-10T00:00:00Z", 99)}\n${record(
+    "event-3",
+    "2026-08-12T00:00:00Z",
+    11,
+  )}\n`);
+  assert.equal((await readFile(path, "utf8")).trim().split("\n").length, 2);
+  const conflict = await adapterFor("qwen_code").collect(
+    { dataPath: directory },
+    range,
+    switched.nextState,
+  );
+  assert.equal(conflict.completeness, "partial");
+  assert.deepEqual(
+    conflict.entries.map((entry) => [entry.date, entry.totalTokens]),
+    [
+      ["2026-08-10", "5"],
+      ["2026-08-11", "7"],
+      ["2026-08-12", "11"],
+    ],
+  );
+  assert.deepEqual(conflict.diagnostics, [{ code: "event_usage_conflict", phase: "collect" }]);
+
+  await writeFile(path, `${record("event-3", "2026-08-12T00:00:00Z", 11)}\n`);
+  assert.equal((await readFile(path, "utf8")).trim().split("\n").length, 1);
+  const deletedHistory = await adapterFor("qwen_code").collect(
+    { dataPath: directory },
+    range,
+    conflict.nextState,
+  );
+  assert.deepEqual(
+    deletedHistory.entries.map((entry) => [entry.date, entry.totalTokens]),
+    [
+      ["2026-08-10", "5"],
+      ["2026-08-11", "7"],
+      ["2026-08-12", "11"],
