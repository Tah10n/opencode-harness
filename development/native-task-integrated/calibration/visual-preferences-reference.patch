index 0000000000000000000000000000000000000000..cf6d285fb068f23055d4e6e1c72a045d2ff68aa8
--- /dev/null
+++ b/src/preferences.ts
@@ -0,0 +1,68 @@
+export type Preferences = {
+  variant: "signal" | "topography" | "radar";
+  theme: "acid" | "plasma" | "ice";
+};
+export const preferenceKey = "tahion.visual.preferences";
+const defaults: Preferences = { variant: "signal", theme: "acid" };
+const variants = ["signal", "topography", "radar"];
+const themes = ["acid", "plasma", "ice"];
+function parse(raw: string | null): Preferences | null {
+  try {
+    const value = JSON.parse(raw ?? "null");
+    if (
+      value?.version === 1 &&
+      typeof value.variant === "string" &&
+      variants.includes(value.variant) &&
+      typeof value.theme === "string" &&
+      themes.includes(value.theme)
+    )
+      return { variant: value.variant, theme: value.theme };
+  } catch {
+    /* invalid storage */
+  }
+  return null;
+}
+export function createPreferences(storage: Storage | undefined) {
+  let current = { ...defaults };
+  const save = () => {
+    try {
+      storage?.setItem(preferenceKey, JSON.stringify({ version: 1, ...current }));
+    } catch {
+      /* in-memory selection survives */
+    }
+  };
+  try {
+    const raw = storage?.getItem(preferenceKey) ?? null;
+    if (raw !== null) current = parse(raw) ?? { ...defaults };
+    else {
+      const variant = storage?.getItem("tahion.backdrop.variant") ?? "";
+      const theme = storage?.getItem("tahion.backdrop.theme") ?? "";
+      const v = variants.includes(variant),
+        t = themes.includes(theme);
+      current = {
+        variant: v ? (variant as Preferences["variant"]) : "signal",
+        theme: t ? (theme as Preferences["theme"]) : "acid",
+      };
+      if (v || t) save();
+    }
+  } catch {
+    current = { ...defaults };
+  }
+  return {
+    get value() {
+      return { ...current };
+    },
+    choose(change: Partial<Preferences>) {
+      current = { ...current, ...change };
+      save();
+      return { ...current };
+    },
+    receive(event: Pick<StorageEvent, "key" | "newValue" | "storageArea">) {
+      if (!storage || event.key !== preferenceKey || event.storageArea !== storage) return null;
+      const next = event.newValue === null ? { ...defaults } : parse(event.newValue);
+      if (!next) return null;
+      current = next;
+      return { ...current };
+    },
+  };
+}
diff --git a/tests/preferences.test.ts b/tests/preferences.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e1059c87ba23c5c6b3c0b4a5643b91c331b3602b
--- /dev/null
+++ b/tests/preferences.test.ts
@@ -0,0 +1,101 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { createPreferences, preferenceKey } from "../src/preferences.ts";
+function memory(initial: Record<string, string> = {}) {
+  const values = { ...initial };
+  let writes = 0;
+  return {
+    getItem: (key: string) => values[key] ?? null,
+    setItem: (key: string, value: string) => {
+      values[key] = value;
+      writes++;
+    },
+    get writes() {
+      return writes;
+    },
+    values,
+  };
+}
+const asStorage = (store: ReturnType<typeof memory>) => store as unknown as Storage;
+test("legacy migration preserves either old field and repeats safely", () => {
+  for (const variant of ["signal", "topography", "radar"]) {
+    for (const theme of ["acid", "plasma", "ice"]) {
+      const store = memory({ "tahion.backdrop.variant": variant, "tahion.backdrop.theme": theme });
+      assert.deepEqual(createPreferences(asStorage(store)).value, { variant, theme });
+      assert.deepEqual(JSON.parse(store.values[preferenceKey]), { version: 1, variant, theme });
+      createPreferences(asStorage(store));
+      assert.equal(store.writes, 1);
+      assert.equal(store.values["tahion.backdrop.variant"], variant);
+    }
+  }
+  const store = memory({ "tahion.backdrop.variant": "bad", "tahion.backdrop.theme": "ice" });
+  assert.deepEqual(createPreferences(asStorage(store)).value, { variant: "signal", theme: "ice" });
+});
+test("current precedence, invalid data and unavailable storage", () => {
+  const store = memory({
+    [preferenceKey]: JSON.stringify({ version: 1, variant: "radar", theme: "ice" }),
+    "tahion.backdrop.variant": "topography",
+  });
+  assert.deepEqual(createPreferences(asStorage(store)).value, { variant: "radar", theme: "ice" });
+  assert.equal(store.writes, 0);
+  for (const value of [
+    "{",
+    "null",
+    JSON.stringify({ version: 2, variant: "radar", theme: "ice" }),
+    JSON.stringify({ version: 1, variant: "bad", theme: "ice" }),
+  ]) {
+    const s = memory({ [preferenceKey]: value });
+    assert.deepEqual(createPreferences(asStorage(s)).value, { variant: "signal", theme: "acid" });
+    assert.equal(s.writes, 0);
+  }
+  assert.deepEqual(createPreferences(undefined).choose({ theme: "ice" }), {
+    variant: "signal",
+    theme: "ice",
+  });
+  const blocked = {
+    getItem() {
+      throw Error();
+    },
+    setItem() {
+      throw Error();
+    },
+  } as unknown as Storage;
+  assert.deepEqual(createPreferences(blocked).choose({ variant: "radar" }), {
+    variant: "radar",
+    theme: "acid",
+  });
+});
+test("selection persists both values and reloads", () => {
+  const store = memory();
+  const c = createPreferences(asStorage(store));
+  assert.equal(store.writes, 0);
+  c.choose({ variant: "topography" });
+  c.choose({ theme: "plasma" });
+  c.choose({ theme: "plasma" });
+  assert.deepEqual(createPreferences(asStorage(store)).value, {
+    variant: "topography",
+    theme: "plasma",
+  });
+});
+test("events have no echo, preserve latest field and ignore irrelevant data", () => {
+  const store = memory(),
+    s = asStorage(store),
+    c = createPreferences(s);
+  const event = (newValue: string | null, key = preferenceKey, storageArea = s) => ({
+    newValue,
+    key,
+    storageArea,
+  });
+  assert.deepEqual(
+    c.receive(event(JSON.stringify({ version: 1, variant: "radar", theme: "ice" }))),
+    { variant: "radar", theme: "ice" },
+  );
+  assert.equal(store.writes, 0);
+  assert.deepEqual(c.choose({ theme: "plasma" }), { variant: "radar", theme: "plasma" });
+  const writes = store.writes;
+  assert.equal(c.receive(event("bad")), null);
+  assert.equal(c.receive(event(null, "other")), null);
+  assert.equal(c.receive(event(null, preferenceKey, {} as Storage)), null);
+  assert.deepEqual(c.receive(event(null)), { variant: "signal", theme: "acid" });
+  assert.equal(store.writes, writes);
+});
