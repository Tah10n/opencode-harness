+    );
+    expect(parseQuery(stringifyQuery(params))).toEqual({
+      "sp ace": "a+b &/%",
+      unicode: "你好",
+    });
+  });
+
+  test("serializes empty params as an empty string", () => {
+    expect(stringifyQuery(new URLSearchParams())).toBe("");
+  });
