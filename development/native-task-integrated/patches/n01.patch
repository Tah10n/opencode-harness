index 0000000000000000000000000000000000000000..3413afb9a716e257ba2e3b404abf075ac89bbddd
--- /dev/null
+++ b/src/visualPreferences.ts
@@ -0,0 +1,155 @@
+export type BackdropVariant = "signal" | "topography" | "radar";
+export type BackdropTheme = "acid" | "plasma" | "ice";
+
+export type VisualPreferences = {
+  version: 1;
+  variant: BackdropVariant;
+  theme: BackdropTheme;
+};
+
+export type VisualPreferencesStorage = Pick<Storage, "getItem" | "setItem">;
+
+export type VisualPreferencesStorageEvent = {
+  storageArea: VisualPreferencesStorage | null;
+  key: string | null;
+  newValue: string | null;
+};
+
+export const visualPreferencesStorageKey = "tahion.visual.preferences";
+export const legacyVariantStorageKey = "tahion.backdrop.variant";
+export const legacyThemeStorageKey = "tahion.backdrop.theme";
+
+export const backdropVariants: readonly BackdropVariant[] = ["signal", "topography", "radar"];
+
+export const backdropThemes: readonly BackdropTheme[] = ["acid", "plasma", "ice"];
+
+export const defaultVisualPreferences: VisualPreferences = {
+  version: 1,
+  variant: "signal",
+  theme: "acid",
+};
+
+export function mergeVisualPreferences(
+  preferences: VisualPreferences,
+  changes: Partial<Pick<VisualPreferences, "variant" | "theme">>,
+): VisualPreferences {
+  return { ...preferences, ...changes };
+}
+
+export function isBackdropVariant(value: unknown): value is BackdropVariant {
+  return typeof value === "string" && backdropVariants.includes(value as BackdropVariant);
+}
+
+export function isBackdropTheme(value: unknown): value is BackdropTheme {
+  return typeof value === "string" && backdropThemes.includes(value as BackdropTheme);
+}
+
+export function parseVisualPreferences(raw: string): VisualPreferences | null {
+  try {
+    const parsed: unknown = JSON.parse(raw);
+
+    if (
+      typeof parsed !== "object" ||
+      parsed === null ||
+      Array.isArray(parsed) ||
+      (parsed as { version?: unknown }).version !== 1
+    ) {
+      return null;
+    }
+
+    const record = parsed as { variant?: unknown; theme?: unknown };
+
+    if (!isBackdropVariant(record.variant) || !isBackdropTheme(record.theme)) {
+      return null;
+    }
+
+    return {
+      version: 1,
+      variant: record.variant,
+      theme: record.theme,
+    };
+  } catch {
+    return null;
+  }
+}
+
+export function serializeVisualPreferences(preferences: VisualPreferences) {
+  return JSON.stringify(preferences);
+}
+
+function readStorageValue(storage: VisualPreferencesStorage, key: string) {
+  try {
+    return { available: true, value: storage.getItem(key) };
+  } catch {
+    return { available: false, value: null };
+  }
+}
+
+export function saveVisualPreferences(
+  storage: VisualPreferencesStorage | null,
+  preferences: VisualPreferences,
+) {
+  if (!storage) {
+    return;
+  }
+
+  try {
+    storage.setItem(visualPreferencesStorageKey, serializeVisualPreferences(preferences));
+  } catch {
+    // Storage can be disabled or full; in-memory preferences still work.
+  }
+}
+
+export function loadVisualPreferences(storage: VisualPreferencesStorage | null): VisualPreferences {
+  if (!storage) {
+    return { ...defaultVisualPreferences };
+  }
+
+  const current = readStorageValue(storage, visualPreferencesStorageKey);
+
+  if (!current.available) {
+    return { ...defaultVisualPreferences };
+  }
+
+  if (current.value !== null) {
+    return parseVisualPreferences(current.value) ?? { ...defaultVisualPreferences };
+  }
+
+  const legacyVariant = readStorageValue(storage, legacyVariantStorageKey);
+  const legacyTheme = readStorageValue(storage, legacyThemeStorageKey);
+  const variant = isBackdropVariant(legacyVariant.value) ? legacyVariant.value : "signal";
+  const theme = isBackdropTheme(legacyTheme.value) ? legacyTheme.value : "acid";
+  const migrated = { version: 1 as const, variant, theme };
+
+  if (
+    (legacyVariant.available && isBackdropVariant(legacyVariant.value)) ||
+    (legacyTheme.available && isBackdropTheme(legacyTheme.value))
+  ) {
+    saveVisualPreferences(storage, migrated);
+  }
+
+  return migrated;
+}
+
+export function getLocalStorage(): VisualPreferencesStorage | null {
+  try {
+    return typeof window === "undefined" ? null : window.localStorage;
+  } catch {
+    return null;
+  }
+}
+
+export function readVisualPreferencesStorageEvent(
+  event: VisualPreferencesStorageEvent,
+  storage: VisualPreferencesStorage | null,
+): VisualPreferences | null | undefined {
+  if (!storage || event.storageArea !== storage || event.key !== visualPreferencesStorageKey) {
+    return undefined;
+  }
+
+  if (event.newValue === null) {
+    return null;
+  }
+
+  return parseVisualPreferences(event.newValue) ?? undefined;
+}
diff --git a/test/visualPreferences.test.ts b/test/visualPreferences.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2e546b831059b2f2e9896acdee2ca6af903eb0a2
--- /dev/null
+++ b/test/visualPreferences.test.ts
@@ -0,0 +1,195 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  defaultVisualPreferences,
+  legacyThemeStorageKey,
+  legacyVariantStorageKey,
+  loadVisualPreferences,
+  mergeVisualPreferences,
+  readVisualPreferencesStorageEvent,
+  saveVisualPreferences,
+  visualPreferencesStorageKey,
+} from "../src/visualPreferences.ts";
+import type { VisualPreferencesStorage } from "../src/visualPreferences.ts";
+
+class MemoryStorage implements VisualPreferencesStorage {
+  readonly values = new Map<string, string>();
+  writes: string[] = [];
+  throwOnGet = false;
+  throwOnSet = false;
+
+  getItem(key: string) {
+    if (this.throwOnGet) {
+      throw new Error("storage read blocked");
+    }
+
+    return this.values.get(key) ?? null;
+  }
+
+  setItem(key: string, value: string) {
+    this.writes.push(key);
+
+    if (this.throwOnSet) {
+      throw new Error("storage write blocked");
+    }
+
+    this.values.set(key, value);
+  }
+}
+
+const record = (variant: string, theme: string) => JSON.stringify({ version: 1, variant, theme });
+
+test("migrates valid legacy fields independently and leaves old keys untouched", () => {
+  const storage = new MemoryStorage();
+  storage.values.set(legacyVariantStorageKey, "radar");
+  storage.values.set(legacyThemeStorageKey, "unsupported");
+
+  assert.deepEqual(loadVisualPreferences(storage), {
+    version: 1,
+    variant: "radar",
+    theme: "acid",
+  });
+  assert.equal(storage.values.get(legacyVariantStorageKey), "radar");
+  assert.equal(storage.values.get(legacyThemeStorageKey), "unsupported");
+  assert.equal(storage.values.get(visualPreferencesStorageKey), record("radar", "acid"));
+
+  const writesAfterMigration = storage.writes.length;
+  assert.deepEqual(loadVisualPreferences(storage), {
+    version: 1,
+    variant: "radar",
+    theme: "acid",
+  });
+  assert.equal(storage.writes.length, writesAfterMigration);
+});
+
+test("current record takes precedence over legacy values", () => {
+  const storage = new MemoryStorage();
+  storage.values.set(visualPreferencesStorageKey, record("topography", "ice"));
+  storage.values.set(legacyVariantStorageKey, "radar");
+  storage.values.set(legacyThemeStorageKey, "plasma");
+
+  assert.deepEqual(loadVisualPreferences(storage), {
+    version: 1,
+    variant: "topography",
+    theme: "ice",
+  });
+  assert.equal(storage.writes.length, 0);
+});
+
+test("malformed, unknown-version, and unsupported records use defaults without overwriting", () => {
+  for (const value of [
+    "not json",
+    JSON.stringify({ version: 2, variant: "radar", theme: "ice" }),
+    JSON.stringify({ version: 1, variant: "unknown", theme: "ice" }),
+    JSON.stringify({ version: 1, variant: "radar" }),
+  ]) {
+    const storage = new MemoryStorage();
+    storage.values.set(visualPreferencesStorageKey, value);
+    storage.values.set(legacyVariantStorageKey, "radar");
+
+    assert.deepEqual(loadVisualPreferences(storage), defaultVisualPreferences);
+    assert.equal(storage.values.get(visualPreferencesStorageKey), value);
+    assert.equal(storage.writes.length, 0);
+  }
+});
+
+test("missing data returns defaults without a startup write", () => {
+  const storage = new MemoryStorage();
+
+  assert.deepEqual(loadVisualPreferences(storage), defaultVisualPreferences);
+  assert.equal(storage.writes.length, 0);
+});
+
+test("blocked storage does not prevent defaults or saving in memory", () => {
+  const blockedRead = new MemoryStorage();
+  blockedRead.throwOnGet = true;
+  assert.deepEqual(loadVisualPreferences(blockedRead), defaultVisualPreferences);
+  assert.doesNotThrow(() => saveVisualPreferences(blockedRead, defaultVisualPreferences));
+
+  const blockedWrite = new MemoryStorage();
+  blockedWrite.values.set(legacyThemeStorageKey, "plasma");
+  blockedWrite.throwOnSet = true;
+  assert.deepEqual(loadVisualPreferences(blockedWrite), {
+    version: 1,
+    variant: "signal",
+    theme: "plasma",
+  });
+});
+
+test("selection saves both fields and reload restores both consumer values", () => {
+  const storage = new MemoryStorage();
+  let preferences = loadVisualPreferences(storage);
+
+  preferences = mergeVisualPreferences(preferences, { variant: "radar" });
+  saveVisualPreferences(storage, preferences);
+  preferences = mergeVisualPreferences(preferences, { theme: "ice" });
+  saveVisualPreferences(storage, preferences);
+
+  assert.deepEqual(loadVisualPreferences(storage), {
+    version: 1,
+    variant: "radar",
+    theme: "ice",
+  });
+  assert.deepEqual(JSON.parse(storage.values.get(visualPreferencesStorageKey)!), {
+    version: 1,
+    variant: "radar",
+    theme: "ice",
+  });
+});
+
+test("only valid new-key localStorage events update consumers and never write back", () => {
+  const storage = new MemoryStorage();
+  const otherStorage = new MemoryStorage();
+  const validEvent = {
+    storageArea: storage,
+    key: visualPreferencesStorageKey,
+    newValue: record("topography", "plasma"),
+  };
+
+  assert.deepEqual(readVisualPreferencesStorageEvent(validEvent, storage), {
+    version: 1,
+    variant: "topography",
+    theme: "plasma",
+  });
+  assert.equal(
+    readVisualPreferencesStorageEvent({ ...validEvent, storageArea: otherStorage }, storage),
+    undefined,
+  );
+  assert.equal(
+    readVisualPreferencesStorageEvent({ ...validEvent, key: "unrelated" }, storage),
+    undefined,
+  );
+  assert.equal(
+    readVisualPreferencesStorageEvent(
+      { ...validEvent, newValue: record("bad", "plasma") },
+      storage,
+    ),
+    undefined,
+  );
+  assert.equal(readVisualPreferencesStorageEvent({ ...validEvent, newValue: null }, storage), null);
+  assert.equal(storage.writes.length, 0);
+});
+
+test("a local selection after a remote update preserves the remote counterpart", () => {
+  const storage = new MemoryStorage();
+  const remote = readVisualPreferencesStorageEvent(
+    {
+      storageArea: storage,
+      key: visualPreferencesStorageKey,
+      newValue: record("topography", "plasma"),
+    },
+    storage,
+  );
+
+  assert.ok(remote);
+  let preferences = remote;
+  preferences = mergeVisualPreferences(preferences, { variant: "radar" });
+  saveVisualPreferences(storage, preferences);
+
+  assert.deepEqual(loadVisualPreferences(storage), {
+    version: 1,
+    variant: "radar",
+    theme: "plasma",
+  });
+  assert.equal(storage.writes.length, 1);
+});
