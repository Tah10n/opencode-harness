diff --git a/src/visualPreferences.ts b/src/visualPreferences.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ebd1f7e6f3ead08c861258711cdac9fc29abca64
--- /dev/null
+++ b/src/visualPreferences.ts
@@ -0,0 +1,150 @@
+export type BackdropVariant = "signal" | "topography" | "radar";
+export type BackdropTheme = "acid" | "plasma" | "ice";
+
+export type VisualPreferences = {
+  variant: BackdropVariant;
+  theme: BackdropTheme;
+};
+
+export type StorageLike = Pick<Storage, "getItem" | "setItem">;
+
+export type VisualStorageEvent = {
+  key: string | null;
+  newValue: string | null;
+  storageArea: StorageLike | null;
+};
+
+export const visualPreferencesStorageKey = "tahion.visual.preferences";
+export const legacyVariantStorageKey = "tahion.backdrop.variant";
+export const legacyThemeStorageKey = "tahion.backdrop.theme";
+
+export const defaultVisualPreferences: VisualPreferences = {
+  variant: "signal",
+  theme: "acid",
+};
+
+const variants: readonly BackdropVariant[] = ["signal", "topography", "radar"];
+const themes: readonly BackdropTheme[] = ["acid", "plasma", "ice"];
+
+function isVariant(value: unknown): value is BackdropVariant {
+  return typeof value === "string" && variants.includes(value as BackdropVariant);
+}
+
+function isTheme(value: unknown): value is BackdropTheme {
+  return typeof value === "string" && themes.includes(value as BackdropTheme);
+}
+
+export function parseVisualPreferences(raw: string): VisualPreferences | null {
+  try {
+    const parsed: unknown = JSON.parse(raw);
+
+    if (
+      typeof parsed !== "object" ||
+      parsed === null ||
+      !("version" in parsed) ||
+      parsed.version !== 1 ||
+      !("variant" in parsed) ||
+      !("theme" in parsed) ||
+      !isVariant(parsed.variant) ||
+      !isTheme(parsed.theme)
+    ) {
+      return null;
+    }
+
+    return { variant: parsed.variant, theme: parsed.theme };
+  } catch {
+    return null;
+  }
+}
+
+function read(storage: StorageLike, key: string) {
+  try {
+    return storage.getItem(key);
+  } catch {
+    return null;
+  }
+}
+
+function write(storage: StorageLike | null, preferences: VisualPreferences) {
+  if (!storage) {
+    return;
+  }
+
+  try {
+    storage.setItem(visualPreferencesStorageKey, JSON.stringify({ version: 1, ...preferences }));
+  } catch {
+    // Storage can be unavailable even after a successful read.
+  }
+}
+
+export function loadVisualPreferences(storage: StorageLike | null): VisualPreferences {
+  if (!storage) {
+    return { ...defaultVisualPreferences };
+  }
+
+  const current = read(storage, visualPreferencesStorageKey);
+
+  if (current !== null) {
+    return parseVisualPreferences(current) ?? { ...defaultVisualPreferences };
+  }
+
+  const legacyVariant = read(storage, legacyVariantStorageKey);
+  const legacyTheme = read(storage, legacyThemeStorageKey);
+  const preferences: VisualPreferences = {
+    variant: isVariant(legacyVariant) ? legacyVariant : defaultVisualPreferences.variant,
+    theme: isTheme(legacyTheme) ? legacyTheme : defaultVisualPreferences.theme,
+  };
+
+  if (isVariant(legacyVariant) || isTheme(legacyTheme)) {
+    write(storage, preferences);
+  }
+
+  return preferences;
+}
+
+export function createVisualPreferencesController(storage: StorageLike | null) {
+  let current = loadVisualPreferences(storage);
+
+  return {
+    get current() {
+      return current;
+    },
+    selectVariant(variant: BackdropVariant) {
+      current = { ...current, variant };
+      write(storage, current);
+      return current;
+    },
+    selectTheme(theme: BackdropTheme) {
+      current = { ...current, theme };
+      write(storage, current);
+      return current;
+    },
+    handleStorageEvent(event: VisualStorageEvent): VisualPreferences | undefined {
+      if (!storage || event.storageArea !== storage || event.key !== visualPreferencesStorageKey) {
+        return undefined;
+      }
+
+      if (event.newValue === null) {
+        current = { ...defaultVisualPreferences };
+        return current;
+      }
+
+      const next = parseVisualPreferences(event.newValue);
+
+      if (!next) {
+        return undefined;
+      }
+
+      current = next;
+      return current;
+    },
+  };
+}
+
+export function getBrowserStorage(): StorageLike | null {
+  try {
+    return typeof window === "undefined" ? null : window.localStorage;
+  } catch {
+    return null;
+  }
+}
diff --git a/test/visualPreferences.test.ts b/test/visualPreferences.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f826be90c6dfee0c5a95152081085340d6c84417
--- /dev/null
+++ b/test/visualPreferences.test.ts
@@ -0,0 +1,199 @@
+import { strict as assert } from "node:assert";
+import { test } from "node:test";
+import {
+  createVisualPreferencesController,
+  defaultVisualPreferences,
+  legacyThemeStorageKey,
+  legacyVariantStorageKey,
+  visualPreferencesStorageKey,
+  type StorageLike,
+} from "../src/visualPreferences.ts";
+
+class MemoryStorage implements StorageLike {
+  private readonly values = new Map<string, string>();
+  readonly writes: Array<[string, string]> = [];
+  throwOnGet = false;
+  throwOnSet = false;
+
+  constructor(initial: Record<string, string> = {}) {
+    for (const [key, value] of Object.entries(initial)) {
+      this.values.set(key, value);
+    }
+  }
+
+  getItem(key: string) {
+    if (this.throwOnGet) {
+      throw new Error("storage read blocked");
+    }
+
+    return this.values.get(key) ?? null;
+  }
+
+  setItem(key: string, value: string) {
+    if (this.throwOnSet) {
+      throw new Error("storage write blocked");
+    }
+
+    this.values.set(key, value);
+    this.writes.push([key, value]);
+  }
+}
+
+function record(variant: string, theme: string, version = 1) {
+  return JSON.stringify({ version, variant, theme });
+}
+
+function storageEvent(
+  storage: StorageLike,
+  newValue: string | null,
+  key = visualPreferencesStorageKey,
+) {
+  return { key, newValue, storageArea: storage };
+}
+
+test("migrates valid legacy choices independently and leaves legacy keys intact", () => {
+  const storage = new MemoryStorage({
+    [legacyVariantStorageKey]: "topography",
+    [legacyThemeStorageKey]: "not-a-theme",
+  });
+
+  const controller = createVisualPreferencesController(storage);
+
+  assert.deepEqual(controller.current, { variant: "topography", theme: "acid" });
+  assert.equal(storage.getItem(legacyVariantStorageKey), "topography");
+  assert.equal(storage.getItem(legacyThemeStorageKey), "not-a-theme");
+  assert.deepEqual(storage.writes, [[visualPreferencesStorageKey, record("topography", "acid")]]);
+});
+
+test("migrates both valid legacy choices into one current record", () => {
+  const storage = new MemoryStorage({
+    [legacyVariantStorageKey]: "radar",
+    [legacyThemeStorageKey]: "plasma",
+  });
+
+  const controller = createVisualPreferencesController(storage);
+
+  assert.deepEqual(controller.current, { variant: "radar", theme: "plasma" });
+  assert.deepEqual(storage.writes, [[visualPreferencesStorageKey, record("radar", "plasma")]]);
+});
+
+test("current record takes precedence, while missing data uses defaults without writing", () => {
+  const currentStorage = new MemoryStorage({
+    [visualPreferencesStorageKey]: record("radar", "ice"),
+    [legacyVariantStorageKey]: "signal",
+    [legacyThemeStorageKey]: "plasma",
+  });
+  const currentController = createVisualPreferencesController(currentStorage);
+
+  assert.deepEqual(currentController.current, { variant: "radar", theme: "ice" });
+  assert.deepEqual(currentStorage.writes, []);
+
+  const emptyStorage = new MemoryStorage();
+  const emptyController = createVisualPreferencesController(emptyStorage);
+
+  assert.deepEqual(emptyController.current, defaultVisualPreferences);
+  assert.deepEqual(emptyStorage.writes, []);
+});
+
+test("malformed, unknown-version, and unsupported current records use both defaults without migration", () => {
+  for (const value of [
+    "not-json",
+    record("radar", "ice", 2),
+    record("unknown", "ice"),
+    record("radar", "unknown"),
+  ]) {
+    const storage = new MemoryStorage({
+      [visualPreferencesStorageKey]: value,
+      [legacyVariantStorageKey]: "topography",
+      [legacyThemeStorageKey]: "plasma",
+    });
+
+    const controller = createVisualPreferencesController(storage);
+
+    assert.deepEqual(controller.current, defaultVisualPreferences);
+    assert.deepEqual(storage.writes, []);
+    assert.equal(storage.getItem(visualPreferencesStorageKey), value);
+  }
+});
+
+test("blocked storage does not prevent in-memory choices", () => {
+  const storage = new MemoryStorage();
+  storage.throwOnGet = true;
+  storage.throwOnSet = true;
+
+  const controller = createVisualPreferencesController(storage);
+
+  assert.doesNotThrow(() => controller.selectVariant("radar"));
+  assert.doesNotThrow(() => controller.selectTheme("ice"));
+  assert.deepEqual(controller.current, { variant: "radar", theme: "ice" });
+});
+
+test("selection saves both fields and a new controller restores them", () => {
+  const storage = new MemoryStorage();
+  const controller = createVisualPreferencesController(storage);
+
+  assert.equal(storage.getItem(visualPreferencesStorageKey), null);
+  controller.selectVariant("topography");
+  assert.deepEqual(JSON.parse(storage.getItem(visualPreferencesStorageKey)!), {
+    version: 1,
+    variant: "topography",
+    theme: "acid",
+  });
+  controller.selectTheme("plasma");
+
+  assert.deepEqual(JSON.parse(storage.getItem(visualPreferencesStorageKey)!), {
+    version: 1,
+    variant: "topography",
+    theme: "plasma",
+  });
+  assert.deepEqual(createVisualPreferencesController(storage).current, {
+    variant: "topography",
+    theme: "plasma",
+  });
+});
+
+test("valid local events update both fields without write-back, and local selection keeps the remote field", () => {
+  const storage = new MemoryStorage();
+  const controller = createVisualPreferencesController(storage);
+  const writesBeforeEvent = storage.writes.length;
+
+  const remote = controller.handleStorageEvent(storageEvent(storage, record("radar", "ice")));
+
+  assert.deepEqual(remote, { variant: "radar", theme: "ice" });
+  assert.deepEqual(controller.current, { variant: "radar", theme: "ice" });
+  assert.equal(storage.writes.length, writesBeforeEvent);
+
+  controller.selectVariant("signal");
+  assert.deepEqual(JSON.parse(storage.getItem(visualPreferencesStorageKey)!), {
+    version: 1,
+    variant: "signal",
+    theme: "ice",
+  });
+});
+
+test("removed, invalid, unrelated, and non-local events have the required effects", () => {
+  const storage = new MemoryStorage();
+  const otherStorage = new MemoryStorage();
+  const controller = createVisualPreferencesController(storage);
+
+  controller.handleStorageEvent(storageEvent(storage, record("topography", "plasma")));
+  const writesBeforeIgnoredEvents = storage.writes.length;
+
+  assert.equal(controller.handleStorageEvent(storageEvent(storage, "not-json")), undefined);
+  assert.equal(
+    controller.handleStorageEvent(storageEvent(storage, record("radar", "ice"), "other-key")),
+    undefined,
+  );
+  assert.equal(
+    controller.handleStorageEvent(storageEvent(otherStorage, record("radar", "ice"))),
+    undefined,
+  );
+  assert.deepEqual(controller.current, { variant: "topography", theme: "plasma" });
+  assert.equal(storage.writes.length, writesBeforeIgnoredEvents);
+
+  const removed = controller.handleStorageEvent(storageEvent(storage, null));
+
+  assert.deepEqual(removed, defaultVisualPreferences);
+  assert.deepEqual(controller.current, defaultVisualPreferences);
+  assert.equal(storage.writes.length, writesBeforeIgnoredEvents);
+});
