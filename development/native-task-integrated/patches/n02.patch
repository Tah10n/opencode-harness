diff --git a/src/visualPreferences.ts b/src/visualPreferences.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8d16062656c8422bf45ccd487c1c844ab050e716
--- /dev/null
+++ b/src/visualPreferences.ts
@@ -0,0 +1,137 @@
+export type BackdropVariant = "signal" | "topography" | "radar";
+export type BackdropTheme = "acid" | "plasma" | "ice";
+
+export type VisualPreferences = {
+  version: 1;
+  variant: BackdropVariant;
+  theme: BackdropTheme;
+};
+
+export const visualPreferencesStorageKey = "tahion.visual.preferences";
+export const legacyVariantStorageKey = "tahion.backdrop.variant";
+export const legacyThemeStorageKey = "tahion.backdrop.theme";
+
+const defaultPreferences: VisualPreferences = {
+  version: 1,
+  variant: "signal",
+  theme: "acid",
+};
+
+const variants: readonly BackdropVariant[] = ["signal", "topography", "radar"];
+const themes: readonly BackdropTheme[] = ["acid", "plasma", "ice"];
+
+export function getDefaultVisualPreferences(): VisualPreferences {
+  return { ...defaultPreferences };
+}
+
+export function parseVisualPreferences(raw: string | null): VisualPreferences | null {
+  if (raw === null) {
+    return null;
+  }
+
+  try {
+    const parsed: unknown = JSON.parse(raw);
+
+    if (!isVisualPreferences(parsed)) {
+      return null;
+    }
+
+    return parsed;
+  } catch {
+    return null;
+  }
+}
+
+export function isVisualPreferences(value: unknown): value is VisualPreferences {
+  if (typeof value !== "object" || value === null) {
+    return false;
+  }
+
+  const record = value as Record<string, unknown>;
+  return (
+    record.version === 1 &&
+    variants.includes(record.variant as BackdropVariant) &&
+    themes.includes(record.theme as BackdropTheme)
+  );
+}
+
+function readStorageValue(storage: Storage, key: string): string | null {
+  try {
+    return storage.getItem(key);
+  } catch {
+    return null;
+  }
+}
+
+function writeStorageValue(storage: Storage, key: string, value: string): void {
+  try {
+    storage.setItem(key, value);
+  } catch {
+    // A blocked storage area must not prevent the controls from working.
+  }
+}
+
+export function readVisualPreferences(storage: Storage | null): VisualPreferences {
+  if (!storage) {
+    return getDefaultVisualPreferences();
+  }
+
+  let currentRaw: string | null;
+  try {
+    currentRaw = storage.getItem(visualPreferencesStorageKey);
+  } catch {
+    return getDefaultVisualPreferences();
+  }
+
+  if (currentRaw !== null) {
+    return parseVisualPreferences(currentRaw) ?? getDefaultVisualPreferences();
+  }
+
+  const legacyVariant = readStorageValue(storage, legacyVariantStorageKey);
+  const legacyTheme = readStorageValue(storage, legacyThemeStorageKey);
+  const variant = variants.includes(legacyVariant as BackdropVariant)
+    ? (legacyVariant as BackdropVariant)
+    : defaultPreferences.variant;
+  const theme = themes.includes(legacyTheme as BackdropTheme)
+    ? (legacyTheme as BackdropTheme)
+    : defaultPreferences.theme;
+
+  if (
+    variants.includes(legacyVariant as BackdropVariant) ||
+    themes.includes(legacyTheme as BackdropTheme)
+  ) {
+    writeVisualPreferences(storage, { version: 1, variant, theme });
+  }
+
+  return { version: 1, variant, theme };
+}
+
+export function writeVisualPreferences(
+  storage: Storage | null,
+  preferences: VisualPreferences,
+): void {
+  if (!storage) {
+    return;
+  }
+
+  writeStorageValue(storage, visualPreferencesStorageKey, JSON.stringify(preferences));
+}
+
+export function preferencesFromStorageEvent(
+  event: StorageEvent,
+  storage: Storage,
+): VisualPreferences | undefined {
+  try {
+    if (event.storageArea !== storage || event.key !== visualPreferencesStorageKey) {
+      return undefined;
+    }
+  } catch {
+    return undefined;
+  }
+
+  if (event.newValue === null) {
+    return getDefaultVisualPreferences();
+  }
+
+  return parseVisualPreferences(event.newValue) ?? undefined;
+}
diff --git a/tests/visualPreferences.test.ts b/tests/visualPreferences.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..841263a77a8637f3c160574820ba49434593abe2
--- /dev/null
+++ b/tests/visualPreferences.test.ts
@@ -0,0 +1,216 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import {
+  legacyThemeStorageKey,
+  legacyVariantStorageKey,
+  preferencesFromStorageEvent,
+  readVisualPreferences,
+  visualPreferencesStorageKey,
+  writeVisualPreferences,
+} from "../src/visualPreferences.ts";
+
+class MemoryStorage implements Storage {
+  private values = new Map<string, string>();
+  writes: Array<{ key: string; value: string }> = [];
+  shouldThrow = false;
+
+  get length() {
+    return this.values.size;
+  }
+
+  clear() {
+    this.values.clear();
+  }
+
+  getItem(key: string) {
+    if (this.shouldThrow) {
+      throw new Error("storage blocked");
+    }
+    return this.values.get(key) ?? null;
+  }
+
+  key(index: number) {
+    return [...this.values.keys()][index] ?? null;
+  }
+
+  removeItem(key: string) {
+    if (this.shouldThrow) {
+      throw new Error("storage blocked");
+    }
+    this.values.delete(key);
+  }
+
+  setItem(key: string, value: string) {
+    if (this.shouldThrow) {
+      throw new Error("storage blocked");
+    }
+    this.values.set(key, value);
+    this.writes.push({ key, value });
+  }
+
+  set(key: string, value: string) {
+    this.values.set(key, value);
+  }
+
+  get(key: string) {
+    return this.values.get(key) ?? null;
+  }
+}
+
+function storageEvent(storageArea: Storage, key: string, newValue: string | null): StorageEvent {
+  return { storageArea, key, newValue } as StorageEvent;
+}
+
+test("migrates valid legacy choices independently and leaves old data intact", () => {
+  const storage = new MemoryStorage();
+  storage.set(legacyVariantStorageKey, "topography");
+  storage.set(legacyThemeStorageKey, "unsupported");
+  storage.set("unrelated", "keep");
+
+  assert.deepEqual(readVisualPreferences(storage), {
+    version: 1,
+    variant: "topography",
+    theme: "acid",
+  });
+  assert.deepEqual(JSON.parse(storage.get(visualPreferencesStorageKey) ?? ""), {
+    version: 1,
+    variant: "topography",
+    theme: "acid",
+  });
+  assert.equal(storage.get(legacyVariantStorageKey), "topography");
+  assert.equal(storage.get(legacyThemeStorageKey), "unsupported");
+  assert.equal(storage.get("unrelated"), "keep");
+
+  const writesAfterMigration = storage.writes.length;
+  assert.deepEqual(readVisualPreferences(storage), {
+    version: 1,
+    variant: "topography",
+    theme: "acid",
+  });
+  assert.equal(storage.writes.length, writesAfterMigration);
+});
+
+test("prefers a complete current record over legacy values", () => {
+  const storage = new MemoryStorage();
+  storage.set(
+    visualPreferencesStorageKey,
+    JSON.stringify({ version: 1, variant: "radar", theme: "plasma" }),
+  );
+  storage.set(legacyVariantStorageKey, "signal");
+  storage.set(legacyThemeStorageKey, "ice");
+
+  assert.deepEqual(readVisualPreferences(storage), {
+    version: 1,
+    variant: "radar",
+    theme: "plasma",
+  });
+  assert.equal(storage.writes.length, 0);
+});
+
+test("does not overwrite malformed or unsupported current records", () => {
+  for (const raw of [
+    "not json",
+    JSON.stringify({ version: 2, variant: "radar", theme: "plasma" }),
+    JSON.stringify({ version: 1, variant: "unknown", theme: "plasma" }),
+    JSON.stringify({ version: 1, variant: "radar", theme: "unknown" }),
+  ]) {
+    const storage = new MemoryStorage();
+    storage.set(visualPreferencesStorageKey, raw);
+    storage.set(legacyVariantStorageKey, "topography");
+    storage.set(legacyThemeStorageKey, "ice");
+
+    assert.deepEqual(readVisualPreferences(storage), {
+      version: 1,
+      variant: "signal",
+      theme: "acid",
+    });
+    assert.equal(storage.get(visualPreferencesStorageKey), raw);
+    assert.equal(storage.writes.length, 0);
+  }
+});
+
+test("missing data returns defaults without a startup write", () => {
+  const storage = new MemoryStorage();
+
+  assert.deepEqual(readVisualPreferences(storage), {
+    version: 1,
+    variant: "signal",
+    theme: "acid",
+  });
+  assert.equal(storage.writes.length, 0);
+});
+
+test("blocked storage does not prevent reads or writes from failing the page", () => {
+  const storage = new MemoryStorage();
+  storage.shouldThrow = true;
+
+  assert.deepEqual(readVisualPreferences(storage), {
+    version: 1,
+    variant: "signal",
+    theme: "acid",
+  });
+  assert.doesNotThrow(() =>
+    writeVisualPreferences(storage, { version: 1, variant: "radar", theme: "ice" }),
+  );
+});
+
+test("a combined selection survives reload and preserves the other choice", () => {
+  const storage = new MemoryStorage();
+  let current = readVisualPreferences(storage);
+
+  current = { ...current, theme: "ice" };
+  writeVisualPreferences(storage, current);
+  current = { ...current, variant: "radar" };
+  writeVisualPreferences(storage, current);
+
+  assert.deepEqual(JSON.parse(storage.get(visualPreferencesStorageKey) ?? ""), {
+    version: 1,
+    variant: "radar",
+    theme: "ice",
+  });
+  assert.deepEqual(readVisualPreferences(storage), current);
+});
+
+test("accepts remote records, resets on removal, and ignores irrelevant events without writing back", () => {
+  const storage = new MemoryStorage();
+  let current = readVisualPreferences(storage);
+  const remote = { version: 1 as const, variant: "topography" as const, theme: "plasma" as const };
+  const writesBeforeEvents = storage.writes.length;
+
+  current =
+    preferencesFromStorageEvent(
+      storageEvent(storage, visualPreferencesStorageKey, JSON.stringify(remote)),
+      storage,
+    ) ?? current;
+  assert.deepEqual(current, remote);
+  assert.equal(storage.writes.length, writesBeforeEvents);
+
+  current = { ...current, variant: "radar" };
+  writeVisualPreferences(storage, current);
+  assert.deepEqual(JSON.parse(storage.get(visualPreferencesStorageKey) ?? ""), {
+    version: 1,
+    variant: "radar",
+    theme: "plasma",
+  });
+
+  const writesBeforeIgnoredEvents = storage.writes.length;
+  for (const event of [
+    storageEvent(storage, visualPreferencesStorageKey, "invalid"),
+    storageEvent(storage, "other.key", JSON.stringify(remote)),
+    storageEvent({} as Storage, visualPreferencesStorageKey, JSON.stringify(remote)),
+  ]) {
+    const next = preferencesFromStorageEvent(event, storage);
+    if (next !== undefined) {
+      current = next;
+    }
+  }
+  assert.deepEqual(current, { version: 1, variant: "radar", theme: "plasma" });
+  assert.equal(storage.writes.length, writesBeforeIgnoredEvents);
+
+  const removed = preferencesFromStorageEvent(
+    storageEvent(storage, visualPreferencesStorageKey, null),
+    storage,
+  );
+  assert.deepEqual(removed, { version: 1, variant: "signal", theme: "acid" });
+  assert.equal(storage.writes.length, writesBeforeIgnoredEvents);
+});
