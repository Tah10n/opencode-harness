diff --git a/src/visualPreferences.ts b/src/visualPreferences.ts
new file mode 100644
index 0000000000000000000000000000000000000000..22d4b99c09725075f8001c209331a69c59ccf79c
--- /dev/null
+++ b/src/visualPreferences.ts
@@ -0,0 +1,136 @@
+export type BackdropVariant = "signal" | "topography" | "radar";
+export type BackdropTheme = "acid" | "plasma" | "ice";
+
+export type VisualPreferences = {
+  version: 1;
+  variant: BackdropVariant;
+  theme: BackdropTheme;
+};
+
+export interface VisualPreferenceStorage {
+  getItem(key: string): string | null;
+  setItem(key: string, value: string): void;
+}
+
+export const visualPreferencesStorageKey = "tahion.visual.preferences";
+export const legacyVariantStorageKey = "tahion.backdrop.variant";
+export const legacyThemeStorageKey = "tahion.backdrop.theme";
+
+const defaultVariant: BackdropVariant = "signal";
+const defaultTheme: BackdropTheme = "acid";
+const variants: readonly BackdropVariant[] = ["signal", "topography", "radar"];
+const themes: readonly BackdropTheme[] = ["acid", "plasma", "ice"];
+
+export function getDefaultVisualPreferences(): VisualPreferences {
+  return { version: 1, variant: defaultVariant, theme: defaultTheme };
+}
+
+export function isVisualPreferences(value: unknown): value is VisualPreferences {
+  if (typeof value !== "object" || value === null || Array.isArray(value)) {
+    return false;
+  }
+
+  const record = value as Record<string, unknown>;
+  return (
+    record.version === 1 &&
+    variants.includes(record.variant as BackdropVariant) &&
+    themes.includes(record.theme as BackdropTheme)
+  );
+}
+
+export function parseVisualPreferencesRecord(raw: string): VisualPreferences | null {
+  try {
+    const parsed: unknown = JSON.parse(raw);
+    return isVisualPreferences(parsed) ? parsed : null;
+  } catch {
+    return null;
+  }
+}
+
+function readStorageValue(storage: VisualPreferenceStorage, key: string) {
+  try {
+    return storage.getItem(key);
+  } catch {
+    return null;
+  }
+}
+
+export function loadVisualPreferences(storage: VisualPreferenceStorage | null): VisualPreferences {
+  if (!storage) {
+    return getDefaultVisualPreferences();
+  }
+
+  let currentRecord: string | null;
+  try {
+    currentRecord = storage.getItem(visualPreferencesStorageKey);
+  } catch {
+    return getDefaultVisualPreferences();
+  }
+
+  if (currentRecord !== null) {
+    return parseVisualPreferencesRecord(currentRecord) ?? getDefaultVisualPreferences();
+  }
+
+  const storedVariant = readStorageValue(storage, legacyVariantStorageKey);
+  const storedTheme = readStorageValue(storage, legacyThemeStorageKey);
+  const variant = variants.includes(storedVariant as BackdropVariant)
+    ? (storedVariant as BackdropVariant)
+    : defaultVariant;
+  const theme = themes.includes(storedTheme as BackdropTheme)
+    ? (storedTheme as BackdropTheme)
+    : defaultTheme;
+  const hasLegacyChoice =
+    variants.includes(storedVariant as BackdropVariant) ||
+    themes.includes(storedTheme as BackdropTheme);
+  const preferences = { version: 1 as const, variant, theme };
+
+  if (hasLegacyChoice) {
+    saveVisualPreferences(storage, preferences);
+  }
+
+  return preferences;
+}
+
+export function saveVisualPreferences(
+  storage: VisualPreferenceStorage | null,
+  preferences: VisualPreferences,
+) {
+  if (!storage) {
+    return;
+  }
+
+  try {
+    storage.setItem(visualPreferencesStorageKey, JSON.stringify(preferences));
+  } catch {
+    // Storage can be disabled or full; in-memory preferences remain usable.
+  }
+}
+
+export function getLocalStorage(): VisualPreferenceStorage | null {
+  if (typeof window === "undefined") {
+    return null;
+  }
+
+  try {
+    return window.localStorage;
+  } catch {
+    return null;
+  }
+}
+
+type VisualPreferencesStorageEvent = Pick<StorageEvent, "key" | "newValue" | "storageArea">;
+
+export function readVisualPreferencesStorageEvent(
+  event: VisualPreferencesStorageEvent,
+  storage: VisualPreferenceStorage,
+): VisualPreferences | null | undefined {
+  if (event.storageArea !== storage || event.key !== visualPreferencesStorageKey) {
+    return undefined;
+  }
+
+  if (event.newValue === null) {
+    return null;
+  }
+
+  return parseVisualPreferencesRecord(event.newValue) ?? undefined;
+}
diff --git a/tests/visualPreferences.test.ts b/tests/visualPreferences.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1b0609d5526e8c1cb2a830714ea518d644871f03
--- /dev/null
+++ b/tests/visualPreferences.test.ts
@@ -0,0 +1,198 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import {
+  getDefaultVisualPreferences,
+  legacyThemeStorageKey,
+  legacyVariantStorageKey,
+  loadVisualPreferences,
+  readVisualPreferencesStorageEvent,
+  saveVisualPreferences,
+  visualPreferencesStorageKey,
+  type VisualPreferenceStorage,
+  type VisualPreferences,
+} from "../src/visualPreferences.ts";
+
+class MemoryStorage implements VisualPreferenceStorage {
+  values = new Map<string, string>();
+  writes = 0;
+
+  constructor(initial: Record<string, string> = {}) {
+    for (const [key, value] of Object.entries(initial)) {
+      this.values.set(key, value);
+    }
+  }
+
+  getItem(key: string) {
+    return this.values.get(key) ?? null;
+  }
+
+  setItem(key: string, value: string) {
+    this.writes += 1;
+    this.values.set(key, value);
+  }
+
+  removeItem(key: string) {
+    this.values.delete(key);
+  }
+}
+
+class BlockedStorage implements VisualPreferenceStorage {
+  getItem() {
+    throw new Error("blocked");
+  }
+
+  setItem() {
+    throw new Error("blocked");
+  }
+}
+
+const preferences: VisualPreferences = { version: 1, variant: "radar", theme: "ice" };
+
+test("migrates independently valid legacy choices and leaves legacy keys intact", () => {
+  const storage = new MemoryStorage({
+    [legacyVariantStorageKey]: "topography",
+    [legacyThemeStorageKey]: "unsupported",
+  });
+
+  assert.deepEqual(loadVisualPreferences(storage), {
+    version: 1,
+    variant: "topography",
+    theme: "acid",
+  });
+  assert.deepEqual(JSON.parse(storage.values.get(visualPreferencesStorageKey)!), {
+    version: 1,
+    variant: "topography",
+    theme: "acid",
+  });
+  assert.equal(storage.values.get(legacyVariantStorageKey), "topography");
+  assert.equal(storage.values.get(legacyThemeStorageKey), "unsupported");
+
+  assert.deepEqual(loadVisualPreferences(storage), {
+    version: 1,
+    variant: "topography",
+    theme: "acid",
+  });
+  assert.equal(storage.writes, 1);
+});
+
+test("gives the current complete record precedence over legacy choices", () => {
+  const storage = new MemoryStorage({
+    [visualPreferencesStorageKey]: JSON.stringify(preferences),
+    [legacyVariantStorageKey]: "signal",
+    [legacyThemeStorageKey]: "plasma",
+  });
+
+  assert.deepEqual(loadVisualPreferences(storage), preferences);
+  assert.equal(storage.writes, 0);
+});
+
+test("uses both defaults for malformed, unknown-version, and unsupported current records", () => {
+  for (const currentRecord of [
+    "not-json",
+    JSON.stringify({ version: 2, variant: "radar", theme: "ice" }),
+    JSON.stringify({ version: 1, variant: "unknown", theme: "ice" }),
+    JSON.stringify({ version: 1, variant: "radar" }),
+  ]) {
+    const storage = new MemoryStorage({
+      [visualPreferencesStorageKey]: currentRecord,
+      [legacyVariantStorageKey]: "topography",
+      [legacyThemeStorageKey]: "plasma",
+    });
+
+    assert.deepEqual(loadVisualPreferences(storage), getDefaultVisualPreferences());
+    assert.equal(storage.writes, 0);
+    assert.equal(storage.values.get(visualPreferencesStorageKey), currentRecord);
+  }
+});
+
+test("missing data uses defaults without a startup write", () => {
+  const storage = new MemoryStorage();
+
+  assert.deepEqual(loadVisualPreferences(storage), getDefaultVisualPreferences());
+  assert.equal(storage.writes, 0);
+});
+
+test("blocked storage falls back to working in-memory defaults and saves safely", () => {
+  const storage = new BlockedStorage();
+
+  assert.deepEqual(loadVisualPreferences(storage), getDefaultVisualPreferences());
+  assert.doesNotThrow(() => saveVisualPreferences(storage, preferences));
+});
+
+test("saving both choices restores both choices on reload", () => {
+  const storage = new MemoryStorage();
+
+  saveVisualPreferences(storage, preferences);
+
+  assert.deepEqual(loadVisualPreferences(storage), preferences);
+  assert.deepEqual(JSON.parse(storage.values.get(visualPreferencesStorageKey)!), preferences);
+});
+
+test("storage events apply complete records and removal resets without writing back", () => {
+  const storage = new MemoryStorage();
+  const otherStorage = new MemoryStorage();
+
+  assert.deepEqual(
+    readVisualPreferencesStorageEvent(
+      {
+        key: visualPreferencesStorageKey,
+        newValue: JSON.stringify(preferences),
+        storageArea: storage,
+      },
+      storage,
+    ),
+    preferences,
+  );
+  assert.deepEqual(
+    readVisualPreferencesStorageEvent(
+      { key: visualPreferencesStorageKey, newValue: null, storageArea: storage },
+      storage,
+    ),
+    null,
+  );
+  assert.equal(
+    readVisualPreferencesStorageEvent(
+      {
+        key: visualPreferencesStorageKey,
+        newValue: JSON.stringify(preferences),
+        storageArea: otherStorage,
+      },
+      storage,
+    ),
+    undefined,
+  );
+  assert.equal(
+    readVisualPreferencesStorageEvent(
+      { key: "unrelated", newValue: JSON.stringify(preferences), storageArea: storage },
+      storage,
+    ),
+    undefined,
+  );
+  assert.equal(
+    readVisualPreferencesStorageEvent(
+      { key: visualPreferencesStorageKey, newValue: "{}", storageArea: storage },
+      storage,
+    ),
+    undefined,
+  );
+  assert.equal(storage.writes, 0);
+});
+
+test("a local selection based on a remote record preserves the latest other field", () => {
+  const storage = new MemoryStorage();
+  const remote = {
+    key: visualPreferencesStorageKey,
+    newValue: JSON.stringify(preferences),
+    storageArea: storage,
+  };
+  const latest = readVisualPreferencesStorageEvent(remote, storage);
+
+  assert.ok(latest);
+  saveVisualPreferences(storage, { ...latest, variant: "topography" });
+
+  assert.deepEqual(loadVisualPreferences(storage), {
+    version: 1,
+    variant: "topography",
+    theme: "ice",
+  });
+});
