diff --git a/src/visualPreferences.ts b/src/visualPreferences.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c667789a166caf39eb23fe10bc8f76935f7479b3
--- /dev/null
+++ b/src/visualPreferences.ts
@@ -0,0 +1,134 @@
+import type { BackdropTheme, BackdropVariant } from "./components/ShaderBackdrop";
+
+export const visualPreferencesStorageKey = "tahion.visual.preferences";
+export const legacyVariantStorageKey = "tahion.backdrop.variant";
+export const legacyThemeStorageKey = "tahion.backdrop.theme";
+
+export const backdropVariants = ["signal", "topography", "radar"] as const;
+export const backdropThemes = ["acid", "plasma", "ice"] as const;
+
+export type VisualPreferences = {
+  version: 1;
+  variant: BackdropVariant;
+  theme: BackdropTheme;
+};
+
+export interface PreferenceStorage {
+  getItem(key: string): string | null;
+  setItem(key: string, value: string): void;
+}
+
+export function defaultVisualPreferences(): VisualPreferences {
+  return { version: 1, variant: "signal", theme: "acid" };
+}
+
+function isAllowed<T extends string>(value: unknown, allowed: readonly T[]): value is T {
+  return typeof value === "string" && allowed.includes(value as T);
+}
+
+export function parseVisualPreferences(raw: string): VisualPreferences | null {
+  try {
+    const parsed: unknown = JSON.parse(raw);
+
+    if (
+      typeof parsed !== "object" ||
+      parsed === null ||
+      Array.isArray(parsed) ||
+      (parsed as { version?: unknown }).version !== 1 ||
+      !isAllowed((parsed as { variant?: unknown }).variant, backdropVariants) ||
+      !isAllowed((parsed as { theme?: unknown }).theme, backdropThemes)
+    ) {
+      return null;
+    }
+
+    const record = parsed as { variant: BackdropVariant; theme: BackdropTheme };
+    return { version: 1, variant: record.variant, theme: record.theme };
+  } catch {
+    return null;
+  }
+}
+
+export function readVisualPreferencesStorageEvent(
+  event: {
+    storageArea: PreferenceStorage | null;
+    key: string | null;
+    newValue: string | null;
+  },
+  storage: PreferenceStorage,
+): VisualPreferences | undefined {
+  if (
+    event.storageArea !== storage ||
+    (event.key !== visualPreferencesStorageKey && event.key !== null)
+  ) {
+    return undefined;
+  }
+
+  if (event.key === null && event.newValue !== null) {
+    return undefined;
+  }
+
+  return event.newValue === null
+    ? defaultVisualPreferences()
+    : (parseVisualPreferences(event.newValue) ?? undefined);
+}
+
+function readLegacyChoice<T extends string>(
+  storage: PreferenceStorage,
+  key: string,
+  allowed: readonly T[],
+): T | null {
+  try {
+    const value = storage.getItem(key);
+    return isAllowed(value, allowed) ? value : null;
+  } catch {
+    return null;
+  }
+}
+
+export function saveVisualPreferences(
+  storage: PreferenceStorage | null | undefined,
+  preferences: VisualPreferences,
+): void {
+  if (!storage) {
+    return;
+  }
+
+  try {
+    storage.setItem(visualPreferencesStorageKey, JSON.stringify(preferences));
+  } catch {
+    // Storage can be unavailable or denied; the in-memory preference remains usable.
+  }
+}
+
+export function loadVisualPreferences(
+  storage: PreferenceStorage | null | undefined,
+): VisualPreferences {
+  if (!storage) {
+    return defaultVisualPreferences();
+  }
+
+  let currentRaw: string | null;
+  try {
+    currentRaw = storage.getItem(visualPreferencesStorageKey);
+  } catch {
+    return defaultVisualPreferences();
+  }
+
+  if (currentRaw !== null) {
+    return parseVisualPreferences(currentRaw) ?? defaultVisualPreferences();
+  }
+
+  const legacyVariant = readLegacyChoice(storage, legacyVariantStorageKey, backdropVariants);
+  const legacyTheme = readLegacyChoice(storage, legacyThemeStorageKey, backdropThemes);
+  const migrated = {
+    version: 1 as const,
+    variant: legacyVariant ?? "signal",
+    theme: legacyTheme ?? "acid",
+  } satisfies VisualPreferences;
+
+  if (legacyVariant !== null || legacyTheme !== null) {
+    saveVisualPreferences(storage, migrated);
+  }
+
+  return migrated;
+}
diff --git a/test/visualPreferences.test.ts b/test/visualPreferences.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..27f80b1b391af70ea53def5215865a4b4158526d
--- /dev/null
+++ b/test/visualPreferences.test.ts
@@ -0,0 +1,199 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import {
+  defaultVisualPreferences,
+  legacyThemeStorageKey,
+  legacyVariantStorageKey,
+  loadVisualPreferences,
+  readVisualPreferencesStorageEvent,
+  saveVisualPreferences,
+  visualPreferencesStorageKey,
+  type PreferenceStorage,
+  type VisualPreferences,
+} from "../src/visualPreferences.ts";
+
+class MemoryStorage implements PreferenceStorage {
+  readonly values = new Map<string, string>();
+  writes: string[] = [];
+
+  getItem(key: string) {
+    return this.values.get(key) ?? null;
+  }
+
+  setItem(key: string, value: string) {
+    this.values.set(key, value);
+    this.writes.push(`${key}=${value}`);
+  }
+}
+
+class BlockedStorage implements PreferenceStorage {
+  getItem() {
+    throw new Error("blocked");
+  }
+
+  setItem() {
+    throw new Error("blocked");
+  }
+}
+
+function record(variant: VisualPreferences["variant"], theme: VisualPreferences["theme"]): string {
+  return JSON.stringify({ version: 1, variant, theme });
+}
+
+test("loads valid legacy choices independently and migrates without changing legacy data", () => {
+  const storage = new MemoryStorage();
+  storage.values.set(legacyVariantStorageKey, "radar");
+  storage.values.set(legacyThemeStorageKey, "unsupported");
+  storage.values.set("unrelated", "keep");
+
+  assert.deepEqual(loadVisualPreferences(storage), {
+    version: 1,
+    variant: "radar",
+    theme: "acid",
+  });
+  assert.equal(storage.values.get(visualPreferencesStorageKey), record("radar", "acid"));
+  assert.equal(storage.values.get(legacyVariantStorageKey), "radar");
+  assert.equal(storage.values.get(legacyThemeStorageKey), "unsupported");
+  assert.equal(storage.values.get("unrelated"), "keep");
+  assert.equal(storage.writes.length, 1);
+
+  assert.deepEqual(loadVisualPreferences(storage), {
+    version: 1,
+    variant: "radar",
+    theme: "acid",
+  });
+  assert.equal(storage.writes.length, 1);
+});
+
+test("a complete current record takes precedence over legacy choices", () => {
+  const storage = new MemoryStorage();
+  storage.values.set(visualPreferencesStorageKey, record("topography", "ice"));
+  storage.values.set(legacyVariantStorageKey, "signal");
+  storage.values.set(legacyThemeStorageKey, "plasma");
+
+  assert.deepEqual(loadVisualPreferences(storage), {
+    version: 1,
+    variant: "topography",
+    theme: "ice",
+  });
+  assert.equal(storage.writes.length, 0);
+});
+
+test("malformed, unknown-version, and unsupported current records use defaults without overwriting", () => {
+  const invalidRecords = [
+    "not json",
+    JSON.stringify({ version: 2, variant: "radar", theme: "ice" }),
+    JSON.stringify({ version: 1, variant: "unknown", theme: "ice" }),
+    JSON.stringify({ version: 1, variant: "radar", theme: "unknown" }),
+  ];
+
+  for (const invalidRecord of invalidRecords) {
+    const storage = new MemoryStorage();
+    storage.values.set(visualPreferencesStorageKey, invalidRecord);
+    storage.values.set(legacyVariantStorageKey, "radar");
+    storage.values.set(legacyThemeStorageKey, "ice");
+
+    assert.deepEqual(loadVisualPreferences(storage), defaultVisualPreferences());
+    assert.equal(storage.values.get(visualPreferencesStorageKey), invalidRecord);
+    assert.equal(storage.writes.length, 0);
+  }
+});
+
+test("blocked storage does not prevent defaults, saving, or in-memory use", () => {
+  const storage = new BlockedStorage();
+
+  assert.deepEqual(loadVisualPreferences(storage), defaultVisualPreferences());
+  assert.doesNotThrow(() =>
+    saveVisualPreferences(storage, { version: 1, variant: "radar", theme: "plasma" }),
+  );
+  assert.doesNotThrow(() => saveVisualPreferences(null, defaultVisualPreferences()));
+});
+
+test("saved selections restore both consumer fields on reload", () => {
+  const storage = new MemoryStorage();
+  const selected = {
+    version: 1 as const,
+    variant: "topography" as const,
+    theme: "plasma" as const,
+  };
+
+  assert.deepEqual(loadVisualPreferences(storage), defaultVisualPreferences());
+  assert.equal(storage.writes.length, 0);
+  saveVisualPreferences(storage, selected);
+
+  assert.equal(storage.values.get(visualPreferencesStorageKey), record("topography", "plasma"));
+  assert.deepEqual(loadVisualPreferences(storage), selected);
+  assert.equal(storage.values.has(legacyVariantStorageKey), false);
+  assert.equal(storage.values.has(legacyThemeStorageKey), false);
+});
+
+test("storage events apply valid local records, reset removals, and ignore other events", () => {
+  const storage = new MemoryStorage();
+  const otherStorage = new MemoryStorage();
+  const remote = {
+    storageArea: storage,
+    key: visualPreferencesStorageKey,
+    newValue: record("radar", "ice"),
+  };
+
+  assert.deepEqual(readVisualPreferencesStorageEvent(remote, storage), {
+    version: 1,
+    variant: "radar",
+    theme: "ice",
+  });
+  assert.deepEqual(
+    readVisualPreferencesStorageEvent(
+      { storageArea: storage, key: visualPreferencesStorageKey, newValue: null },
+      storage,
+    ),
+    defaultVisualPreferences(),
+  );
+  assert.deepEqual(
+    readVisualPreferencesStorageEvent({ storageArea: storage, key: null, newValue: null }, storage),
+    defaultVisualPreferences(),
+  );
+  assert.equal(
+    readVisualPreferencesStorageEvent(
+      { storageArea: storage, key: visualPreferencesStorageKey, newValue: "{}" },
+      storage,
+    ),
+    undefined,
+  );
+  assert.equal(
+    readVisualPreferencesStorageEvent(
+      {
+        storageArea: otherStorage,
+        key: visualPreferencesStorageKey,
+        newValue: record("radar", "ice"),
+      },
+      storage,
+    ),
+    undefined,
+  );
+  assert.equal(
+    readVisualPreferencesStorageEvent(
+      { storageArea: storage, key: "other", newValue: record("radar", "ice") },
+      storage,
+    ),
+    undefined,
+  );
+  assert.equal(storage.writes.length, 0);
+});
+
+test("a local selection after a remote update keeps the remote sibling field", () => {
+  const storage = new MemoryStorage();
+  const remote = readVisualPreferencesStorageEvent(
+    { storageArea: storage, key: visualPreferencesStorageKey, newValue: record("radar", "ice") },
+    storage,
+  );
+
+  assert.ok(remote);
+  const localSelection = { ...remote, theme: "plasma" as const };
+  saveVisualPreferences(storage, localSelection);
+
+  assert.deepEqual(JSON.parse(storage.values.get(visualPreferencesStorageKey) ?? ""), {
+    version: 1,
+    variant: "radar",
+    theme: "plasma",
+  });
+});
