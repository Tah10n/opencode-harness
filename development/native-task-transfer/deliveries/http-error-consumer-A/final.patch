-import {test} from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs';import os from 'node:os';import path from 'node:path';
-import {findUser} from '../src/users.mjs';test('legacy JSON user',async()=>{assert.deepEqual(await findUser(async url=>({status:200,json:async()=>({url})}),'https://local','a'),{url:'https://local/users/a'});});
+import {test} from 'node:test';import assert from 'node:assert/strict';
+import {HttpError, request} from '../src/http.mjs';
+import {findUser} from '../src/users.mjs';
+
+test('legacy JSON user',async()=>{assert.deepEqual(await findUser(async url=>({status:200,json:async()=>({url})}),'https://local','a'),{url:'https://local/users/a'});});
+
+test('204 succeeds without parsing JSON', async () => {
+  let parsed = false;
+  const result = await request(async () => ({status: 204, json: async () => { parsed = true; }}));
+  assert.equal(result, null);
+  assert.equal(parsed, false);
+});
+
+test('malformed error body retains HTTP status', async () => {
+  await assert.rejects(
+    request(async () => ({status: 500, json: async () => { throw new SyntaxError('bad JSON'); }}), '/failed'),
+    error => {
+      assert.equal(error instanceof HttpError, true);
+      assert.equal(error.status, 500);
+      assert.equal(error.url, '/failed');
+      assert.equal(error.body, null);
+      return true;
+    },
+  );
+});
+
+test('findUser handles only 404 and preserves encoded ID and options', async () => {
+  const options = {signal: {aborted: false}};
+  let call;
+  const result = await findUser(async (url, receivedOptions) => {
+    call = [url, receivedOptions];
+    return {status: 404, json: async () => ({message: 'missing'})};
+  }, 'https://local', 'a/b c', options);
+  assert.equal(result, null);
+  assert.equal(call[0], 'https://local/users/a%2Fb%20c');
+  assert.equal(call[1], options);
+});
+
+test('findUser propagates non-404 failures by identity', async () => {
+  const failure = new Error('network');
+  await assert.rejects(findUser(async () => { throw failure; }, 'https://local', 'a'), error => error === failure);
+});
