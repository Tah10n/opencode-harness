diff --git a/README.md b/README.md
--- a/README.md
+++ b/README.md
@@ -1,3 +1,12 @@
 # http-error-consumer
 
 Small local library. Run `npm test`.
+
+`request(fetcher, url, options)` returns parsed JSON for successful responses.
+A `204` response returns `null` without attempting to parse a body. Other
+non-2xx responses throw the exported `HttpError`, which includes `status`,
+`url`, and parsed `body` fields; an unparseable error body is represented by
+`null`.
+
+`findUser` requests `/users/<encoded id>` and treats an `HttpError` with status
+`404` as a missing user by returning `null`. All other errors are propagated.
diff --git a/src/http.mjs b/src/http.mjs
--- a/src/http.mjs
+++ b/src/http.mjs
@@ -1 +1,27 @@
-export async function request(fetcher,url,options={}){const r=await fetcher(url,options);return r.json();}
+export class HttpError extends Error {
+  constructor(status, url, body) {
+    super(`HTTP request failed with status ${status}`);
+    this.name = 'HttpError';
+    this.status = status;
+    this.url = url;
+    this.body = body;
+  }
+}
+
+export async function request(fetcher, url, options = {}) {
+  const response = await fetcher(url, options);
+
+  if (response.status === 204) return null;
+
+  if (response.status >= 200 && response.status <= 299) {
+    return response.json();
+  }
+
+  let body = null;
+  try {
+    body = await response.json();
+  } catch {
+    // Preserve the HTTP failure when the error body cannot be parsed.
+  }
+  throw new HttpError(response.status, url, body);
+}
diff --git a/src/users.mjs b/src/users.mjs
--- a/src/users.mjs
+++ b/src/users.mjs
@@ -1 +1,10 @@
-import {request} from './http.mjs';export function findUser(fetcher,base,id,options={}){return request(fetcher,base+'/users/'+id,options);}
+import {HttpError, request} from './http.mjs';
+
+export async function findUser(fetcher, base, id, options = {}) {
+  try {
+    return await request(fetcher, `${base}/users/${encodeURIComponent(id)}`, options);
+  } catch (error) {
+    if (error instanceof HttpError && error.status === 404) return null;
+    throw error;
+  }
+}
