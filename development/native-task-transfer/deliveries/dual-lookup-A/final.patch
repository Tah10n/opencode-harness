diff --git a/README.md b/README.md
--- a/README.md
+++ b/README.md
@@ -1,3 +1,18 @@
 # dual-lookup
 
-Small local library. Run `npm test`.
+`createLookup(transport)` adapts a callback-based `transport.get(id, callback)`.
+
+- `lookup(id, callback)` returns `undefined` and invokes the callback at most once.
+- `lookup(id)` returns a Promise that resolves with the value or rejects with the
+  same error object.
+
+The first completion wins. Later callbacks and errors, including a throw after a
+callback, are ignored. The transport is called with its original `this` binding,
+and the ID is passed through unchanged.
+
+`listNames(lookup, ids, callback)` remains the callback-based, sequential API.
+`listNamesAsync(lookup, ids)` consumes Promise lookups and returns names in input
+order, including duplicates. An empty ID list resolves to `[]`; lookup
+rejections are propagated.
+
+Run `npm test`.
diff --git a/src/lookup.mjs b/src/lookup.mjs
--- a/src/lookup.mjs
+++ b/src/lookup.mjs
@@ -1 +1,33 @@
-export function createLookup(transport){return function lookup(id,callback){transport.get(id,callback);};}
+export function createLookup(transport) {
+  return function lookup(id, callback) {
+    const promiseStyle = typeof callback !== 'function';
+    let resolvePromise;
+    let rejectPromise;
+    const promise = promiseStyle
+      ? new Promise((resolve, reject) => {
+          resolvePromise = resolve;
+          rejectPromise = reject;
+        })
+      : undefined;
+    let completed = false;
+
+    function complete(error, value) {
+      if (completed) return;
+      completed = true;
+      if (promiseStyle) {
+        if (error) rejectPromise(error);
+        else resolvePromise(value);
+      } else {
+        callback(error, value);
+      }
+    }
+
+    try {
+      transport.get(id, complete);
+    } catch (error) {
+      complete(error);
+    }
+
+    return promise;
+  };
+}
diff --git a/src/names.mjs b/src/names.mjs
--- a/src/names.mjs
+++ b/src/names.mjs
@@ -1 +1,5 @@
 export function listNames(lookup,ids,callback){const names=[];let index=0;function next(){if(index===ids.length)return callback(null,names);lookup(ids[index++],(err,user)=>{if(err)return callback(err);names.push(user.name);next();});}next();}
+
+export function listNamesAsync(lookup, ids) {
+  return Promise.all(ids.map(id => lookup(id))).then(users => users.map(user => user.name));
+}
