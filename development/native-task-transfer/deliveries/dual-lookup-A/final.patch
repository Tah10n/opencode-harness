 import {test} from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs';import os from 'node:os';import path from 'node:path';
-import {createLookup} from '../src/lookup.mjs';import {listNames} from '../src/names.mjs';test('legacy callback consumer',async()=>{const lookup=createLookup({get(id,cb){cb(null,{name:id.toUpperCase()});}});assert.deepEqual(await new Promise((resolve,reject)=>listNames(lookup,['a','b'],(e,x)=>e?reject(e):resolve(x))),['A','B']);});
+import {createLookup} from '../src/lookup.mjs';import {listNames,listNamesAsync} from '../src/names.mjs';
+
+test('legacy callback consumer',async()=>{const lookup=createLookup({get(id,cb){cb(null,{name:id.toUpperCase()});}});assert.deepEqual(await new Promise((resolve,reject)=>listNames(lookup,['a','b'],(e,x)=>e?reject(e):resolve(x))),['A','B']);});
+
+test('promise lookup preserves transport binding and id', async () => {
+  const transport = {prefix: 'x', get(id, cb) { cb(null, this.prefix + id); }};
+  const lookup = createLookup(transport);
+  assert.equal(await lookup(7), 'x7');
+});
+
+test('promise lookup uses the first completion', async () => {
+  const error = new Error('late');
+  const lookup = createLookup({get(id, cb) { cb(null, 'first'); cb(error, 'second'); throw new Error('later'); }});
+  assert.equal(await lookup('id'), 'first');
+});
+
+test('promise lookup rejects the original synchronous error', async () => {
+  const error = new Error('failure');
+  const lookup = createLookup({get() { throw error; }});
+  await assert.rejects(lookup('id'), reason => reason === error);
+});
+
+test('callback lookup completes at most once and returns undefined', () => {
+  const error = new Error('late');
+  const calls = [];
+  const lookup = createLookup({get(id, cb) { cb(null, 'first'); cb(error, 'second'); throw new Error('later'); }});
+  assert.equal(lookup('id', (...args) => calls.push(args)), undefined);
+  assert.deepEqual(calls, [[null, 'first']]);
+});
+
+test('callback lookup reports a synchronous throw', () => {
+  const error = new Error('failure');
+  const lookup = createLookup({get() { throw error; }});
+  const calls = [];
+  lookup('id', (...args) => calls.push(args));
+  assert.equal(calls[0][0], error);
+});
+
+test('listNamesAsync preserves order and duplicates', async () => {
+  const lookup = id => new Promise(resolve => setTimeout(() => resolve({name: id}), id === 'a' ? 15 : 1));
+  assert.deepEqual(await listNamesAsync(lookup, ['a', 'b', 'a']), ['a', 'b', 'a']);
+  assert.deepEqual(await listNamesAsync(lookup, []), []);
+});
+
+test('listNamesAsync preserves rejection identity', async () => {
+  const error = new Error('lookup failure');
+  await assert.rejects(listNamesAsync(() => Promise.reject(error), ['id']), reason => reason === error);
+});
