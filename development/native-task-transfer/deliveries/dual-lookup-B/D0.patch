 # dual-lookup
 
-Small local library. Run `npm test`.
+`createLookup(transport)` supports both callback and Promise consumers. Pass a
+function callback to receive `(error, value)` and get `undefined` back; omit it
+to receive a Promise. The first transport completion wins, including when the
+transport calls back more than once or throws after completing.
+
+`listNames(lookup, ids, callback)` remains the callback-based API.
+`listNamesAsync(lookup, ids)` uses Promise lookups and returns names in input
+order, including duplicate IDs. It returns an empty array for empty input and
+propagates lookup rejections.
+
+Run `npm test`.
diff --git a/src/lookup.mjs b/src/lookup.mjs
index 2e1cb037b6fd1dc8e289ff1c10141e3fb1131c92..83df55a20743c6c83dd4e093a5668fe94b6c98c8 100644
--- a/src/lookup.mjs
+++ b/src/lookup.mjs
@@ -1 +1,30 @@
-export function createLookup(transport){return function lookup(id,callback){transport.get(id,callback);};}
+export function createLookup(transport) {
+  return function lookup(id, callback) {
+    const promiseMode = typeof callback !== 'function';
+    let settled = false;
+    let resolvePromise;
+    let rejectPromise;
+    const promise = promiseMode ? new Promise((resolve, reject) => {
+      resolvePromise = resolve;
+      rejectPromise = reject;
+    }) : undefined;
+
+    function complete(error, value) {
+      if (settled) return;
+      settled = true;
+      if (promiseMode) {
+        if (error) rejectPromise(error);
+        else resolvePromise(value);
+      } else {
+        callback(error, value);
+      }
+    }
+
+    try {
+      transport.get.call(transport, id, complete);
+    } catch (error) {
+      if (!settled) complete(error);
+    }
+    return promise;
+  };
+}
diff --git a/src/names.mjs b/src/names.mjs
index 80e5a7cfd93a04c9bf55f58e383313086a234b16..e42e9c63b085707696f541165f993f5374ce1ae7 100644
--- a/src/names.mjs
+++ b/src/names.mjs
@@ -1 +1,6 @@
 export function listNames(lookup,ids,callback){const names=[];let index=0;function next(){if(index===ids.length)return callback(null,names);lookup(ids[index++],(err,user)=>{if(err)return callback(err);names.push(user.name);next();});}next();}
+
+export async function listNamesAsync(lookup, ids) {
+  const users = await Promise.all(ids.map((id) => lookup(id)));
+  return users.map((user) => user.name);
+}
