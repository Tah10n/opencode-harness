 import {test} from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs';import os from 'node:os';import path from 'node:path';
-import {createLookup} from '../src/lookup.mjs';import {listNames} from '../src/names.mjs';test('legacy callback consumer',async()=>{const lookup=createLookup({get(id,cb){cb(null,{name:id.toUpperCase()});}});assert.deepEqual(await new Promise((resolve,reject)=>listNames(lookup,['a','b'],(e,x)=>e?reject(e):resolve(x))),['A','B']);});
+import {createLookup} from '../src/lookup.mjs';import {listNames,listNamesAsync} from '../src/names.mjs';
+
+test('legacy callback consumer',async()=>{const lookup=createLookup({get(id,cb){cb(null,{name:id.toUpperCase()});}});assert.deepEqual(await new Promise((resolve,reject)=>listNames(lookup,['a','b'],(e,x)=>e?reject(e):resolve(x))),['A','B']);});
+
+test('callback lookup preserves transport context and first completion', () => {
+  const id = {key: 'id'};
+  const error = new Error('late');
+  const transport = {value: 7, get(receivedId, callback) {
+    assert.equal(this, transport);
+    assert.equal(receivedId, id);
+    callback(null, {name: this.value});
+    callback(error, {name: 8});
+    throw error;
+  }};
+  const lookup = createLookup(transport);
+  const results = [];
+  assert.equal(lookup(id, (err, value) => results.push([err, value])), undefined);
+  assert.deepEqual(results, [[null, {name: 7}]]);
+});
+
+test('promise lookup resolves first callback and ignores later completion', async () => {
+  const error = new Error('late');
+  const lookup = createLookup({get(id, callback) {
+    callback(null, {name: id});
+    callback(error, null);
+    throw error;
+  }});
+  assert.deepEqual(await lookup('name'), {name: 'name'});
+});
+
+test('promise lookup rejects the original synchronous transport error', async () => {
+  const error = new Error('transport');
+  const lookup = createLookup({get() { throw error; }});
+  await assert.rejects(lookup('name'), (received) => received === error);
+});
+
+test('listNamesAsync preserves order and duplicates', async () => {
+  const lookup = createLookup({get(id, callback) {
+    setTimeout(() => callback(null, {name: id.toUpperCase()}), id === 'a' ? 10 : 0);
+  }});
+  assert.deepEqual(await listNamesAsync(lookup, ['a', 'b', 'a']), ['A', 'B', 'A']);
+  assert.deepEqual(await listNamesAsync(lookup, []), []);
+});
+
+test('listNamesAsync propagates lookup rejection identity', async () => {
+  const error = new Error('missing');
+  const lookup = createLookup({get(id, callback) { callback(error); }});
+  await assert.rejects(listNamesAsync(lookup, ['x']), (received) => received === error);
+});
