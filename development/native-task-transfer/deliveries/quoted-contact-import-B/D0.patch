-import {parseRows} from './csv.mjs';export function importContacts(text){const [head,...rows]=parseRows(text);return rows.map(row=>({name:row[0],email:row[1]}));}
+import {parseRows} from './csv.mjs';
+
+export function importContacts(text) {
+  const [headers, ...rows] = parseRows(text);
+  if (!headers) return [];
+  if (new Set(headers).size !== headers.length || !headers.includes('name') || !headers.includes('email')) {
+    throw new TypeError('Headers must uniquely include name and email');
+  }
+  const nameIndex = headers.indexOf('name');
+  const emailIndex = headers.indexOf('email');
+  return rows.map((row) => {
+    if (row.length !== headers.length) throw new TypeError('Row width does not match headers');
+    return {name: row[nameIndex], email: row[emailIndex]};
+  });
+}
diff --git a/src/csv.mjs b/src/csv.mjs
index bc35fed27f3b492356e9c73030ccb55068e189cf..7759b3170047bbaa0552bff343e9d231cdd0eb4e 100644
--- a/src/csv.mjs
+++ b/src/csv.mjs
@@ -1 +1,74 @@
-export function parseRows(text){return text.trim().split(/\r?\n/).map(row=>row.split(','));}
+export function parseRows(text) {
+  if (text.length === 0) return [];
+
+  const rows = [];
+  let row = [];
+  let field = '';
+  let i = 0;
+  let quoted = false;
+  let afterQuote = false;
+
+  const finishField = () => {
+    row.push(field);
+    field = '';
+  };
+  const finishRow = () => {
+    finishField();
+    rows.push(row);
+    row = [];
+  };
+
+  while (i < text.length) {
+    const char = text[i];
+    if (quoted) {
+      if (char !== '"') {
+        field += char;
+        i++;
+      } else if (text[i + 1] === '"') {
+        field += '"';
+        i += 2;
+      } else {
+        quoted = false;
+        afterQuote = true;
+        i++;
+      }
+    } else if (afterQuote) {
+      if (char === ',') {
+        finishField();
+        afterQuote = false;
+        i++;
+      } else if (char === '\n') {
+        finishRow();
+        afterQuote = false;
+        i++;
+      } else if (char === '\r' && text[i + 1] === '\n') {
+        finishRow();
+        afterQuote = false;
+        i += 2;
+      } else {
+        throw new SyntaxError('Invalid character after closing quote');
+      }
+    } else if (char === '"') {
+      if (field !== '') throw new SyntaxError('Quote in unquoted field');
+      quoted = true;
+      i++;
+    } else if (char === ',') {
+      finishField();
+      i++;
+    } else if (char === '\n') {
+      finishRow();
+      i++;
+    } else if (char === '\r') {
+      if (text[i + 1] !== '\n') throw new SyntaxError('Bare carriage return');
+      finishRow();
+      i += 2;
+    } else {
+      field += char;
+      i++;
+    }
+  }
+
+  if (quoted) throw new SyntaxError('Unclosed quoted field');
+  if (afterQuote || field !== '' || row.length > 0) finishRow();
+  return rows;
+}
