--- /dev/null
+++ b/test/csv.test.mjs
@@ -0,0 +1,20 @@
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {parseRows} from '../src/csv.mjs';
+
+test('parses quoted commas, quotes, and newlines', () => {
+  assert.deepEqual(parseRows('name,note\nAda,"hello, ""world""\nnext"'), [
+    ['name', 'note'], ['Ada', 'hello, "world"\nnext'],
+  ]);
+});
+
+test('preserves simple fields and trailing empty fields', () => {
+  assert.deepEqual(parseRows('a,b,\n'), [['a', 'b', '']]);
+});
+
+test('rejects malformed quoting', () => {
+  assert.throws(() => parseRows('a,"unclosed'), SyntaxError);
+  assert.throws(() => parseRows('a,b"oops'), SyntaxError);
+  assert.throws(() => parseRows('"ok"x'), SyntaxError);
+  assert.throws(() => parseRows('a\rb'), SyntaxError);
+});
