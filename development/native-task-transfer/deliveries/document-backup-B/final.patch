-import fs from 'node:fs';export function load(file){return JSON.parse(fs.readFileSync(file,'utf8'));}export function save(file,value){fs.writeFileSync(file,JSON.stringify(value));}
+import fs from 'node:fs';
+import path from 'node:path';
+
+function validate(value) {
+  if (value === null || typeof value !== 'object' || Array.isArray(value) || typeof value.text !== 'string') {
+    throw new TypeError('Invalid document');
+  }
+  return value;
+}
+
+function readDocument(file) {
+  return validate(JSON.parse(fs.readFileSync(file, 'utf8')));
+}
+
+export function load(file) {
+  try {
+    return readDocument(file);
+  } catch (primaryError) {
+    try {
+      return readDocument(file + '.bak');
+    } catch {
+      throw primaryError;
+    }
+  }
+}
+
+export function save(file, value) {
+  validate(value);
+  const serialized = JSON.stringify(value);
+  if (serialized === undefined) throw new TypeError('Document is not serializable');
+
+  let previous;
+  try {
+    previous = fs.readFileSync(file);
+    validate(JSON.parse(previous.toString('utf8')));
+  } catch (error) {
+    if (error.code !== 'ENOENT') throw error;
+    previous = undefined;
+  }
+
+  if (previous !== undefined) fs.writeFileSync(file + '.bak', previous);
+
+  const temporary = path.join(path.dirname(file), `.${path.basename(file)}.${process.pid}.${Date.now()}.tmp`);
+  try {
+    fs.writeFileSync(temporary, serialized);
+    fs.renameSync(temporary, file);
+  } finally {
+    try { fs.unlinkSync(temporary); } catch (error) { if (error.code !== 'ENOENT') throw error; }
+  }
+}
