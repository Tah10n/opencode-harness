 import {test} from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs';import os from 'node:os';import path from 'node:path';
-import {save,load} from '../src/documents.mjs';test('legacy save/load',()=>{const f=path.join(fs.mkdtempSync(path.join(os.tmpdir(),'docs-')),'d');save(f,{text:'é',color:'red'});assert.deepEqual(load(f),{text:'é',color:'red'});});
+import {save,load} from '../src/documents.mjs';
+
+test('legacy save/load',()=>{const f=path.join(fs.mkdtempSync(path.join(os.tmpdir(),'docs-')),'d');save(f,{text:'é',color:'red'});assert.deepEqual(load(f),{text:'é',color:'red'});});
+
+test('loads a corrupt primary from backup without writing either file',()=>{
+  const dir=fs.mkdtempSync(path.join(os.tmpdir(),'docs-')); const f=path.join(dir,'d');
+  fs.writeFileSync(f,'{bad'); fs.writeFileSync(f+'.bak','{"text":"recovered","tag":1}');
+  const primary=fs.readFileSync(f); const backup=fs.readFileSync(f+'.bak');
+  assert.deepEqual(load(f),{text:'recovered',tag:1});
+  assert.deepEqual(fs.readFileSync(f),primary); assert.deepEqual(fs.readFileSync(f+'.bak'),backup);
+});
+
+test('keeps the exact previous primary as backup after two saves',()=>{
+  const f=path.join(fs.mkdtempSync(path.join(os.tmpdir(),'docs-')),'d');
+  save(f,{text:'one',extra:{a:1}}); const first=fs.readFileSync(f);
+  save(f,{text:'two'}); assert.deepEqual(fs.readFileSync(f+'.bak'),first); assert.deepEqual(load(f),{text:'two'});
+});
+
+test('invalid save preserves primary and backup',()=>{
+  const f=path.join(fs.mkdtempSync(path.join(os.tmpdir(),'docs-')),'d');
+  save(f,{text:'old'}); fs.writeFileSync(f+'.bak','old backup');
+  const primary=fs.readFileSync(f); const backup=fs.readFileSync(f+'.bak');
+  assert.throws(()=>save(f,{text:3}),TypeError);
+  assert.deepEqual(fs.readFileSync(f),primary); assert.deepEqual(fs.readFileSync(f+'.bak'),backup);
+});
