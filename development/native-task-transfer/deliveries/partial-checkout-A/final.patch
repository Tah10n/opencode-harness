diff --git a/src/plan.mjs b/src/plan.mjs
--- a/src/plan.mjs
+++ b/src/plan.mjs
@@ -1 +1,28 @@
-export function plan(stock,lines){return {accepted:lines.map((x,index)=>({...x,index})),rejected:[]};}
+const hasOwn = (object, key) => Object.prototype.hasOwnProperty.call(object, key);
+
+function validateLines(lines) {
+  if (!Array.isArray(lines)) throw new TypeError('lines must be an array');
+  for (const line of lines) {
+    if (line === null || typeof line !== 'object' || typeof line.sku !== 'string' ||
+        line.sku.length === 0 || !Number.isSafeInteger(line.qty) || line.qty <= 0) {
+      throw new TypeError('invalid checkout line');
+    }
+  }
+}
+
+export function plan(stock, lines) {
+  validateLines(lines);
+  const remaining = new Map(Object.keys(stock).map((sku) => [sku, stock[sku]]));
+  const accepted = [];
+  const rejected = [];
+
+  lines.forEach((line, index) => {
+    if (hasOwn(stock, line.sku) && remaining.get(line.sku) >= line.qty) {
+      accepted.push({index, sku: line.sku, qty: line.qty});
+      remaining.set(line.sku, remaining.get(line.sku) - line.qty);
+    } else {
+      rejected.push({index, sku: line.sku, qty: line.qty, reason: 'unavailable'});
+    }
+  });
+  return {accepted, rejected};
+}
diff --git a/src/receipt.mjs b/src/receipt.mjs
--- a/src/receipt.mjs
+++ b/src/receipt.mjs
@@ -1 +1,8 @@
-import {checkout} from './checkout.mjs';export function purchase(stock,lines,prices){const result=checkout(stock,lines);return {...result,totalCents:lines.reduce((n,x)=>n+prices[x.sku]*x.qty,0)};}
+import {checkout} from './checkout.mjs';
+
+export function purchase(stock, lines, prices) {
+  const result = checkout(stock, lines);
+  const totalCents = result.accepted.reduce((total, line) =>
+    total + prices[line.sku] * line.qty, 0);
+  return {...result, totalCents};
+}
