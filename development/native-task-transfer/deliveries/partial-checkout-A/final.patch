 import {test} from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs';import os from 'node:os';import path from 'node:path';
-import {purchase} from '../src/receipt.mjs';test('legacy single purchase',()=>{const s={a:5};assert.equal(purchase(s,[{sku:'a',qty:2}],{a:125}).totalCents,250);assert.equal(s.a,3);});
+import {purchase} from '../src/receipt.mjs';
+import {checkout} from '../src/checkout.mjs';
+
+test('legacy single purchase',()=>{const s={a:5};assert.equal(purchase(s,[{sku:'a',qty:2}],{a:125}).totalCents,250);assert.equal(s.a,3);});
+
+test('purchase fulfills duplicate SKUs in order', () => {
+  const stock = {a: 5};
+  const result = purchase(stock, [{sku: 'a', qty: 3}, {sku: 'a', qty: 3}], {a: 100});
+  assert.deepEqual(result.accepted, [{index: 0, sku: 'a', qty: 3}]);
+  assert.deepEqual(result.rejected, [{index: 1, sku: 'a', qty: 3, reason: 'unavailable'}]);
+  assert.equal(result.totalCents, 300);
+  assert.equal(stock.a, 2);
+});
+
+test('an invalid later line leaves stock unchanged', () => {
+  const stock = {a: 5};
+  assert.throws(() => checkout(stock, [{sku: 'a', qty: 2}, {sku: 'a', qty: 0}]), TypeError);
+  assert.deepEqual(stock, {a: 5});
+});
