@@ -1,3 +1,13 @@
 # transactional-settings
 
-Small local library. Run `npm test`.
+`read(file)` reads and parses the current settings state. `transact(file, fn,
+expectedRevision?)` invokes a synchronous callback with an isolated mutable copy
+of the data, increments the revision, and returns the committed state and
+callback result.
+
+Callbacks must return synchronously; returning a Promise or thenable throws a
+`TypeError` without committing. If `expectedRevision` does not strictly match
+the current revision, `ConflictError` is thrown before the callback runs.
+
+Transactions are persisted through a sibling temporary file and rename, so
+readers never observe partially written JSON.
diff --git a/src/store.mjs b/src/store.mjs
--- a/src/store.mjs
+++ b/src/store.mjs
@@ -1 +1,50 @@
-import fs from 'node:fs';export function read(file){return JSON.parse(fs.readFileSync(file,'utf8'));}export function transact(file,fn,expectedRevision){const current=read(file);const result=fn(current.data);current.revision++;fs.writeFileSync(file,JSON.stringify(current));return {state:current,result};}
+import fs from 'node:fs';
+import path from 'node:path';
+
+export class ConflictError extends Error {
+  constructor(message = 'Revision conflict') {
+    super(message);
+    this.name = 'ConflictError';
+  }
+}
+
+export function read(file) {
+  return JSON.parse(fs.readFileSync(file, 'utf8'));
+}
+
+export function transact(file, fn, expectedRevision) {
+  const current = read(file);
+
+  if (arguments.length >= 3 && expectedRevision !== current.revision) {
+    throw new ConflictError(
+      `Expected revision ${expectedRevision}, found ${current.revision}`,
+    );
+  }
+
+  const draft = structuredClone(current.data);
+  const result = fn(draft);
+  if (result !== null && (typeof result === 'object' || typeof result === 'function') &&
+      typeof result.then === 'function') {
+    throw new TypeError('Transaction callback must return synchronously');
+  }
+
+  const state = {revision: current.revision + 1, data: draft};
+  const serialized = JSON.stringify(state);
+  const temporary = path.join(
+    path.dirname(file),
+    `.${path.basename(file)}.${process.pid}.${Math.random().toString(36).slice(2)}.tmp`,
+  );
+
+  try {
+    fs.writeFileSync(temporary, serialized);
+    fs.renameSync(temporary, file);
+  } finally {
+    try {
+      fs.unlinkSync(temporary);
+    } catch (error) {
+      if (error.code !== 'ENOENT') throw error;
+    }
+  }
+
+  return {state, result};
+}
