-import {read,transact} from '../src/store.mjs';test('legacy commit',()=>{const f=path.join(fs.mkdtempSync(path.join(os.tmpdir(),'settings-')),'s');fs.writeFileSync(f,JSON.stringify({revision:0,data:{x:1}}));assert.equal(transact(f,d=>{d.x=2;return 'ok'}).result,'ok');assert.deepEqual(read(f),{revision:1,data:{x:2}});});
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import {ConflictError, read, transact} from '../src/store.mjs';
+
+function settingsFile(state) {
+  const directory = fs.mkdtempSync(path.join(os.tmpdir(), 'settings-'));
+  const file = path.join(directory, 's');
+  fs.writeFileSync(file, JSON.stringify(state));
+  return file;
+}
+
+test('legacy commit', () => {
+  const file = settingsFile({revision: 0, data: {x: 1}});
+  assert.equal(transact(file, data => { data.x = 2; return 'ok'; }).result, 'ok');
+  assert.deepEqual(read(file), {revision: 1, data: {x: 2}});
+});
+
+test('conflict does not invoke the callback', () => {
+  const file = settingsFile({revision: 3, data: {x: 1}});
+  const original = fs.readFileSync(file);
+  let invoked = false;
+
+  assert.throws(() => transact(file, () => { invoked = true; }, 2), ConflictError);
+  assert.equal(invoked, false);
+  assert.deepEqual(fs.readFileSync(file), original);
+});
+
+test('thrown callback preserves exact bytes', () => {
+  const file = settingsFile({revision: 0, data: {nested: {keep: true}}});
+  const original = fs.readFileSync(file);
+  const failure = new Error('callback failed');
+
+  assert.throws(() => transact(file, data => {
+    data.nested.keep = false;
+    throw failure;
+  }), error => error === failure);
+  assert.deepEqual(fs.readFileSync(file), original);
+});
+
+test('persists nested updates and deletions', () => {
+  const file = settingsFile({revision: 4, data: {nested: {old: true, keep: 1}, remove: true}});
+
+  const transaction = transact(file, data => {
+    data.nested.updated = {value: 2};
+    delete data.nested.old;
+    delete data.remove;
+  });
+
+  assert.deepEqual(transaction.state, {
+    revision: 5,
+    data: {nested: {keep: 1, updated: {value: 2}}},
+  });
+  assert.deepEqual(read(file), transaction.state);
+});
