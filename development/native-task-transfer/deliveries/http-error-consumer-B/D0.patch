 # http-error-consumer
 
 Small local library. Run `npm test`.
+
+`request(fetcher, url, options)` returns parsed JSON for successful responses.
+Status 204 is returned as `null` without attempting to parse a body. Other
+non-2xx responses throw the exported `HttpError`, whose `status`, `url`, and
+`body` fields describe the failure; an unparseable error body produces a
+`null` body.
+
+`findUser` treats an `HttpError` with status 404 as a missing user and returns
+`null`. All other errors are propagated unchanged.
diff --git a/src/http.mjs b/src/http.mjs
index 8effa479ad53808b6692b9197d1c5b0747e4c2e7..02e2915255f17fa0bc906b9e7f13de4ecc547dff 100644
--- a/src/http.mjs
+++ b/src/http.mjs
@@ -1 +1,19 @@
-export async function request(fetcher,url,options={}){const r=await fetcher(url,options);return r.json();}
+export class HttpError extends Error {
+  constructor(status,url,body) {
+    super(`HTTP request failed with status ${status}`);
+    this.name='HttpError';
+    this.status=status;
+    this.url=url;
+    this.body=body;
+  }
+}
+
+export async function request(fetcher,url,options={}) {
+  const response=await fetcher(url,options);
+  if(response.status>=200&&response.status<=299) {
+    return response.status===204?null:response.json();
+  }
+  let body=null;
+  try { body=await response.json(); } catch {}
+  throw new HttpError(response.status,url,body);
+}
diff --git a/src/users.mjs b/src/users.mjs
index 76a4eee9d40f76527ae6b3d237f1131559869723..cedb63a126f45e617ca05fded2473f83cf4ef474 100644
