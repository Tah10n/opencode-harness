 # partial-checkout
 
-Small local library. Run `npm test`.
+`plan(stock, lines)`, `checkout(stock, lines)`, and `purchase(stock, lines, prices)`
+fulfill whole lines in input order. Duplicate SKUs use the remaining stock, so a
+later line can be rejected even when an earlier line was accepted. Invalid lines
+are validated atomically before checkout changes stock. `purchase` charges only
+accepted lines and returns the amount as `totalCents`.
+
+Run `npm test`.
diff --git a/src/plan.mjs b/src/plan.mjs
index b5221f325b317a78166bd495d49af535786540ee..d008079ed09b26b47a4b0ec5fdfae2ca463f1677 100644
--- a/src/plan.mjs
+++ b/src/plan.mjs
@@ -1 +1,20 @@
-export function plan(stock,lines){return {accepted:lines.map((x,index)=>({...x,index})),rejected:[]};}
+function validateLines(lines){
+  if(!Array.isArray(lines))throw new TypeError('lines must be an array');
+  for(const line of lines){
+    if(line===null||typeof line!=='object'||Array.isArray(line)||typeof line.sku!=='string'||line.sku.length===0||!Number.isSafeInteger(line.qty)||line.qty<=0)throw new TypeError('invalid line');
+  }
+}
+
+export function plan(stock,lines){
+  validateLines(lines);
+  const remaining={...stock};
+  const accepted=[];
+  const rejected=[];
+  lines.forEach((line,index)=>{
+    if(Object.prototype.hasOwnProperty.call(stock,line.sku)&&remaining[line.sku]>=line.qty){
+      remaining[line.sku]-=line.qty;
+      accepted.push({index,sku:line.sku,qty:line.qty});
+    }else rejected.push({index,sku:line.sku,qty:line.qty,reason:'unavailable'});
+  });
+  return {accepted,rejected};
+}
