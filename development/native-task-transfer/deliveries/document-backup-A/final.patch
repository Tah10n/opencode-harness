 import {test} from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs';import os from 'node:os';import path from 'node:path';
-import {save,load} from '../src/documents.mjs';test('legacy save/load',()=>{const f=path.join(fs.mkdtempSync(path.join(os.tmpdir(),'docs-')),'d');save(f,{text:'é',color:'red'});assert.deepEqual(load(f),{text:'é',color:'red'});});
+import {save,load} from '../src/documents.mjs';
+
+test('legacy save/load',()=>{const f=path.join(fs.mkdtempSync(path.join(os.tmpdir(),'docs-')),'d');save(f,{text:'é',color:'red'});assert.deepEqual(load(f),{text:'é',color:'red'});});
+
+test('loads a valid backup without changing either file',()=>{const dir=fs.mkdtempSync(path.join(os.tmpdir(),'docs-'));const f=path.join(dir,'d');const backup=Buffer.from('{"text":"recovered","version":1}');fs.writeFileSync(f,'not json');fs.writeFileSync(`${f}.bak`,backup);assert.deepEqual(load(f),{text:'recovered',version:1});assert.equal(fs.readFileSync(f,'utf8'),'not json');assert.deepEqual(fs.readFileSync(`${f}.bak`),backup);});
+
+test('preserves exact previous primary bytes as backup',()=>{const f=path.join(fs.mkdtempSync(path.join(os.tmpdir(),'docs-')),'d');save(f,{text:'one',extra:true});const previous=fs.readFileSync(f);save(f,{text:'two'});assert.deepEqual(fs.readFileSync(`${f}.bak`),previous);assert.deepEqual(load(f),{text:'two'});});
+
+test('invalid save leaves primary and backup unchanged',()=>{const f=path.join(fs.mkdtempSync(path.join(os.tmpdir(),'docs-')),'d');save(f,{text:'one'});const primary=fs.readFileSync(f);fs.writeFileSync(`${f}.bak`,'old backup');const backup=fs.readFileSync(`${f}.bak`);assert.throws(()=>save(f,{text:3}),TypeError);assert.deepEqual(fs.readFileSync(f),primary);assert.deepEqual(fs.readFileSync(`${f}.bak`),backup);});
