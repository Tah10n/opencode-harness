diff --git a/packages/connector/test/state-security.test.mjs b/packages/connector/test/state-security.test.mjs
index 3b2b4c6..64e999e 100644
--- a/packages/connector/test/state-security.test.mjs
+++ b/packages/connector/test/state-security.test.mjs
@@ -106,6 +106,65 @@ test(
   },
 );
 
+test(
+  "recognizes the exact historical flat runtime without changing its files",
+  { skip: process.platform === "win32" },
+  async (context) => {
+    const root = await mkdtemp(join(tmpdir(), "viberacing-flat-runtime-"));
+    context.after(() => rm(root, { recursive: true, force: true }));
+    const state = join(root, ".viberacing");
+    const files = [
+      "bin/viberacing.mjs",
+      "lib/browser.mjs",
+      "lib/config.mjs",
+      "lib/executables.mjs",
+      "lib/readers.mjs",
+      "lib/registry.mjs",
+      "lib/runtime.mjs",
+      ...[
+        "antigravity",
+        "claude",
+        "codex",
+        "cursor",
+        "gemini",
+        "kimi",
+        "opencode",
+        "qwen-settings",
+        "qwen",
+        "shared",
+      ].map((name) => `lib/adapters/${name}.mjs`),
+    ];
+    await mkdir(join(state, "lib", "adapters"), { recursive: true });
+    await mkdir(join(state, "bin"), { recursive: true });
+    await writeFile(
+      join(state, "installation.json"),
+      `${JSON.stringify({
+        version: 1,
+        id: "12345678-1234-4123-8123-123456789abc",
+        secret: "legacy_flat_runtime_secret_that_is_long_enough",
+      })}\n`,
+    );
+    const originals = new Map();
+    for (const file of files) {
+      const contents = `legacy:${file}\n`;
+      originals.set(file, contents);
+      await writeFile(join(state, file), contents, { mode: 0o644 });
+    }
+    const environment = { ...process.env, HOME: root, USERPROFILE: root };
+    delete environment.VIBERACING_STATE_DIR;
+    await execFileAsync(
+      process.execPath,
+      ["--input-type=module", "--eval", ensureStateScript],
+      { env: { ...environment, VIBERACING_STATE_DIR: state } },
+    );
+    for (const [file, contents] of originals)
+      assert.equal(await readFile(join(state, file), "utf8"), contents);
+    assert.deepEqual(JSON.parse(await readFile(join(state, ".viberacing-state"), "utf8")), {
+      format: 1,
+    });
+  },
+);
+
 test(
   "POSIX state security rejects unrelated content before changing modes",
   { skip: process.platform === "win32" },
