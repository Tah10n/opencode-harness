+test("recognizes the exact legacy flat runtime and preserves it through preparation and reload", async (context) => {
+  const root = await mkdtemp(join(tmpdir(), "viberacing-flat-runtime-"));
+  context.after(() => rm(root, { recursive: true, force: true }));
+  const state = join(root, ".viberacing");
+  const legacyFiles = [
+    "browser.mjs", "config.mjs", "executables.mjs", "readers.mjs", "registry.mjs", "runtime.mjs",
+  ];
+  const adapters = ["antigravity", "claude", "codex", "cursor", "gemini", "kimi", "opencode", "qwen-settings", "qwen", "shared"];
+  await mkdir(join(state, "bin"), { recursive: true, mode: 0o777 });
+  await mkdir(join(state, "lib", "adapters"), { recursive: true, mode: 0o777 });
+  const contents = new Map([
+    [join(state, "bin", "viberacing.mjs"), "#!/usr/bin/env node\n// old launcher\n"],
+    ...legacyFiles.map((name) => [join(state, "lib", name), `// old ${name}\n`]),
+    ...adapters.map((name) => [join(state, "lib", "adapters", `${name}.mjs`), `// old ${name}\n`]),
+  ]);
+  for (const [path, value] of contents) await writeFile(path, value, { mode: 0o755 });
+  await writeFile(join(state, "installation.json"), JSON.stringify({
+    version: 1, id: "12345678-1234-4123-8123-123456789abc", secret: "legacy_installation_secret_that_is_long_enough",
+  }));
+  await chmod(state, 0o777);
+  const environment = { ...process.env, HOME: root, USERPROFILE: root, NODE_ENV: "test" };
+  await execFileAsync(process.execPath, ["--input-type=module", "--eval", ensureStateScript], { env: environment });
+  const before = new Map(await Promise.all([...contents].map(async ([path]) => [path, await readFile(path, "utf8")])));
+  const runtimeUrl = new URL("../bin/viberacing.mjs", import.meta.url);
+  const prepareScript = `import { prepareRuntime } from ${JSON.stringify(new URL("../lib/config.mjs", import.meta.url).href)}; await prepareRuntime(new URL(${JSON.stringify(runtimeUrl.href)})); await prepareRuntime(new URL(${JSON.stringify(runtimeUrl.href)}));`;
+  await execFileAsync(process.execPath, ["--input-type=module", "--eval", prepareScript], { env: environment });
+  for (const [path, value] of before) assert.equal(await readFile(path, "utf8"), value, path);
+  await execFileAsync(process.execPath, ["--input-type=module", "--eval", ensureStateScript], { env: environment });
+
+  const rejected = join(root, "rejected");
+  const rejectedState = join(rejected, ".viberacing");
+  await mkdir(join(rejectedState, "lib"), { recursive: true });
+  await writeFile(join(rejectedState, "lib", "unknown.mjs"), "foreign\n");
+  await writeFile(join(rejectedState, "installation.json"), await readFile(join(state, "installation.json")));
+  const rejectedEnvironment = { ...environment, HOME: rejected, USERPROFILE: rejected };
+  await assert.rejects(
+    execFileAsync(process.execPath, ["--input-type=module", "--eval", ensureStateScript], { env: rejectedEnvironment }),
+    /unrelated entry/,
+  );
+  assert.equal(await readFile(join(rejectedState, "lib", "unknown.mjs"), "utf8"), "foreign\n");
+});
