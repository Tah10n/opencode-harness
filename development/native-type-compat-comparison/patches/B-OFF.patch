+/**
+ * Wait for the next occurrence of an event.
+ *
+ * @param {(String|Symbol)} event The event name.
+ * @param {Object} [options] Optional cancellation signal.
+ * @returns {Promise<Array>} A promise for the emitted arguments.
+ * @public
+ */
+EventEmitter.prototype.waitFor = function waitFor(event, options) {
+  var emitter = this
+    , signal = options && options.signal;
+
+  return new Promise(function (resolve, reject) {
+    if (signal && signal.aborted) {
+      reject(signal.reason);
+      return;
+    }
+
+    var settled = false;
+
+    function cleanup() {
+      if (signal) signal.removeEventListener('abort', onAbort);
+    }
+
+    function onAbort() {
+      if (settled) return;
+
+      settled = true;
+      emitter.removeListener(event, listener);
+      cleanup();
+      reject(signal.reason);
+    }
+
+    function listener() {
+      if (settled) return;
+
+      settled = true;
+      emitter.removeListener(event, listener);
+      cleanup();
+
+      var args = new Array(arguments.length);
+      for (var i = 0; i < arguments.length; i++) args[i] = arguments[i];
+      resolve(args);
+    }
+
+    emitter.on(event, listener);
+    if (signal) signal.addEventListener('abort', onAbort);
+  });
+};
+
