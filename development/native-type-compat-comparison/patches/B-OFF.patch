+
+  describe('EventEmitter#waitFor', function () {
+    it('registers synchronously and resolves a fresh argument array', function () {
+      var e = new EventEmitter()
+        , object = {}
+        , waiting = e.waitFor('data');
+
+      assume(e.listenerCount('data')).equals(1);
+      e.emit('data', object, 1, 2, 3, 4, 5, 6);
+
+      return waiting.then(function (args) {
+        assume(args).deep.equals([object, 1, 2, 3, 4, 5, 6]);
+        assume(args[0]).equals(object);
+        assume(e.listenerCount('data')).equals(0);
+      });
+    });
+
+    it('supports zero arguments and multiple independent waiters', function () {
+      var e = new EventEmitter()
+        , noArgs = e.waitFor('empty')
+        , first = e.waitFor('value')
+        , second = e.waitFor('value')
+        , value = {};
+
+      e.emit('empty');
+      e.emit('value', value);
+
+      return Promise.all([noArgs, first, second]).then(function (results) {
+        assume(results[0]).deep.equals([]);
+        assume(results[1]).deep.equals([value]);
+        assume(results[2]).deep.equals([value]);
+        assume(results[1] === results[2]).equals(false);
+      });
+    });
+
+    it('supports symbols and removes only its own registration', function () {
+      var e = new EventEmitter()
+        , event = Symbol('event')
+        , regularCalls = 0
+        , onceCalls = 0
+        , first = e.waitFor(event)
+        , second = e.waitFor(event);
+
+      e.on(event, function () { regularCalls++; });
+      e.once(event, function () { onceCalls++; });
+      assume(e.listenerCount(event)).equals(4);
+
+      e.emit(event, 'value');
+
+      return Promise.all([first, second]).then(function (results) {
+        assume(results[0]).deep.equals(['value']);
+        assume(results[1]).deep.equals(['value']);
+        assume(regularCalls).equals(1);
+        assume(onceCalls).equals(1);
+        assume(e.listenerCount(event)).equals(1);
+      });
+    });
+
+    it('does not run again during recursive emission', function () {
+      var e = new EventEmitter()
+        , calls = 0
+        , waiting = e.waitFor('event');
+
+      e.on('event', function () {
+        calls++;
+        if (calls === 1) e.emit('event', 'recursive');
+      });
+
+      e.emit('event', 'first');
+
+      return waiting.then(function (args) {
+        assume(args).deep.equals(['first']);
+        assume(calls).equals(2);
+        assume(e.listenerCount('event')).equals(1);
+      });
+    });
+
+    it('rejects with a pre-aborted reason without registering', function () {
+      var e = new EventEmitter()
+        , signal = makeSignal()
+        , reason = {};
+
+      signal.abort(reason);
+      var waiting = e.waitFor('event', { signal: signal });
+
+      assume(e.listenerCount('event')).equals(0);
+      assume(signal.added).equals(0);
+
+      return waiting.then(function () {
+        throw new Error('waitFor should reject');
+      }, function (error) {
+        assume(error).equals(reason);
+      });
+    });
+
+    it('rejects a pending waiter on abort and cleans up its handler', function () {
+      var e = new EventEmitter()
+        , signal = makeSignal()
+        , reason = {}
+        , waiting = e.waitFor('event', { signal: signal });
+
+      assume(e.listenerCount('event')).equals(1);
+      assume(signal.added).equals(1);
+      signal.abort(reason);
+      assume(e.listenerCount('event')).equals(0);
+      assume(signal.removed).equals(1);
+
+      return waiting.then(function () {
+        throw new Error('waitFor should reject');
+      }, function (error) {
+        assume(error).equals(reason);
+      });
+    });
+
+    it('settles on the first event or abort and detaches the abort handler', function () {
+      var e = new EventEmitter()
+        , eventSignal = makeSignal()
+        , abortSignal = makeSignal()
+        , eventReason = {}
+        , abortReason = {}
+        , eventWaiting = e.waitFor('event', { signal: eventSignal })
+        , abortWaiting = e.waitFor('abort', { signal: abortSignal });
+
+      e.emit('event', 'value');
+      eventSignal.abort(eventReason);
+      abortSignal.abort(abortReason);
+      e.emit('abort', 'late');
+
+      return Promise.all([
+        eventWaiting.then(function (args) {
+          assume(args).deep.equals(['value']);
+          assume(eventSignal.removed).equals(1);
+        }),
+        abortWaiting.then(function () {
+          throw new Error('waitFor should reject');
+        }, function (error) {
+          assume(error).equals(abortReason);
+          assume(abortSignal.removed).equals(1);
+        })
+      ]);
+    });
+
+    it('stays pending after ordinary removal and can still be aborted', function () {
+      var e = new EventEmitter()
+        , signal = makeSignal()
+        , allSignal = makeSignal()
+        , reason = {}
+        , allReason = {}
+        , pending = e.waitFor('event', { signal: signal });
+
+      e.off('event');
+      assume(e.listenerCount('event')).equals(0);
+      var pendingError = pending.then(function () {
+        throw new Error('removed waitFor should not resolve');
+      }, function (error) {
+        return error;
+      });
+
+      var later = e.waitFor('event');
+      signal.abort(reason);
+      assume(e.listenerCount('event')).equals(1);
+      e.emit('event', 'later');
+
+      var allPending = e.waitFor('all', { signal: allSignal });
+      e.removeAllListeners('all');
+      var allPendingError = allPending.then(function () {
+        throw new Error('removeAllListeners should not settle waitFor');
+      }, function (error) {
+        return error;
+      });
+      allSignal.abort(allReason);
+      assume(e.listenerCount('all')).equals(0);
+
+      return Promise.all([
+        pendingError,
+        later.then(function (args) {
+          assume(args).deep.equals(['later']);
+        }),
+        allPendingError
+      ]).then(function (results) {
+        assume(results[0]).equals(reason);
+        assume(results[2]).equals(allReason);
+      });
+    });
+
+    function makeSignal() {
+      var listeners = []
+        , signal = {
+          aborted: false,
+          reason: undefined,
+          added: 0,
+          removed: 0,
+          addEventListener: function (type, listener) {
+            if (type === 'abort') {
+              listeners.push(listener);
+              signal.added++;
+            }
+          },
+          removeEventListener: function (type, listener) {
+            if (type !== 'abort') return;
+            var index = listeners.indexOf(listener);
+            if (index !== -1) {
+              listeners.splice(index, 1);
+              signal.removed++;
+            }
+          },
+          abort: function (reason) {
+            signal.aborted = true;
+            signal.reason = reason;
+            listeners.slice().forEach(function (listener) {
+              listener.call(signal);
+            });
+          }
+        };
+
+      return signal;
+    }
+  });
 });
