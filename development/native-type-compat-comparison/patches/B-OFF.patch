@@ -0,0 +1,41 @@
+import EventEmitter from '..';
+
+declare const symbolEvent: unique symbol;
+
+type TupleEvents = {
+  [symbolEvent]: [object];
+  message: [string, number];
+  done: [];
+};
+
+const controller = new AbortController();
+const tupleEmitter = new EventEmitter<TupleEvents>();
+const message: Promise<[string, number]> = tupleEmitter.waitFor('message', {
+  signal: controller.signal
+});
+const symbol: Promise<[object]> = tupleEmitter.waitFor(symbolEvent);
+const done: Promise<[]> = tupleEmitter.waitFor('done');
+
+type FunctionEvents = {
+  message: (value: string, count: number) => void;
+};
+
+const functionEmitter = new EventEmitter<FunctionEvents>();
+const functionMessage: Promise<[string, number]> = functionEmitter.waitFor('message');
+
+const untypedEmitter = new EventEmitter();
+const untyped: Promise<any[]> = untypedEmitter.waitFor(Symbol('event'), {
+  signal: controller.signal
+});
+
+void message;
+void symbol;
+void done;
+void functionMessage;
+void untyped;
+
+// @ts-expect-error Event arguments retain their declared order and types.
+const wrongMessage: Promise<[number, string]> = tupleEmitter.waitFor('message');
+
+// @ts-expect-error waitFor options only support an AbortSignal.
+tupleEmitter.waitFor('message', { timeout: 10 });
