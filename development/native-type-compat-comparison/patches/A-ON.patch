+it('exposes subscribe to ESM consumers', () => {
+  const emitter = new EventEmitter();
+  let calls = 0;
+  const unsubscribe = emitter.subscribe('event', () => calls++);
+
+  emitter.emit('event');
+  unsubscribe();
+  emitter.emit('event');
+
+  if (calls !== 1) throw new Error('subscribe should be available to ESM consumers');
