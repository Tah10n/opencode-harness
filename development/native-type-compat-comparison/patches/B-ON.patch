+/**
+ * Return a promise that resolves with the arguments from the next event.
+ *
+ * @param {(String|Symbol)} event The event name.
+ * @param {Object} [options] Optional cancellation settings.
+ * @returns {Promise<Array>} A promise for the emitted arguments.
+ * @public
+ */
+EventEmitter.prototype.waitFor = function waitFor(event, options) {
+  var emitter = this
+    , signal = options && options.signal;
+
+  if (signal && signal.aborted) return Promise.reject(signal.reason);
+
+  return new Promise(function (resolve, reject) {
+    var settled = false;
+
+    function cleanup() {
+      if (signal) signal.removeEventListener('abort', onAbort);
+    }
+
+    function onAbort() {
+      if (settled) return;
+
+      settled = true;
+      emitter.removeListener(event, onEvent);
+      cleanup();
+      reject(signal.reason);
+    }
+
+    function onEvent() {
+      if (settled) return;
+
+      var args = new Array(arguments.length);
+      for (var i = 0; i < arguments.length; i++) args[i] = arguments[i];
+
+      settled = true;
+      emitter.removeListener(event, onEvent);
+      cleanup();
+      resolve(args);
+    }
+
+    emitter.once(event, onEvent);
+    if (signal) signal.addEventListener('abort', onAbort);
+  });
+};
+
