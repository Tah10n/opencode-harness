+
+  describe('EventEmitter#waitFor', function () {
+    function createSignal() {
+      var handler;
+
+      return {
+        aborted: false,
+        reason: undefined,
+        added: 0,
+        removed: 0,
+        addEventListener: function (event, fn) {
+          if (event === 'abort') {
+            this.added++;
+            handler = fn;
+          }
+        },
+        removeEventListener: function (event, fn) {
+          if (event === 'abort' && handler === fn) {
+            this.removed++;
+            handler = undefined;
+          }
+        },
+        abort: function (reason) {
+          this.aborted = true;
+          this.reason = reason;
+          if (handler) handler();
+        }
+      };
+    }
+
+    it('resolves independent waiters with fresh argument arrays', function () {
+      var e = new EventEmitter()
+        , event = 'data'
+        , object = {}
+        , args = [0, 1, 2, 3, 4, 5, object]
+        , calls = []
+        , listener = function () { calls.push('on'); }
+        , once = function () { calls.push('once'); };
+
+      e.on(event, listener);
+      e.once(event, once);
+
+      var first = e.waitFor(event)
+        , second = e.waitFor(event);
+
+      // Check the actual registrations immediately before the emit.
+      assume(e.listenerCount(event)).equals(4);
+      e.emit.apply(e, [event].concat(args));
+
+      return Promise.all([first, second]).then(function (results) {
+        assume(results[0]).deep.equals(args);
+        assume(results[1]).deep.equals(args);
+        assume(results[0][6]).equals(object);
+        assume(results[0] === results[1]).equals(false);
+        assume(calls).deep.equals(['on', 'once']);
+        assume(e.listeners(event)).deep.equals([listener]);
+      });
+    });
+
+    it('handles zero arguments and an immediate emit', function () {
+      var e = new EventEmitter()
+        , waiting = e.waitFor('empty');
+
+      // Registration is synchronous, before the real entry point is called.
+      assume(e.listenerCount('empty')).equals(1);
+      e.emit('empty');
+
+      return waiting.then(function (args) {
+        assume(args).deep.equals([]);
+        assume(e.listenerCount('empty')).equals(0);
+      });
+    });
+
+    if ('undefined' !== typeof Symbol) it('supports symbols and recursive emits', function () {
+      var e = new EventEmitter()
+        , event = Symbol('recursive')
+        , waiting;
+
+      e.once(event, function () {
+        e.emit(event, 'inner');
+      });
+      waiting = e.waitFor(event);
+
+      assume(e.listenerCount(event)).equals(2);
+      e.emit(event, 'outer');
+
+      return waiting.then(function (args) {
+        assume(args).deep.equals(['inner']);
+        assume(e.listenerCount(event)).equals(0);
+      });
+    });
+
+    it('rejects pre-aborted signals without registering', function () {
+      var e = new EventEmitter()
+        , signal = createSignal()
+        , reason = {};
+
+      signal.abort(reason);
+      var waiting = e.waitFor('data', { signal: signal });
+
+      assume(signal.added).equals(0);
+      assume(e.listenerCount('data')).equals(0);
+
+      return waiting.then(function () {
+        throw new Error('expected rejection');
+      }, function (error) {
+        assume(error).equals(reason);
+      });
+    });
+
+    it('removes its listener and abort handler when cancelled', function () {
+      var e = new EventEmitter()
+        , signal = createSignal()
+        , reason = {};
+      var waiting = e.waitFor('data', { signal: signal });
+
+      // Check the actual listener before triggering the transition.
+      assume(e.listenerCount('data')).equals(1);
+      assume(signal.added).equals(1);
+      signal.abort(reason);
+      assume(e.listenerCount('data')).equals(0);
+      assume(signal.removed).equals(1);
+
+      return waiting.then(function () {
+        throw new Error('expected rejection');
+      }, function (error) {
+        assume(error).equals(reason);
+        signal.abort({});
+        assume(signal.removed).equals(1);
+      });
+    });
+
+    it('settles on the first event or abort and cleans up the handler', function () {
+      var e = new EventEmitter()
+        , eventFirstSignal = createSignal()
+        , abortFirstSignal = createSignal()
+        , eventReason = {}
+        , abortReason = {}
+        , eventFirst = e.waitFor('event-first', { signal: eventFirstSignal })
+        , abortFirst = e.waitFor('abort-first', { signal: abortFirstSignal });
+
+      assume(e.listenerCount('event-first')).equals(1);
+      assume(e.listenerCount('abort-first')).equals(1);
+      e.emit('event-first', eventReason);
+      eventFirstSignal.abort({});
+      abortFirstSignal.abort(abortReason);
+      e.emit('abort-first', {});
+
+      return Promise.all([
+        eventFirst.then(function (args) {
+          assume(args).deep.equals([eventReason]);
+          assume(eventFirstSignal.removed).equals(1);
+          assume(e.listenerCount('event-first')).equals(0);
+        }),
+        abortFirst.then(function () {
+          throw new Error('expected rejection');
+        }, function (error) {
+          assume(error).equals(abortReason);
+          assume(abortFirstSignal.removed).equals(1);
+          assume(e.listenerCount('abort-first')).equals(0);
+        })
+      ]);
+    });
+
+    it('does not settle on ordinary removal and supports later registrations', function () {
+      var e = new EventEmitter()
+        , offSignal = createSignal()
+        , allSignal = createSignal()
+        , offReason = {}
+        , allReason = {}
+        , offWaiting = e.waitFor('off', { signal: offSignal })
+        , allWaiting = e.waitFor('all', { signal: allSignal });
+
+      assume(e.listenerCount('off')).equals(1);
+      assume(e.listenerCount('all')).equals(1);
+      e.off('off');
+      e.removeAllListeners('all');
+      assume(e.listenerCount('off')).equals(0);
+      assume(e.listenerCount('all')).equals(0);
+
+      offSignal.abort(offReason);
+      allSignal.abort(allReason);
+
+      return Promise.all([
+        offWaiting.then(function () {
+          throw new Error('expected rejection');
+        }, function (error) {
+          assume(error).equals(offReason);
+          assume(offSignal.removed).equals(1);
+        }),
+        allWaiting.then(function () {
+          throw new Error('expected rejection');
+        }, function (error) {
+          assume(error).equals(allReason);
+          assume(allSignal.removed).equals(1);
+        })
+      ]).then(function () {
+        var offLater = e.waitFor('off')
+          , allLater = e.waitFor('all');
+
+        assume(e.listenerCount('off')).equals(1);
+        assume(e.listenerCount('all')).equals(1);
+        e.emit('off', 'again');
+        e.emit('all', 'again');
+
+        return Promise.all([offLater, allLater]).then(function (results) {
+          assume(results[0]).deep.equals(['again']);
+          assume(results[1]).deep.equals(['again']);
+        });
+      });
+    });
+  });
 });
