+  const preWaiting = pre.waitFor('event', { signal: preAborted.signal });
+
+  assert.equal(pre.listenerCount('event'), 0);
+  await assert.rejects(preWaiting, error => error === preReason);
+
+  let abortHandler;
+  const signal = {
+    aborted: false,
+    reason: undefined,
+    added: 0,
+    removed: 0,
+    addEventListener(event, handler) {
+      if (event === 'abort') {
+        this.added++;
+        abortHandler = handler;
+      }
+    },
+    removeEventListener(event, handler) {
+      if (event === 'abort' && abortHandler === handler) {
+        this.removed++;
+        abortHandler = undefined;
+      }
+    },
+    abort(reason) {
+      this.aborted = true;
+      this.reason = reason;
+      if (abortHandler) abortHandler();
+    }
+  };
+  const emitter = new EventEmitter();
+  const reason = {};
+  const waiting = emitter.waitFor('event', { signal });
+
+  assert.equal(emitter.listenerCount('event'), 1);
+  assert.equal(signal.added, 1);
+  emitter.removeAllListeners('event');
+  signal.abort(reason);
+  await assert.rejects(waiting, error => error === reason);
+  assert.equal(signal.removed, 1);
+
+  const later = emitter.waitFor('event');
+  emitter.emit('event', 'later');
+  assert.deepEqual(await later, ['later']);
+});
