+import EventEmitter from '..';
+
+interface Events {
+  data: [string];
+}
+
+const emitter = new EventEmitter<Events>();
+
+// @ts-expect-error Event names must come from the event map.
+emitter.waitFor('missing');
+// @ts-expect-error The signal option must be an AbortSignal.
+emitter.waitFor('data', { signal: 'not-a-signal' });
+// @ts-expect-error The resolved tuple preserves the event argument types.
+const wrongResult: Promise<[number]> = emitter.waitFor('data');
+
+void wrongResult;
