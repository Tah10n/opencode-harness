+/**
+ * Remove and return items from the front of the list.
+ * @param count
+ * @returns {Array}
+ */
+Denque.prototype.drain = function drain(count) {
+  if (count !== undefined && (typeof count !== 'number' || !isFinite(count) || count < 0 || count !== Math.floor(count))) {
+    throw new RangeError('count must be a finite nonnegative integer');
+  }
+
+  var length = this.size();
+  count = count === undefined ? length : Math.min(count, length);
+  var removed = new Array(count);
+  for (var i = 0; i < count; i++) removed[i] = this.shift();
+  return removed;
+};
