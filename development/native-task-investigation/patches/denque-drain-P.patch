+/**
+ * Remove and return items from the front of the list in FIFO order.
+ * Returns all items when count is omitted or undefined.
+ * @param count
+ * @returns {Array}
+ */
+Denque.prototype.drain = function drain(count) {
+  if (count !== undefined && (typeof count !== 'number' || !isFinite(count) || count < 0 || Math.floor(count) !== count)) {
+    throw new RangeError('count must be a finite nonnegative integer');
+  }
+
+  var length = this.size();
+  var drainLength = count === undefined ? length : Math.min(count, length);
+  var drained = new Array(drainLength);
+  for (var i = 0; i < drainLength; i++) drained[i] = this.shift();
+  return drained;
+};
