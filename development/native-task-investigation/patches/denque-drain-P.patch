+describe('Denque.prototype.drain', function () {
+  it('should drain a bounded number of items and then the remainder', function () {
+    var a = new Denque([1, 2, 3, 4]);
+
+    assert.deepEqual(a.drain(2), [1, 2]);
+    assert.equal(a.length, 2);
+    assert.deepEqual(a.toArray(), [3, 4]);
+    assert.deepEqual(a.drain(), [3, 4]);
+    assert.equal(a.length, 0);
+  });
+
+  it('should drain available items for a count larger than the length', function () {
+    var a = new Denque([1, 2]);
+
+    assert.deepEqual(a.drain(10), [1, 2]);
+    assert.deepEqual(a.drain(), []);
+    assert.equal(a.length, 0);
+  });
+
+  it('should treat an explicit undefined count like an omitted count', function () {
+    var a = new Denque([1, 2]);
+
+    assert.deepEqual(a.drain(undefined), [1, 2]);
+    assert.equal(a.length, 0);
+  });
+
+  it('should reject invalid counts without modifying the queue', function () {
+    var a = new Denque([1, 2, 3]);
+    var invalidCounts = [-1, 1.5, NaN, Infinity, -Infinity, '1', null, {}];
+
+    invalidCounts.forEach(function (count) {
+      assert.throws(function () {
+        a.drain(count);
+      }, RangeError);
+      assert.deepEqual(a.toArray(), [1, 2, 3]);
+    });
+  });
+
+  it('should return fresh empty arrays for zero and empty queues', function () {
+    var a = new Denque([1, 2]);
+    var zero = a.drain(0);
+    var negativeZero = a.drain(-0);
+
+    assert.deepEqual(zero, []);
+    assert.deepEqual(negativeZero, []);
+    assert.notStrictEqual(zero, negativeZero);
+    assert.deepEqual(a.toArray(), [1, 2]);
+    assert.deepEqual(new Denque().drain(), []);
+  });
+
+  it('should preserve special values and object identity', function () {
+    var object = {};
+    var a = new Denque([undefined, null, NaN, object]);
+    var drained = a.drain();
+
+    assert.equal(drained.length, 4);
+    assert.strictEqual(drained[0], undefined);
+    assert.strictEqual(drained[1], null);
+    assert(drained[2] !== drained[2]);
+    assert.strictEqual(drained[3], object);
+    assert.equal(a.length, 0);
+  });
+
+  it('should drain wrapped storage after growth', function () {
+    var a = new Denque();
+    var i;
+
+    for (i = 0; i < 8; i++) a.push(i);
+    for (i = 0; i < 5; i++) a.shift();
+    for (i = 8; i < 16; i++) a.push(i);
+
+    assert(a._head > a._tail);
+    assert.deepEqual(a.drain(6), [5, 6, 7, 8, 9, 10]);
+    assert.deepEqual(a.toArray(), [11, 12, 13, 14, 15]);
+    assert.deepEqual(a.drain(), [11, 12, 13, 14, 15]);
+  });
+
+  it('should allow drained queues to be reused, including with capacity', function () {
+    var a = new Denque([1, 2, 3], { capacity: 3 });
+
+    assert.deepEqual(a.drain(), [1, 2, 3]);
+    a.push(2);
+    a.unshift(1);
+    assert.strictEqual(a.peek(), 1);
+    assert.strictEqual(a.peekBack(), 2);
+    assert.deepEqual(a.toArray(), [1, 2]);
+    assert.strictEqual(a.pop(), 2);
+    assert.strictEqual(a.shift(), 1);
+    assert.equal(a.size(), 0);
+    a.push(3);
+    a.push(4);
+    a.push(5);
+    a.push(6);
+    assert.deepEqual(a.toArray(), [4, 5, 6]);
+  });
+});
