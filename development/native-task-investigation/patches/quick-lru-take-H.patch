+test('.take() consumes live entries from both cache generations', t => {
+	const evictions = [];
+	const lru = new QuickLRU({
+		maxSize: 2,
+		onEviction: (...args) => evictions.push(args),
+	});
+	const oldKey = {};
+	const oldValue = {};
+	const recentKey = {};
+	const recentValue = {};
+
+	lru.set(oldKey, oldValue);
+	lru.set('retained', 'old');
+	lru.set(recentKey, recentValue);
+
+	t.true(lru.__oldCache.has(oldKey));
+	const oldResult = lru.take(oldKey);
+	t.deepEqual(oldResult, {value: oldValue});
+	t.not(oldResult, oldValue);
+	const recentResult = lru.take(recentKey);
+	t.deepEqual(recentResult, {value: recentValue});
+	t.not(recentResult, recentValue);
+	t.deepEqual([...lru], [['retained', 'old']]);
+	t.deepEqual(evictions, []);
+	t.is(lru.take(oldKey), undefined);
+	t.is(lru.take('missing'), undefined);
+
+	lru.set('undefined', undefined);
+	const result = lru.take('undefined');
+	t.not(result, undefined);
+	t.is(result.value, undefined);
+	t.is(lru.take('undefined'), undefined);
+});
+
+test('.take() evicts expired entries and retains unrelated entries', async t => {
+	const evictions = [];
+	const lru = new QuickLRU({
+		maxSize: 2,
+		onEviction: (...args) => evictions.push(args),
+	});
+	const expiredValue = {};
+
+	lru.set('expired', expiredValue, {maxAge: 1});
+	lru.set('retained', 'old');
+	lru.set('recent', 'new');
+	await delay(10);
+
+	t.true(lru.__oldCache.has('expired'));
+	t.is(lru.take('expired'), undefined);
+	t.deepEqual(evictions, [['expired', expiredValue]]);
+	t.deepEqual([...lru], [['recent', 'new'], ['retained', 'old']]);
+	t.is(lru.take('expired'), undefined);
+	t.deepEqual(evictions, [['expired', expiredValue]]);
+});
+
