+/**
+ * Remove one exact listener registration.
+ *
+ * @param {EventEmitter} emitter Reference to the `EventEmitter` instance.
+ * @param {(String|Symbol)} event The event name.
+ * @param {EE} listener The listener registration.
+ * @private
+ */
+function removeListenerInstance(emitter, event, listener) {
+  var evt = prefix ? prefix + event : event
+    , listeners = emitter._events[evt]
+    , remaining;
+
+  if (!listeners) return;
+  if (listeners === listener) {
+    clearEvent(emitter, evt);
+    return;
+  }
+  if (listeners.fn) return;
+
+  remaining = [];
+  for (var i = 0, length = listeners.length; i < length; i++) {
+    if (listeners[i] !== listener) remaining.push(listeners[i]);
+  }
+
+  if (remaining.length) emitter._events[evt] = remaining.length === 1 ? remaining[0] : remaining;
+  else clearEvent(emitter, evt);
+}
