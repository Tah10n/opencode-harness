+    , snapshot
+    , args
+    , results
+    , i;
+
+  if (!listeners) return [];
+
+  snapshot = listeners.fn ? [listeners] : listeners.slice();
+  args = new Array(arguments.length - 1);
+  for (i = 1; i < arguments.length; i++) args[i - 1] = arguments[i];
+
+  results = new Array(snapshot.length);
+  for (i = 0; i < snapshot.length; i++) {
+    if (snapshot[i].once) removeListenerInstance(this, event, snapshot[i]);
+    results[i] = snapshot[i].fn.apply(snapshot[i].context, args);
+  }
+
