+/**
+ * Remove and return items from the front of the list.
+ * @param count
+ * @returns {array}
+ */
+Denque.prototype.drain = function drain(count) {
+  if (count !== undefined &&
+      (typeof count !== 'number' || !isFinite(count) || count < 0 || count % 1 !== 0)) {
+    throw new RangeError('count must be a finite non-negative integer');
+  }
+
+  var size = this.size();
+  if (count === undefined || count > size) count = size;
+
+  var removed = new Array(count);
+  var head = this._head;
+  for (var i = 0; i < count; i++) {
+    removed[i] = this._list[head];
+    this._list[head] = undefined;
+    head = (head + 1) & this._capacityMask;
+  }
+  this._head = head;
+  return removed;
+};
