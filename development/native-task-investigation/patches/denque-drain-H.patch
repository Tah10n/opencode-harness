+describe('Denque.prototype.drain', function () {
+  it('should drain a bounded number or all remaining items', function () {
+    var a = new Denque([1, 2, 3, 4, 5]);
+
+    assert.deepEqual(a.drain(2), [1, 2]);
+    assert.deepEqual(a.toArray(), [3, 4, 5]);
+    assert.strictEqual(a.length, 3);
+    assert.strictEqual(a.size(), 3);
+    assert.deepEqual(a.drain(100), [3, 4, 5]);
+    assert.strictEqual(a.length, 0);
+    assert.deepEqual(a.drain(), []);
+  });
+
+  it('should accept omitted and explicit undefined counts', function () {
+    var a = new Denque([1, 2]);
+    assert.deepEqual(a.drain(undefined), [1, 2]);
+    assert.deepEqual(a.toArray(), []);
+
+    var b = new Denque([3, 4]);
+    assert.deepEqual(b.drain(), [3, 4]);
+    assert.deepEqual(b.toArray(), []);
+  });
+
+  it('should reject invalid counts without changing the queue', function () {
+    var a = new Denque([1, 2, 3]);
+    var invalid = [-1, 1.5, NaN, Infinity, -Infinity, '1', true, {}];
+
+    invalid.forEach(function (count) {
+      assert.throws(function () {
+        a.drain(count);
+      }, RangeError);
+      assert.deepEqual(a.toArray(), [1, 2, 3]);
+      assert.strictEqual(a.length, 3);
+    });
+  });
+
+  it('should return a fresh empty array for zero without changing the queue', function () {
+    var a = new Denque([1]);
+    var first = a.drain(0);
+    var second = a.drain(-0);
+
+    assert(Array.isArray(first));
+    assert(Array.isArray(second));
+    assert.strictEqual(first.length, 0);
+    assert.strictEqual(second.length, 0);
+    assert.notStrictEqual(first, second);
+    assert.deepEqual(a.toArray(), [1]);
+  });
+
+  it('should preserve special values and object identity', function () {
+    var object = {};
+    var a = new Denque([undefined, null, NaN, object, false]);
+    var drained = a.drain();
+
+    assert.strictEqual(drained.length, 5);
+    assert.strictEqual(drained[0], undefined);
+    assert.strictEqual(drained[1], null);
+    assert(drained[2] !== drained[2]);
+    assert.strictEqual(drained[3], object);
+    assert.strictEqual(drained[4], false);
+    assert.strictEqual(a.length, 0);
+  });
+
+  it('should drain correctly from wrapped grown storage', function () {
+    var a = new Denque();
+    var expected = [];
+    var i;
+
+    for (i = 0; i < 32; i++) {
+      a.push(i);
+      expected.push(i);
+    }
+    for (i = 0; i < 20; i++) {
+      assert.strictEqual(a.shift(), expected.shift());
+    }
+    for (i = 32; i <= 70; i++) {
+      a.push(i);
+      expected.push(i);
+    }
+
+    assert(a._head > a._tail);
+    assert.deepEqual(a.drain(10), expected.splice(0, 10));
+    assert.deepEqual(a.toArray(), expected);
+    assert.strictEqual(a.length, expected.length);
+  });
+
+  it('should leave queues reusable, including capacity-limited queues', function () {
+    var a = new Denque([1, 2, 3], { capacity: 3 });
+    assert.deepEqual(a.drain(), [1, 2, 3]);
+    assert.strictEqual(a.length, 0);
+
+    a.push(4);
+    a.unshift(3);
+    a.push(5);
+    assert.deepEqual(a.toArray(), [3, 4, 5]);
+    assert.strictEqual(a.peek(), 3);
+    assert.strictEqual(a.peekFront(), 3);
+    assert.strictEqual(a.peekBack(), 5);
+    assert.strictEqual(a.pop(), 5);
+    assert.strictEqual(a.shift(), 3);
+    assert.deepEqual(a.toArray(), [4]);
+
+    assert.deepEqual(a.drain(1), [4]);
+    a.push(6);
+    a.unshift(5);
+    assert.deepEqual(a.toArray(), [5, 6]);
+    assert.strictEqual(a.length, 2);
+    assert.strictEqual(a.size(), 2);
+  });
+});
