diff --git a/packages/connector/test/state-security.test.mjs b/packages/connector/test/state-security.test.mjs
index 3b2b4c6..d034ee4 100644
--- a/packages/connector/test/state-security.test.mjs
+++ b/packages/connector/test/state-security.test.mjs
@@ -106,6 +106,55 @@ test(
   },
 );
 
+test(
+  "accepts the exact flat legacy runtime and preserves it across reloads",
+  { skip: process.platform === "win32" },
+  async (context) => {
+    const root = await mkdtemp(join(tmpdir(), "viberacing-flat-runtime-"));
+    context.after(() => rm(root, { recursive: true, force: true }));
+    const state = join(root, ".viberacing");
+    const core = ["browser", "config", "executables", "readers", "registry", "runtime"];
+    const adapters = [
+      "antigravity",
+      "claude",
+      "codex",
+      "cursor",
+      "gemini",
+      "kimi",
+      "opencode",
+      "qwen-settings",
+      "qwen",
+      "shared",
+    ];
+    await mkdir(join(state, "lib", "adapters"), { recursive: true, mode: 0o777 });
+    await mkdir(join(state, "bin"), { mode: 0o777 });
+    await writeFile(
+      join(state, "installation.json"),
+      `${JSON.stringify({ version: 1, id: "12345678-1234-4123-8123-123456789abc", secret: "legacy_installation_secret_that_is_long_enough" })}\n`,
+    );
+    const legacy = [
+      [join(state, "bin", "viberacing.mjs"), "legacy launcher\n"],
+      ...core.map((name) => [join(state, "lib", `${name}.mjs`), `legacy ${name}\n`]),
+      ...adapters.map((name) => [join(state, "lib", "adapters", `${name}.mjs`), `legacy ${name}\n`]),
+    ];
+    for (const [path, contents] of legacy) await writeFile(path, contents, { mode: 0o755 });
+    const before = await Promise.all(legacy.map(async ([path]) => [path, await readFile(path)]));
+    const environment = { ...process.env, HOME: root, USERPROFILE: root };
+    delete environment.VIBERACING_STATE_DIR;
+    for (let attempt = 0; attempt < 2; attempt += 1)
+      await execFileAsync(process.execPath, ["--input-type=module", "--eval", ensureStateScript], {
+        env: environment,
+      });
+    assert.deepEqual(
+      await Promise.all(before.map(async ([path, contents]) => [path, await readFile(path)])),
+      before,
+    );
+    assert.deepEqual(JSON.parse(await readFile(join(state, ".viberacing-state"), "utf8")), {
+      format: 1,
+    });
+  },
+);
+
 test(
   "POSIX state security rejects unrelated content before changing modes",
   { skip: process.platform === "win32" },
