+test("accepts the exact flat legacy runtime and preserves it across runtime preparation", async (context) => {
+  const root = await mkdtemp(join(tmpdir(), "viberacing-flat-runtime-"));
+  context.after(() => rm(root, { recursive: true, force: true }));
+  const state = join(root, ".viberacing");
+  await mkdir(join(state, "lib", "adapters"), { recursive: true, mode: 0o777 });
+  await mkdir(join(state, "bin"), { mode: 0o777 });
+  await writeFile(
+    join(state, "installation.json"),
+    `${JSON.stringify({
+      version: 1,
+      id: "12345678-1234-4123-8123-123456789abc",
+      secret: "legacy_installation_secret_that_is_long_enough",
+    })}\n`,
+  );
+  const legacyFiles = [
+    "bin/viberacing.mjs",
+    "lib/browser.mjs",
+    "lib/config.mjs",
+    "lib/executables.mjs",
+    "lib/readers.mjs",
+    "lib/registry.mjs",
+    "lib/runtime.mjs",
+    ...[
+      "antigravity",
+      "claude",
+      "codex",
+      "cursor",
+      "gemini",
+      "kimi",
+      "opencode",
+      "qwen-settings",
+      "qwen",
+      "shared",
+    ].map((name) => `lib/adapters/${name}.mjs`),
+  ];
+  const original = new Map();
+  await Promise.all(
+    legacyFiles.map(async (name) => {
+      const contents = `legacy:${name}\n`;
+      original.set(name, contents);
+      await writeFile(join(state, name), contents, { mode: 0o755 });
+    }),
+  );
+  const environment = {
+    ...process.env,
+    HOME: root,
+    USERPROFILE: root,
+    NODE_ENV: "test",
+    VIBERACING_STATE_DIR: state,
+  };
+  await execFileAsync(
+    process.execPath,
+    ["--input-type=module", "--eval", `import { prepareRuntime } from ${JSON.stringify(configUrl)}; await prepareRuntime(${JSON.stringify(new URL("../bin/viberacing.mjs", import.meta.url).href)});`],
+    { env: environment },
+  );
+  await execFileAsync(process.execPath, ["--input-type=module", "--eval", ensureStateScript], {
+    env: environment,
+  });
+  for (const name of legacyFiles) assert.equal(await readFile(join(state, name), "utf8"), original.get(name));
+  assert.deepEqual(JSON.parse(await readFile(join(state, ".viberacing-state"), "utf8")), { format: 1 });
+});
