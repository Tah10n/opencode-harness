+test("accepts and preserves the exact legacy flat runtime across preparation and reload", async () => {
+  const home = await mkdtemp(join(tmpdir(), "viberacing-legacy-runtime-"));
+  const restoreEnvironment = useModuleEnvironment(home);
+  try {
+    const directory = join(home, ".viberacing");
+    const legacyFiles = [
+      "browser",
+      "config",
+      "executables",
+      "readers",
+      "registry",
+      "runtime",
+    ].map((name) => join("lib", `${name}.mjs`));
+    legacyFiles.push("bin/viberacing.mjs");
+    for (const name of [
+      "antigravity",
+      "claude",
+      "codex",
+      "cursor",
+      "gemini",
+      "kimi",
+      "opencode",
+      "qwen-settings",
+      "qwen",
+      "shared",
+    ])
+      legacyFiles.push(join("lib", "adapters", `${name}.mjs`));
+    await mkdir(join(directory, "lib", "adapters"), { recursive: true });
+    await mkdir(join(directory, "bin"), { recursive: true });
+    const bytes = new Map();
+    for (const name of legacyFiles) {
+      const value = Buffer.from(`legacy:${name}\n`);
+      bytes.set(name, value);
+      await writeFile(join(directory, name), value);
+    }
+    await writeFile(
+      join(directory, "installation.json"),
+      JSON.stringify({ version: 1, id: "11111111-1111-4111-8111-111111111111", secret: "a".repeat(32) }),
+    );
+    await writeFile(join(directory, ".viberacing-state"), '{"format":1}\n');
+    const module = await import(`../lib/config.mjs?legacy=${encodeURIComponent(home)}`);
+    const sourceUrl = new URL("../bin/viberacing.mjs", import.meta.url);
+    await module.prepareRuntime(sourceUrl);
+    const reloaded = await import(`../lib/config.mjs?legacy-reload=${encodeURIComponent(home)}`);
+    await reloaded.prepareRuntime(sourceUrl);
+    for (const [name, value] of bytes)
+      assert.deepEqual(await readFile(join(directory, name)), value, name);
+    await access(join(directory, "runtime", connectorVersion, "bin", "viberacing.mjs"));
+  } finally {
+    restoreEnvironment();
+    await rm(home, { recursive: true, force: true });
+  }
+});
+
+test("rejects an unknown entry alongside the legacy flat runtime", async () => {
+  const home = await mkdtemp(join(tmpdir(), "viberacing-legacy-reject-"));
+  const restoreEnvironment = useModuleEnvironment(home);
+  try {
+    const directory = join(home, ".viberacing");
+    await mkdir(join(directory, "lib", "adapters"), { recursive: true });
+    await mkdir(join(directory, "bin"), { recursive: true });
+    await writeFile(join(directory, "installation.json"), JSON.stringify({ version: 1, id: "22222222-2222-4222-8222-222222222222", secret: "b".repeat(32) }));
+    await writeFile(join(directory, "lib", "unknown.mjs"), "foreign");
+    const module = await import(`../lib/config.mjs?legacy-reject=${encodeURIComponent(home)}`);
+    await assert.rejects(module.prepareRuntime(new URL("../bin/viberacing.mjs", import.meta.url)), /unrelated entry/);
+  } finally {
+    restoreEnvironment();
+    await rm(home, { recursive: true, force: true });
+  }
+});
