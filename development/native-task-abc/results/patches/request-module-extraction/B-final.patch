new file mode 100644
index 0000000..b0522c2
--- /dev/null
+++ b/packages/connector/test/transport.test.mjs
@@ -0,0 +1,56 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { createServer } from "node:http";
+import { request, retryAfterMilliseconds } from "../lib/transport.mjs";
+
+async function fixtureServer(handler) {
+  const server = createServer(handler);
+  await new Promise((resolve) => server.listen(0, "127.0.0.1", resolve));
+  return { server, origin: `http://127.0.0.1:${server.address().port}` };
+}
+
+test("transport preserves request shape and retries transient protocol responses", async () => {
+  const requests = [];
+  let count = 0;
+  const fixture = await fixtureServer((req, res) => {
+    const chunks = [];
+    req.on("data", (chunk) => chunks.push(chunk));
+    req.on("end", () => {
+      requests.push({ method: req.method, headers: req.headers, body: Buffer.concat(chunks).toString() });
+      count += 1;
+      res.writeHead(count === 1 ? 503 : 204, { "content-type": "application/json" });
+      res.end(count === 1 ? JSON.stringify({ error: "temporarily_unavailable" }) : undefined);
+    });
+  });
+  try {
+    assert.equal(
+      await request(
+        fixture.origin,
+        "/api/upload",
+        { method: "POST", headers: { "Content-Type": "application/json" }, body: '{"total":3}' },
+        2,
+        { kind: "empty" },
+      ),
+      null,
+    );
+    assert.equal(requests.length, 2);
+    assert.deepEqual(requests[0], requests[1]);
+    assert.equal(requests[0].body, '{"total":3}');
+  } finally {
+    await new Promise((resolve) => fixture.server.close(resolve));
+  }
+});
+
+test("transport bounds Retry-After and refuses redirects", async () => {
+  const response = new Response(null, { headers: { "retry-after": "999" } });
+  assert.equal(retryAfterMilliseconds(response, { NODE_ENV: "test", VIBERACING_TEST_MAX_RETRY_AFTER_MS: "1000" }), 1000);
+  const fixture = await fixtureServer((_req, res) => {
+    res.writeHead(302, { location: "http://127.0.0.1/elsewhere" });
+    res.end();
+  });
+  try {
+    await assert.rejects(request(fixture.origin, "/redirect", {}, 1, { kind: "empty" }));
+  } finally {
+    await new Promise((resolve) => fixture.server.close(resolve));
+  }
+});
