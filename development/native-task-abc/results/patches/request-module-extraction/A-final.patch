diff --git a/packages/connector/test/transport.test.mjs b/packages/connector/test/transport.test.mjs
new file mode 100644
index 0000000..db934f7
--- /dev/null
+++ b/packages/connector/test/transport.test.mjs
@@ -0,0 +1,53 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { createServer } from "node:http";
+import { once } from "node:events";
+import { request, retryAfterMilliseconds } from "../lib/transport.mjs";
+
+test("transport preserves request options and retries eligible responses", async (t) => {
+  const calls = [];
+  const server = createServer((incoming, response) => {
+    let body = "";
+    incoming.on("data", (chunk) => (body += chunk));
+    incoming.on("end", () => {
+      calls.push({ method: incoming.method, headers: incoming.headers, body });
+      if (calls.length === 1) {
+        response.writeHead(503, { "content-type": "application/json", "retry-after": "0" });
+        response.end(JSON.stringify({ error: "temporarily_unavailable" }));
+      } else response.writeHead(204).end();
+    });
+  });
+  server.listen(0, "127.0.0.1");
+  await once(server, "listening");
+  t.after(() => server.close());
+
+  const result = await request(
+    `http://127.0.0.1:${server.address().port}`,
+    "/transport",
+    { method: "POST", headers: { "Content-Type": "application/json" }, body: '{"x":1}' },
+    2,
+    { kind: "empty" },
+  );
+  assert.equal(result, null);
+  assert.equal(calls.length, 2);
+  assert.deepEqual(calls[0], calls[1]);
+  assert.equal(calls[0].method, "POST");
+  assert.equal(calls[0].body, '{"x":1}');
+  assert.equal(calls[0].headers["content-type"], "application/json");
+});
+
+test("transport bounds numeric Retry-After using the existing test control", () => {
+  const previousNodeEnvironment = process.env.NODE_ENV;
+  const previousMaximum = process.env.VIBERACING_TEST_MAX_RETRY_AFTER_MS;
+  process.env.NODE_ENV = "test";
+  process.env.VIBERACING_TEST_MAX_RETRY_AFTER_MS = "25";
+  try {
+    const response = new Response(null, { headers: { "Retry-After": "60" } });
+    assert.equal(retryAfterMilliseconds(response), 25);
+  } finally {
+    if (previousNodeEnvironment === undefined) delete process.env.NODE_ENV;
+    else process.env.NODE_ENV = previousNodeEnvironment;
+    if (previousMaximum === undefined) delete process.env.VIBERACING_TEST_MAX_RETRY_AFTER_MS;
+    else process.env.VIBERACING_TEST_MAX_RETRY_AFTER_MS = previousMaximum;
+  }
+});
