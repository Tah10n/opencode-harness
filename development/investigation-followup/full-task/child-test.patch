+test("event collectors retain first tuples across a source switch and count new events", async (context) => {
+  const range = { rangeStart: "2026-08-01", rangeEnd: "2026-08-31" };
+  const expected = (date, totalTokens, inputTokens, outputTokens) => ({
+    date,
+    totalTokens,
+    inputTokens,
+    outputTokens,
+    cacheReadTokens: "0",
+    cacheWriteTokens: "0",
+    reasoningTokens: "0",
+  });
+  const cases = [
+    {
+      agentId: "claude_code",
+      path: (root) => join(root, "session.jsonl"),
+      record: (id, date, input, output) => ({
+        type: "assistant",
+        timestamp: `${date}T12:00:00Z`,
+        privateContent: `private-${id}`,
+        message: { id, role: "assistant", usage: { input_tokens: input, output_tokens: output } },
+      }),
+      expected,
+      supportsConflicts: true,
+    },
+    {
+      agentId: "kimi_code",
+      collectionMethod: "kimi_wire_jsonl",
+      path: (root) => join(root, "project", "session", "agents", "main", "wire.jsonl"),
+      record: (id, date, input, output) => ({
+        type: "usage.record",
+        time: Date.parse(`${date}T12:00:00Z`),
+        privateContent: `private-${id}`,
+        usage: { inputOther: input, output, inputCacheRead: 0, inputCacheCreation: 0 },
+      }),
+      expected,
+      supportsConflicts: false,
+    },
+    {
+      agentId: "kimi_code",
+      collectionMethod: "kimi_legacy_wire_jsonl",
+      path: (root) => join(root, "wire.jsonl"),
+      record: (id, date, input, output) => ({
+        timestamp: `${date}T12:00:00Z`,
+        privateContent: `private-${id}`,
+        message: {
+          type: "StatusUpdate",
+          payload: {
+            message_id: id,
+            token_usage: {
+              input_other: input,
+              output,
+              input_cache_read: 0,
+              input_cache_creation: 0,
+            },
+          },
+        },
+      }),
+      expected,
+      supportsConflicts: true,
+    },
+    {
+      agentId: "qwen_code",
+      path: (root) => join(root, "token-usage-2026-08.jsonl"),
+      record: (id, date, input, output) => ({
+        schemaVersion: 1,
+        id,
+        timestamp: `${date}T12:00:00Z`,
+        inputTokens: input,
+        outputTokens: output,
+        cachedTokens: 0,
+        thoughtsTokens: 0,
+        totalTokens: input + output,
+        privateContent: `private-${id}`,
+      }),
+      expected,
+      supportsConflicts: true,
+    },
+    {
+      agentId: "gemini_cli",
+      path: (root) => join(root, "session-switch.jsonl"),
+      record: (id, date, input, output) => ({
+        type: "gemini",
+        id,
+        timestamp: `${date}T12:00:00Z`,
+        privateContent: `private-${id}`,
+        usageMetadata: { input, output, cached: 0, thoughts: 0, total: input + output },
+      }),
+      expected,
+      supportsConflicts: true,
+    },
+    {
+      agentId: "antigravity",
+      path: (root) => join(root, "capture.jsonl"),
+      record: (id, date, input, output) => ({
+        id,
+        date,
+        privateContent: `private-${id}`,
+        usage: {
+          date,
+          totalTokens: String(input + output),
+          inputTokens: String(input),
+          outputTokens: String(output),
+          cacheReadTokens: "0",
+          cacheWriteTokens: "0",
+          reasoningTokens: "0",
+        },
+      }),
+      expected,
+      supportsConflicts: true,
+    },
+  ];
+
+  for (const item of cases) {
+    const root = await mkdtemp(join(tmpdir(), `viberacing-switch-${item.agentId}-`));
+    context.after(() => rm(root, { recursive: true, force: true }));
+    const path = item.path(root);
+    await mkdir(dirname(path), { recursive: true });
+    const source = {
+      dataPath: item.agentId === "antigravity" ? path : root,
+      ...(item.collectionMethod ? { collectionMethod: item.collectionMethod } : {}),
+    };
+    const writeRecords = async (records) =>
+      writeFile(path, `${records.map((record) => JSON.stringify(record)).join("\n")}\n`);
+    const firstRecord = item.record("switch-event-a", "2026-08-10", 4, 6);
+    await writeRecords([firstRecord]);
+    const adapter = adapterFor(item.agentId);
+    const first = await adapter.collect(source, range, {});
+    assert.equal(first.completeness, "complete", item.agentId);
+    assert.deepEqual(first.entries, [item.expected("2026-08-10", "10", "4", "6")], item.agentId);
+
+    const persistedState = JSON.parse(JSON.stringify(first.nextState));
+    const firstStateText = JSON.stringify(persistedState);
+    for (const value of ["switch-event-a", "private-switch-event-a"])
+      assert.equal(firstStateText.includes(value), false, `${item.agentId} content-free state`);
+
+    const conflicting = item.record("switch-event-a", "2026-08-10", 40, 59);
+    const secondRecord = item.record("switch-event-b", "2026-08-11", 3, 4);
+    await writeRecords([item.supportsConflicts ? conflicting : firstRecord, secondRecord]);
+    const switched = await adapter.collect(source, range, persistedState);
+    assert.equal(switched.completeness, item.supportsConflicts ? "partial" : "complete", item.agentId);
+    assert.deepEqual(
+      switched.entries,
+      [
+        item.expected("2026-08-10", "10", "4", "6"),
+        item.expected("2026-08-11", "7", "3", "4"),
+      ],
+      `${item.agentId} first accepted tuple and unrelated event`,
+    );
+    const switchedStateText = JSON.stringify(switched.nextState);
+    for (const value of [
+      "switch-event-a",
+      "switch-event-b",
+      "private-switch-event-a",
+      "private-switch-event-b",
+    ])
+      assert.equal(switchedStateText.includes(value), false, `${item.agentId} content-free state`);
+
+    const thirdRecord = item.record("switch-event-c", "2026-08-12", 2, 5);
+    await writeRecords([secondRecord, thirdRecord]);
+    const truncated = await adapter.collect(source, range, switched.nextState);
+    assert.deepEqual(
+      truncated.entries,
+      [
+        item.expected("2026-08-10", "10", "4", "6"),
+        item.expected("2026-08-11", "7", "3", "4"),
+        item.expected("2026-08-12", "7", "2", "5"),
+      ],
+      `${item.agentId} retained history after truncation`,
+    );
+  }
+});
