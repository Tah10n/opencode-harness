+    kimi_code: (await fixture("kimi.jsonl")).trim().split("\n")[1],
+  };
+  const kimiNext = (await fixture("kimi.jsonl")).trim().split("\n")[2];
+  const cases = [
+    {
+      agentId: "claude_code",
+      name: "session.jsonl",
+      next: (line) => ({
+        ...JSON.parse(line),
+        timestamp: "2026-08-11T12:00:00Z",
+        message: { ...JSON.parse(line).message, id: "moved-new" },
+      }),
+    },
+    {
+      agentId: "qwen_code",
+      name: "token-usage-2026-08.jsonl",
+      next: (line) => ({ ...JSON.parse(line), id: "moved-new", timestamp: "2026-08-11T12:00:00Z" }),
+    },
+    {
+      agentId: "antigravity",
+      name: "capture.jsonl",
+      next: (line) => ({ ...JSON.parse(line), session_id: "moved-new", timestamp: "2026-08-11T12:00:00Z" }),
+    },
+    {
+      agentId: "gemini_cli",
+      name: "session-moved.jsonl",
+      next: (line) => ({ ...JSON.parse(line), id: "moved-new", timestamp: "2026-08-11T12:00:00Z" }),
+    },
+    {
+      agentId: "kimi_code",
+      name: "wire.jsonl",
+      next: () => JSON.parse(kimiNext),
+    },
+  ];
+  for (const item of cases) {
+    const oldRoot = await mkdtemp(join(tmpdir(), `viberacing-ledger-old-${item.agentId}-`));
+    const newRoot = `${oldRoot}-moved`;
+    context.after(() => rm(oldRoot, { recursive: true, force: true }));
+    context.after(() => rm(newRoot, { recursive: true, force: true }));
+    const oldPath = join(oldRoot, item.name);
+    await writeFile(oldPath, `${fixtureLines[item.agentId]}\n`);
+    const adapter = adapterFor(item.agentId);
+    const source = { dataPath: oldRoot, collectionMethod: adapter.collectionMethods[0] };
+    const first = await adapter.collect(source, range, {});
+    const replacement = JSON.stringify(
+      item.agentId === "kimi_code" ? item.next() : item.next(fixtureLines[item.agentId]),
+    );
+    await rename(oldRoot, newRoot);
+    await writeFile(join(newRoot, item.name), `${fixtureLines[item.agentId]}\n${replacement}\n`);
+    const movedSource = { ...source, dataPath: newRoot };
+    assert.match(await readFile(join(newRoot, item.name), "utf8"), /\S/, `${item.agentId} setup`);
+    const stateForSecond =
+      item.agentId === "qwen_code"
