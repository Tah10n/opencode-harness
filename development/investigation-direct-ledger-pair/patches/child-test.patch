+function eventLedgerCases() {
+  return [
+    {
+      name: "Claude",
+      agentId: "claude_code",
+      fileName: "session.jsonl",
+      make(id, date, input) {
+        return JSON.stringify({
+          type: "assistant",
+          timestamp: `${date}T12:00:00Z`,
+          message: {
+            id,
+            role: "assistant",
+            usage: { input_tokens: input, output_tokens: 5 },
+          },
+        });
+      },
+    },
+    {
+      name: "Kimi legacy",
+      agentId: "kimi_code",
+      collectionMethod: "kimi_legacy_wire_jsonl",
+      fileName: "wire.jsonl",
+      make(id, date, input) {
+        return JSON.stringify({
+          type: "StatusUpdate",
+          timestamp: `${date}T12:00:00Z`,
+          message: {
+            type: "StatusUpdate",
+            timestamp: `${date}T12:00:00Z`,
+            payload: {
+              message_id: id,
+              token_usage: { input_other: input, output: 5 },
+            },
+          },
+        });
+      },
+    },
+    {
+      name: "Qwen",
+      agentId: "qwen_code",
+      fileName: "token-usage-2026-08.jsonl",
+      make(id, date, input) {
+        return JSON.stringify({
+          schemaVersion: 1,
+          id,
+          timestamp: `${date}T12:00:00Z`,
+          inputTokens: input,
+          outputTokens: 5,
+          totalTokens: input + 5,
+        });
+      },
+    },
+    {
+      name: "Gemini",
+      agentId: "gemini_cli",
+      fileName: "session-events.jsonl",
+      make(id, date, input) {
+        return JSON.stringify({
+          id,
+          type: "gemini",
+          timestamp: `${date}T12:00:00Z`,
+          tokens: { input, output: 5, total: input + 5 },
+        });
+      },
+    },
+    {
+      name: "Antigravity",
+      agentId: "antigravity",
+      fileName: "capture.jsonl",
+      singleFile: true,
+      make(id, date, input) {
+        return JSON.stringify({
+          id,
+          date,
+          usage: { date, inputTokens: String(input), outputTokens: "5" },
+        });
+      },
+    },
+  ];
+}
+
+function ledgerSource(item, root) {
+  return {
+    dataPath: item.singleFile ? join(root, item.fileName) : root,
+    ...(item.collectionMethod === undefined ? {} : { collectionMethod: item.collectionMethod }),
+  };
+}
+
+async function writeLedgerEvent(root, item, line) {
+  await mkdir(root, { recursive: true });
+  await writeFile(join(root, item.fileName), `${line}\n`);
+}
+
+function dailyTotals(result) {
+  return result.entries.map(({ date, totalTokens }) => ({ date, totalTokens }));
+}
+
+function legacyEventCollectorState(state) {
+  const legacy = { parserVersion: state.parserVersion, files: {} };
+  for (const [path, file] of Object.entries(state.files ?? {})) {
+    legacy.files[path] = Object.fromEntries(
+      ["size", "modifiedAt", "ino", "safeOffset", "tailFingerprint", "eventDays", "entries", "ids"]
+        .filter((key) => file[key] !== undefined)
+        .map((key) => [key, file[key]]),
+    );
+  }
+  if (state.messages !== undefined) legacy.messages = state.messages;
+  return legacy;
+}
+
+test("event collectors conservatively migrate state across copied and truncated session paths", async (context) => {
+  const range = { rangeStart: "2026-08-01", rangeEnd: "2026-08-31" };
+  for (const item of eventLedgerCases()) {
+    const root = await mkdtemp(join(tmpdir(), `viberacing-${item.agentId}-ledger-`));
+    context.after(() => rm(root, { force: true, recursive: true }));
+    const originalRoot = join(root, "original");
+    const switchedRoot = join(root, "switched");
+    const firstLine = item.make("account-one-event", "2026-08-10", 10);
+    const secondLine = item.make("account-two-event", "2026-08-11", 20);
+    await writeLedgerEvent(originalRoot, item, firstLine);
+    const adapter = adapterFor(item.agentId);
+    const first = await adapter.collect(ledgerSource(item, originalRoot), range, {});
+    assert.equal(first.completeness, "complete", item.name);
+
+    await writeLedgerEvent(switchedRoot, item, firstLine);
+    const copied = await adapter.collect(
+      ledgerSource(item, switchedRoot),
+      range,
+      legacyEventCollectorState(first.nextState),
+    );
+    assert.deepEqual(dailyTotals(copied), [{ date: "2026-08-10", totalTokens: "15" }], item.name);
+
+    await writeLedgerEvent(switchedRoot, item, secondLine);
+    const switched = await adapter.collect(
+      ledgerSource(item, switchedRoot),
+      range,
+      copied.nextState,
+    );
+    assert.deepEqual(
+      dailyTotals(switched),
+      [
+        { date: "2026-08-10", totalTokens: "15" },
+        { date: "2026-08-11", totalTokens: "25" },
+      ],
+      item.name,
+    );
+    assert.doesNotMatch(JSON.stringify(switched.nextState), /account-one-event|account-two-event/);
+  }
+});
+
+test("event collectors keep the first tuple for conflicts and still accept unrelated events", async (context) => {
+  const range = { rangeStart: "2026-08-01", rangeEnd: "2026-08-31" };
+  for (const item of eventLedgerCases()) {
+    const root = await mkdtemp(join(tmpdir(), `viberacing-${item.agentId}-conflict-`));
+    context.after(() => rm(root, { force: true, recursive: true }));
+    const pathRoot = join(root, "events");
+    await writeLedgerEvent(pathRoot, item, item.make("stable-event", "2026-08-10", 10));
+    const adapter = adapterFor(item.agentId);
+    const first = await adapter.collect(ledgerSource(item, pathRoot), range, {});
+
+    await writeFile(
+      join(pathRoot, item.fileName),
+      `${item.make("stable-event", "2026-08-10", 20)}\n${item.make("unrelated-event", "2026-08-12", 30)}\n`,
+    );
+    const result = await adapter.collect(ledgerSource(item, pathRoot), range, first.nextState);
+    assert.equal(result.completeness, "partial", item.name);
+    assert.deepEqual(
+      dailyTotals(result),
+      [
+        { date: "2026-08-10", totalTokens: "15" },
+        { date: "2026-08-12", totalTokens: "35" },
+      ],
+      item.name,
+    );
+    assert.doesNotMatch(JSON.stringify(result.nextState), /stable-event|unrelated-event/);
+  }
+});
