+test("OpenCode retains exact-ID usage across database history replacement", async (context) => {
+  const directory = await mkdtemp(join(tmpdir(), "viberacing-opencode-exact-id-"));
+  context.after(() => rm(directory, { force: true, recursive: true }));
+  const path = join(directory, "opencode.db");
+  const { DatabaseSync } = await import("node:sqlite");
+  const database = new DatabaseSync(path);
+  database.exec("CREATE TABLE message (id TEXT, time_created INTEGER, data TEXT)");
+  database
+    .prepare("INSERT INTO message (id, time_created, data) VALUES (?, ?, ?)")
+    .run(
+      "exact-message-id",
+      Date.parse("2026-08-10T12:00:00Z"),
+      JSON.stringify({ role: "assistant", tokens: { input: 10, output: 5, total: 15 } }),
+    );
+  database.close();
+
+  const range = { rangeStart: "2026-08-01", rangeEnd: "2026-08-31" };
+  const adapter = adapterFor("opencode");
+  const first = await adapter.collect({ dataPath: path }, range, {});
+  assert.equal(first.completeness, "complete");
+
+  const replacement = new DatabaseSync(path);
+  replacement
+    .prepare("DELETE FROM message WHERE id = ?")
+    .run("exact-message-id");
+  replacement
+    .prepare("INSERT INTO message (id, time_created, data) VALUES (?, ?, ?)")
+    .run(
+      "replacement-message-id",
+      Date.parse("2026-08-11T12:00:00Z"),
+      JSON.stringify({ role: "assistant", tokens: { input: 20, output: 5, total: 25 } }),
+    );
+  replacement.close();
+
+  const switched = await adapter.collect({ dataPath: path }, range, first.nextState);
+  assert.equal(switched.completeness, "complete");
+  assert.deepEqual(dailyTotals(switched), [
+    { date: "2026-08-10", totalTokens: "15" },
+    { date: "2026-08-11", totalTokens: "25" },
+  ]);
+  assert.doesNotMatch(JSON.stringify(switched.nextState), /exact-message-id|replacement-message-id/);
+});
