+test("a persisted source mapping switch retains the event ledger and counts new usage", async (context) => {
+  const oldSourceId = "64646464-6464-4464-8464-646464646464";
+  const newSourceId = "65656565-6565-4565-8565-656565656565";
+  const oldAccountId = "66666666-6666-4666-8666-666666666666";
+  const newAccountId = "67676767-6767-4767-8767-676767676767";
+  const clientSourceId = "68686868-6868-4868-8868-686868686868";
+  let remoteSourceId = oldSourceId;
+  const usageBodies = [];
+  const server = createServer((request, response) => {
+    const chunks = [];
+    request.on("data", (chunk) => chunks.push(chunk));
+    request.on("end", () => {
+      const body = chunks.length ? JSON.parse(Buffer.concat(chunks).toString("utf8")) : null;
+      response.setHeader("content-type", "application/json");
+      if (request.url === "/api/installations/current") {
+        response.end(JSON.stringify(reconciliationResponse([{ sourceId: remoteSourceId }])));
+        return;
+      }
+      if (request.url === "/api/usage") {
+        usageBodies.push(body);
+        response.end(JSON.stringify(usageResponse(body)));
+        return;
+      }
+      response.statusCode = 404;
+      response.end(JSON.stringify({ error: "not_found" }));
+    });
+  });
+  server.listen(0, "127.0.0.1");
+  await once(server, "listening");
+  context.after(() => server.close());
+  const address = server.address();
+  assert.equal(typeof address, "object");
+
+  const home = await mkdtemp(join(tmpdir(), "viberacing-account-switch-ledger-"));
+  context.after(() => rm(home, { recursive: true, force: true }));
+  const projects = join(home, ".claude", "projects");
+  const session = join(projects, "session.jsonl");
+  await mkdir(projects, { recursive: true });
+  const claudeLine = (id, date, input) =>
+    JSON.stringify({
+      type: "assistant",
+      timestamp: `${date}T12:00:00Z`,
+      message: { id, role: "assistant", usage: { input_tokens: input, output_tokens: 5 } },
+    });
+  await writeFile(session, `${claudeLine("account-one-event", "2026-09-20", 10)}\n`);
+  const origin = `http://127.0.0.1:${address.port}`;
+  const directory = await writeMappedInstallation(home, origin, [
+    {
+      clientSourceId,
+      sourceId: oldSourceId,
+      agentAccountId: oldAccountId,
+      agentId: "claude_code",
+      dataPath: projects,
+      collectionMethod: "claude_jsonl",
+      supportedSurface: "cli",
+      suggestedLabel: "Personal",
+      accountLabel: "Personal",
+    },
+  ]);
+  const environment = connectorEnvironment(home, { NODE_ENV: "test" });
+  await execFileAsync(process.execPath, [connectorPath, "sync"], { env: environment });
+  assert.equal(usageBodies.length, 1);
+
+  const configPath = join(directory, "config.json");
+  const config = JSON.parse(await readFile(configPath, "utf8"));
+  config.sources[0] = {
+    ...config.sources[0],
+    sourceId: newSourceId,
+    agentAccountId: newAccountId,
+    accountLabel: "Work",
+    lastAcceptedSyncSequence: "0",
+  };
+  await writeFile(configPath, `${JSON.stringify(config)}\n`);
+  remoteSourceId = newSourceId;
+  await writeFile(session, `${claudeLine("account-two-event", "2026-09-21", 20)}\n`);
+
+  await execFileAsync(process.execPath, [connectorPath, "sync"], { env: environment });
+  assert.equal(usageBodies.length, 2);
+  assert.deepEqual(
+    usageBodies[1].snapshots[0].entries.map(({ date, totalTokens }) => ({ date, totalTokens })),
+    [
+      { date: "2026-09-20", totalTokens: "15" },
+      { date: "2026-09-21", totalTokens: "25" },
+    ],
+  );
+  const state = JSON.parse(await readFile(join(directory, "state.json"), "utf8"));
+  assert.doesNotMatch(JSON.stringify(state), /account-one-event|account-two-event/);
+  assert.equal(JSON.parse(await readFile(configPath, "utf8")).sources[0].sourceId, newSourceId);
+});
