+test("conflicting event tuples retain the first value and still collect unrelated events", async (context) => {
+  const range = { rangeStart: "2026-08-01", rangeEnd: "2026-08-31" };
+  const cases = eventCollectorCases.filter((item) => item.conflicts !== false);
+
+  for (const item of cases) {
+    const directory = await mkdtemp(join(tmpdir(), `viberacing-conflict-${item.agentId}-`));
+    context.after(() => rm(directory, { force: true, recursive: true }));
+    const path = join(directory, item.name);
+    const source = {
+      dataPath: directory,
+      ...(item.collectionMethod === undefined ? {} : { collectionMethod: item.collectionMethod }),
+    };
+    const adapter = adapterFor(item.agentId);
+    const firstId = `provider-event-${item.agentId}-accepted`;
+    const unrelatedId = `provider-event-${item.agentId}-unrelated`;
+    await writeFile(path, `${JSON.stringify(item.record(firstId, "2026-08-10", 10))}\n`);
+    const first = await adapter.collect(source, range, {});
+    await writeFile(
+      path,
+      `${[
+        item.record(firstId, "2026-08-10", 99),
+        item.record(unrelatedId, "2026-08-11", 20),
+      ]
+        .map(JSON.stringify)
