+        ["2026-08-10", "10"],
+        ["2026-08-11", "20"],
+      ],
+      item.agentId,
+    );
+    assert.ok(
+      conflicted.warnings.length > 0 || conflicted.diagnostics.length > 0,
+      `${item.agentId} did not expose the partial result`,
+    );
+  }
