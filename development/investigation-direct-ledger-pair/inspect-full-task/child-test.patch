+test("event collectors retain usage across a file switch and migrate 0.4.3 state", async (context) => {
+  const range = { rangeStart: "2026-08-01", rangeEnd: "2026-08-31" };
+  const cases = eventCollectorCases;
+
+  for (const item of cases) {
+    const directory = await mkdtemp(join(tmpdir(), `viberacing-switch-${item.agentId}-`));
+    context.after(() => rm(directory, { force: true, recursive: true }));
+    const path = join(directory, item.name);
+    const source = {
+      dataPath: directory,
+      ...(item.collectionMethod === undefined ? {} : { collectionMethod: item.collectionMethod }),
+    };
+    const firstId = `provider-event-${item.agentId}-first`;
+    const secondId = `provider-event-${item.agentId}-second`;
+    await writeFile(
+      path,
+      `${JSON.stringify(item.record(firstId, "2026-08-10", 10))}\n`,
+    );
+    const adapter = adapterFor(item.agentId);
+    const first = await adapter.collect(source, range, {});
+    const legacyState =
+      item.agentId === "claude_code"
+        ? {
+            parserVersion: item.parserVersion,
+            files: first.nextState.files,
+            messages: first.nextState.messages,
+          }
+        : { parserVersion: item.parserVersion, files: first.nextState.files };
+
+    await writeFile(
+      path,
+      `${JSON.stringify(item.record(secondId, "2026-08-11", 20))}\n`,
+    );
+    const switched = await adapter.collect(source, range, legacyState);
+    assert.equal(switched.completeness, "complete", item.agentId);
+    assert.deepEqual(
+      switched.entries.map(({ date, totalTokens }) => [date, totalTokens]),
+      [
+        ["2026-08-10", "10"],
+        ["2026-08-11", "20"],
+      ],
+      item.agentId,
+    );
+    assert.doesNotMatch(JSON.stringify(switched.nextState), new RegExp(firstId));
+    assert.doesNotMatch(JSON.stringify(switched.nextState), new RegExp(secondId));
+
+    const copiedDirectory = join(directory, "copied");
+    await mkdir(copiedDirectory, { recursive: true });
+    const copiedPath = join(copiedDirectory, item.name);
+    await writeFile(
+      copiedPath,
+      `${JSON.stringify(item.record(firstId, "2026-08-10", 10))}\n`,
+    );
+    const copied = await adapter.collect(source, range, switched.nextState);
+    assert.equal(copied.completeness, "complete", `${item.agentId} copied`);
+    assert.deepEqual(
+      copied.entries.map(({ date, totalTokens }) => [date, totalTokens]),
+      [
+        ["2026-08-10", "10"],
+        ["2026-08-11", "20"],
+      ],
+      `${item.agentId} copied`,
+    );
+  }
+});
