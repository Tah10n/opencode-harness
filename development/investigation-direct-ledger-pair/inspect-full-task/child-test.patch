+test("OpenCode retains exact events across database replacement and fails closed on ID reuse", async (context) => {
+  const { DatabaseSync } = await import("node:sqlite");
+  const directory = await mkdtemp(join(tmpdir(), "viberacing-opencode-switch-"));
+  context.after(() => rm(directory, { force: true, recursive: true }));
+  const path = join(directory, "opencode.db");
+  const range = { rangeStart: "2026-08-01", rangeEnd: "2026-08-31" };
+  const row = (id, date, total) => ({
+    id,
+    time_created: Date.parse(`${date}T12:00:00Z`),
+    data: JSON.stringify({
+      role: "assistant",
+      time: { created: Date.parse(`${date}T12:00:00Z`) },
+      tokens: { input: total, output: 0, total },
+    }),
+  });
+  const writeDatabase = (rows) => {
+    const database = new DatabaseSync(path);
+    database.exec("CREATE TABLE message (id TEXT PRIMARY KEY, time_created INTEGER, data TEXT)");
+    const insert = database.prepare("INSERT INTO message (id, time_created, data) VALUES (?, ?, ?)");
+    for (const value of rows) insert.run(value.id, value.time_created, value.data);
+    database.close();
+  };
+  const source = { dataPath: path, collectionMethod: "opencode_sqlite" };
+  await writeDatabase([row("opencode-event-first", "2026-08-10", 10)]);
+  const adapter = adapterFor("opencode");
+  const first = await adapter.collect(source, range, {});
+
+  await rm(path);
+  writeDatabase([row("opencode-event-second", "2026-08-11", 20)]);
+  const switched = await adapter.collect(source, range, first.nextState);
+  assert.equal(switched.completeness, "complete");
+  assert.deepEqual(
+    switched.entries.map(({ date, totalTokens }) => [date, totalTokens]),
+    [
+      ["2026-08-10", "10"],
+      ["2026-08-11", "20"],
+    ],
+  );
+
+  await rm(path);
+  writeDatabase([
+    row("opencode-event-first", "2026-08-10", 99),
+    row("opencode-event-third", "2026-08-12", 30),
+  ]);
+  const conflicted = await adapter.collect(source, range, switched.nextState);
+  assert.equal(conflicted.completeness, "partial");
+  assert.deepEqual(
+    conflicted.entries.map(({ date, totalTokens }) => [date, totalTokens]),
+    [
+      ["2026-08-10", "10"],
+      ["2026-08-11", "20"],
+      ["2026-08-12", "30"],
+    ],
+  );
+  assert.doesNotMatch(JSON.stringify(conflicted.nextState), /opencode-event-(?:first|second|third)/);
+});
