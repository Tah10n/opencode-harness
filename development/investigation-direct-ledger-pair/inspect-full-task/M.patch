+export function observeEvent(ledger, id, entry) {
+  const key = eventIdentity(id);
+  const tuple = tupleForEntry(entry);
+  if (key === null || tuple === null) return { status: "invalid" };
+  const existing = ledger.events[key];
+  if (existing !== undefined)
+    return { status: JSON.stringify(existing) === JSON.stringify(tuple) ? "duplicate" : "conflict" };
+  const legacy = ledger.legacyEvents[key];
+  if (legacy !== undefined)
+    return { status: legacy.date === tuple.date ? "legacy" : "conflict" };
+  const candidate = { ...ledger, events: { ...ledger.events, [key]: tuple } };
+  if (
+    Object.keys(candidate.events).length + Object.keys(candidate.legacyEvents ?? {}).length >
+      maximumEventLedgerEntries ||
+    Buffer.byteLength(JSON.stringify(candidate)) > maximumEventLedgerBytes
+  )
+    return { status: "limit" };
+  ledger.events[key] = tuple;
+  return { status: "accepted" };
+}
