+describe('Denque.prototype.removeWhere', function () {
+  it('should visit original values and indexes and retain survivors in order', function () {
+    var seen = [];
+    var mixed = new Denque([1, 2, 3, 4, 5]);
+    var removed = mixed.removeWhere(function (value, index) {
+      seen.push([value, index]);
+      return value % 2 === 0;
+    });
+
+    assert.strictEqual(removed, 2);
+    assert.deepStrictEqual(seen, [[1, 0], [2, 1], [3, 2], [4, 3], [5, 4]]);
+    assert.deepStrictEqual(mixed.toArray(), [1, 3, 5]);
+
+    var none = new Denque([1, 2, 3]);
+    assert.strictEqual(none.removeWhere(function () { return false; }), 0);
+    assert.deepStrictEqual(none.toArray(), [1, 2, 3]);
+
+    var all = new Denque([1, 2, 3]);
+    assert.strictEqual(all.removeWhere(function () { return true; }), 3);
+    assert.deepStrictEqual(all.toArray(), []);
+  });
+
+  it('should leave the queue unchanged when the predicate throws', function () {
+    var values = [{ id: 1 }, { id: 2 }, { id: 3 }];
+    var queue = new Denque(values);
+    var error = new Error('stop');
+
+    assert.throws(function () {
+      queue.removeWhere(function (value, index) {
+        if (index === 0) return true;
+        if (index === 1) throw error;
+        return value.id === 3;
+      });
+    }, function (thrown) {
+      return thrown === error;
+    });
+
+    assert.strictEqual(queue.length, values.length);
+    for (var i = 0; i < values.length; i++) {
+      assert.strictEqual(queue.peekAt(i), values[i]);
+    }
+    assert.throws(function () {
+      new Denque().removeWhere(null);
+    }, Error);
+  });
+
+  it('should filter wrapped bounded queues without changing capacity', function () {
+    var marker = { value: 'marker' };
+    var queue = new Denque([], { capacity: 4 });
+    queue.push(0);
+    queue.push(false);
+    queue.push('');
+    queue.push(null);
+    queue.shift();
+    queue.shift();
+    queue.push(0);
+    queue.push(false);
+    queue.push(0);
+    queue.push(marker);
+
+    assert(queue._head > queue._tail);
+    var listLength = queue._list.length;
+    var capacityMask = queue._capacityMask;
+    assert.strictEqual(queue.removeWhere(function (value) { return value === 0; }), 2);
+    assert.deepStrictEqual(queue.toArray(), [false, marker]);
+    assert.strictEqual(queue.peekAt(1), marker);
+    assert.strictEqual(queue._list.length, listLength);
+    assert.strictEqual(queue._capacityMask, capacityMask);
+
+    queue.push(1);
+    assert.deepStrictEqual(queue.toArray(), [false, marker, 1]);
+  });
+});
