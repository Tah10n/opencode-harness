+/**
+ * Remove every item for which predicate returns a truthy value.
+ * The predicate is evaluated for all current items before the queue changes.
+ * @param {function} predicate
+ * @returns {number}
+ */
+Denque.prototype.removeWhere = function removeWhere(predicate) {
+  if (typeof predicate !== 'function') {
+    throw new Error('predicate must be a function');
+  }
+
+  var size = this.size();
+  if (size === 0) return 0;
+
+  var items = this._copyArray(false);
+  var matches = new Array(size);
+  var removed = 0;
+  var i;
+
+  for (i = 0; i < size; i++) {
+    matches[i] = predicate(items[i], i);
+    if (matches[i]) removed++;
+  }
+
+  if (removed === 0) return 0;
+
+  var head = this._head;
+  var survivors = size - removed;
+
+  for (i = 0; i < size; i++) {
+    this._list[(head + i) & this._capacityMask] = void 0;
+  }
+
+  var write = head;
+  for (i = 0; i < size; i++) {
+    if (!matches[i]) {
+      this._list[write] = items[i];
+      write = (write + 1) & this._capacityMask;
+    }
+  }
+
+  this._tail = (head + survivors) & this._capacityMask;
+  return removed;
+};
+
