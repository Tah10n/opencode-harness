+describe('Denque.prototype.removeWhere', function () {
+  it('should visit values in order with their original indexes', function () {
+    var queue = new Denque(['keep', 'remove', 'keep', 'remove']);
+    var seen = [];
+
+    assert.strictEqual(queue.removeWhere(function (value, index) {
+      seen.push([value, index]);
+      return value === 'remove';
+    }), 2);
+    assert.deepEqual(seen, [
+      ['keep', 0],
+      ['remove', 1],
+      ['keep', 2],
+      ['remove', 3]
+    ]);
+    assert.deepEqual(queue.toArray(), ['keep', 'keep']);
+
+    queue = new Denque([1, 2, 3]);
+    assert.strictEqual(queue.removeWhere(function () { return false; }), 0);
+    assert.deepEqual(queue.toArray(), [1, 2, 3]);
+
+    queue = new Denque([1, 2, 3]);
+    assert.strictEqual(queue.removeWhere(function () { return true; }), 3);
+    assert.deepEqual(queue.toArray(), []);
+  });
+
+  it('should leave the queue unchanged when the predicate throws', function () {
+    var first = { value: 1 };
+    var second = { value: 2 };
+    var third = { value: 3 };
+    var queue = new Denque([first, second, third]);
+    queue.shift();
+    queue.push(first);
+    var original = queue.toArray();
+    var error = new Error('stop');
+
+    assert.deepEqual(queue.toArray(), [second, third, first]);
+    assert.throws(function () {
+      queue.removeWhere(function (value, index) {
+        if (index === 0) return true;
+        throw error;
+      });
+    }, function (thrown) {
+      return thrown === error;
+    });
+    assert.strictEqual(queue.peekAt(0), original[0]);
+    assert.strictEqual(queue.peekAt(1), original[1]);
+    assert.strictEqual(queue.peekAt(2), original[2]);
+
+    assert.throws(function () {
+      new Denque().removeWhere(null);
+    }, Error);
+  });
+
+  it('should filter wrapped capacity queues without losing identity or capacity', function () {
+    var marker = { marker: true };
+    var queue = new Denque([0, marker, false, marker], { capacity: 4 });
+
+    queue.shift();
+    queue.push(0);
+    queue.shift();
+    queue.push(marker);
+    queue.shift();
+    queue.push(false);
+    queue.shift();
+    queue.push(marker);
+
+    assert.strictEqual(queue._head > queue._tail, true);
+    var internalCapacity = queue._list.length;
+    assert.deepEqual(queue.toArray(), [0, marker, false, marker]);
+    assert.strictEqual(queue.removeWhere(function (value) { return !value; }), 2);
+    assert.strictEqual(queue.peekAt(0), marker);
+    assert.strictEqual(queue.peekAt(1), marker);
+    assert.deepEqual(queue.toArray(), [marker, marker]);
+    assert.strictEqual(queue._list.length, internalCapacity);
+    assert.strictEqual(queue._capacity, 4);
+
+    queue.push('tail');
+    queue.unshift('head');
+    assert.deepEqual(queue.toArray(), ['head', marker, marker, 'tail']);
+    queue.push('overflow');
+    assert.deepEqual(queue.toArray(), [marker, marker, 'tail', 'overflow']);
+    assert.strictEqual(queue.length, 4);
+    assert.strictEqual(queue._list.length, internalCapacity);
+  });
+});
