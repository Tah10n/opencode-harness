+/**
+ * Remove every item for which predicate returns a truthy value.
+ * The predicate is evaluated against a snapshot before the queue is changed.
+ * @param {Function} predicate
+ * @returns {number}
+ */
+Denque.prototype.removeWhere = function removeWhere(predicate) {
+  if (typeof predicate !== 'function') {
+    throw new Error('predicate must be a function');
+  }
+
+  var values = this._copyArray(false);
+  var survivors = [];
+  var removed = 0;
+  var i;
+
+  for (i = 0; i < values.length; i++) {
+    if (predicate(values[i], i)) removed++;
+    else survivors.push(values[i]);
+  }
+
+  if (removed === 0) return 0;
+
+  var head = this._head;
+  for (i = 0; i < survivors.length; i++) {
+    this._list[(head + i) & this._capacityMask] = survivors[i];
+  }
+  for (; i < values.length; i++) {
+    this._list[(head + i) & this._capacityMask] = void 0;
+  }
+  this._tail = (head + survivors.length) & this._capacityMask;
+
+  return removed;
+};
