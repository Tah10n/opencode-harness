+test('.getOrInsertComputed() returns existing undefined values and refreshes old entries', t => {
+	const lru = new QuickLRU({maxSize: 2});
+	lru.set('old', undefined);
+	lru.set('other', 'value');
+	t.true(lru.__oldCache.has('old'));
+
+	let factoryCalls = 0;
+	t.is(lru.getOrInsertComputed('old', () => {
+		factoryCalls++;
+		return 'computed';
+	}), undefined);
+
+	t.is(factoryCalls, 0);
+	t.false(lru.__oldCache.has('old'));
+	t.true(lru.has('old'));
+
+	lru.set('new', 'value');
+	t.false(lru.has('other'));
+	t.true(lru.has('old'));
+});
+
+test('.getOrInsertComputed() replaces expired entries with the default TTL', async t => {
+	const evictions = [];
+	const lru = new QuickLRU({
+		maxSize: 1,
+		maxAge: 1000,
+		onEviction(key, value) {
+			evictions.push([key, value]);
+		},
+	});
+
+	lru.set('key', 'expired', {maxAge: 1});
+	await delay(20);
+	t.true(lru.__oldCache.has('key'));
+	t.true(lru.expiresIn('key') <= 0);
+
+	let factoryCalls = 0;
+	t.is(lru.getOrInsertComputed('key', key => {
+		factoryCalls++;
+		t.is(key, 'key');
+		return 'fresh';
+	}), 'fresh');
+
+	t.is(factoryCalls, 1);
+	t.deepEqual(evictions, [['key', 'expired']]);
+	const remaining = lru.expiresIn('key');
+	t.true(remaining > 500 && remaining <= 1000);
+	t.is(lru.get('key'), 'fresh');
+});
+
+test('.getOrInsertComputed() preserves factory errors and cache isolation', t => {
+	const key = {};
+	const otherKey = {};
+	const first = new QuickLRU({maxSize: 10});
+	const second = new QuickLRU({maxSize: 10});
+	const reason = new Error('factory failed');
+	let factoryCalls = 0;
+	t.false(first.has(key));
+	t.is(first.size, 0);
+
+	t.throws(() => {
+		first.getOrInsertComputed(key, receivedKey => {
+			factoryCalls++;
+			t.is(receivedKey, key);
+			throw reason;
+		});
+	}, {is: reason});
+
+	t.is(factoryCalls, 1);
+	t.false(first.has(key));
+	t.is(first.size, 0);
+	t.is(first.getOrInsertComputed(key, receivedKey => {
+		t.is(receivedKey, key);
+		return 'first';
+	}), 'first');
+	t.is(first.getOrInsertComputed(otherKey, () => 'other'), 'other');
+	t.is(second.getOrInsertComputed(key, () => 'second'), 'second');
+	t.is(first.get(key), 'first');
+	t.is(second.get(key), 'second');
+});
+
