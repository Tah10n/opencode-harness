+test("event ledgers survive source moves, account switches, and conflicting rewrites", async (context) => {
+  const directory = await mkdtemp(join(tmpdir(), "viberacing-event-ledger-"));
+  context.after(() => rm(directory, { force: true, recursive: true }));
+  const firstPath = join(directory, "first.jsonl");
+  const movedPath = join(directory, "moved.jsonl");
+  const range = { rangeStart: "2026-07-15", rangeEnd: "2026-08-14" };
+  const source = {
+    dataPath: firstPath,
+    sourceId: "11111111-1111-4111-8111-111111111111",
+    agentId: "antigravity",
+    collectionMethod: "antigravity_cli_capture",
+    agentAccountId: "22222222-2222-4222-8222-222222222222",
+  };
+  const record = (id, total) =>
+    JSON.stringify({
+      id,
+      date: "2026-08-10",
+      usage: {
+        date: "2026-08-10",
+        totalTokens: String(total),
+        inputTokens: String(total),
+        outputTokens: "0",
+        cacheReadTokens: "0",
+        cacheWriteTokens: "0",
+        reasoningTokens: "0",
+      },
+    });
+  await writeFile(firstPath, `${record("same-event", 10)}\n`);
+  const adapter = adapterFor("antigravity");
+  const first = await adapter.collect(source, range, {});
+  assert.equal(first.entries[0].totalTokens, "10");
+  assert.doesNotMatch(JSON.stringify(first.nextState.eventLedger), /same-event/);
+
+  await rename(firstPath, movedPath);
+  const switched = await adapter.collect(
+    { ...source, dataPath: movedPath, agentAccountId: "33333333-3333-4333-8333-333333333333" },
+    range,
+    first.nextState,
+  );
+  assert.equal(switched.entries[0].totalTokens, "20");
+
+  await writeFile(movedPath, `${record("same-event", 99)}\n${record("new-event", 5)}\n`);
+  const conflicting = await adapter.collect(
+    { ...source, dataPath: movedPath, agentAccountId: "33333333-3333-4333-8333-333333333333" },
+    range,
+    switched.nextState,
+  );
+  assert.equal(conflicting.completeness, "partial");
+  assert.deepEqual(conflicting.warnings, ["event_ledger_conflict"]);
+  assert.equal(conflicting.entries[0].totalTokens, "25");
+});
+
