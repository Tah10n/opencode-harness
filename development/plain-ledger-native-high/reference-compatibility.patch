diff --git a/packages/connector/test/antigravity-compatibility.test.mjs b/packages/connector/test/antigravity-compatibility.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..c901a1227a4935ac190941d99e8a89baa65f0746
--- /dev/null
+++ b/packages/connector/test/antigravity-compatibility.test.mjs
@@ -0,0 +1,85 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { createHash } from "node:crypto";
+import { mkdtemp, writeFile, stat, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { adapterFor, parseAntigravityLines } from "../lib/readers.mjs";
+
+const range = { rangeStart: "2026-07-15", rangeEnd: "2026-08-14" };
+const usage = { input_tokens: 10, output_tokens: 5, total_tokens: 15 };
+const reload = (state) => JSON.parse(JSON.stringify(state));
+const totals = (result) => result.entries.map(({ date, totalTokens }) => [date, totalTokens]);
+const adapter = adapterFor("antigravity");
+const cases = [
+  { id: "private-event", date: "2026-08-10", usage },
+  { id: "private-event", timestamp: "2026-08-10T12:00:00Z", usage },
+  { session_id: "private-event", date: "2026-08-10", usage },
+  { session_id: "private-event", time: "2026-08-10T12:00:00Z", result: { usage } },
+];
+
+for (const [index, record] of cases.entries()) {
+  test(`Antigravity parser-compatible shape ${index}: reload, alias replay, conflict and truncation`, async (t) => {
+    const root = await mkdtemp(join(tmpdir(), "antigravity-compat-"));
+    t.after(() => rm(root, { recursive: true, force: true }));
+    const file = join(root, "capture.jsonl");
+    const source = { dataPath: root };
+    await writeFile(file, `${JSON.stringify(record)}\n`);
+    let result = await adapter.collect(source, range, {});
+    assert.equal(result.completeness, "complete");
+    assert.deepEqual(result.entries, parseAntigravityLines([JSON.stringify(record)]));
+    assert.deepEqual(totals(result), [["2026-08-10", "15"]]);
+    result = await adapter.collect(source, range, reload(result.nextState));
+    assert.deepEqual(totals(result), [["2026-08-10", "15"]]);
+    const canonical = { id: "private-event", date: "2026-08-10", usage };
+    const fresh = { id: "private-new", date: "2026-08-11", usage: { input_tokens: 4, output_tokens: 3 } };
+    await writeFile(file, [canonical, fresh].map(JSON.stringify).join("\n") + "\n");
+    result = await adapter.collect(source, range, reload(result.nextState));
+    assert.deepEqual(totals(result), [["2026-08-10", "15"], ["2026-08-11", "7"]]);
+    canonical.usage = { input_tokens: 100, output_tokens: 50 };
+    await writeFile(file, JSON.stringify(canonical) + "\n");
+    result = await adapter.collect(source, range, reload(result.nextState));
+    assert.equal(result.completeness, "partial");
+    assert.ok(result.diagnostics.some(({ code }) => code === "local_event_identity_conflict"));
+    assert.deepEqual(totals(result), [["2026-08-10", "15"], ["2026-08-11", "7"]]);
+    assert.doesNotMatch(JSON.stringify(result.nextState), /private-event|private-new/);
+  });
+}
+
+test("Antigravity rereads pre-fix checkpoints while retaining accepted tuples and conflicts", async (t) => {
+  const root = await mkdtemp(join(tmpdir(), "antigravity-checkpoint-"));
+  t.after(() => rm(root, { recursive: true, force: true }));
+  const file = join(root, "capture.jsonl");
+  const contents = cases.slice(0, 2).map((record, index) => JSON.stringify({ ...record, id: index ? "private-missed" : "private-accepted" })).join("\n") + "\n";
+  await writeFile(file, contents);
+  const info = await stat(file);
+  // Serialized version-2 input: first canonical event accepted; timestamp-only
+  // event skipped; file checkpoint nevertheless advanced to EOF by the old code.
+  const hash = (value) => createHash("sha256").update(value).digest("hex");
+  const old = {
+    parserVersion: 2,
+    files: { [file]: { size: info.size, modifiedAt: info.mtimeMs, ino: info.ino,
+      safeOffset: info.size, tailFingerprint: hash(Buffer.from(contents).subarray(-256)), lineCount: 2 } },
+    ledger: { [hash("private-accepted")]: { date: "2026-08-10", parserVersion: 2,
+      usage: { totalTokens: "15", inputTokens: "10", outputTokens: "5", cacheReadTokens: "0", cacheWriteTokens: "0", reasoningTokens: "0" } } },
+    legacyBaseline: [], legacyEventDays: {},
+  };
+  let result = await adapter.collect({ dataPath: root }, range, reload(old));
+  assert.deepEqual(totals(result), [["2026-08-10", "30"]]);
+  result = await adapter.collect({ dataPath: root }, range, reload(result.nextState));
+  assert.deepEqual(totals(result), [["2026-08-10", "30"]]);
+  await writeFile(file, JSON.stringify({ id: "private-accepted", date: "2026-08-10", usage: { input_tokens: 100, output_tokens: 50 } }) + "\n");
+  result = await adapter.collect({ dataPath: root }, range, reload(result.nextState));
+  assert.equal(result.completeness, "partial");
+  assert.deepEqual(totals(result), [["2026-08-10", "30"]]);
+});
+
+test("Antigravity still reports malformed identity as partial", async (t) => {
+  const root = await mkdtemp(join(tmpdir(), "antigravity-invalid-"));
+  t.after(() => rm(root, { recursive: true, force: true }));
+  await writeFile(join(root, "capture.jsonl"), JSON.stringify({ id: "", session_id: "fallback-must-not-override", date: "2026-08-10", usage }) + "\n");
+  const result = await adapter.collect({ dataPath: root }, range, {});
+  assert.equal(result.completeness, "partial");
+  assert.deepEqual(result.entries, []);
+  assert.ok(result.diagnostics.some(({ code }) => code === "local_store_schema_unsupported"));
+});
