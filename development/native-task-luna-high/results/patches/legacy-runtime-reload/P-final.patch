+async function snapshotTree(directory, prefix = "") {
+  const snapshot = [];
+  for (const entry of await readdir(directory, { withFileTypes: true })) {
+    const path = join(directory, entry.name);
+    const relativePath = `${prefix}${entry.name}`;
+    const info = await lstat(path);
+    if (info.isSymbolicLink()) snapshot.push([relativePath, "symlink", await readlink(path)]);
+    else if (info.isDirectory())
+      snapshot.push(...(await snapshotTree(path, `${relativePath}/`)));
+    else snapshot.push([relativePath, "file", (await readFile(path)).toString("base64")]);
+  }
+  return snapshot.sort(([left], [right]) => left.localeCompare(right));
+}
