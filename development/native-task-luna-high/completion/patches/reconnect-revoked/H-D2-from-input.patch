+test("connect recovers an account-deleted installation without an abandoned pairing", async (context) => {
+  const installationId = "91919191-9191-4919-8919-919191919191";
+  const clientSourceId = "92929292-9292-4929-8929-929292929292";
+  const sourceId = "93939393-9393-4939-8939-939393939393";
+  const mapping = {
+    clientSourceId,
+    sourceId,
+    agentAccountId: "94949494-9494-4949-8949-949494949494",
+    agentId: "antigravity",
+    accountLabel: "Recovered",
+    collectionMethod: "antigravity_cli_capture",
+    lastAcceptedSyncSequence: "0",
+  };
+  let reconciliationRequests = 0;
+  let pairingStarts = 0;
+  let pairingCancellations = 0;
+  const server = createServer((request, response) => {
+    const chunks = [];
+    request.on("data", (chunk) => chunks.push(chunk));
+    request.on("end", () => {
+      const body = chunks.length ? JSON.parse(Buffer.concat(chunks).toString("utf8")) : null;
+      response.setHeader("content-type", "application/json");
+      if (request.url === "/api/installations/current") {
+        reconciliationRequests += 1;
+        response.statusCode = 403;
+        response.end("{account deleted");
+        return;
+      }
+      if (request.url === "/api/pairing/cancel") {
+        pairingCancellations += 1;
+        response.statusCode = 204;
+        response.removeHeader("content-type");
+        response.end();
+        return;
+      }
+      if (request.url === "/api/pairing/start") {
+        pairingStarts += 1;
+        response.statusCode = 201;
+        response.end(
+          JSON.stringify({
+            installationId,
+            code: "ABCDEFGH",
+            pollToken: "account_deleted_pairing_poll_token_long_enough",
+            verificationUrl: `http://${request.headers.host}/connect?code=ABCDEFGH`,
+            expiresInSeconds: 30,
+          }),
+        );
+        return;
+      }
+      if (request.url === "/api/pairing/poll") {
+        response.end(
+          JSON.stringify({
+            status: "active",
+            deviceToken: "account_deleted_recovery_device_token_long_enough",
+            protocol: {
+              version: 2,
+              snapshotDays: 31,
+              maximumSources: 32,
+              maximumEntries: 1_024,
+            },
+            sources: [mapping],
+          }),
+        );
+        return;
+      }
+      response.end(JSON.stringify(usageResponse(body)));
+    });
+  });
+  server.listen(0, "127.0.0.1");
+  await once(server, "listening");
+  context.after(() => server.close());
+  const address = server.address();
+  assert.notEqual(address, null);
+  assert.equal(typeof address, "object");
+  const origin = `http://127.0.0.1:${address.port}`;
+  const home = await mkdtemp(join(tmpdir(), "viberacing-account-deleted-reconnect-"));
+  context.after(() => rm(home, { recursive: true }));
+  const installation = await writeCaptureInstallation(home, origin, {
+    installationId,
+    clientSourceId,
+    sourceId,
+  });
+  const directory = installation.directory;
+  await writeFile(
+    join(directory, "installation.json"),
+    `${JSON.stringify({
+      version: 1,
+      id: installationId,
+      secret: "account_deleted_installation_secret_long_enough",
+    })}\n`,
+  );
+  const sourcesBefore = await readLocalSources(directory);
+  await mkdir(join(directory, "pending"), { recursive: true });
+  await writeFile(join(directory, "pending", `${sourceId}.json`), "{}\n");
+  await writeFile(
+    join(directory, "dirty.json"),
+    `${JSON.stringify({
+      version: 2,
+      sources: {
+        [clientSourceId]: {
+          dirtySince: new Date().toISOString(),
+          lastEventAt: new Date().toISOString(),
+          generation: "95959595-9595-4959-8959-959595959595",
+        },
+      },
+    })}\n`,
+  );
+  const environment = connectorEnvironment(home, {
+    NODE_ENV: "test",
+    PATH: "",
+    VIBERACING_TEST_PAIRING_POLL_INTERVAL_MS: "10",
+  });
+
+  const result = await execFileAsync(
+    process.execPath,
+    [connectorPath, "connect", "--origin", origin],
+    { env: environment },
+  );
+  assert.equal(reconciliationRequests, 1);
+  assert.equal(pairingStarts, 1);
+  assert.equal(pairingCancellations, 0);
+  assert.equal(
+    JSON.parse(await readFile(join(directory, "installation.json"), "utf8")).id,
+    installationId,
+  );
+  const connected = JSON.parse(await readFile(join(directory, "config.json"), "utf8"));
+  assert.equal(connected.deviceToken, "account_deleted_recovery_device_token_long_enough");
+  assert.deepEqual(connected.sources.map((source) => source.sourceId), [sourceId]);
+  assert.deepEqual(await readLocalSources(directory), sourcesBefore);
+  await assert.rejects(access(join(directory, "connect-attempt.json")));
+  await assert.rejects(access(join(directory, "pending", `${sourceId}.json`)));
+  await assert.rejects(access(join(directory, "dirty.json")));
+  assert.match(result.stdout, /Connected\. Exact aggregate sync is active\./);
+});
