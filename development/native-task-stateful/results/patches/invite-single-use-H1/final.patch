 import {test} from 'node:test';import assert from 'node:assert/strict';import {ledger} from '../src/ledger.mjs';import {accept} from '../src/route.mjs';
 test('join, remove pending invitation, missing token',()=>{const b=ledger([{token:'t',team:'red',email:'a@b',expiresAt:50}]);assert.deepEqual(accept(b,{token:'t'},()=>1),{status:'joined',team:'red'});assert.deepEqual(b.members(),[{team:'red',email:'a@b'}]);const selected=b.list().filter(x=>x.token==='t');for(const x of selected)b.remove(x.token);assert.equal(b.peek('t'),undefined);assert.deepEqual(accept(b,{token:'unknown'},()=>1),{status:'missing'});});
+
+test('a valid invitation is single-use and preserves unrelated invitations', () => {
+  const b = ledger([
+    {token: 't', team: 'red', email: 'a@b', expiresAt: 50},
+    {token: 'other', team: 'blue', email: 'c@d', expiresAt: 50},
+  ]);
+  let clockCalls = 0;
+  const clock = () => {
+    clockCalls++;
+    return 1;
+  };
+
+  assert.deepEqual(b.peek('t'), {token: 't', team: 'red', email: 'a@b', expiresAt: 50});
+  assert.deepEqual(accept(b, {token: 't'}, clock), {status: 'joined', team: 'red'});
+  assert.equal(clockCalls, 1);
+  assert.equal(b.peek('t'), undefined);
+  assert.deepEqual(b.list(), [{token: 'other', team: 'blue', email: 'c@d', expiresAt: 50}]);
+  assert.deepEqual(b.members(), [{team: 'red', email: 'a@b'}]);
+
+  assert.equal(b.peek('t'), undefined);
+  assert.deepEqual(accept(b, {token: 't'}, clock), {status: 'missing'});
+  assert.equal(clockCalls, 2);
+  assert.deepEqual(b.list(), [{token: 'other', team: 'blue', email: 'c@d', expiresAt: 50}]);
+  assert.deepEqual(b.members(), [{team: 'red', email: 'a@b'}]);
+});
+
+test('expired invitations at the equality and past boundaries are retained', () => {
+  for (const expiresAt of [10, 9]) {
+    const b = ledger([{token: 't', team: 'red', email: 'a@b', expiresAt}]);
+    let clockCalls = 0;
+    const clock = () => {
+      clockCalls++;
+      return 10;
+    };
+
+    assert.deepEqual(b.peek('t'), {token: 't', team: 'red', email: 'a@b', expiresAt});
+    assert.deepEqual(accept(b, {token: 't'}, clock), {status: 'expired'});
+    assert.equal(clockCalls, 1);
+    assert.deepEqual(b.peek('t'), {token: 't', team: 'red', email: 'a@b', expiresAt});
+    assert.deepEqual(b.members(), []);
+  }
+});
+
+test('missing and independently removed invitations are no-ops', () => {
+  const b = ledger([{token: 't', team: 'red', email: 'a@b', expiresAt: 50}]);
+  b.remove('t');
+  assert.equal(b.peek('t'), undefined);
+  let clockCalls = 0;
+  const clock = () => {
+    clockCalls++;
+    return 1;
+  };
+  assert.deepEqual(accept(b, {token: 't'}, clock), {status: 'missing'});
+  assert.equal(clockCalls, 1);
+  assert.deepEqual(b.members(), []);
+  assert.deepEqual(accept(b, {token: 'unknown'}, clock), {status: 'missing'});
+  assert.equal(clockCalls, 2);
+  assert.deepEqual(b.members(), []);
+});
