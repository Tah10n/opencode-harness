 # invite-single-use
-A small Node library. Run npm test.
+
+A small Node library for accepting team invitations. Run `npm test`.
+
+`accept(book, request, clock)` accepts an invitation at most once. A valid
+invitation is removed from pending and returns `{status: 'joined', team}`. An
+invitation whose `expiresAt` is equal to or earlier than the clock value returns
+`{status: 'expired'}` and remains pending. Replayed or missing tokens return
+`{status: 'missing'}` without adding a member.
diff --git a/src/redeem.mjs b/src/redeem.mjs
index 56534c7..a0ed440 100644
--- a/src/redeem.mjs
+++ b/src/redeem.mjs
@@ -1 +1,8 @@
-export function redeem(book,token,now){const invite=book.peek(token);if(!invite)return {status:'missing'};book.join(invite.team,invite.email);return {status:'joined',team:invite.team};}
+export function redeem(book, token, now) {
+  const invite = book.peek(token);
+  if (!invite) return {status: 'missing'};
+  if (invite.expiresAt <= now) return {status: 'expired'};
+  book.remove(token);
+  book.join(invite.team, invite.email);
+  return {status: 'joined', team: invite.team};
+}
diff --git a/test/invite.test.mjs b/test/invite.test.mjs
index 8d641a2..683d8c9 100644
