-test('success, retry and idle',()=>{
+
+test('processes a mixed batch in FIFO order and preserves payloads',()=>{
+ const jobs=[{id:'a',payload:{value:1}},{id:'b',payload:{value:2}},{id:'c',payload:{value:3}},{id:'d',payload:{value:4}}];
+ const q=queue(jobs),received=[];
+ const result=work(q,job=>{received.push(job);return job.id!=='b';},3);
+ assert.deepEqual(received,jobs.slice(0,3));
+ assert.deepEqual(result,{sent:['a','c'],retried:['b']});
+ assert.deepEqual(q.snapshot(),{ready:[jobs[3],jobs[1]],leased:[]});
+});
+
+test('retries each initially ready job at most once when all jobs fail',()=>{
+ const jobs=[{id:'a',payload:1},{id:'b',payload:2}],q=queue(jobs),received=[];
+ const result=work(q,job=>{received.push(job.id);return false;},5);
+ assert.deepEqual(received,['a','b']);
+ assert.deepEqual(result,{sent:[],retried:['a','b']});
+ assert.deepEqual(q.snapshot(),{ready:jobs,leased:[]});
