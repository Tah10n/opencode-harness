 # queue-batch
-A small Node library. Run npm test.
+A small Node library. Run `npm test`.
+
+`work(q, send, limit = 1)` processes up to `limit` jobs that are ready when
+the call starts, in FIFO order. `limit` must be a nonnegative safe integer.
+Successful jobs are acknowledged; failed jobs are retried once at the ready
+queue's tail and are not processed again during the same call. It returns
+`{sent, retried}`, with IDs in processing order. A zero limit or an empty queue
+does nothing.
diff --git a/src/worker.mjs b/src/worker.mjs
index 92d2351..9bf79e5 100644
--- a/src/worker.mjs
+++ b/src/worker.mjs
@@ -1,5 +1,10 @@
-export function work(q, send) {
- const job=q.take();if(!job)return {sent:[],retried:[]};
- const ok=send(job);if(ok)q.ack(job.id);else q.retry(job.id);
- return {sent:ok?[job.id]:[],retried:ok?[]:[job.id]};
+export function work(q, send, limit=1) {
+ if(!Number.isSafeInteger(limit)||limit<0)throw new RangeError('limit must be a nonnegative safe integer');
+ const count=Math.min(limit,q.snapshot().ready.length),sent=[],retried=[];
+ for(let i=0;i<count;i++){
+  const job=q.take();
+  const ok=send(job);
+  if(ok){q.ack(job.id);sent.push(job.id);}else{q.retry(job.id);retried.push(job.id);}
+ }
+ return {sent,retried};
 }
