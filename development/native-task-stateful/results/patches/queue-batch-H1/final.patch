+  let sends=0;
+  assert.throws(()=>work(q,()=>{sends++;return true;},limit),RangeError);
+  assert.equal(sends,0);
+  assert.deepEqual(q.snapshot(),before);
+ }
+});
+
+test('zero limit is a no-op',()=>{
