 import {test} from 'node:test';import assert from 'node:assert/strict';import {ledger} from '../src/ledger.mjs';import {accept} from '../src/route.mjs';
 test('join, remove pending invitation, missing token',()=>{const b=ledger([{token:'t',team:'red',email:'a@b',expiresAt:50}]);assert.deepEqual(accept(b,{token:'t'},()=>1),{status:'joined',team:'red'});assert.deepEqual(b.members(),[{team:'red',email:'a@b'}]);const selected=b.list().filter(x=>x.token==='t');for(const x of selected)b.remove(x.token);assert.equal(b.peek('t'),undefined);assert.deepEqual(accept(b,{token:'unknown'},()=>1),{status:'missing'});});
+
+test('a valid invitation is consumed and replay is missing',()=>{const b=ledger([{token:'one',team:'red',email:'one@example.test',expiresAt:20},{token:'two',team:'blue',email:'two@example.test',expiresAt:20}]);let calls=0;const clock=()=>{calls+=1;return 10;};assert.deepEqual(accept(b,{token:'one'},clock),{status:'joined',team:'red'});assert.equal(calls,1);assert.deepEqual(b.members(),[{team:'red',email:'one@example.test'}]);assert.equal(b.peek('one'),undefined);assert.deepEqual(b.peek('two'),{token:'two',team:'blue',email:'two@example.test',expiresAt:20});assert.deepEqual(accept(b,{token:'one'},clock),{status:'missing'});assert.equal(calls,2);assert.deepEqual(b.members(),[{team:'red',email:'one@example.test'}]);assert.deepEqual(b.peek('two'),{token:'two',team:'blue',email:'two@example.test',expiresAt:20});});
+
+test('an invitation at its expiration time remains pending and does not join',()=>{const b=ledger([{token:'equal',team:'red',email:'equal@example.test',expiresAt:10}]);let calls=0;assert.deepEqual(accept(b,{token:'equal'},()=>{calls+=1;return 10;}),{status:'expired'});assert.equal(calls,1);assert.deepEqual(b.peek('equal'),{token:'equal',team:'red',email:'equal@example.test',expiresAt:10});assert.deepEqual(b.members(),[]);});
+
+test('an invitation past its expiration remains pending and does not join',()=>{const b=ledger([{token:'past',team:'red',email:'past@example.test',expiresAt:9}]);assert.deepEqual(accept(b,{token:'past'},()=>10),{status:'expired'});assert.deepEqual(b.peek('past'),{token:'past',team:'red',email:'past@example.test',expiresAt:9});assert.deepEqual(b.members(),[]);});
+
+test('a missing invitation is a no-op and evaluates the clock once',()=>{const b=ledger([]);let calls=0;assert.deepEqual(accept(b,{token:'missing'},()=>{calls+=1;return 10;}),{status:'missing'});assert.equal(calls,1);assert.deepEqual(b.list(),[]);assert.deepEqual(b.members(),[]);});
+
+test('a separately removed invitation remains missing',()=>{const b=ledger([{token:'removed',team:'red',email:'removed@example.test',expiresAt:20}]);assert.equal(b.remove('removed'),true);assert.equal(b.peek('removed'),undefined);assert.deepEqual(accept(b,{token:'removed'},()=>10),{status:'missing'});assert.deepEqual(b.members(),[]);});
