 # editor-cancel
-A small Node library. Run npm test.
+A small Node library for staging and publishing drafts. Run `npm test`.
+
+Use `apply(store, actions)` to execute an ordered batch of publish and cancel
+actions:
+
+```js
+apply(store, [
+ {type: 'publish', id: 'article'},
+ {type: 'cancel', id: 'article-draft'}
+]);
+```
+
+Every action must have type `publish` or `cancel` and a nonempty string `id`.
+The complete batch is validated before any action runs, and the result is an
+array of booleans from the store operations. Cancel removes only the staged
+revision, so an existing published revision and unrelated staged drafts stay
+intact. Canceling an absent revision returns `false`; an empty batch returns
+`[]`.
diff --git a/src/editor.mjs b/src/editor.mjs
index 83e0918f062770be66c465b4ea6c16593d3d4ee7..d19e14e26d4717024df4787a761c14ad91b2785f 100644
--- a/src/editor.mjs
+++ b/src/editor.mjs
@@ -1,3 +1,13 @@
 export function apply(store, actions) {
- return actions.map(a=>a.type==='publish'?store.publish(a.id):false);
+ if (!Array.isArray(actions)) throw new TypeError('actions must be an array');
+ for (const action of actions) {
+  if (action === null || typeof action !== 'object' ||
+      (action.type !== 'publish' && action.type !== 'cancel') ||
+      typeof action.id !== 'string' || action.id.length === 0) {
+   throw new TypeError('each action must have a valid type and id');
+  }
+ }
+ return actions.map(action => action.type === 'publish'
+  ? store.publish(action.id)
+  : store.cancel(action.id));
 }
