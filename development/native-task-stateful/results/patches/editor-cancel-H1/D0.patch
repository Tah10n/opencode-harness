+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {drafts} from '../src/drafts.mjs';
+import {apply} from '../src/editor.mjs';
+
+test('preserves publish semantics and no-work cases', () => {
+ const s = drafts();
+ assert.deepEqual(apply(s, []), []);
+ assert.deepEqual(apply(s, [{type: 'publish', id: 'missing'}]), [false]);
+ s.stage('x', 'draft');
+ assert.deepEqual(apply(s, [{type: 'publish', id: 'x'}]), [true]);
+ assert.deepEqual(apply(s, [{type: 'cancel', id: 'x'}]), [false]);
+ assert.deepEqual(s.read(), {staged: {}, published: {x: 'draft'}});
+});
+
+test('cancels an existing staged replacement without removing its publication', () => {
+ const s = drafts();
+ s.stage('x', 'original');
+ assert.deepEqual(s.read(), {staged: {x: 'original'}, published: {}});
+ assert.deepEqual(apply(s, [{type: 'publish', id: 'x'}]), [true]);
+ s.stage('x', 'replacement');
+ assert.deepEqual(s.read(), {staged: {x: 'replacement'}, published: {x: 'original'}});
+
+ assert.deepEqual(apply(s, [{type: 'cancel', id: 'x'}]), [true]);
+ assert.deepEqual(s.read(), {staged: {}, published: {x: 'original'}});
+});
+
+test('preserves unrelated staged drafts when canceling a published id', () => {
+ const s = drafts();
+ s.stage('published', 'first');
+ s.stage('unrelated', 'keep');
+ assert.deepEqual(s.read(), {
+  staged: {published: 'first', unrelated: 'keep'},
+  published: {}
+ });
+ assert.deepEqual(apply(s, [{type: 'publish', id: 'published'}]), [true]);
+ s.stage('published', 'replacement');
+ assert.deepEqual(s.read(), {
+  staged: {unrelated: 'keep', published: 'replacement'},
+  published: {published: 'first'}
+ });
+
+ assert.deepEqual(apply(s, [{type: 'cancel', id: 'published'}]), [true]);
+ assert.deepEqual(s.read(), {
+  staged: {unrelated: 'keep'},
+  published: {published: 'first'}
+ });
+});
+
+test('repeated and missing cancellation return false', () => {
+ const s = drafts();
+ s.stage('x', 'draft');
+ assert.deepEqual(s.read(), {staged: {x: 'draft'}, published: {}});
+ assert.deepEqual(apply(s, [{type: 'cancel', id: 'x'}]), [true]);
+ assert.deepEqual(s.read(), {staged: {}, published: {}});
+ assert.deepEqual(apply(s, [{type: 'cancel', id: 'x'}]), [false]);
+ assert.deepEqual(apply(s, [{type: 'cancel', id: 'missing'}]), [false]);
+ assert.deepEqual(s.read(), {staged: {}, published: {}});
+});
+
+test('executes mixed actions in input order and supports an empty batch', () => {
+ const s = drafts();
+ s.stage('published', 'publish me');
+ s.stage('cancelled', 'cancel me');
+ assert.deepEqual(s.read(), {
+  staged: {published: 'publish me', cancelled: 'cancel me'},
+  published: {}
+ });
+ assert.deepEqual(apply(s, []), []);
+ assert.deepEqual(s.read(), {
+  staged: {published: 'publish me', cancelled: 'cancel me'},
+  published: {}
+ });
+
+ assert.deepEqual(apply(s, [
+  {type: 'publish', id: 'published'},
+  {type: 'cancel', id: 'cancelled'},
+  {type: 'cancel', id: 'published'}
+ ]), [true, true, false]);
+ assert.deepEqual(s.read(), {
+  staged: {},
+  published: {published: 'publish me'}
+ });
+});
+
+test('rejects an invalid later action without mutating earlier valid actions', () => {
+ const s = drafts();
+ s.stage('first', 'first draft');
+ s.stage('second', 'second draft');
+ assert.deepEqual(s.read(), {
+  staged: {first: 'first draft', second: 'second draft'},
+  published: {}
+ });
+
+ assert.throws(
+  () => apply(s, [
+   {type: 'publish', id: 'first'},
+   {type: 'archive', id: 'second'}
+  ]),
+  TypeError
+ );
+ assert.deepEqual(s.read(), {
+  staged: {first: 'first draft', second: 'second draft'},
+  published: {}
+ });
+});
