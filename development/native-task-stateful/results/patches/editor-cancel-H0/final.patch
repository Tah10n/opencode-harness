 export function apply(store, actions) {
- return actions.map(a=>a.type==='publish'?store.publish(a.id):false);
+ if (!Array.isArray(actions)) throw new TypeError('actions must be an array');
+ for (const action of actions) {
+  if (action === null || typeof action !== 'object' ||
+      (action.type !== 'publish' && action.type !== 'cancel') ||
+      typeof action.id !== 'string' || action.id.length === 0) {
+   throw new TypeError('invalid action');
+  }
+ }
+ return actions.map(action =>
+  action.type === 'publish' ? store.publish(action.id) : store.cancel(action.id)
+ );
 }
