 import {test} from 'node:test';import assert from 'node:assert/strict';import {drafts} from '../src/drafts.mjs';import {apply} from '../src/editor.mjs';
-test('publish, cancel, absent',()=>{const s=drafts();s.stage('x','draft');assert.deepEqual(apply(s,[{type:'publish',id:'x'}]),[true]);assert.deepEqual(s.read().published,{x:'draft'});const selected=Object.keys(s.read().staged).filter(id=>id==='x');for(const id of selected)s.cancel(id);assert.deepEqual(s.read().staged,{});assert.equal(s.cancel('missing'),false);});
+
+test('cancel removes a staged replacement without removing its published revision or unrelated drafts',()=>{
+ const s=drafts();
+ s.stage('x','first');
+ assert.deepEqual(apply(s,[{type:'publish',id:'x'}]),[true]);
+ s.stage('x','replacement');
+ s.stage('other','draft');
+ assert.deepEqual(apply(s,[{type:'cancel',id:'x'}]),[true]);
+ assert.deepEqual(s.read(),{staged:{other:'draft'},published:{x:'first'}});
+});
+
+test('repeated and missing cancellation return false',()=>{
+ const s=drafts();
+ s.stage('x','draft');
+ assert.deepEqual(apply(s,[{type:'cancel',id:'x'},{type:'cancel',id:'x'},{type:'cancel',id:'missing'}]),[true,false,false]);
+ assert.deepEqual(s.read(),{staged:{},published:{}});
+});
+
+test('mixed actions execute in input order and return store results',()=>{
+ const s=drafts();
+ s.stage('publish-me','one');
+ s.stage('cancel-me','two');
+ assert.deepEqual(apply(s,[{type:'publish',id:'publish-me'},{type:'cancel',id:'cancel-me'},{type:'publish',id:'cancel-me'}]),[true,true,false]);
+ assert.deepEqual(s.read(),{staged:{},published:{'publish-me':'one'}});
+});
+
+test('invalid actions are rejected before any action mutates the store',()=>{
+ const s=drafts();
+ s.stage('x','draft');
+ s.stage('other','keep');
+ assert.throws(()=>apply(s,[{type:'publish',id:'x'},{type:'cancel',id:''}]),TypeError);
+ assert.deepEqual(s.read(),{staged:{x:'draft',other:'keep'},published:{}});
+ assert.throws(()=>apply(s,[{type:'publish',id:'x'},{type:'archive',id:'other'}]),TypeError);
+ assert.deepEqual(s.read(),{staged:{x:'draft',other:'keep'},published:{}});
+});
+
+test('empty batches and absent publishes do no work',()=>{
+ const s=drafts();
+ assert.deepEqual(apply(s,[]),[]);
+ assert.deepEqual(apply(s,[{type:'publish',id:'missing'}]),[false]);
+ assert.deepEqual(s.read(),{staged:{},published:{}});
+});
