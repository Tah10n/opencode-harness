 import {test} from 'node:test';import assert from 'node:assert/strict';import {ledger} from '../src/ledger.mjs';import {accept} from '../src/route.mjs';
 test('join, remove pending invitation, missing token',()=>{const b=ledger([{token:'t',team:'red',email:'a@b',expiresAt:50}]);assert.deepEqual(accept(b,{token:'t'},()=>1),{status:'joined',team:'red'});assert.deepEqual(b.members(),[{team:'red',email:'a@b'}]);const selected=b.list().filter(x=>x.token==='t');for(const x of selected)b.remove(x.token);assert.equal(b.peek('t'),undefined);assert.deepEqual(accept(b,{token:'unknown'},()=>1),{status:'missing'});});
+
+test('a valid invitation is single-use and preserves unrelated invitations',()=>{let calls=0;const b=ledger([{token:'used',team:'red',email:'a@b',expiresAt:10},{token:'other',team:'blue',email:'c@d',expiresAt:10}]);const clock=()=>{calls++;return 1;};assert.deepEqual(accept(b,{token:'used'},clock),{status:'joined',team:'red'});assert.equal(calls,1);assert.deepEqual(accept(b,{token:'used'},clock),{status:'missing'});assert.equal(calls,2);assert.deepEqual(b.members(),[{team:'red',email:'a@b'}]);assert.deepEqual(b.list(),[{token:'other',team:'blue',email:'c@d',expiresAt:10}]);});
+
+test('an invitation expires at its expiration time or later',()=>{for(const now of [10,11]){const b=ledger([{token:'t',team:'red',email:'a@b',expiresAt:10}]);assert.deepEqual(accept(b,{token:'t'},()=>now),{status:'expired'});assert.deepEqual(b.list(),[{token:'t',team:'red',email:'a@b',expiresAt:10}]);assert.deepEqual(b.members(),[]);}});
+
+test('manual removal and missing acceptance remain no-ops',()=>{const b=ledger([{token:'t',team:'red',email:'a@b',expiresAt:50}]);assert.equal(b.remove('t'),true);assert.deepEqual(accept(b,{token:'t'},()=>1),{status:'missing'});assert.deepEqual(accept(b,{token:'unknown'},()=>1),{status:'missing'});assert.deepEqual(b.members(),[]);});
