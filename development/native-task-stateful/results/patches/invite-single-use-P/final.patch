@@ -1 +1 @@
-export function redeem(book,token,now){const invite=book.peek(token);if(!invite)return {status:'missing'};book.join(invite.team,invite.email);return {status:'joined',team:invite.team};}
+export function redeem(book,token,now){const invite=book.peek(token);if(!invite)return {status:'missing'};if(invite.expiresAt<=now)return {status:'expired'};book.remove(token);book.join(invite.team,invite.email);return {status:'joined',team:invite.team};}
