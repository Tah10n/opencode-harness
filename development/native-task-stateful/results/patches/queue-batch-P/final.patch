+export function work(q, send, limit = 1) {
+ if (!Number.isSafeInteger(limit) || limit < 0) {
+  throw new RangeError('limit must be a nonnegative safe integer');
+ }
+ if (limit === 0) return {sent:[],retried:[]};
+
+ const count = Math.min(limit, q.snapshot().ready.length);
+ const sent = [], retried = [];
+ for (let i = 0; i < count; i++) {
+  const job = q.take();
+  if (!job) break;
+  if (send(job)) {
+   q.ack(job.id);
+   sent.push(job.id);
+  } else {
+   q.retry(job.id);
+   retried.push(job.id);
+  }
+ }
+ return {sent, retried};
 }
