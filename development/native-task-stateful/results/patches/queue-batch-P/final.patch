+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {queue} from '../src/queue.mjs';
+import {work} from '../src/worker.mjs';
+
+test('legacy successful, retry and idle behavior', () => {
+ const success = queue([{id:'success', payload:{value:1}}]);
+ assert.deepEqual(work(success, () => true), {sent:['success'], retried:[]});
+ assert.deepEqual(success.snapshot(), {ready:[], leased:[]});
+
+ const retry = queue([{id:'retry', payload:{value:2}}]);
+ assert.deepEqual(work(retry, () => false), {sent:[], retried:['retry']});
+ assert.deepEqual(retry.snapshot(), {
+  ready:[{id:'retry', payload:{value:2}}],
+  leased:[]
+ });
+
+ assert.deepEqual(work(retry, () => true), {sent:['retry'], retried:[]});
+ assert.deepEqual(retry.snapshot(), {ready:[], leased:[]});
+ assert.deepEqual(work(retry, () => true), {sent:[], retried:[]});
+});
+
+test('processes a mixed batch in FIFO order and preserves retry payloads', () => {
+ const q = queue([
+  {id:'a', payload:{value:1}},
+  {id:'b', payload:{value:2}},
+  {id:'c', payload:{value:3}},
+  {id:'d', payload:{value:4}}
+ ]);
+ const processed = [];
+
+ assert.deepEqual(work(q, job => {
+  processed.push(job.id);
+  return job.id !== 'b';
+ }, 3), {sent:['a','c'], retried:['b']});
+ assert.deepEqual(processed, ['a','b','c']);
+ assert.deepEqual(q.snapshot(), {
+  ready:[
+   {id:'d', payload:{value:4}},
+   {id:'b', payload:{value:2}}
+  ],
+  leased:[]
+ });
+});
+
+test('bounds all-failure retry to the ready jobs present at call start', () => {
+ const q = queue([{id:'a', payload:1}, {id:'b', payload:2}]);
+ const processed = [];
+
+ assert.deepEqual(work(q, job => {
+  processed.push(job.id);
+  return false;
+ }, 5), {sent:[], retried:['a','b']});
+ assert.deepEqual(processed, ['a','b']);
+ assert.deepEqual(q.snapshot(), {
+  ready:[{id:'a', payload:1}, {id:'b', payload:2}],
+  leased:[]
+ });
+});
+
+test('rejects invalid limits and leaves the queue untouched', () => {
+ const invalidLimits = [-1, 1.5, NaN, Infinity, Number.MAX_SAFE_INTEGER + 1, '1'];
+
+ for (const limit of invalidLimits) {
+  const q = queue([{id:'a', payload:1}]);
+  const before = q.snapshot();
+  let sends = 0;
+  assert.throws(() => work(q, () => {
+   sends++;
+   return true;
+  }, limit), RangeError);
+  assert.equal(sends, 0);
+  assert.deepEqual(q.snapshot(), before);
+ }
+});
+
+test('zero and empty work are no-ops', () => {
+ const q = queue([{id:'a', payload:1}]);
+ const before = q.snapshot();
+ let sends = 0;
+
+ assert.deepEqual(work(q, () => {
+  sends++;
+  return true;
+ }, 0), {sent:[], retried:[]});
+ assert.equal(sends, 0);
+ assert.deepEqual(q.snapshot(), before);
+
+ const empty = queue([]);
+ assert.deepEqual(work(empty, () => {
+  sends++;
+  return true;
+ }, 3), {sent:[], retried:[]});
+ assert.equal(sends, 0);
+ assert.deepEqual(empty.snapshot(), {ready:[], leased:[]});
 });
