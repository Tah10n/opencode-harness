 import {test} from 'node:test';import assert from 'node:assert/strict';
 import {queue} from '../src/queue.mjs';import {work} from '../src/worker.mjs';
-test('success, retry and idle',()=>{
- const q=queue([{id:'a',payload:1}]);
- assert.deepEqual(work(q,()=>true),{sent:['a'],retried:[]});
- assert.deepEqual(q.snapshot(),{ready:[],leased:[]});
- const expected=q.snapshot().ready.map(x=>x.id);
- assert.deepEqual(work(q,job=>!expected.includes(job.id)).retried,expected);
- assert.deepEqual(q.snapshot().ready.map(x=>x.id),expected);
- assert.deepEqual(work(q,()=>true),{sent:[],retried:[]});
+
+test('successful delivery sends once and removes the job',()=>{
+  const job={id:'a',payload:{value:1}};
+  const q=queue([job]);
+  const delivered=[];
+
+  assert.deepEqual(work(q,sentJob=>{delivered.push(sentJob);return true;}),{sent:['a'],retried:[]});
+  assert.deepEqual(delivered,[job]);
+  assert.deepEqual(q.snapshot(),{ready:[],leased:[]});
+});
+
+test('failed delivery retries with its payload and preserves unrelated ready work',()=>{
+  const failed={id:'failed',payload:{value:1}};
+  const other={id:'other',payload:{value:2}};
+  const q=queue([failed,other]);
+
+  assert.deepEqual(work(q,()=>false),{sent:[],retried:['failed']});
+  assert.deepEqual(q.snapshot(),{ready:[other,failed],leased:[]});
+
+  const delivered=[];
+  assert.deepEqual(work(q,sentJob=>{delivered.push(sentJob);return true;}),{sent:['other'],retried:[]});
+  assert.deepEqual(work(q,sentJob=>{delivered.push(sentJob);return true;}),{sent:['failed'],retried:[]});
+  assert.deepEqual(delivered,[other,failed]);
+  assert.deepEqual(q.snapshot(),{ready:[],leased:[]});
+});
+
+test('empty queue returns empty results without sending',()=>{
+  const q=queue([]);
+  let sendCalls=0;
+
+  assert.deepEqual(work(q,()=>{sendCalls++;return true;}),{sent:[],retried:[]});
+  assert.equal(sendCalls,0);
+  assert.deepEqual(q.snapshot(),{ready:[],leased:[]});
 });
