+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {queue} from '../src/queue.mjs';
+import {work} from '../src/worker.mjs';
+
+test('successful delivery sends once and removes the job', () => {
+  const q = queue([{id: 'a', payload: 1}]);
+  const sent = [];
+
+  assert.deepEqual(work(q, job => {
+    sent.push(job);
+    return true;
+  }), {sent: ['a'], retried: []});
+  assert.deepEqual(sent, [{id: 'a', payload: 1}]);
+  assert.deepEqual(q.snapshot(), {ready: [], leased: []});
+
+  assert.deepEqual(work(q, job => {
+    sent.push(job);
+    return true;
+  }), {sent: [], retried: []});
+  assert.deepEqual(sent, [{id: 'a', payload: 1}]);
+});
+
+test('failed delivery retains the job and preserves unrelated ready work', () => {
+  const q = queue([
+    {id: 'a', payload: {attempt: 1}},
+    {id: 'b', payload: {attempt: 1}}
+  ]);
+  const received = [];
+
+  assert.deepEqual(work(q, job => {
+    received.push(job);
+    return false;
+  }), {sent: [], retried: ['a']});
+  assert.deepEqual(received, [{id: 'a', payload: {attempt: 1}}]);
+  assert.deepEqual(q.snapshot(), {
+    ready: [
+      {id: 'b', payload: {attempt: 1}},
+      {id: 'a', payload: {attempt: 1}}
+    ],
+    leased: []
+  });
+});
+
+test('a retried job can be consumed by a later successful attempt', () => {
+  const q = queue([{id: 'a', payload: 1}]);
+
+  assert.deepEqual(work(q, () => false), {sent: [], retried: ['a']});
+  assert.deepEqual(work(q, job => {
+    assert.deepEqual(job, {id: 'a', payload: 1});
+    return true;
+  }), {sent: ['a'], retried: []});
+  assert.deepEqual(q.snapshot(), {ready: [], leased: []});
+});
+
+test('idle processing returns empty results without sending', () => {
+  const q = queue([]);
+  let sendCalls = 0;
+
+  assert.deepEqual(work(q, () => {
+    sendCalls++;
+    return true;
+  }), {sent: [], retried: []});
+  assert.equal(sendCalls, 0);
+  assert.deepEqual(q.snapshot(), {ready: [], leased: []});
+});
