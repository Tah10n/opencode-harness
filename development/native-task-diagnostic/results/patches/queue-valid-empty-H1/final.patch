+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {queue} from '../src/queue.mjs';
+import {work} from '../src/worker.mjs';
+
+test('successful delivery sends once and removes the job', () => {
+ const q = queue([{id: 'a', payload: 1}]);
+ let calls = 0;
+
+ assert.deepEqual(q.snapshot(), {ready: [{id: 'a', payload: 1}], leased: []});
+ const result = work(q, job => {
+  calls++;
+  assert.deepEqual(job, {id: 'a', payload: 1});
+  return true;
+ });
+
+ assert.deepEqual(result, {sent: ['a'], retried: []});
+ assert.equal(calls, 1);
+ assert.deepEqual(q.snapshot(), {ready: [], leased: []});
+});
+
+test('failed delivery returns the job to ready and preserves unrelated work', () => {
+ const q = queue([
+  {id: 'a', payload: 1},
+  {id: 'b', payload: 2}
+ ]);
+ let calls = 0;
+
+ assert.deepEqual(q.snapshot(), {
+  ready: [{id: 'a', payload: 1}, {id: 'b', payload: 2}],
+  leased: []
+ });
+ const result = work(q, job => {
+  calls++;
+  assert.deepEqual(job, {id: 'a', payload: 1});
+  return false;
+ });
+
+ assert.deepEqual(result, {sent: [], retried: ['a']});
+ assert.equal(calls, 1);
+ assert.deepEqual(q.snapshot(), {
+  ready: [{id: 'b', payload: 2}, {id: 'a', payload: 1}],
+  leased: []
+ });
+
+ assert.deepEqual(work(q, job => {
+  assert.deepEqual(job, {id: 'b', payload: 2});
+  return true;
+ }), {sent: ['b'], retried: []});
+ assert.deepEqual(q.snapshot(), {ready: [{id: 'a', payload: 1}], leased: []});
+ assert.deepEqual(work(q, job => {
+  assert.deepEqual(job, {id: 'a', payload: 1});
+  return true;
+ }), {sent: ['a'], retried: []});
+ assert.deepEqual(q.snapshot(), {ready: [], leased: []});
+});
+
+test('a retried job is delivered and removed on a later successful attempt', () => {
+ const q = queue([{id: 'a', payload: 1}]);
+ let calls = 0;
+
+ assert.deepEqual(q.snapshot(), {ready: [{id: 'a', payload: 1}], leased: []});
+ assert.deepEqual(work(q, () => false), {sent: [], retried: ['a']});
+ assert.deepEqual(q.snapshot(), {ready: [{id: 'a', payload: 1}], leased: []});
+
+ const result = work(q, job => {
+  calls++;
+  assert.deepEqual(job, {id: 'a', payload: 1});
+  return true;
+ });
+
+ assert.deepEqual(result, {sent: ['a'], retried: []});
+ assert.equal(calls, 1);
+ assert.deepEqual(q.snapshot(), {ready: [], leased: []});
+});
+
+test('idle processing returns empty results without sending', () => {
+ const q = queue([]);
+
+ assert.deepEqual(q.snapshot(), {ready: [], leased: []});
+ const result = work(q, () => assert.fail('send must not be called when idle'));
+
+ assert.deepEqual(result, {sent: [], retried: []});
+ assert.deepEqual(q.snapshot(), {ready: [], leased: []});
+});
