+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {queue} from '../src/queue.mjs';
+import {work} from '../src/worker.mjs';
+
+test('successfully sends one job and removes it', () => {
+  const q = queue([
+    {id: 'first', payload: {value: 1}},
+    {id: 'later', payload: {value: 2}},
+  ]);
+  const sent = [];
+
+  assert.deepEqual(q.snapshot(), {
+    ready: [
+      {id: 'first', payload: {value: 1}},
+      {id: 'later', payload: {value: 2}},
+    ],
+    leased: [],
+  });
+  assert.deepEqual(work(q, (job) => {
+    sent.push(job);
+    return true;
+  }), {sent: ['first'], retried: []});
+
+  assert.deepEqual(sent, [{id: 'first', payload: {value: 1}}]);
+  assert.deepEqual(q.snapshot(), {
+    ready: [{id: 'later', payload: {value: 2}}],
+    leased: [],
+  });
+});
+
+test('failed delivery retries the job and a later attempt can succeed', () => {
+  const q = queue([
+    {id: 'failed', payload: {value: 1}},
+    {id: 'unrelated', payload: {value: 2}},
+  ]);
+  const attempted = [];
+
+  assert.deepEqual(q.snapshot(), {
+    ready: [
+      {id: 'failed', payload: {value: 1}},
+      {id: 'unrelated', payload: {value: 2}},
+    ],
+    leased: [],
+  });
+  assert.deepEqual(work(q, (job) => {
+    attempted.push(job);
+    return false;
+  }), {sent: [], retried: ['failed']});
+  assert.deepEqual(q.snapshot(), {
+    ready: [
+      {id: 'unrelated', payload: {value: 2}},
+      {id: 'failed', payload: {value: 1}},
+    ],
+    leased: [],
+  });
+
+  assert.deepEqual(work(q, (job) => {
+    attempted.push(job);
+    return true;
+  }), {sent: ['unrelated'], retried: []});
+  assert.deepEqual(q.snapshot(), {
+    ready: [{id: 'failed', payload: {value: 1}}],
+    leased: [],
+  });
+
+  assert.deepEqual(work(q, (job) => {
+    attempted.push(job);
+    return true;
+  }), {sent: ['failed'], retried: []});
+  assert.deepEqual(attempted, [
+    {id: 'failed', payload: {value: 1}},
+    {id: 'unrelated', payload: {value: 2}},
+    {id: 'failed', payload: {value: 1}},
+  ]);
+  assert.deepEqual(q.snapshot(), {ready: [], leased: []});
+});
+
+test('idle processing returns empty results without calling send', () => {
+  const q = queue([]);
+  let sendCalls = 0;
+
+  assert.deepEqual(q.snapshot(), {ready: [], leased: []});
+  assert.deepEqual(work(q, () => {
+    sendCalls += 1;
+    return true;
+  }), {sent: [], retried: []});
+
+  assert.equal(sendCalls, 0);
+  assert.deepEqual(q.snapshot(), {ready: [], leased: []});
 });
